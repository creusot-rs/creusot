    | & _61: t_Option_Int = Any.any_l ()
    | & _63: int = Any.any_l ()
    | & _65: int = Any.any_l () ])
    [ return (result: t_SpinLock_T) ->
    {[@stop_split] [@expl:new_T ensures] ([@stop_split] [@expl:new result type invariant] inv_SpinLock_T result)
      /\ ([@stop_split] [@expl:new ensures] result.inv = inv'1)}
      (! return {result}) ]
end
