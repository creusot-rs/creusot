name: "creusot-deps"
synopsis: "Opam dependencies for Creusot"
opam-version: "2.0"
maintainer: "Armaël Guéneau <armael.gueneau@inria.fr>"
authors: "the creusot authors"
depends: [
  "ocaml" {= "5.3.0"}
  "why3" {= "git-05bf4ddf"}
  "why3-ide" {= "git-05bf4ddf" & !?in-creusot-ci}
  "why3find" {= "git-c9ec1d0"} # if these versions change don't forget to update creusot-setup/src/tools_versions_urls.rs
# optional dependencies of why3
  "ocamlgraph"
  "camlzip"
  "zarith"
]
# When updating the hash and git-XXX below, don't forget to update them in the
# depends: field above!
pin-depends: [
  [ "why3.git-05bf4ddf" "git+https://gitlab.inria.fr/why3/why3.git#05bf4ddf55cb3042f34c3bc0ed3aff56a226978a" ]
  [ "why3-ide.git-05bf4ddf" "git+https://gitlab.inria.fr/why3/why3.git#05bf4ddf55cb3042f34c3bc0ed3aff56a226978a" ]
  [ "why3find.git-c9ec1d0" "git+https://github.com/mcoulmance/why3find.git#c9ec1d03bdc92ab4ce991028613b70c5acc7022b"]
]
