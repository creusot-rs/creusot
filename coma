#!/usr/bin/env bash

pushd $(dirname "$1") > /dev/null
INPUTPATH=$(pwd)/$(basename "$1")
OUTDIR=$(pwd)
popd > /dev/null
SCRIPTPATH=$(dirname "$BASH_SOURCE")
pushd "$SCRIPTPATH" > /dev/null
eval $(cargo run --bin dev-env)
PROC=$(ls -td ./target/creusot/debug/build/creusot-std-proc/*/out | head -n1)
STD=$(ls -t ./target/creusot/debug/build/creusot-std/*/out/libcreusot_std-*.rmeta | head -n1)
cargo run --bin creusot-rustc --  \
  --edition=2024 \
  -Zno-codegen \
  -Zmacro-backtrace \
  --extern creusot_std=$STD \
  -Ldependency=$PROC \
  -Ldependency=$(dirname $STD) \
  --crate-type=lib \
  "$INPUTPATH" \
  -- \
  --output-file="${INPUTPATH%.*}.coma" \
  --span-mode=absolute \
  --creusot-extern creusot_std=./target/creusot/debug/libcreusot_std.cmeta

popd > /dev/null
