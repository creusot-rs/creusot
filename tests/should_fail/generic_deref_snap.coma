module M_bad
  use creusot.int.Int32
  use creusot.prelude.Mode
  use creusot.prelude.Any
  
  predicate precondition_deref (self: ()) (args: Int32.t) (mode: Mode.t)
  
  predicate postcondition_deref (self: ()) (args: Int32.t) (result: Int32.t) (mode: Mode.t)
  
  let deref_wrap_Snapshot_i32 (x: Int32.t) (mode: Mode.t) (return (x'0: Int32.t)) =
  {[@stop_split] [@expl:deref_wrap requires] precondition_deref () x mode}
    any
    [ return (result: Int32.t) -> {[@stop_split] [@expl:deref_wrap ensures] postcondition_deref () x result mode}
      (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let bad (x: Int32.t) (mode: Mode.t) (return (x'0: Int32.t)) = {not Mode.terminates mode}
    (! bb0
    [ bb0 = s0
      [ s0 = [ &_4 <- x ] s1
      | s1 = deref_wrap_Snapshot_i32 {_4} {mode} (fun (_x: Int32.t) -> [ &_2 <- _x ] s2)
      | s2 = [ &_ret <- _2 ] s3
      | s3 = return {_ret} ] ]
    [ & _ret: Int32.t = Any.any_l () | & x: Int32.t = x | & _2: Int32.t = Any.any_l () | & _4: Int32.t = Any.any_l () ])
    [ return (result: Int32.t) -> (! return {result}) ]
end
module M_deref_wrap
  use creusot.prelude.Mode
  use creusot.prelude.Any
  
  type t_T
  
  type t_Target
  
  predicate precondition_deref (self: ()) (args: t_T) (mode: Mode.t)
  
  axiom precondition_fndef:
    forall mode: Mode.t. forall args: t_T [precondition_deref () args mode]. (let self = args in false)
        -> precondition_deref () args mode
  
  predicate inv_Target (_1: t_Target)
  
  predicate invariant_ref_Target [@inline:trivial] (self: t_Target) = inv_Target self
  
  meta "rewrite_def" predicate invariant_ref_Target
  
  predicate inv_ref_Target [@inline:trivial] (_1: t_Target) = invariant_ref_Target _1
  
  meta "rewrite_def" predicate inv_ref_Target
  
  predicate postcondition_deref (self: ()) (args: t_T) (result: t_Target) (mode: Mode.t)
  
  axiom postcondition_fndef:
    forall args: t_T, result: t_Target, mode: Mode.t [postcondition_deref () args result mode]. postcondition_deref () args result mode
      -> (let self = args in inv_ref_Target result)
  
  predicate postcondition_once_deref (self: ()) (args: t_T) (result: t_Target) (mode: Mode.t) =
    postcondition_deref self args result mode
  
  meta "rewrite_def" predicate postcondition_once_deref
  
  let deref_T (self: t_T) (mode: Mode.t) (return (x: t_Target)) =
  {[@stop_split] [@expl:deref requires] precondition_deref () self mode}
    any
    [ return (result: t_Target) -> {[@stop_split] [@expl:deref ensures] postcondition_once_deref () self result mode}
      (! return {result}) ]
  
  predicate inv_T (_1: t_T)
  
  predicate invariant_ref_T [@inline:trivial] (self: t_T) = inv_T self
  
  meta "rewrite_def" predicate invariant_ref_T
  
  predicate inv_ref_T [@inline:trivial] (_1: t_T) = invariant_ref_T _1
  
  meta "rewrite_def" predicate inv_ref_T
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let deref_wrap_T (x: t_T) (mode: Mode.t) (return (x'0: t_Target)) = {not Mode.terminates mode}
    {[@stop_split] [@expl:deref_wrap_T requires] ([@stop_split] [@expl:deref_wrap 'x' type invariant] inv_ref_T x)
    /\ ([@stop_split] [@expl:deref_wrap requires] precondition_deref () x mode)}
    (! bb0
    [ bb0 = s0
      [ s0 = [ &_8 <- x ] s1
      | s1 = deref_T {_8} {mode} (fun (_x: t_Target) -> [ &_6 <- _x ] s2)
      | s2 = [ &_ret <- _6 ] s3
      | s3 = return {_ret} ] ]
    [ & _ret: t_Target = Any.any_l () | & x: t_T = x | & _6: t_Target = Any.any_l () | & _8: t_T = Any.any_l () ])
    [ return (result: t_Target) ->
    {[@stop_split] [@expl:deref_wrap_T ensures] ([@stop_split] [@expl:deref_wrap result type invariant] inv_ref_Target result)
      /\ ([@stop_split] [@expl:deref_wrap ensures] postcondition_deref () x result mode)}
      (! return {result}) ]
end
