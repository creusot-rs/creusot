module M_f
  use creusot.prelude.MutBorrow
  use creusot.int.Int32
  use map.Map
  use creusot.prelude.Any
  use creusot.prelude.Mode
  
  type t_Guarded_refmut_i32 = {
    inner: MutBorrow.t Int32.t;
    _guard: Map.map (MutBorrow.t Int32.t) bool;
    _initial: MutBorrow.t Int32.t }
  
  predicate resolve_refmut_i32 [@inline:trivial] (_1: MutBorrow.t Int32.t) = _1.final = _1.current
  
  meta "rewrite_def" predicate resolve_refmut_i32
  
  predicate index_Mapping_refmut_i32_bool [@inline:trivial] (self: Map.map (MutBorrow.t Int32.t) bool) (a: MutBorrow.t Int32.t) =
    Map.get self a
  
  meta "rewrite_def" predicate index_Mapping_refmut_i32_bool
  
  function guard_refmut_i32 [@inline:trivial] (self: t_Guarded_refmut_i32) : Map.map (MutBorrow.t Int32.t) bool =
    self._guard
  
  meta "rewrite_def" function guard_refmut_i32
  
  predicate rel_refmut_i32 [@inline:trivial] (self: MutBorrow.t Int32.t) (other: MutBorrow.t Int32.t) =
    self.final = other.final
  
  meta "rewrite_def" predicate rel_refmut_i32
  
  predicate invariant_Guarded_refmut_i32 [@inline:trivial] (self: t_Guarded_refmut_i32) =
    index_Mapping_refmut_i32_bool (guard_refmut_i32 self) self.inner /\ rel_refmut_i32 self.inner self._initial
  
  meta "rewrite_def" predicate invariant_Guarded_refmut_i32
  
  predicate inv_Guarded_refmut_i32 (_1: t_Guarded_refmut_i32)
  
  axiom inv_axiom [@rewrite]: forall _1: t_Guarded_refmut_i32 [inv_Guarded_refmut_i32 _1]. inv_Guarded_refmut_i32 _1
      = invariant_Guarded_refmut_i32 _1
  
  predicate resolve_Guarded_refmut_i32 (_1: t_Guarded_refmut_i32)
  
  axiom resolve_axiom [@rewrite]:
    forall _1: t_Guarded_refmut_i32 [resolve_Guarded_refmut_i32 _1]. resolve_Guarded_refmut_i32 _1
      = resolve_refmut_i32 _1.inner
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let f (g: t_Guarded_refmut_i32) (mode: Mode.t) (return (x: MutBorrow.t Int32.t)) = {not Mode.terminates mode}
    {[@stop_split] [@expl:f 'g' type invariant] inv_Guarded_refmut_i32 g}
    (! bb0
    [ bb0 = s0
      [ s0 = MutBorrow.borrow_final <Int32.t> {g.inner.current} {MutBorrow.get_id g.inner}
          (fun (_bor: MutBorrow.t Int32.t) ->
            [ &_2 <- _bor ] [ &g <- { g with inner = { g.inner with current = _bor.final } } ] s1)
      | s1 = MutBorrow.borrow_final <Int32.t> {_2.current} {MutBorrow.get_id _2}
          (fun (_bor: MutBorrow.t Int32.t) -> [ &_ret <- _bor ] [ &_2 <- { _2 with current = _bor.final } ] s2)
      | s2 = -{resolve_refmut_i32 _2}- s3
      | s3 = s4 [ _ck -> (! {[@expl:type invariant] inv_Guarded_refmut_i32 g} any) ]
      | s4 = -{resolve_Guarded_refmut_i32 g}- s5
      | s5 = return {_ret} ] ]
    [ & _ret: MutBorrow.t Int32.t = Any.any_l ()
    | & g: t_Guarded_refmut_i32 = g
    | & _2: MutBorrow.t Int32.t = Any.any_l () ]) [ return (result: MutBorrow.t Int32.t) -> (! return {result}) ]
end
