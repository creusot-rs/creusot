module M_vec_insert_past_end
  use seq.Seq
  use creusot.int.UInt8
  use creusot.int.UInt64
  use creusot.prelude.MutBorrow
  use creusot.prelude.Any
  use int.Int
  
  type t_Vec_u8_Global
  
  constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)
  
  function view_Vec_u8_Global (self: t_Vec_u8_Global) : Seq.seq UInt8.t
  
  axiom view_Vec_u8_Global_spec:
    forall self: t_Vec_u8_Global [view_Vec_u8_Global self]. Seq.length (view_Vec_u8_Global self)
      <= UInt64.t'int const_MAX
  
  let new_u8 (return (x: t_Vec_u8_Global)) = any
    [ return (result: t_Vec_u8_Global) -> {[@stop_split] [@expl:new ensures] Seq.length (view_Vec_u8_Global result) = 0}
      (! return {result}) ]
  
  function index_Vec_u8_Global [@inline:trivial] (self: t_Vec_u8_Global) (ix: int) : UInt8.t =
    Seq.get (view_Vec_u8_Global self) ix
  
  meta "rewrite_def" function index_Vec_u8_Global
  
  let insert_u8 (self: MutBorrow.t t_Vec_u8_Global) (index: UInt64.t) (element: UInt8.t) (return (x: ())) =
  {[@stop_split] [@expl:insert requires] UInt64.t'int index <= Seq.length (view_Vec_u8_Global self.current)}
    any
    [ return (result: ()) ->
    {[@stop_split] [@expl:insert_u8 ensures] ([@stop_split] [@expl:insert ensures #0] Seq.length (view_Vec_u8_Global self.final)
        = Seq.length (view_Vec_u8_Global self.current) + 1)
      /\ ([@stop_split] [@expl:insert ensures #1] forall i: int. 0 <= i /\ i < UInt64.t'int index
          -> index_Vec_u8_Global self.final i = index_Vec_u8_Global self.current i)
      /\ ([@stop_split] [@expl:insert ensures #2] index_Vec_u8_Global self.final (UInt64.t'int index) = element)
      /\ ([@stop_split] [@expl:insert ensures #3] forall i: int. UInt64.t'int index < i
          /\ i < Seq.length (view_Vec_u8_Global self.final)
        -> index_Vec_u8_Global self.final i = index_Vec_u8_Global self.current (i - 1))}
      (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let vec_insert_past_end (return (x: ())) = (! bb0
    [ bb0 = s0
      [ s0 = new_u8 (fun (_x: t_Vec_u8_Global) -> [ &v <- _x ] s1)
      | s1 = MutBorrow.borrow_mut <t_Vec_u8_Global> {v}
          (fun (_bor: MutBorrow.t t_Vec_u8_Global) -> [ &_3 <- _bor ] [ &v <- _bor.final ] s2)
      | s2 = insert_u8 {_3} {(1: UInt64.t)} {(42: UInt8.t)} (fun (_x: ()) -> [ &_2 <- _x ] s3)
      | s3 = return {_ret} ] ]
    [ & _ret: () = Any.any_l ()
    | & v: t_Vec_u8_Global = Any.any_l ()
    | & _2: () = Any.any_l ()
    | & _3: MutBorrow.t t_Vec_u8_Global = Any.any_l () ]) [ return (result: ()) -> (! return {result}) ]
end
module M_vecdeque_index_past_end
  use seq.Seq
  use creusot.int.UInt8
  use creusot.int.UInt64
  use creusot.prelude.Any
  use int.Int
  
  type t_VecDeque_u8_Global
  
  constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)
  
  function view_VecDeque_u8_Global (self: t_VecDeque_u8_Global) : Seq.seq UInt8.t
  
  axiom view_VecDeque_u8_Global_spec:
    forall self: t_VecDeque_u8_Global [view_VecDeque_u8_Global self]. Seq.length (view_VecDeque_u8_Global self)
      <= UInt64.t'int const_MAX
  
  let new_u8 (return (x: t_VecDeque_u8_Global)) = any
    [ return (result: t_VecDeque_u8_Global) ->
    {[@stop_split] [@expl:new ensures] Seq.length (view_VecDeque_u8_Global result) = 0}
      (! return {result}) ]
  
  let index_VecDeque_u8_Global (self: t_VecDeque_u8_Global) (index: UInt64.t) (return (x: UInt8.t)) =
  {[@stop_split] [@expl:index requires] UInt64.t'int index < Seq.length (view_VecDeque_u8_Global self)}
    any
    [ return (result: UInt8.t) -> {[@stop_split] [@expl:index ensures] result
      = Seq.get (view_VecDeque_u8_Global self) (UInt64.t'int index)}
      (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let vecdeque_index_past_end (return (x: UInt8.t)) = (! bb0
    [ bb0 = s0
      [ s0 = new_u8 (fun (_x: t_VecDeque_u8_Global) -> [ &v <- _x ] s1)
      | s1 = index_VecDeque_u8_Global {v} {(0: UInt64.t)} (fun (_x: UInt8.t) -> [ &_2 <- _x ] s2)
      | s2 = [ &_ret <- _2 ] s3
      | s3 = return {_ret} ] ]
    [ & _ret: UInt8.t = Any.any_l () | & v: t_VecDeque_u8_Global = Any.any_l () | & _2: UInt8.t = Any.any_l () ])
    [ return (result: UInt8.t) -> (! return {result}) ]
end
