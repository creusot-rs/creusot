module M_use_logic
  use creusot.prelude.Any
  use creusot.prelude.Mode
  
  predicate logic = true
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let use' (mode: Mode.t) (return (x: ())) = (! bb0
    [ bb0 = return {_ret} ] [ & _ret: () = Any.any_l () ])
    [ return (result: ()) -> {[@stop_split] [@expl:use_logic ensures] logic} (! return {result}) ]
end
