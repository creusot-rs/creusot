module M_gloop
  use creusot.int.UInt64
  use creusot.prelude.Mode
  use creusot.prelude.Any
  use int.Int
  
  predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self
  
  meta "rewrite_def" predicate ge_log_Int
  
  predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self
  
  meta "rewrite_def" predicate gt_log_Int
  
  predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
    ge_log_Int self 0 /\ gt_log_Int self other
  
  meta "rewrite_def" predicate well_founded_relation_Int
  
  let new_unit (x: ()) (mode: Mode.t) (return (x'0: ())) = any
    [ return (result: ()) -> {[@stop_split] [@expl:new ensures] result = x} (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let gloop (x: UInt64.t) (mode: Mode.t) (return (x'0: ())) = (! bb0
    [ bb0 = s0 [ s0 = [ &i <- x ] s1 | s1 = bb1 ]
    | bb1 = bb1invariant
      [ bb1 = {[@expl:loop variant] well_founded_relation_Int variant_old_bb1 (UInt64.t'int i)} bb1invariant
      | bb1invariant = (! [ &variant_old_bb1 <- UInt64.t'int i ] s0
        [ s0 = [ &_9 <- UInt64.gt i (0: UInt64.t) ] s1
        | s1 = any [ br0 -> {_9 = false} (! bb4) | br1 -> {_9} (! bb3) ] ])
        [ bb3 = s0 [ s0 = UInt64.sub {i} {(1: UInt64.t)} (fun (_x: UInt64.t) -> [ &i <- _x ] s1) | s1 = bb1 ] ] ]
    | bb4 = s0
      [ s0 = new_unit {_3} {Mode.into_ghost mode} (fun (_x: ()) -> [ &_2 <- _x ] s1)
      | s1 = [ &i'0 <- x ] s2
      | s2 = bb6 ]
    | bb6 = bb6invariant
      [ bb6 = {Mode.terminates mode
        -> ([@expl:loop variant] well_founded_relation_Int variant_old_bb6 (UInt64.t'int i'0))}
        bb6invariant
      | bb6invariant = (! [ &variant_old_bb6 <- UInt64.t'int i'0 ] s0
        [ s0 = [ &_16 <- UInt64.gt i'0 (0: UInt64.t) ] s1
        | s1 = any [ br0 -> {_16 = false} (! bb9) | br1 -> {_16} (! bb8) ] ])
        [ bb8 = s0 [ s0 = UInt64.sub {i'0} {(1: UInt64.t)} (fun (_x: UInt64.t) -> [ &i'0 <- _x ] s1) | s1 = bb6 ] ] ]
    | bb9 = return {_ret} ]
    [ & _ret: () = Any.any_l ()
    | & x: UInt64.t = x
    | & _2: () = Any.any_l ()
    | & _3: () = Any.any_l ()
    | & i: UInt64.t = Any.any_l ()
    | & _9: bool = Any.any_l ()
    | & i'0: UInt64.t = Any.any_l ()
    | & _16: bool = Any.any_l ()
    | & variant_old_bb1: int = Any.any_l ()
    | & variant_old_bb6: int = Any.any_l () ]) [ return (result: ()) -> (! return {result}) ]
end
