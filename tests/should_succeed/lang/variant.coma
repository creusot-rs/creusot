module M_frec
  use creusot.int.UInt64
  use creusot.prelude.Mode
  use creusot.prelude.Any
  use int.Int
  
  let frec (x: UInt64.t) (mode: Mode.t) (return (x'0: ())) = any [ return (result: ()) -> (! return {result}) ]
  
  predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self
  
  meta "rewrite_def" predicate ge_log_Int
  
  predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self
  
  meta "rewrite_def" predicate gt_log_Int
  
  predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
    ge_log_Int self 0 /\ gt_log_Int self other
  
  meta "rewrite_def" predicate well_founded_relation_Int
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let frec'0 (x: UInt64.t) (mode: Mode.t) (return (x'0: ())) = (! bb0
    [ bb0 = s0
      [ s0 = [ &_4 <- x <> (0: UInt64.t) ] s1 | s1 = any [ br0 -> {_4 = false} (! bb4) | br1 -> {_4} (! bb1) ] ]
    | bb1 = s0
      [ s0 = UInt64.sub {x} {(1: UInt64.t)} (fun (_x: UInt64.t) -> [ &_6 <- _x ] s1)
      | s1 = frec {_6} {mode} (fun (_x: ()) -> [ &_ret <- _x ] s2)
      | s2 = return {_ret} ]
    | bb4 = return {_ret} ]
    [ & _ret: () = Any.any_l () | & x: UInt64.t = x | & _4: bool = Any.any_l () | & _6: UInt64.t = Any.any_l () ]
    [ frec (x: UInt64.t) (mode: Mode.t) (_k (_ret: ())) -> {Mode.terminates mode
      -> ([@expl:function variant] well_founded_relation_Int function_variant (UInt64.t'int x))}
      frec {x} {mode} (_k) ] [ function_variant: int = UInt64.t'int x ]) [ return (result: ()) -> (! return {result}) ]
end
