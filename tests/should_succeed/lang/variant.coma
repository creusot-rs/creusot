  let frec_partial'0 (x: UInt64.t) (mode: Mode.t) (return (x'0: ())) =
  {[@stop_split] [@expl:frec_partial requires] Mode.terminates mode -> ge_log_Int (UInt64.t'int x) 1}
    (! bb0
    [ bb0 = s0 [ s0 = [ &_6 <- x = (0: UInt64.t) ] s1 | s1 = any [ br0 -> {_6 = false} (! bb3) | br1 -> {_6} (! bb1) ] ]
    | bb1 = s0 [ s0 = frec_partial {x} {mode} (fun (_x: ()) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ]
    | bb3 = s0
      [ s0 = [ &_9 <- UInt64.gt x (1: UInt64.t) ] s1 | s1 = any [ br0 -> {_9 = false} (! bb8) | br1 -> {_9} (! bb4) ] ]
    | bb4 = s0
      [ s0 = UInt64.sub {x} {(1: UInt64.t)} (fun (_x: UInt64.t) -> [ &_11 <- _x ] s1)
      | s1 = frec_partial {_11} {mode} (fun (_x: ()) -> [ &_ret <- _x ] s2)
      | s2 = return {_ret} ]
    | bb8 = return {_ret} ]
    [ & _ret: () = Any.any_l ()
    | & x: UInt64.t = x
    | & _6: bool = Any.any_l ()
    | & _9: bool = Any.any_l ()
    | & _11: UInt64.t = Any.any_l () ]
    [ frec_partial (x: UInt64.t) (mode: Mode.t) (_k (_ret: ())) -> {Mode.terminates mode
