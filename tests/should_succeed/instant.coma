module M_test_instant
  use creusot.int.UInt64
  use creusot.prelude.Any
  use int.Int
  
  type t_Instant
  
  predicate inv_Instant (_1: t_Instant)
  
  predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self
  
  meta "rewrite_def" predicate ge_log_Int
  
  function view_Instant (self: t_Instant) : int
  
  axiom view_Instant_spec: forall self: t_Instant [view_Instant self]. ge_log_Int (view_Instant self) 0
  
  let now (return (x: t_Instant)) = any
    [ return (result: t_Instant) ->
    {[@stop_split] [@expl:now ensures] ([@stop_split] [@expl:now result type invariant] inv_Instant result)
      /\ ([@stop_split] [@expl:now ensures] ge_log_Int (view_Instant result) 0)}
      (! return {result}) ]
  
  type t_Duration
  
  predicate inv_Duration (_1: t_Duration)
  
  function secs_to_nanos (secs: int) : int = secs * 1000000000
  
  constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)
  
  function view_Duration (self: t_Duration) : int
  
  axiom view_Duration_spec: forall self: t_Duration [view_Duration self]. ge_log_Int (view_Duration self) 0
      /\ view_Duration self <= secs_to_nanos (UInt64.t'int const_MAX) + 999999999
  
  let from_secs (secs: UInt64.t) (return (x: t_Duration)) = any
    [ return (result: t_Duration) ->
    {[@stop_split] [@expl:from_secs ensures] ([@stop_split] [@expl:from_secs result type invariant] inv_Duration result)
      /\ ([@stop_split] [@expl:from_secs ensures] view_Duration result = secs_to_nanos (UInt64.t'int secs))}
      (! return {result}) ]
  
  predicate invariant_ref_Instant [@inline:trivial] (self: t_Instant) = inv_Instant self
  
  meta "rewrite_def" predicate invariant_ref_Instant
  
  predicate inv_ref_Instant [@inline:trivial] (_1: t_Instant) = invariant_ref_Instant _1
  
  meta "rewrite_def" predicate inv_ref_Instant
  
  let elapsed (self: t_Instant) (return (x: t_Duration)) =
  {[@stop_split] [@expl:elapsed 'self' type invariant] inv_ref_Instant self}
    any
    [ return (result: t_Duration) ->
    {[@stop_split] [@expl:elapsed ensures] ([@stop_split] [@expl:elapsed result type invariant] inv_Duration result)
      /\ ([@stop_split] [@expl:elapsed ensures] ge_log_Int (view_Duration result) 0)}
      (! return {result}) ]
  
  predicate invariant_ref_Duration [@inline:trivial] (self: t_Duration) = inv_Duration self
  
  meta "rewrite_def" predicate invariant_ref_Duration
  
  predicate inv_ref_Duration [@inline:trivial] (_1: t_Duration) = invariant_ref_Duration _1
  
  meta "rewrite_def" predicate inv_ref_Duration
  
  function deep_model_Duration [@inline:trivial] (self: t_Duration) : int = view_Duration self
  
  meta "rewrite_def" function deep_model_Duration
  
  function deep_model_ref_Duration [@inline:trivial] (self: t_Duration) : int = deep_model_Duration self
  
  meta "rewrite_def" function deep_model_ref_Duration
  
  let ge_Duration (self: t_Duration) (other: t_Duration) (return (x: bool)) =
  {[@stop_split] [@expl:ge_Duration requires] ([@stop_split] [@expl:ge 'self' type invariant] inv_ref_Duration self)
    /\ ([@stop_split] [@expl:ge 'other' type invariant] inv_ref_Duration other)}
    any
    [ return (result: bool) -> {[@stop_split] [@expl:ge ensures] result
      = ge_log_Int (deep_model_ref_Duration self) (deep_model_ref_Duration other)}
      (! return {result}) ]
  
  type t_Option_Instant = None | Some t_Instant
  
  predicate inv_Option_Instant (_1: t_Option_Instant)
  
  axiom inv_axiom [@rewrite]: forall _1: t_Option_Instant [inv_Option_Instant _1]. inv_Option_Instant _1
      = match _1 with
        | None -> true
        | Some f0 -> inv_Instant f0
        end
  
  type t_Option_Int = None'0 | Some'0 int
  
  function deep_model_Instant [@inline:trivial] (self: t_Instant) : int = view_Instant self
  
  meta "rewrite_def" function deep_model_Instant
  
  function deep_model_Option_Instant [@inline:trivial] (self: t_Option_Instant) : t_Option_Int = match self with
      | Some t -> Some'0 (deep_model_Instant t)
      | None -> None'0
      end
  
  meta "rewrite_def" function deep_model_Option_Instant
  
  predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self
  
  meta "rewrite_def" predicate gt_log_Int
  
  predicate le_log_Option_Int (self: t_Option_Int) (o: t_Option_Int) =
    match self with
      | None'0 -> true
      | Some'0 s -> match o with
        | None'0 -> false
        | Some'0 o'0 -> s <= o'0
        end
      end
  
  predicate lt_log_Option_Int (self: t_Option_Int) (o: t_Option_Int) =
    match o with
      | None'0 -> false
      | Some'0 o'0 -> match self with
        | None'0 -> true
        | Some'0 s -> s < o'0
        end
      end
  
  function le_lt_log_Option_Int (self: t_Option_Int) (other: t_Option_Int) : ()
  
  axiom le_lt_log_Option_Int_spec: forall self: t_Option_Int, other: t_Option_Int. le_log_Option_Int self other
      = (lt_log_Option_Int self other \/ self = other)
  
  function transitive_Option_Int (x: t_Option_Int) (y: t_Option_Int) (z: t_Option_Int) : ()
  
  axiom transitive_Option_Int_spec: forall x: t_Option_Int, y: t_Option_Int, z: t_Option_Int. lt_log_Option_Int x y
      -> lt_log_Option_Int y z -> lt_log_Option_Int x z
  
  function irreflexive_Option_Int (self: t_Option_Int) : ()
  
  axiom irreflexive_Option_Int_spec: forall self: t_Option_Int. not lt_log_Option_Int self self
  
  let checked_add (self: t_Instant) (duration: t_Duration) (return (x: t_Option_Instant)) =
  {[@stop_split] [@expl:checked_add requires] ([@stop_split] [@expl:checked_add 'self' type invariant] inv_ref_Instant self)
    /\ ([@stop_split] [@expl:checked_add 'duration' type invariant] inv_Duration duration)}
    any
    [ return (result: t_Option_Instant) ->
    {[@stop_split] [@expl:checked_add ensures] ([@stop_split] [@expl:checked_add result type invariant] inv_Option_Instant result)
      /\ ([@stop_split] [@expl:checked_add ensures #0] view_Duration duration = 0
        -> deep_model_Option_Instant result = Some'0 (view_Instant self))
      /\ ([@stop_split] [@expl:checked_add ensures #1] gt_log_Int (view_Duration duration) 0 /\ result <> None
      -> lt_log_Option_Int (Some'0 (view_Instant self)) (deep_model_Option_Instant result))}
      (! return {result}) ]
  
  predicate invariant_ref_Option_Instant [@inline:trivial] (self: t_Option_Instant) = inv_Option_Instant self
  
  meta "rewrite_def" predicate invariant_ref_Option_Instant
  
  predicate inv_ref_Option_Instant [@inline:trivial] (_1: t_Option_Instant) = invariant_ref_Option_Instant _1
  
  meta "rewrite_def" predicate inv_ref_Option_Instant
  
  function deep_model_ref_Option_Instant [@inline:trivial] (self: t_Option_Instant) : t_Option_Int =
    deep_model_Option_Instant self
  
  meta "rewrite_def" function deep_model_ref_Option_Instant
  
  let eq_Option_Instant (self: t_Option_Instant) (other: t_Option_Instant) (return (x: bool)) =
  {[@stop_split] [@expl:eq_Option_Instant requires] ([@stop_split] [@expl:eq 'self' type invariant] inv_ref_Option_Instant self)
    /\ ([@stop_split] [@expl:eq 'other' type invariant] inv_ref_Option_Instant other)}
    any
    [ return (result: bool) -> {[@stop_split] [@expl:eq ensures] result
      = (deep_model_ref_Option_Instant self = deep_model_ref_Option_Instant other)}
      (! return {result}) ]
  
  let elim_Some (_x: t_Option_Instant) (return (f0: t_Instant)) = any
    [ _k (f0: t_Instant) -> {Some f0 = _x} (! return {f0})
    | _chk -> (! {[@expl:elim Some] match _x with
        | Some _ -> true
        | _ -> false
        end}
      any) ]
  
  predicate gt_log_Option_Int [@inline:trivial] (self: t_Option_Int) (other: t_Option_Int) =
    lt_log_Option_Int other self
  
  meta "rewrite_def" predicate gt_log_Option_Int
  
  let checked_sub (self: t_Instant) (duration: t_Duration) (return (x: t_Option_Instant)) =
  {[@stop_split] [@expl:checked_sub requires] ([@stop_split] [@expl:checked_sub 'self' type invariant] inv_ref_Instant self)
    /\ ([@stop_split] [@expl:checked_sub 'duration' type invariant] inv_Duration duration)}
    any
    [ return (result: t_Option_Instant) ->
    {[@stop_split] [@expl:checked_sub ensures] ([@stop_split] [@expl:checked_sub result type invariant] inv_Option_Instant result)
      /\ ([@stop_split] [@expl:checked_sub ensures #0] view_Duration duration = 0
        -> deep_model_Option_Instant result = Some'0 (view_Instant self))
      /\ ([@stop_split] [@expl:checked_sub ensures #1] gt_log_Int (view_Duration duration) 0 /\ result <> None
      -> gt_log_Option_Int (Some'0 (view_Instant self)) (deep_model_Option_Instant result))}
      (! return {result}) ]
  
  let sub_Instant (self: t_Instant) (other: t_Instant) (return (x: t_Duration)) =
  {[@stop_split] [@expl:sub_Instant requires] ([@stop_split] [@expl:sub 'self' type invariant] inv_Instant self)
    /\ ([@stop_split] [@expl:sub 'other' type invariant] inv_Instant other)}
    any
    [ return (result: t_Duration) ->
    {[@stop_split] [@expl:sub_Instant ensures] ([@stop_split] [@expl:sub result type invariant] inv_Duration result)
      /\ ([@stop_split] [@expl:sub ensures #0] gt_log_Int (view_Instant self) (view_Instant other)
        -> gt_log_Int (view_Duration result) 0)
      /\ ([@stop_split] [@expl:sub ensures #1] view_Instant self <= view_Instant other -> view_Duration result = 0)}
      (! return {result}) ]
  
  let eq_Duration (self: t_Duration) (other: t_Duration) (return (x: bool)) =
  {[@stop_split] [@expl:eq_Duration requires] ([@stop_split] [@expl:eq 'self' type invariant] inv_ref_Duration self)
    /\ ([@stop_split] [@expl:eq 'other' type invariant] inv_ref_Duration other)}
    any
    [ return (result: bool) -> {[@stop_split] [@expl:eq ensures] result
      = (deep_model_ref_Duration self = deep_model_ref_Duration other)}
      (! return {result}) ]
  
  let gt_Duration (self: t_Duration) (other: t_Duration) (return (x: bool)) =
  {[@stop_split] [@expl:gt_Duration requires] ([@stop_split] [@expl:gt 'self' type invariant] inv_ref_Duration self)
    /\ ([@stop_split] [@expl:gt 'other' type invariant] inv_ref_Duration other)}
    any
    [ return (result: bool) -> {[@stop_split] [@expl:gt ensures] result
      = gt_log_Int (deep_model_ref_Duration self) (deep_model_ref_Duration other)}
      (! return {result}) ]
  
  let duration_since (self: t_Instant) (earlier: t_Instant) (return (x: t_Duration)) =
  {[@stop_split] [@expl:duration_since requires] ([@stop_split] [@expl:duration_since 'self' type invariant] inv_ref_Instant self)
    /\ ([@stop_split] [@expl:duration_since 'earlier' type invariant] inv_Instant earlier)}
    any
    [ return (result: t_Duration) ->
    {[@stop_split] [@expl:duration_since ensures] ([@stop_split] [@expl:duration_since result type invariant] inv_Duration result)
      /\ ([@stop_split] [@expl:duration_since ensures #0] gt_log_Int (view_Instant self) (view_Instant earlier)
        -> gt_log_Int (view_Duration result) 0)
      /\ ([@stop_split] [@expl:duration_since ensures #1] view_Instant self <= view_Instant earlier
      -> view_Duration result = 0)}
      (! return {result}) ]
  
  type t_Option_Duration = None'1 | Some'1 t_Duration
  
  predicate inv_Option_Duration (_1: t_Option_Duration)
  
  axiom inv_axiom'0 [@rewrite]: forall _1: t_Option_Duration [inv_Option_Duration _1]. inv_Option_Duration _1
      = match _1 with
        | None'1 -> true
        | Some'1 f0 -> inv_Duration f0
        end
  
  let checked_duration_since (self: t_Instant) (earlier: t_Instant) (return (x: t_Option_Duration)) =
  {[@stop_split] [@expl:checked_duration_since requires] ([@stop_split] [@expl:checked_duration_since 'self' type invariant] inv_ref_Instant self)
    /\ ([@stop_split] [@expl:checked_duration_since 'earlier' type invariant] inv_Instant earlier)}
    any
    [ return (result: t_Option_Duration) ->
    {[@stop_split] [@expl:checked_duration_since ensures] ([@stop_split] [@expl:checked_duration_since result type invariant] inv_Option_Duration result)
      /\ ([@stop_split] [@expl:checked_duration_since ensures #0] ge_log_Int (view_Instant self) (view_Instant earlier)
        -> result <> None'1)
      /\ ([@stop_split] [@expl:checked_duration_since ensures #1] view_Instant self < view_Instant earlier
      -> result = None'1)}
      (! return {result}) ]
  
  predicate invariant_ref_Option_Duration [@inline:trivial] (self: t_Option_Duration) = inv_Option_Duration self
  
  meta "rewrite_def" predicate invariant_ref_Option_Duration
  
  predicate inv_ref_Option_Duration [@inline:trivial] (_1: t_Option_Duration) = invariant_ref_Option_Duration _1
  
  meta "rewrite_def" predicate inv_ref_Option_Duration
  
  let is_some_Duration (self: t_Option_Duration) (return (x: bool)) =
  {[@stop_split] [@expl:is_some 'self' type invariant] inv_ref_Option_Duration self}
    any
    [ return (result: bool) -> {[@stop_split] [@expl:is_some ensures] result = (self <> None'1)} (! return {result}) ]
  
  let is_none_Duration (self: t_Option_Duration) (return (x: bool)) =
  {[@stop_split] [@expl:is_none 'self' type invariant] inv_ref_Option_Duration self}
    any
    [ return (result: bool) -> {[@stop_split] [@expl:is_none ensures] result = (self = None'1)} (! return {result}) ]
  
  let saturating_duration_since (self: t_Instant) (earlier: t_Instant) (return (x: t_Duration)) =
  {[@stop_split] [@expl:saturating_duration_since requires] ([@stop_split] [@expl:saturating_duration_since 'self' type invariant] inv_ref_Instant self)
    /\ ([@stop_split] [@expl:saturating_duration_since 'earlier' type invariant] inv_Instant earlier)}
    any
    [ return (result: t_Duration) ->
    {[@stop_split] [@expl:saturating_duration_since ensures] ([@stop_split] [@expl:saturating_duration_since result type invariant] inv_Duration result)
      /\ ([@stop_split] [@expl:saturating_duration_since ensures #0] gt_log_Int (view_Instant self) (view_Instant earlier)
        -> gt_log_Int (view_Duration result) 0)
      /\ ([@stop_split] [@expl:saturating_duration_since ensures #1] view_Instant self <= view_Instant earlier
      -> view_Duration result = 0)}
      (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let test_instant (return (x: ())) = (! bb0
    [ bb0 = s0
      [ s0 = now (fun (_x: t_Instant) -> [ &instant <- _x ] s1)
      | s1 = from_secs {(0: UInt64.t)} (fun (_x: t_Duration) -> [ &zero_dur <- _x ] s2)
      | s2 = elapsed {instant} (fun (_x: t_Duration) -> [ &_6 <- _x ] s3)
      | s3 = ge_Duration {_6} {zero_dur} (fun (_x: bool) -> [ &_4 <- _x ] s4)
      | s4 = any [ br0 -> {_4 = false} (! bb6) | br1 -> {_4} (! bb5) ] ]
    | bb5 = s0
      [ s0 = checked_add {instant} {zero_dur} (fun (_x: t_Option_Instant) -> [ &_13 <- _x ] s1)
      | s1 = [ &_17 <- Some instant ] s2
      | s2 = eq_Option_Instant {_13} {_17} (fun (_x: bool) -> [ &_11 <- _x ] s3)
      | s3 = any [ br0 -> {_11 = false} (! bb10) | br1 -> {_11} (! bb9) ] ]
    | bb9 = s0
      [ s0 = from_secs {(3: UInt64.t)} (fun (_x: t_Duration) -> [ &three_seconds <- _x ] s1)
      | s1 = checked_add {instant} {three_seconds} (fun (_x: t_Option_Instant) -> [ &_23 <- _x ] s2)
      | s2 = any [ br0 -> {_23 = None} (! bb66) | br1 (x0: t_Instant) -> {_23 = Some x0} (! bb14) ] ]
    | bb14 = s0
      [ s0 = elim_Some {_23} (fun (r0: t_Instant) -> [ &greater_instant <- r0 ] s1)
      | s1 = {[@expl:assertion] view_Instant instant < view_Instant greater_instant} s2
      | s2 = checked_add {greater_instant} {three_seconds} (fun (_x: t_Option_Instant) -> [ &_33 <- _x ] s3)
      | s3 = any [ br0 -> {_33 = None} (! bb66) | br1 (x0: t_Instant) -> {_33 = Some x0} (! bb18) ] ]
    | bb18 = s0
      [ s0 = elim_Some {_33} (fun (r0: t_Instant) -> [ &even_greater_instant <- r0 ] s1)
      | s1 = {[@expl:assertion] view_Instant instant < view_Instant even_greater_instant} s2
      | s2 = checked_sub {instant} {zero_dur} (fun (_x: t_Option_Instant) -> [ &_44 <- _x ] s3)
      | s3 = [ &_48 <- Some instant ] s4
      | s4 = eq_Option_Instant {_44} {_48} (fun (_x: bool) -> [ &_42 <- _x ] s5)
      | s5 = any [ br0 -> {_42 = false} (! bb23) | br1 -> {_42} (! bb22) ] ]
    | bb22 = s0
      [ s0 = checked_sub {instant} {three_seconds} (fun (_x: t_Option_Instant) -> [ &_53 <- _x ] s1)
      | s1 = any [ br0 -> {_53 = None} (! bb66) | br1 (x0: t_Instant) -> {_53 = Some x0} (! bb26) ] ]
    | bb26 = s0
      [ s0 = elim_Some {_53} (fun (r0: t_Instant) -> [ &lesser_instant <- r0 ] s1)
      | s1 = {[@expl:assertion] gt_log_Int (view_Instant instant) (view_Instant lesser_instant)} s2
      | s2 = sub_Instant {instant} {instant} (fun (_x: t_Duration) -> [ &_64 <- _x ] s3)
      | s3 = eq_Duration {_64} {zero_dur} (fun (_x: bool) -> [ &_62 <- _x ] s4)
      | s4 = any [ br0 -> {_62 = false} (! bb31) | br1 -> {_62} (! bb30) ] ]
    | bb30 = s0
      [ s0 = sub_Instant {instant} {greater_instant} (fun (_x: t_Duration) -> [ &_72 <- _x ] s1)
      | s1 = eq_Duration {_72} {zero_dur} (fun (_x: bool) -> [ &_70 <- _x ] s2)
      | s2 = any [ br0 -> {_70 = false} (! bb35) | br1 -> {_70} (! bb34) ] ]
    | bb34 = s0
      [ s0 = sub_Instant {greater_instant} {instant} (fun (_x: t_Duration) -> [ &_80 <- _x ] s1)
      | s1 = gt_Duration {_80} {zero_dur} (fun (_x: bool) -> [ &_78 <- _x ] s2)
      | s2 = any [ br0 -> {_78 = false} (! bb39) | br1 -> {_78} (! bb38) ] ]
    | bb38 = s0
      [ s0 = duration_since {greater_instant} {instant} (fun (_x: t_Duration) -> [ &_88 <- _x ] s1)
      | s1 = gt_Duration {_88} {zero_dur} (fun (_x: bool) -> [ &_86 <- _x ] s2)
      | s2 = any [ br0 -> {_86 = false} (! bb43) | br1 -> {_86} (! bb42) ] ]
    | bb42 = s0
      [ s0 = duration_since {instant} {greater_instant} (fun (_x: t_Duration) -> [ &_96 <- _x ] s1)
      | s1 = eq_Duration {_96} {zero_dur} (fun (_x: bool) -> [ &_94 <- _x ] s2)
      | s2 = any [ br0 -> {_94 = false} (! bb47) | br1 -> {_94} (! bb46) ] ]
    | bb46 = s0
      [ s0 = checked_duration_since {greater_instant} {instant} (fun (_x: t_Option_Duration) -> [ &_104 <- _x ] s1)
      | s1 = is_some_Duration {_104} (fun (_x: bool) -> [ &_102 <- _x ] s2)
      | s2 = any [ br0 -> {_102 = false} (! bb51) | br1 -> {_102} (! bb50) ] ]
    | bb50 = s0
      [ s0 = checked_duration_since {instant} {greater_instant} (fun (_x: t_Option_Duration) -> [ &_111 <- _x ] s1)
      | s1 = is_none_Duration {_111} (fun (_x: bool) -> [ &_109 <- _x ] s2)
      | s2 = any [ br0 -> {_109 = false} (! bb55) | br1 -> {_109} (! bb54) ] ]
    | bb54 = s0
      [ s0 = saturating_duration_since {greater_instant} {instant} (fun (_x: t_Duration) -> [ &_118 <- _x ] s1)
      | s1 = gt_Duration {_118} {zero_dur} (fun (_x: bool) -> [ &_116 <- _x ] s2)
      | s2 = any [ br0 -> {_116 = false} (! bb59) | br1 -> {_116} (! bb58) ] ]
    | bb58 = s0
      [ s0 = saturating_duration_since {instant} {greater_instant} (fun (_x: t_Duration) -> [ &_126 <- _x ] s1)
      | s1 = eq_Duration {_126} {zero_dur} (fun (_x: bool) -> [ &_124 <- _x ] s2)
      | s2 = any [ br0 -> {_124 = false} (! bb63) | br1 -> {_124} (! bb66) ] ]
    | bb66 = return {_ret}
    | bb63 = {false} any
    | bb59 = {false} any
    | bb55 = {false} any
    | bb51 = {false} any
    | bb47 = {false} any
    | bb43 = {false} any
    | bb39 = {false} any
    | bb35 = {false} any
    | bb31 = {false} any
    | bb23 = {false} any
    | bb10 = {false} any
    | bb6 = {false} any ]
    [ & _ret: () = Any.any_l ()
    | & instant: t_Instant = Any.any_l ()
    | & zero_dur: t_Duration = Any.any_l ()
    | & _4: bool = Any.any_l ()
    | & _6: t_Duration = Any.any_l ()
    | & _11: bool = Any.any_l ()
    | & _13: t_Option_Instant = Any.any_l ()
    | & _17: t_Option_Instant = Any.any_l ()
    | & three_seconds: t_Duration = Any.any_l ()
    | & greater_instant: t_Instant = Any.any_l ()
    | & _23: t_Option_Instant = Any.any_l ()
    | & even_greater_instant: t_Instant = Any.any_l ()
    | & _33: t_Option_Instant = Any.any_l ()
    | & _42: bool = Any.any_l ()
    | & _44: t_Option_Instant = Any.any_l ()
    | & _48: t_Option_Instant = Any.any_l ()
    | & lesser_instant: t_Instant = Any.any_l ()
    | & _53: t_Option_Instant = Any.any_l ()
    | & _62: bool = Any.any_l ()
    | & _64: t_Duration = Any.any_l ()
    | & _70: bool = Any.any_l ()
    | & _72: t_Duration = Any.any_l ()
    | & _78: bool = Any.any_l ()
    | & _80: t_Duration = Any.any_l ()
    | & _86: bool = Any.any_l ()
    | & _88: t_Duration = Any.any_l ()
    | & _94: bool = Any.any_l ()
    | & _96: t_Duration = Any.any_l ()
    | & _102: bool = Any.any_l ()
    | & _104: t_Option_Duration = Any.any_l ()
    | & _109: bool = Any.any_l ()
    | & _111: t_Option_Duration = Any.any_l ()
    | & _116: bool = Any.any_l ()
    | & _118: t_Duration = Any.any_l ()
    | & _124: bool = Any.any_l ()
    | & _126: t_Duration = Any.any_l () ]) [ return (result: ()) -> (! return {result}) ]
end
