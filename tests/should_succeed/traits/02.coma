module M_omg
  use creusot.prelude.Mode
  use creusot.prelude.Any
  
  type t_T
  
  predicate inv_T (_1: t_T)
  
  predicate resolve_T (_1: t_T)
  
  predicate invariant_ref_T [@inline:trivial] (self: t_T) = inv_T self
  
  meta "rewrite_def" predicate invariant_ref_T
  
  predicate inv_ref_T [@inline:trivial] (_1: t_T) = invariant_ref_T _1
  
  meta "rewrite_def" predicate inv_ref_T
  
  predicate precondition_is_true (self: ()) (args: t_T) (mode: Mode.t)
  
  axiom precondition_fndef:
    forall mode: Mode.t. forall args: t_T [precondition_is_true () args mode]. (let self = args in inv_ref_T self)
        -> precondition_is_true () args mode
  
  predicate postcondition_is_true (self: ()) (args: t_T) (result: bool) (mode: Mode.t)
  
  axiom postcondition_fndef:
    forall args: t_T, result: bool, mode: Mode.t [postcondition_is_true () args result mode]. postcondition_is_true () args result mode
      -> (let self = args in result = true)
  
  predicate postcondition_once_is_true (self: ()) (args: t_T) (result: bool) (mode: Mode.t) =
    postcondition_is_true self args result mode
  
  meta "rewrite_def" predicate postcondition_once_is_true
  
  let is_true_T (self: t_T) (mode: Mode.t) (return (x: bool)) =
  {[@stop_split] [@expl:is_true requires] precondition_is_true () self mode}
    any
    [ return (result: bool) -> {[@stop_split] [@expl:is_true ensures] postcondition_once_is_true () self result mode}
      (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let omg_T (a: t_T) (mode: Mode.t) (return (x: bool)) = {not Mode.terminates mode}
    {[@stop_split] [@expl:omg 'a' type invariant] inv_T a}
    (! bb0
    [ bb0 = s0
      [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_T a} any) ]
      | s1 = -{resolve_T a}- s2
      | s2 = is_true_T {a} {mode} (fun (_x: bool) -> [ &_ret <- _x ] s3)
      | s3 = return {_ret} ] ] [ & _ret: bool = Any.any_l () | & a: t_T = a ])
    [ return (result: bool) -> {[@stop_split] [@expl:omg ensures] result = true} (! return {result}) ]
end
