module M_test
  use creusot.int.UInt64
  use creusot.prelude.Mode
  use creusot.prelude.Any
  
  type t_T
  
  type t_Tgt
  
  type tup2_ref_T_usize = { f0: t_T; f1: UInt64.t }
  
  predicate inv_T (_1: t_T)
  
  predicate invariant_ref_T [@inline:trivial] (self: t_T) = inv_T self
  
  meta "rewrite_def" predicate invariant_ref_T
  
  predicate inv_ref_T [@inline:trivial] (_1: t_T) = invariant_ref_T _1
  
  meta "rewrite_def" predicate inv_ref_T
  
  predicate precondition_ix (self: ()) (args: tup2_ref_T_usize) (mode: Mode.t)
  
  axiom precondition_fndef:
    forall mode: Mode.t. forall args: tup2_ref_T_usize [precondition_ix () args mode]. (let {f0 = self; f1 = ix} = args in inv_ref_T self)
        -> precondition_ix () args mode
  
  predicate inv_Tgt (_1: t_Tgt)
  
  predicate postcondition_ix (self: ()) (args: tup2_ref_T_usize) (result: t_Tgt) (mode: Mode.t)
  
  axiom postcondition_fndef:
    forall args: tup2_ref_T_usize, result: t_Tgt, mode: Mode.t [postcondition_ix () args result mode]. postcondition_ix () args result mode
      -> (let {f0 = self; f1 = ix} = args in inv_Tgt result)
  
  predicate postcondition_once_ix (self: ()) (args: tup2_ref_T_usize) (result: t_Tgt) (mode: Mode.t) =
    postcondition_ix self args result mode
  
  meta "rewrite_def" predicate postcondition_once_ix
  
  let ix_T (self: t_T) (ix: UInt64.t) (mode: Mode.t) (return (x: t_Tgt)) =
  {[@stop_split] [@expl:ix requires] precondition_ix () { f0 = self; f1 = ix } mode}
    any
    [ return (result: t_Tgt) -> {[@stop_split] [@expl:ix ensures] postcondition_once_ix () { f0 = self;
                                                                                             f1 = ix } result mode}
      (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let test_T (a: t_T) (mode: Mode.t) (return (x: t_Tgt)) = {not Mode.terminates mode}
    {[@stop_split] [@expl:test 'a' type invariant] inv_ref_T a}
    (! bb0
    [ bb0 = s0 [ s0 = ix_T {a} {(0: UInt64.t)} {mode} (fun (_x: t_Tgt) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
    [ & _ret: t_Tgt = Any.any_l () | & a: t_T = a ])
    [ return (result: t_Tgt) -> {[@stop_split] [@expl:test result type invariant] inv_Tgt result} (! return {result}) ]
end
