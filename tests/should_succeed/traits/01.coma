module M_uses_generic
  use creusot.prelude.Mode
  use creusot.int.UInt32
  use creusot.prelude.Any
  
  type t_T
  
  predicate inv_T (_1: t_T)
  
  predicate precondition_from_b (self: ()) (args: t_T) (mode: Mode.t)
  
  axiom precondition_fndef:
    forall mode: Mode.t. forall args: t_T [precondition_from_b () args mode]. (let x = args in inv_T x)
        -> precondition_from_b () args mode
  
  predicate postcondition_from_b (self: ()) (args: t_T) (result: UInt32.t) (mode: Mode.t)
  
  axiom postcondition_fndef:
    forall args: t_T, result: UInt32.t, mode: Mode.t [postcondition_from_b () args result mode]. postcondition_from_b () args result mode
      -> (let x = args in true)
  
  predicate postcondition_once_from_b (self: ()) (args: t_T) (result: UInt32.t) (mode: Mode.t) =
    postcondition_from_b self args result mode
  
  meta "rewrite_def" predicate postcondition_once_from_b
  
  let from_b_T (x: t_T) (mode: Mode.t) (return (x'0: UInt32.t)) =
  {[@stop_split] [@expl:from_b requires] precondition_from_b () x mode}
    any
    [ return (result: UInt32.t) -> {[@stop_split] [@expl:from_b ensures] postcondition_once_from_b () x result mode}
      (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let uses_generic_T (b: t_T) (mode: Mode.t) (return (x: UInt32.t)) = {not Mode.terminates mode}
    {[@stop_split] [@expl:uses_generic 'b' type invariant] inv_T b}
    (! bb0
    [ bb0 = s0 [ s0 = from_b_T {b} {mode} (fun (_x: UInt32.t) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
    [ & _ret: UInt32.t = Any.any_l () | & b: t_T = b ]) [ return (result: UInt32.t) -> (! return {result}) ]
end
