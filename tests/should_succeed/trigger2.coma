module M_resolve_seq
  use seq.Seq
  use creusot.prelude.MutBorrow
  use creusot.int.UInt64
  use int.Int
  
  type t_Vec_refmut_T_Global
  
  type t_T
  
  constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)
  
  function view_Vec_refmut_T_Global (self: t_Vec_refmut_T_Global) : Seq.seq (MutBorrow.t t_T)
  
  axiom view_Vec_refmut_T_Global_spec:
    forall self: t_Vec_refmut_T_Global [view_Vec_refmut_T_Global self]. Seq.length (view_Vec_refmut_T_Global self)
      <= UInt64.t'int const_MAX
  
  predicate resolve_refmut_T [@inline:trivial] (_1: MutBorrow.t t_T) = _1.final = _1.current
  
  meta "rewrite_def" predicate resolve_refmut_T
  
  function index_Vec_refmut_T_Global [@inline:trivial] (self: t_Vec_refmut_T_Global) (ix: int) : MutBorrow.t t_T =
    Seq.get (view_Vec_refmut_T_Global self) ix
  
  meta "rewrite_def" function index_Vec_refmut_T_Global
  
  predicate resolve_Vec_refmut_T_Global [@inline:trivial] (self: t_Vec_refmut_T_Global) =
    forall i: int. 0 <= i /\ i < Seq.length (view_Vec_refmut_T_Global self)
      -> resolve_refmut_T (index_Vec_refmut_T_Global self i)
  
  meta "rewrite_def" predicate resolve_Vec_refmut_T_Global
  
  predicate resolve_Vec_refmut_T_Global'0 (_1: t_Vec_refmut_T_Global)
  
  axiom resolve_axiom:
    forall _1: t_Vec_refmut_T_Global [resolve_Vec_refmut_T_Global'0 _1]. resolve_Vec_refmut_T_Global'0 _1
      -> resolve_Vec_refmut_T_Global _1
  
  predicate inv_T (_1: t_T)
  
  predicate invariant_refmut_T [@inline:trivial] (self: MutBorrow.t t_T) = inv_T self.current /\ inv_T self.final
  
  meta "rewrite_def" predicate invariant_refmut_T
  
  predicate inv_refmut_T [@inline:trivial] (_1: MutBorrow.t t_T) = invariant_refmut_T _1
  
  meta "rewrite_def" predicate inv_refmut_T
  
  predicate invariant_ref_refmut_T [@inline:trivial] (self: MutBorrow.t t_T) = inv_refmut_T self
  
  meta "rewrite_def" predicate invariant_ref_refmut_T
  
  predicate inv_ref_refmut_T [@inline:trivial] (_1: MutBorrow.t t_T) = invariant_ref_refmut_T _1
  
  meta "rewrite_def" predicate inv_ref_refmut_T
  
  predicate invariant_Seq_refmut_T [@inline:trivial] (self: Seq.seq (MutBorrow.t t_T)) =
    forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_refmut_T (Seq.get self i)
  
  meta "rewrite_def" predicate invariant_Seq_refmut_T
  
  predicate inv_Seq_refmut_T [@inline:trivial] (_1: Seq.seq (MutBorrow.t t_T)) = invariant_Seq_refmut_T _1
  
  meta "rewrite_def" predicate inv_Seq_refmut_T
  
  predicate invariant_ref_Seq_refmut_T [@inline:trivial] (self: Seq.seq (MutBorrow.t t_T)) = inv_Seq_refmut_T self
  
  meta "rewrite_def" predicate invariant_ref_Seq_refmut_T
  
  predicate inv_ref_Seq_refmut_T [@inline:trivial] (_1: Seq.seq (MutBorrow.t t_T)) = invariant_ref_Seq_refmut_T _1
  
  meta "rewrite_def" predicate inv_ref_Seq_refmut_T
  
  let len_refmut_T (self: Seq.seq (MutBorrow.t t_T)) (return (x: int)) =
  {[@stop_split] [@expl:len 'self' type invariant] inv_ref_Seq_refmut_T self}
    any [ return (result: int) -> {[@stop_split] [@expl:len ensures] result = Seq.length self} (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  constant seq : t_Vec_refmut_T_Global
  
  predicate resolve_seq_T (seq: t_Vec_refmut_T_Global)
  
  goal vc_resolve_seq_T: [@stop_split] [@expl:resolve_seq ensures] resolve_Vec_refmut_T_Global'0 seq
    -> (forall i: int [Seq.get (view_Vec_refmut_T_Global seq) i]. 0 <= i
        /\ i < len_refmut_T (view_Vec_refmut_T_Global seq)
      -> (Seq.get (view_Vec_refmut_T_Global seq) i).current = (Seq.get (view_Vec_refmut_T_Global seq) i).final)
end
