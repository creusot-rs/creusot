module M_takes_guarded
  use creusot.prelude.MutBorrow
  use creusot.int.Int32
  use map.Map
  use creusot.prelude.Any
  
  type t_GuardedBorrow_i32 = {
    borrow: MutBorrow.t Int32.t;
    _guard: Map.map Int32.t bool;
    _initial: MutBorrow.t Int32.t }
  
  predicate index_Mapping_i32_bool [@inline:trivial] (self: Map.map Int32.t bool) (a: Int32.t) = Map.get self a
  
  meta "rewrite_def" predicate index_Mapping_i32_bool
  
  function guard_i32 [@inline:trivial] (self: t_GuardedBorrow_i32) : Map.map Int32.t bool = self._guard
  
