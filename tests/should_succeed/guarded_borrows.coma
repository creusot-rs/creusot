  function prophecy_i32 [@inline:trivial] (self: t_GuardedBorrow_i32) : Int32.t = self._initial.final
  
  meta "rewrite_def" function prophecy_i32
  
  predicate invariant_GuardedBorrow_i32 (self: t_GuardedBorrow_i32) =
    index_Mapping_i32_bool (guard_i32 self) self.borrow.current /\ prophecy_i32 self = self.borrow.final
  
