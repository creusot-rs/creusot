      | s2 = [ &map <- _3 ] s3
      | s3 = {[@expl:assertion] index_FMap_Int_Int map 1 = 3} s4
      | s4 = any
        [ any_ (_dest: t_FMap_Int_Int) ->
        (! -{([@stop_split] [@expl:insert ensures] ([@stop_split] [@expl:insert ensures #0] to_mapping_Int (insert_Int map 2 42)
              = Map.set (to_mapping_Int map) 2 (Some 42))
            /\ ([@stop_split] [@expl:insert ensures #1] len_Int (insert_Int map 2 42)
