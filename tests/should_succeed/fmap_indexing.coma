  use creusot.prelude.Any
  use int.Int
  
  type t_FMap_Int_Int
  
  predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self
  
  meta "rewrite_def" predicate ge_log_Int
  
  function len_Int (self: t_FMap_Int_Int) : int
  
  axiom len_Int_spec: forall self: t_FMap_Int_Int [len_Int self]. ge_log_Int (len_Int self) 0
  
  type t_Option_Int = None | Some int
  
  function to_mapping_Int (self: t_FMap_Int_Int) : Map.map int t_Option_Int
  
  constant empty_Int : t_FMap_Int_Int
  
  axiom empty_Int_spec: len_Int empty_Int = 0
  
  axiom empty_Int_spec'0: to_mapping_Int empty_Int = Const.const (None)
  
  function get_Int [@inline:trivial] (self: t_FMap_Int_Int) (k: int) : t_Option_Int = Map.get (to_mapping_Int self) k
  
  meta "rewrite_def" function get_Int
  
  predicate contains_Int [@inline:trivial] (self: t_FMap_Int_Int) (k: int) = get_Int self k <> None
  
  meta "rewrite_def" predicate contains_Int
  
  function insert_Int (self: t_FMap_Int_Int) (k: int) (v: int) : t_FMap_Int_Int
  
  axiom insert_Int_spec:
    forall self: t_FMap_Int_Int, k: int, v: int [insert_Int self k v]. to_mapping_Int (insert_Int self k v)
      = Map.set (to_mapping_Int self) k (Some v)
  
  axiom insert_Int_spec'0:
    forall self: t_FMap_Int_Int, k: int, v: int [insert_Int self k v]. len_Int (insert_Int self k v)
      = (if contains_Int self k then len_Int self else len_Int self + 1)
  
  constant any_Int : int
  
  function unwrap_Option_Int (self: t_Option_Int) : int = match self with
      | Some x -> x
      | None -> any_Int
      end
  
  function lookup_Int [@inline:trivial] (self: t_FMap_Int_Int) (k: int) : int = unwrap_Option_Int (get_Int self k)
  
  meta "rewrite_def" function lookup_Int
  
  function index_FMap_Int_Int [@inline:trivial] (self: t_FMap_Int_Int) (key: int) : int = lookup_Int self key
  
  meta "rewrite_def" function index_FMap_Int_Int
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let foo (return (x: ())) = (! bb0
    [ bb0 = s0
