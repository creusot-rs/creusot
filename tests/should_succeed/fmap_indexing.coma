          /\ _dest = insert_Int map 2 42}-
          [ &_9 <- _dest ] s5) ] [ _ck -> (! any) ]
      | s5 = [ &map <- _9 ] s6
      | s6 = {[@expl:assertion] index_FMap_Int_Int map 1 = 3 /\ index_FMap_Int_Int map 2 = 42} s7
      | s7 = any
        [ any_ (_dest: t_FMap_Int_Int) ->
        (! -{([@stop_split] [@expl:insert ensures] ([@stop_split] [@expl:insert ensures #0] to_mapping_Int (insert_Int map 1 4)
              = Map.set (to_mapping_Int map) 1 (Some 4))
            /\ ([@stop_split] [@expl:insert ensures #1] len_Int (insert_Int map 1 4)
            = (if contains_Int map 1 then len_Int map else len_Int map + 1)))
          /\ _dest = insert_Int map 1 4}-
          [ &_15 <- _dest ] s8) ] [ _ck -> (! any) ]
      | s8 = [ &map <- _15 ] s9
      | s9 = {[@expl:assertion] index_FMap_Int_Int map 1 = 4 /\ index_FMap_Int_Int map 2 = 42} s10
