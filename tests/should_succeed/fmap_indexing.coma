    [ & _ret: () = Any.any_l ()
    | & map: t_FMap_Int_Int = Any.any_l ()
    | & _3: t_FMap_Int_Int = Any.any_l ()
    | & _9: t_FMap_Int_Int = Any.any_l ()
    | & _15: t_FMap_Int_Int = Any.any_l () ]) [ return (result: ()) -> (! return {result}) ]
