module M_f
  use creusot.int.Int32
  use creusot.prelude.Mode
  use creusot.prelude.Any
  
  predicate inv_never [@inline:trivial] (_1: ()) = false
  
  meta "rewrite_def" predicate inv_never
  
  let panic (mode: Mode.t) (expr: string) (return (x: ())) =
  {[@stop_split] [@expl:panic requires] not Mode.nopanic mode}
    any
    [ return (result: ()) -> {[@stop_split] [@expl:panic result type invariant] inv_never result} (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let f (mode: Mode.t) (return (x: ())) = (! bb0
    [ bb0 = s0
      [ s0 = [ &_1 <- (1: Int32.t) ] s1
      | s1 = [ &_2 <- Int32.le (0: Int32.t) _1 ] s2
      | s2 = any [ br0 -> {_2 = false} (! bb1) | br1 -> {_2} (! bb3) ] ]
    | bb3 = s0
      [ s0 = [ &_3 <- Int32.lt _1 (10: Int32.t) ] s1 | s1 = any [ br0 -> {_3 = false} (! bb1) | br1 -> {_3} (! bb7) ] ]
    | bb7 = any [ br0 -> {false} (! bb8) | br1 -> (! bb14) ]
    | bb8 = s0 [ s0 = panic {mode} {"assertion failed: true"} (fun (_x: ()) -> [ &_5 <- _x ] s1) | s1 = {false} any ]
    | bb1 = any
      [ br0 -> {_1 = (5: Int32.t)} (! bb6)
      | br1 -> {_1 = (6: Int32.t)} (! bb6)
      | default -> -{_1 <> (5: Int32.t) /\ _1 <> (6: Int32.t)}- (! bb4) ]
    | bb4 = any [ br0 -> {false = false} (! bb12) | br1 -> {false} (! bb14) ]
    | bb12 = s0 [ s0 = panic {mode} {"assertion failed: false"} (fun (_x: ()) -> [ &_9 <- _x ] s1) | s1 = {false} any ]
    | bb6 = any [ br0 -> {false = false} (! bb10) | br1 -> {false} (! bb14) ]
    | bb14 = return {_ret}
    | bb10 = s0
      [ s0 = panic {mode} {"assertion failed: false"} (fun (_x: ()) -> [ &_7 <- _x ] s1) | s1 = {false} any ] ]
    [ & _ret: () = Any.any_l ()
    | & _1: Int32.t = Any.any_l ()
    | & _2: bool = Any.any_l ()
    | & _3: bool = Any.any_l ()
    | & _5: () = Any.any_l ()
    | & _7: () = Any.any_l ()
    | & _9: () = Any.any_l () ]) [ return (result: ()) -> (! return {result}) ]
end
