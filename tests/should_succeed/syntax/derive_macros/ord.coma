  function deep_model_MixedEnum (self: t_MixedEnum) : t_MixedEnumDeepModel = match self with
      | Foo v0_1 -> Foo'0 (deep_model_u32 v0_1)
      | Bar foo_1 bar_1 -> Bar'0 (deep_model_u32 foo_1) (deep_model_i16 bar_1)
      | Baz -> Baz'0
      end
  
