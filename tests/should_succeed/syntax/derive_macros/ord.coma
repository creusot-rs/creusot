      -> lt_log_MixedEnumDeepModel y z -> lt_log_MixedEnumDeepModel x z
  
  function irreflexive_MixedEnumDeepModel (self: t_MixedEnumDeepModel) : () = ()
  
  axiom irreflexive_MixedEnumDeepModel_spec: forall self: t_MixedEnumDeepModel. not lt_log_MixedEnumDeepModel self self
  
