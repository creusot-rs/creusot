  axiom lt_log_total_MixedEnumDeepModel_spec:
    forall self: t_MixedEnumDeepModel, other: t_MixedEnumDeepModel. lt_log_MixedEnumDeepModel self other
      \/ self = other \/ lt_log_MixedEnumDeepModel other self
  
  type t_Ordering = Less | Equal | Greater
  
  function cmp_log_MixedEnumDeepModel (self: t_MixedEnumDeepModel) (other: t_MixedEnumDeepModel) : t_Ordering = if self
    = other then
