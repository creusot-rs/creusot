  use creusot.int.UInt32
  use creusot.int.Int16
  use map.Map
  use int.Int
  
  type t_MixedEnum = Foo UInt32.t | Bar UInt32.t Int16.t | Baz
  
  type t_MixedEnumDeepModel = Foo'0 int | Bar'0 int int | Baz'0
  
  type tup2_MixedEnumDeepModel_MixedEnumDeepModel = { f0: t_MixedEnumDeepModel; f1: t_MixedEnumDeepModel }
  
  predicate lt_log_MixedEnumDeepModel [@inline:trivial] (self: t_MixedEnumDeepModel) (rhs: t_MixedEnumDeepModel) =
    let discriminant = fun (x: t_MixedEnumDeepModel) -> match x with
      | Foo'0 _ -> 0 + 0
      | Bar'0 _ _ -> 0 + 1
      | Baz'0 -> 0 + 2
      end in match { f0 = self; f1 = rhs } with
      | {f0 = Foo'0 v0_1; f1 = Foo'0 v0_2} -> v0_1 < v0_2
      | {f0 = Bar'0 foo_1 bar_1; f1 = Bar'0 foo_2 bar_2} -> foo_1 < foo_2 \/ foo_1 = foo_2 /\ bar_1 < bar_2
      | {f0 = Baz'0; f1 = Baz'0} -> false
      | _ -> Map.get discriminant self < Map.get discriminant rhs
      end
  
  meta "rewrite_def" predicate lt_log_MixedEnumDeepModel
  
  predicate le_log_MixedEnumDeepModel [@inline:trivial] (self: t_MixedEnumDeepModel) (other: t_MixedEnumDeepModel) =
    lt_log_MixedEnumDeepModel self other \/ self = other
  
  meta "rewrite_def" predicate le_log_MixedEnumDeepModel
  
  function le_lt_log_MixedEnumDeepModel (self: t_MixedEnumDeepModel) (other: t_MixedEnumDeepModel) : () = ()
  
  axiom le_lt_log_MixedEnumDeepModel_spec:
    forall self: t_MixedEnumDeepModel, other: t_MixedEnumDeepModel. le_log_MixedEnumDeepModel self other
      = (lt_log_MixedEnumDeepModel self other \/ self = other)
  
  function transitive_MixedEnumDeepModel (x: t_MixedEnumDeepModel) (y: t_MixedEnumDeepModel) (z: t_MixedEnumDeepModel) : ()
