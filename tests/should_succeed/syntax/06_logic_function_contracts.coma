module M_all_zero
  use seq.Seq
  use int.Int
  
  let len_Int (self: Seq.seq int) (return (x: int)) = any
    [ return (result: int) -> {[@stop_split] [@expl:len ensures] result = Seq.length self} (! return {result}) ]
  
  predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self
  
  meta "rewrite_def" predicate ge_log_Int
  
  predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self
  
  meta "rewrite_def" predicate gt_log_Int
  
  predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
    ge_log_Int self 0 /\ gt_log_Int self other
  
  meta "rewrite_def" predicate well_founded_relation_Int
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  constant seq : Seq.seq int
  
  predicate all_zero (seq: Seq.seq int)
  
  goal vc_all_zero: ([@stop_split] [@expl:len ensures] len_Int seq = Seq.length seq)
    -> (if len_Int seq = 0 then
      true
    else
      ([@stop_split] [@expl:len ensures] len_Int seq = Seq.length seq)
      -> (if Seq.get seq (len_Int seq - 1) = 0 then
        ([@stop_split] [@expl:len ensures] len_Int seq = Seq.length seq)
        -> ([@expl:variant decreases] well_founded_relation_Int (len_Int seq) (len_Int (Seq.([..]) seq 0 (len_Int seq
        - 1))))
      else
        true
      )
    )
end
module M_stupid
  use int.Int
  
  type t_T
  
  predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self
  
  meta "rewrite_def" predicate ge_log_Int
  
  predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self
  
  meta "rewrite_def" predicate gt_log_Int
  
  predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
    ge_log_Int self 0 /\ gt_log_Int self other
  
  meta "rewrite_def" predicate well_founded_relation_Int
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  constant x : t_T
  
  constant i : int
  
  predicate stupid_T (x: t_T) (i: int)
  
  goal vc_stupid_T: if i <= 0 then
      true
    else
      if x = x then [@expl:variant decreases] well_founded_relation_Int i 0 else true

end
module M_sum
  use seq.Seq
  use int.Int
  
  let len_Int (self: Seq.seq int) (return (x: int)) = any
    [ return (result: int) -> {[@stop_split] [@expl:len ensures] result = Seq.length self} (! return {result}) ]
  
  predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self
  
  meta "rewrite_def" predicate ge_log_Int
  
  predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self
  
  meta "rewrite_def" predicate gt_log_Int
  
  predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
    ge_log_Int self 0 /\ gt_log_Int self other
  
  meta "rewrite_def" predicate well_founded_relation_Int
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  constant seq : Seq.seq int
  
  function sum (seq: Seq.seq int) : int
  
  goal vc_sum: ([@stop_split] [@expl:len ensures] len_Int seq = Seq.length seq)
    -> (if len_Int seq = 0 then
      true
    else
      ([@stop_split] [@expl:len ensures] len_Int seq = Seq.length seq)
      -> ([@stop_split] [@expl:len ensures] len_Int seq = Seq.length seq)
      -> ([@expl:variant decreases] well_founded_relation_Int (len_Int seq) (len_Int (Seq.([..]) seq 0 (len_Int seq
      - 1))))
    )
end
