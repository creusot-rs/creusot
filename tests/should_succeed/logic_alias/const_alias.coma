module M_add_one
  use creusot.int.Int64
  use creusot.prelude.Any
  use int.Int
  
  constant const_MAX: Int64.t = (9223372036854775807: Int64.t)
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let add_one (x: Int64.t) (return (x'0: Int64.t)) = {[@stop_split] [@expl:add_one requires] Int64.to_int x
    < Int64.to_int const_MAX - 2}
    (! bb0
    [ bb0 = s0 [ s0 = Int64.add {x} {(1: Int64.t)} (fun (_x: Int64.t) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
    [ & _ret: Int64.t = Any.any_l () | & x: Int64.t = x ])
    [ return (result: Int64.t) -> {[@stop_split] [@expl:add_one ensures] result = Int64.add x (1: Int64.t)}
      (! return {result}) ]
end
module M_add_two
  use creusot.int.Int64
  use creusot.prelude.Any
  use int.Int
  
  constant const_MAX: Int64.t = (9223372036854775807: Int64.t)
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let add_two (a: Int64.t) (return (x: Int64.t)) = {[@stop_split] [@expl:add_two requires] Int64.to_int a
    < Int64.to_int const_MAX - 3}
    (! bb0
    [ bb0 = s0 [ s0 = Int64.add {a} {(2: Int64.t)} (fun (_x: Int64.t) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
    [ & _ret: Int64.t = Any.any_l () | & a: Int64.t = a ])
    [ return (result: Int64.t) -> {[@stop_split] [@expl:add_two ensures] result
      = Int64.add (Int64.add a (1: Int64.t)) (1: Int64.t)}
      (! return {result}) ]
end
