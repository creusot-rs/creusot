  function produces_trans_Iter_T (a: t_Iter_T) (ab: Seq.seq t_T) (b: t_Iter_T) (bc: Seq.seq t_T) (c: t_Iter_T) : ()
  
  axiom produces_trans_Iter_T_spec:
    forall a: t_Iter_T, ab: Seq.seq t_T, b: t_Iter_T, bc: Seq.seq t_T, c: t_Iter_T. produces_Iter_T a ab b
      -> produces_Iter_T b bc c -> produces_Iter_T a (Seq.(++) ab bc) c
  
  function produces_refl_Iter_T (self: t_Iter_T) : ()
  
  axiom produces_refl_Iter_T_spec: forall self: t_Iter_T. produces_Iter_T self (Seq.empty: Seq.seq t_T) self
  
  predicate resolve_refmut_Iter_T [@inline:trivial] (_1: MutBorrow.t t_Iter_T) = _1.final = _1.current
  
  meta "rewrite_def" predicate resolve_refmut_Iter_T
  
  predicate completed_Iter_T (self: MutBorrow.t t_Iter_T) =
    resolve_refmut_Iter_T self /\ Slice64.view (view_Iter_T self.current) = (Seq.empty: Seq.seq t_T)
  
  let next_Iter_T (self_: MutBorrow.t t_Iter_T) (return (x: t_Option_ref_T)) =
  {[@stop_split] [@expl:next 'self_' type invariant] inv_refmut_Iter_T self_}
    any
    [ return (result: t_Option_ref_T) ->
    {[@stop_split] [@expl:next_Iter_T ensures] ([@stop_split] [@expl:next result type invariant] inv_Option_ref_T result)
      /\ ([@stop_split] [@expl:next ensures] match result with
        | None -> completed_Iter_T self_
        | Some v -> produces_Iter_T self_.current (Seq.singleton v) self_.final
        end)}
      (! return {result}) ]
  
  predicate is_zero_T (self: t_T)
  
  predicate invariant_ref_ref_T [@inline:trivial] (self: t_T) = inv_ref_T self
  
  meta "rewrite_def" predicate invariant_ref_ref_T
  
  predicate inv_ref_ref_T [@inline:trivial] (_1: t_T) = invariant_ref_ref_T _1
  
  meta "rewrite_def" predicate inv_ref_ref_T
  
  predicate invariant_Seq_ref_T [@inline:trivial] (self: Seq.seq t_T) =
    forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_ref_T (Seq.get self i)
  
  meta "rewrite_def" predicate invariant_Seq_ref_T
  
  predicate inv_Seq_ref_T [@inline:trivial] (_1: Seq.seq t_T) = invariant_Seq_ref_T _1
  
  meta "rewrite_def" predicate inv_Seq_ref_T
  
  let elim_Some (_x: t_Option_ref_T) (return (f0: t_T)) = any
    [ _k (f0: t_T) -> {Some f0 = _x} (! return {f0})
    | _chk -> (! {[@expl:elim Some] match _x with
        | Some _ -> true
        | _ -> false
        end}
      any) ]
  
  predicate precondition_is_zero (self: ()) (args: t_T)
  
  axiom precondition_fndef: forall args: t_T [precondition_is_zero () args]. (let self = args in inv_ref_T self)
      -> precondition_is_zero () args
  
  predicate postcondition_is_zero (self: ()) (args: t_T) (result: bool)
  
  axiom postcondition_fndef:
    forall args: t_T, res: bool [postcondition_is_zero () args res]. postcondition_is_zero () args res
      -> (let self = args in res = is_zero_T self)
  
  predicate postcondition_once_is_zero (self: ()) (args: t_T) (result: bool) = postcondition_is_zero self args result
  
  meta "rewrite_def" predicate postcondition_once_is_zero
  
  let is_zero_T'0 (self: t_T) (return (x: bool)) = {[@stop_split] [@expl:is_zero requires] precondition_is_zero () self}
    any
    [ return (result: bool) -> {[@stop_split] [@expl:is_zero ensures] postcondition_once_is_zero () self result}
      (! return {result}) ]
  
  predicate resolve_Iter_T (_1: t_Iter_T)
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let no_zeros_T (elems: Slice64.slice t_T) (return (x: bool)) =
  {[@stop_split] [@expl:no_zeros 'elems' type invariant] inv_ref_slice_T elems}
    (! bb0
    [ bb0 = s0
      [ s0 = into_iter_ref_slice_T {elems} (fun (_x: t_Iter_T) -> [ &iter <- _x ] s1)
      | s1 = [ &iter_old <- iter ] s2
      | s2 = [ &produced <- Seq.empty: Seq.seq t_T ] s3
      | s3 = bb4 ]
    | bb4 = bb4
      [ bb4 = {[@expl:inferred invariant: type invariant] inv_Iter_T iter}
        {[@expl:for invariant] inv_Seq_ref_T produced}
        {[@expl:for invariant] produces_Iter_T iter_old produced iter}
        {[@expl:loop invariant] forall i: int. 0 <= i /\ i < Seq.length produced -> not is_zero_T (Seq.get produced i)}
        (! s0)
        [ s0 = MutBorrow.borrow_mut <t_Iter_T> {iter}
            (fun (_bor: MutBorrow.t t_Iter_T) -> [ &_26 <- _bor ] -{inv_Iter_T _bor.final}- [ &iter <- _bor.final ] s1)
          [ _ck -> (! {[@expl:type invariant] inv_Iter_T iter} any) ]
        | s1 = MutBorrow.borrow_final <t_Iter_T> {_26.current} {MutBorrow.get_id _26}
            (fun (_bor: MutBorrow.t t_Iter_T) ->
              [ &_25 <- _bor ] -{inv_Iter_T _bor.final}-
              [ &_26 <- { _26 with current = _bor.final } ] s2)
          [ _ck -> (! {[@expl:type invariant] inv_Iter_T _26.current} any) ]
        | s2 = next_Iter_T {_25} (fun (_x: t_Option_ref_T) -> [ &_24 <- _x ] s3)
        | s3 = s4 [ _ck -> (! {[@expl:type invariant] inv_refmut_Iter_T _26} any) ]
        | s4 = -{resolve_refmut_Iter_T _26}- s5
        | s5 = any [ br0 -> {_24 = None} (! bb9) | br1 (x0: t_T) -> {_24 = Some x0} (! bb10) ] ]
        [ bb10 = s0
          [ s0 = elim_Some {_24} (fun (r0: t_T) -> [ &__creusot_proc_iter_elem <- r0 ] s1)
          | s1 = [ &produced <- Seq.(++) produced (Seq.singleton __creusot_proc_iter_elem) ] s2
          | s2 = [ &elem <- __creusot_proc_iter_elem ] s3
          | s3 = is_zero_T'0 {elem} (fun (_x: bool) -> [ &_35 <- _x ] s4)
          | s4 = any [ br0 -> {_35 = false} (! bb4) | br1 -> {_35} (! bb13) ] ] ] ]
    | bb13 = s0
      [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_Iter_T iter} any) ]
      | s1 = -{resolve_Iter_T iter}- s2
      | s2 = [ &_ret <- false ] s3
      | s3 = return {_ret} ]
    | bb9 = s0
      [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_Iter_T iter} any) ]
      | s1 = -{resolve_Iter_T iter}- s2
      | s2 = [ &_ret <- true ] s3
      | s3 = return {_ret} ] ]
    [ & _ret: bool = Any.any_l ()
    | & elems: Slice64.slice t_T = elems
    | & iter: t_Iter_T = Any.any_l ()
    | & iter_old: t_Iter_T = Any.any_l ()
    | & produced: Seq.seq t_T = Any.any_l ()
    | & _24: t_Option_ref_T = Any.any_l ()
    | & _25: MutBorrow.t t_Iter_T = Any.any_l ()
    | & _26: MutBorrow.t t_Iter_T = Any.any_l ()
    | & __creusot_proc_iter_elem: t_T = Any.any_l ()
    | & elem: t_T = Any.any_l ()
    | & _35: bool = Any.any_l () ])
    [ return (result: bool) -> {[@stop_split] [@expl:no_zeros ensures] result
      = (forall i: int. 0 <= i /\ i < Seq.length (Slice64.view elems)
        -> not is_zero_T (Seq.get (Slice64.view elems) i))}
      (! return {result}) ]
end
