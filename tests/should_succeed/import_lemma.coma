module M_direct__all_good
  function gen_key (seed: int) : int
  
  predicate is_secure (pkey: int)
  
  function lemma_all_good (seed: int) : ()
  
  axiom lemma_all_good_spec: forall seed: int [gen_key seed]. is_secure (gen_key seed)
  
  constant rng_seed : int
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  function all_good : ()
  
  goal vc_all_good: [@stop_split] [@expl:all_good ensures] is_secure (gen_key rng_seed)
end
