module M_private__lemma_all_good
  function gen_key (seed: int) : int = let _ = seed in 4
  
  predicate is_secure (pkey: int) = let _ = pkey in true
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  constant seed : int
  
  function lemma_all_good (seed: int) : ()
  
