module M_basic
  use int.Int
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  constant a : int
  
  predicate basic (a: int)
  
  goal vc_basic: [@stop_split] [@expl:basic ensures] forall c: int. a + c - c = a
end
module M_multi_arg
  use int.Int
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  constant a : int
  
  constant b : int
  
  predicate multi_arg (a: int) (b: int)
  
  goal vc_multi_arg: [@stop_split] [@expl:multi_arg ensures] forall c: int, d: int. a + c - c = a /\ a - d + d = a
end
module M_triggers
  use int.Int
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  constant a : int
  
  constant b : int
  
  predicate triggers (a: int) (b: int)
  
  goal vc_triggers: [@stop_split] [@expl:triggers ensures] forall c: int, d: int [a + c, a + d]. a + c - c = a
      /\ a - d + d = a
end
