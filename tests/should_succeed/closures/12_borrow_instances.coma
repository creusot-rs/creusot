module M_test1
  use creusot.int.UInt32
  use creusot.prelude.Mode
  
  type t_F
  
  predicate postcondition_once_F (self: t_F) (args: UInt32.t) (result: bool) (mode: Mode.t)
  
  predicate resolve_F (_1: t_F)
  
  predicate postcondition_mut_F (self: t_F) (args: UInt32.t) (result_state: t_F) (result: bool) (mode: Mode.t)
  
  function fn_mut_once_F (self: t_F) (args: UInt32.t) (res: bool) (mode: Mode.t) : ()
  
  axiom fn_mut_once_F_spec:
    forall self: t_F, args: UInt32.t, res: bool, mode: Mode.t [postcondition_once_F self args res mode]. postcondition_once_F self args res mode
      = (exists res_state: t_F. postcondition_mut_F self args res_state res mode /\ resolve_F res_state)
  
  predicate hist_inv_F (self: t_F) (result_state: t_F)
  
  function hist_inv_trans_F (self: t_F) (b: t_F) (c: t_F) : ()
  
  axiom hist_inv_trans_F_spec:
    forall self: t_F, b: t_F, c: t_F [hist_inv_F self b, hist_inv_F b c | hist_inv_F self b, hist_inv_F self c | hist_inv_F b c, hist_inv_F self c]. hist_inv_F self b
      -> hist_inv_F b c -> hist_inv_F self c
  
  function hist_inv_refl_F (self: t_F) : ()
  
  axiom hist_inv_refl_F_spec: forall self: t_F [hist_inv_F self self]. hist_inv_F self self
  
  function postcondition_mut_hist_inv_F (self: t_F) (args: UInt32.t) (res_state: t_F) (res: bool) (mode: Mode.t) : ()
  
  axiom postcondition_mut_hist_inv_F_spec:
    forall self: t_F, args: UInt32.t, res_state: t_F, res: bool, mode: Mode.t [postcondition_mut_F self args res_state res mode | hist_inv_F self res_state]. postcondition_mut_F self args res_state res mode
      -> hist_inv_F self res_state
  
  function fn_hist_inv_F (self: t_F) (res_state: t_F) : ()
  
  axiom fn_hist_inv_F_spec: forall self: t_F, res_state: t_F [hist_inv_F self res_state]. hist_inv_F self res_state
      = (self = res_state)
  
  predicate postcondition_F (self: t_F) (args: UInt32.t) (result: bool) (mode: Mode.t)
  
  function fn_once_F (self: t_F) (args: UInt32.t) (res: bool) (mode: Mode.t) : ()
  
  axiom fn_once_F_spec:
    forall self: t_F, args: UInt32.t, res: bool, mode: Mode.t [postcondition_once_F self args res mode]. postcondition_once_F self args res mode
      = (postcondition_F self args res mode /\ resolve_F self)
  
  function fn_mut_F (self: t_F) (args: UInt32.t) (res_state: t_F) (res: bool) (mode: Mode.t) : ()
  
  axiom fn_mut_F_spec:
    forall self: t_F, args: UInt32.t, res_state: t_F, res: bool, mode: Mode.t [postcondition_mut_F self args res_state res mode]. postcondition_mut_F self args res_state res mode
      = (postcondition_F self args res mode /\ self = res_state)
  
  predicate postcondition_ref_F (self: t_F) (args: UInt32.t) (result: bool) (mode: Mode.t) =
    postcondition_F self args result mode
  
  meta "rewrite_def" predicate postcondition_ref_F
  
  predicate postcondition_mut_ref_F (self: t_F) (args: UInt32.t) (result_state: t_F) (result: bool) (mode: Mode.t) =
    postcondition_F self args result mode /\ self = result_state
  
  meta "rewrite_def" predicate postcondition_mut_ref_F
  
  predicate postcondition_once_ref_F (self: t_F) (args: UInt32.t) (result: bool) (mode: Mode.t) =
    postcondition_F self args result mode
  
  meta "rewrite_def" predicate postcondition_once_ref_F
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  constant x : t_F
  
  constant n : UInt32.t
  
  constant r : bool
  
  constant mode : Mode.t
  
  function test1_F (x: t_F) (n: UInt32.t) (r: bool) (mode: Mode.t) : ()
  
  goal vc_test1_F:
    [@stop_split] [@expl:test1_F ensures] ([@stop_split] [@expl:test1 ensures #0] postcondition_ref_F x n r mode
      = postcondition_F x n r mode)
    /\ ([@stop_split] [@expl:test1 ensures #1] forall xx: t_F. postcondition_mut_ref_F x n xx r mode
        = (postcondition_F x n r mode /\ x = xx))
    /\ ([@stop_split] [@expl:test1 ensures #2] postcondition_once_ref_F x n r mode = postcondition_F x n r mode)
end
module M_test2
  use creusot.prelude.MutBorrow
  use creusot.int.UInt32
  use creusot.prelude.Mode
  
  type t_F
  
  predicate postcondition_once_F (self: t_F) (args: UInt32.t) (result: bool) (mode: Mode.t)
  
  predicate resolve_F (_1: t_F)
  
  predicate postcondition_mut_F (self: t_F) (args: UInt32.t) (result_state: t_F) (result: bool) (mode: Mode.t)
  
  function fn_mut_once_F (self: t_F) (args: UInt32.t) (res: bool) (mode: Mode.t) : ()
  
  axiom fn_mut_once_F_spec:
    forall self: t_F, args: UInt32.t, res: bool, mode: Mode.t [postcondition_once_F self args res mode]. postcondition_once_F self args res mode
      = (exists res_state: t_F. postcondition_mut_F self args res_state res mode /\ resolve_F res_state)
  
  predicate hist_inv_F (self: t_F) (result_state: t_F)
  
  function hist_inv_trans_F (self: t_F) (b: t_F) (c: t_F) : ()
  
  axiom hist_inv_trans_F_spec:
    forall self: t_F, b: t_F, c: t_F [hist_inv_F self b, hist_inv_F b c | hist_inv_F self b, hist_inv_F self c | hist_inv_F b c, hist_inv_F self c]. hist_inv_F self b
      -> hist_inv_F b c -> hist_inv_F self c
  
  function hist_inv_refl_F (self: t_F) : ()
  
  axiom hist_inv_refl_F_spec: forall self: t_F [hist_inv_F self self]. hist_inv_F self self
  
  function postcondition_mut_hist_inv_F (self: t_F) (args: UInt32.t) (res_state: t_F) (res: bool) (mode: Mode.t) : ()
  
  axiom postcondition_mut_hist_inv_F_spec:
    forall self: t_F, args: UInt32.t, res_state: t_F, res: bool, mode: Mode.t [postcondition_mut_F self args res_state res mode | hist_inv_F self res_state]. postcondition_mut_F self args res_state res mode
      -> hist_inv_F self res_state
  
  predicate postcondition_mut_refmut_F (self: MutBorrow.t t_F) (args: UInt32.t) (result_state: MutBorrow.t t_F) (result: bool) (mode: Mode.t) =
    postcondition_mut_F self.current args result_state.current result mode /\ self.final = result_state.final
  
  meta "rewrite_def" predicate postcondition_mut_refmut_F
  
  predicate postcondition_once_refmut_F (self: MutBorrow.t t_F) (args: UInt32.t) (result: bool) (mode: Mode.t) =
    postcondition_mut_F self.current args self.final result mode
  
  meta "rewrite_def" predicate postcondition_once_refmut_F
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  constant x : MutBorrow.t t_F
  
  constant n : UInt32.t
  
  constant r : bool
  
  constant mode : Mode.t
  
  function test2_F (x: MutBorrow.t t_F) (n: UInt32.t) (r: bool) (mode: Mode.t) : ()
  
  goal vc_test2_F:
    [@stop_split] [@expl:test2_F ensures] ([@stop_split] [@expl:test2 ensures #0] forall xx: MutBorrow.t t_F. postcondition_mut_refmut_F x n xx r mode
        = (postcondition_mut_F x.current n xx.current r mode /\ x.final = xx.final))
    /\ ([@stop_split] [@expl:test2 ensures #1] postcondition_once_refmut_F x n r mode
    = postcondition_mut_F x.current n x.final r mode)
end
