    {[@stop_split] [@expl:weaken_3_std_A requires] ([@stop_split] [@expl:weaken_3_std 'f' type invariant] inv_F f)
    /\ ([@stop_split] [@expl:weaken_3_std 'a' type invariant] inv_A a)
    /\ ([@stop_split] [@expl:weaken_3_std requires] precondition_F f a mode)}
    (! bb0
    [ bb0 = s0 [ s0 = call_once_F {f} {a} {mode} (fun (_x: t_Output) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
    [ & _ret: t_Output = Any.any_l () | & f: t_F = f | & a: t_A = a ])
    [ return (result: t_Output) ->
    {[@stop_split] [@expl:weaken_3_std_A ensures] ([@stop_split] [@expl:weaken_3_std result type invariant] inv_Output result)
      /\ ([@stop_split] [@expl:weaken_3_std ensures] postcondition_once_F f a result mode)}
      (! return {result}) ]
end
module M_weaken_std
  use creusot.prelude.Mode
  use creusot.prelude.Any
  
  type t_F
  
  type t_A
  
  type t_Output
  
  predicate inv_F (_1: t_F)
  
  predicate inv_A (_1: t_A)
  
  predicate precondition_F (self: t_F) (args: t_A) (mode: Mode.t)
  
  predicate inv_Output (_1: t_Output)
  
  predicate postcondition_once_F (self: t_F) (args: t_A) (result: t_Output) (mode: Mode.t)
  
  predicate resolve_F (_1: t_F)
  
  predicate postcondition_mut_F (self: t_F) (args: t_A) (result_state: t_F) (result: t_Output) (mode: Mode.t)
  
  function fn_mut_once_F (self: t_F) (args: t_A) (res: t_Output) (mode: Mode.t) : ()
  
  axiom fn_mut_once_F_spec:
    forall self: t_F, args: t_A, res: t_Output, mode: Mode.t [postcondition_once_F self args res mode]. postcondition_once_F self args res mode
      = (exists res_state: t_F. postcondition_mut_F self args res_state res mode /\ resolve_F res_state)
  
  predicate hist_inv_F (self: t_F) (result_state: t_F)
  
  function hist_inv_trans_F (self: t_F) (b: t_F) (c: t_F) : ()
  
  axiom hist_inv_trans_F_spec:
    forall self: t_F, b: t_F, c: t_F [hist_inv_F self b, hist_inv_F b c | hist_inv_F self b, hist_inv_F self c | hist_inv_F b c, hist_inv_F self c]. hist_inv_F self b
      -> hist_inv_F b c -> hist_inv_F self c
  
  function hist_inv_refl_F (self: t_F) : ()
  
  axiom hist_inv_refl_F_spec: forall self: t_F [hist_inv_F self self]. hist_inv_F self self
  
  function postcondition_mut_hist_inv_F (self: t_F) (args: t_A) (res_state: t_F) (res: t_Output) (mode: Mode.t) : ()
  
  axiom postcondition_mut_hist_inv_F_spec:
    forall self: t_F, args: t_A, res_state: t_F, res: t_Output, mode: Mode.t [postcondition_mut_F self args res_state res mode | hist_inv_F self res_state]. postcondition_mut_F self args res_state res mode
      -> hist_inv_F self res_state
  
  let weaken_2_std_A (f: t_F) (a: t_A) (mode: Mode.t) (return (x: t_Output)) =
  {[@stop_split] [@expl:weaken_2_std_A requires] ([@stop_split] [@expl:weaken_2_std 'f' type invariant] inv_F f)
    /\ ([@stop_split] [@expl:weaken_2_std 'a' type invariant] inv_A a)
    /\ ([@stop_split] [@expl:weaken_2_std requires] precondition_F f a mode)}
    any
    [ return (result: t_Output) ->
    {[@stop_split] [@expl:weaken_2_std_A ensures] ([@stop_split] [@expl:weaken_2_std result type invariant] inv_Output result)
      /\ ([@stop_split] [@expl:weaken_2_std ensures] exists f2: t_F. postcondition_mut_F f a f2 result mode
        /\ resolve_F f2)}
      (! return {result}) ]
  
  function fn_hist_inv_F (self: t_F) (res_state: t_F) : ()
  
  axiom fn_hist_inv_F_spec: forall self: t_F, res_state: t_F [hist_inv_F self res_state]. hist_inv_F self res_state
      = (self = res_state)
  
  predicate postcondition_F (self: t_F) (args: t_A) (result: t_Output) (mode: Mode.t)
  
  function fn_once_F (self: t_F) (args: t_A) (res: t_Output) (mode: Mode.t) : ()
  
  axiom fn_once_F_spec:
    forall self: t_F, args: t_A, res: t_Output, mode: Mode.t [postcondition_once_F self args res mode]. postcondition_once_F self args res mode
      = (postcondition_F self args res mode /\ resolve_F self)
  
  function fn_mut_F (self: t_F) (args: t_A) (res_state: t_F) (res: t_Output) (mode: Mode.t) : ()
  
  axiom fn_mut_F_spec:
    forall self: t_F, args: t_A, res_state: t_F, res: t_Output, mode: Mode.t [postcondition_mut_F self args res_state res mode]. postcondition_mut_F self args res_state res mode
      = (postcondition_F self args res mode /\ self = res_state)
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let weaken_std_A (f: t_F) (a: t_A) (mode: Mode.t) (return (x: t_Output)) = {not Mode.terminates mode}
    {[@stop_split] [@expl:weaken_std_A requires] ([@stop_split] [@expl:weaken_std 'f' type invariant] inv_F f)
    /\ ([@stop_split] [@expl:weaken_std 'a' type invariant] inv_A a)
    /\ ([@stop_split] [@expl:weaken_std requires] precondition_F f a mode)}
    (! bb0
    [ bb0 = s0 [ s0 = weaken_2_std_A {f} {a} {mode} (fun (_x: t_Output) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
    [ & _ret: t_Output = Any.any_l () | & f: t_F = f | & a: t_A = a ])
    [ return (result: t_Output) ->
    {[@stop_split] [@expl:weaken_std_A ensures] ([@stop_split] [@expl:weaken_std result type invariant] inv_Output result)
      /\ ([@stop_split] [@expl:weaken_std ensures] postcondition_F f a result mode)}
      (! return {result}) ]
end
