module M_nested_closure
  use creusot.prelude.Any
  use creusot.prelude.Mode
  
  type closure0 = { c0: bool }
  
  let closure0 [@coma:extspec] (self: closure0) (mode: Mode.t) (return (x: bool)) = bb0
    [ bb0 = s0 [ s0 = [ &_ret <- self.c0 ] s1 | s1 = return {_ret} ] ]
    [ & _ret: bool = Any.any_l () | & self: closure0 = self ] [ return (result: bool) -> return {result} ]
  
  meta "rewrite_def" predicate closure0'pre
  
  meta "rewrite_def" predicate closure0'post'return
  
  type closure0'0 = { c0'0: bool }
  
  predicate precondition_closure0 (self: closure0) (args: ()) (mode: Mode.t) = closure0'pre self mode
  
  meta "rewrite_def" predicate precondition_closure0
  
  predicate postcondition_closure0 (self: closure0) (args: ()) (result: bool) (mode: Mode.t) =
    closure0'post'return self mode result
  
  meta "rewrite_def" predicate postcondition_closure0
  
  let call_closure0 (self: closure0) (args: ()) (mode: Mode.t) (return (x: bool)) =
  {[@stop_split] [@expl:call requires] precondition_closure0 self args mode}
    any
    [ return (result: bool) -> {[@stop_split] [@expl:call ensures] postcondition_closure0 self args result mode}
      (! return {result}) ]
  
  let closure0'0 [@coma:extspec] (self: closure0'0) (mode: Mode.t) (return (x: bool)) = bb0
    [ bb0 = s0
      [ s0 = [ &omg <- { c0 = self.c0'0 } ] s1
      | s1 = call_closure0 {omg} {_5} {mode} (fun (_x: bool) -> [ &_ret <- _x ] s2)
      | s2 = return {_ret} ] ]
    [ & _ret: bool = Any.any_l ()
    | & self: closure0'0 = self
    | & omg: closure0 = Any.any_l ()
    | & _5: () = Any.any_l () ] [ return (result: bool) -> return {result} ]
  
  meta "rewrite_def" predicate closure0'0'pre
  
  meta "rewrite_def" predicate closure0'0'post'return
  
  predicate precondition_closure0'0 (self: closure0'0) (args: ()) (mode: Mode.t) = closure0'0'pre self mode
  
  meta "rewrite_def" predicate precondition_closure0'0
  
  predicate postcondition_closure0'0 (self: closure0'0) (args: ()) (result: bool) (mode: Mode.t) =
    closure0'0'post'return self mode result
  
  meta "rewrite_def" predicate postcondition_closure0'0
  
  let call_closure0'0 (self: closure0'0) (args: ()) (mode: Mode.t) (return (x: bool)) =
  {[@stop_split] [@expl:call requires] precondition_closure0'0 self args mode}
    any
    [ return (result: bool) -> {[@stop_split] [@expl:call ensures] postcondition_closure0'0 self args result mode}
      (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let nested_closure (mode: Mode.t) (return (x: ())) = {not Mode.terminates mode}
    (! bb0
    [ bb0 = s0
      [ s0 = [ &a <- true ] s1
      | s1 = [ &_4 <- { c0'0 = a } ] s2
      | s2 = call_closure0'0 {_4} {_6} {mode} (fun (_x: bool) -> [ &_a <- _x ] s3)
      | s3 = return {_ret} ] ]
    [ & _ret: () = Any.any_l ()
    | & a: bool = Any.any_l ()
    | & _a: bool = Any.any_l ()
    | & _4: closure0'0 = Any.any_l ()
    | & _6: () = Any.any_l () ]) [ return (result: ()) -> (! return {result}) ]
end
