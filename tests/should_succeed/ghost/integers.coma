module M_ghost_function
  use creusot.prelude.Mode
  use int.ComputerDivision
  use creusot.prelude.Any
  use int.Int
  
  let rem_Int (mode: Mode.t) (self: int) (other: int) (return (x: int)) = {[@stop_split] [@expl:rem requires] other
    <> 0}
    any
    [ return (result: int) -> {[@stop_split] [@expl:rem ensures] result = ComputerDivision.mod self other}
      (! return {result}) ]
  
  let add_Int (mode: Mode.t) (self: int) (other: int) (return (x: int)) = any
    [ return (result: int) -> {[@stop_split] [@expl:add ensures] result = self + other} (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let ghost_function (mode: Mode.t) (x: int) (y: int) (z: int) (return (x'0: int)) =
  {[@stop_split] [@expl:ghost_function requires] z <> 0}
    (! bb0
    [ bb0 = s0
      [ s0 = rem_Int {mode} {y} {z} (fun (_x: int) -> [ &_11 <- _x ] s1)
      | s1 = add_Int {mode} {x} {_11} (fun (_x: int) -> [ &_ret <- _x ] s2)
      | s2 = return {_ret} ] ]
    [ & _ret: int = Any.any_l () | & x: int = x | & y: int = y | & z: int = z | & _11: int = Any.any_l () ])
    [ return (result: int) -> {[@stop_split] [@expl:ghost_function ensures] result = x + ComputerDivision.mod y z}
      (! return {result}) ]
end
module M_in_ghost_block
  use creusot.int.Int128
  use creusot.prelude.Mode
  use int.ComputerDivision
  use creusot.prelude.Any
  use int.Int
  
  let new (mode: Mode.t) (value: Int128.t) (return (x: int)) = any
    [ return (result: int) -> {[@stop_split] [@expl:new ensures] result = Int128.to_int value} (! return {result}) ]
  
  let into_inner_Int (mode: Mode.t) (self: int) (return (x: int)) = any
    [ return (result: int) -> {[@stop_split] [@expl:into_inner ensures] result = self} (! return {result}) ]
  
  let new_Int (mode: Mode.t) (x: int) (return (x'0: int)) = any
    [ return (result: int) -> {[@stop_split] [@expl:new ensures] result = x} (! return {result}) ]
  
  let deref_Ghost_Int (mode: Mode.t) (self: int) (return (x: int)) = any
    [ return (result: int) -> {[@stop_split] [@expl:deref ensures] result = self} (! return {result}) ]
  
  let add_Int (mode: Mode.t) (self: int) (other: int) (return (x: int)) = any
    [ return (result: int) -> {[@stop_split] [@expl:add ensures] result = self + other} (! return {result}) ]
  
  let mul_Int (mode: Mode.t) (self: int) (other: int) (return (x: int)) = any
    [ return (result: int) -> {[@stop_split] [@expl:mul ensures] result = self * other} (! return {result}) ]
  
  let new_unit (mode: Mode.t) (x: ()) (return (x'0: ())) = any
    [ return (result: ()) -> {[@stop_split] [@expl:new ensures] result = x} (! return {result}) ]
  
  let ghost_function (mode: Mode.t) (x: int) (y: int) (z: int) (return (x'0: int)) =
  {[@stop_split] [@expl:ghost_function requires] z <> 0}
    any
    [ return (result: int) -> {[@stop_split] [@expl:ghost_function ensures] result = x + ComputerDivision.mod y z}
      (! return {result}) ]
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let in_ghost_block (mode: Mode.t) (return (x: ())) = (! bb0
    [ bb0 = s0
      [ s0 = new {Mode.into_ghost mode} {(1: Int128.t)} (fun (_x: int) -> [ &_3 <- _x ] s1)
      | s1 = into_inner_Int {Mode.into_ghost mode} {_3} (fun (_x: int) -> [ &_2 <- _x ] s2)
      | s2 = new_Int {Mode.into_ghost mode} {_2} (fun (_x: int) -> [ &x <- _x ] s3)
      | s3 = new {Mode.into_ghost mode} {(2: Int128.t)} (fun (_x: int) -> [ &_7 <- _x ] s4)
      | s4 = into_inner_Int {Mode.into_ghost mode} {_7} (fun (_x: int) -> [ &y <- _x ] s5)
      | s5 = deref_Ghost_Int {Mode.into_ghost mode} {x} (fun (_x: int) -> [ &_10 <- _x ] s6)
      | s6 = add_Int {Mode.into_ghost mode} {_10} {y} (fun (_x: int) -> [ &z <- _x ] s7)
      | s7 = new {Mode.into_ghost mode} {(3: Int128.t)} (fun (_x: int) -> [ &_16 <- _x ] s8)
      | s8 = into_inner_Int {Mode.into_ghost mode} {_16} (fun (_x: int) -> [ &_15 <- _x ] s9)
      | s9 = mul_Int {Mode.into_ghost mode} {z} {_15} (fun (_x: int) -> [ &w <- _x ] s10)
      | s10 = {[@expl:assertion] w = 9} s11
      | s11 = new_unit {Mode.into_ghost mode} {_5} (fun (_x: ()) -> [ &_4 <- _x ] s12)
      | s12 = new {Mode.into_ghost mode} {(4: Int128.t)} (fun (_x: int) -> [ &_24 <- _x ] s13)
      | s13 = into_inner_Int {Mode.into_ghost mode} {_24} (fun (_x: int) -> [ &_23 <- _x ] s14)
      | s14 = new {Mode.into_ghost mode} {(13: Int128.t)} (fun (_x: int) -> [ &_26 <- _x ] s15)
      | s15 = into_inner_Int {Mode.into_ghost mode} {_26} (fun (_x: int) -> [ &_25 <- _x ] s16)
      | s16 = new {Mode.into_ghost mode} {(5: Int128.t)} (fun (_x: int) -> [ &_28 <- _x ] s17)
      | s17 = into_inner_Int {Mode.into_ghost mode} {_28} (fun (_x: int) -> [ &_27 <- _x ] s18)
      | s18 = ghost_function {Mode.into_ghost mode} {_23} {_25} {_27} (fun (_x: int) -> [ &x'0 <- _x ] s19)
      | s19 = {[@expl:assertion] x'0 = 7} s20
      | s20 = new_unit {Mode.into_ghost mode} {_21} (fun (_x: ()) -> [ &_20 <- _x ] s21)
      | s21 = return {_ret} ] ]
    [ & _ret: () = Any.any_l ()
    | & x: int = Any.any_l ()
    | & _2: int = Any.any_l ()
    | & _3: int = Any.any_l ()
    | & _4: () = Any.any_l ()
    | & _5: () = Any.any_l ()
    | & y: int = Any.any_l ()
    | & _7: int = Any.any_l ()
    | & z: int = Any.any_l ()
    | & _10: int = Any.any_l ()
    | & w: int = Any.any_l ()
    | & _15: int = Any.any_l ()
    | & _16: int = Any.any_l ()
    | & _20: () = Any.any_l ()
    | & _21: () = Any.any_l ()
    | & x'0: int = Any.any_l ()
    | & _23: int = Any.any_l ()
    | & _24: int = Any.any_l ()
    | & _25: int = Any.any_l ()
    | & _26: int = Any.any_l ()
    | & _27: int = Any.any_l ()
    | & _28: int = Any.any_l () ]) [ return (result: ()) -> (! return {result}) ]
end
