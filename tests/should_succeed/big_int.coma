module M_foo
  use creusot.int.UInt128
  use int.Int
  
  constant const_MAX: UInt128.t = (340282366920938463463374607431768211455: UInt128.t)
  
  predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self
  
  meta "rewrite_def" predicate gt_log_Int
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  function foo : ()
  
  goal vc_foo:
    let i = 99114423091819531172504291514877162636065 in let j = 99114423091819531172504291514877162636065 in i = j
    && gt_log_Int i (UInt128.t'int const_MAX) && gt_log_Int j (UInt128.t'int const_MAX)
end
