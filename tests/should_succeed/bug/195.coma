module M_example
  use creusot.prelude.Any
  use creusot.prelude.Mode
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let example (mode: Mode.t) (_example_parameter: bool) (return (x: ())) =
  {[@stop_split] [@expl:example requires] _example_parameter = _example_parameter}
    (! bb0
    [ bb0 = return {_ret} ] [ & _ret: () = Any.any_l () ]) [ return (result: ()) -> (! return {result}) ]
end
