module M_impl_Clone_for_Lit__clone (* <Lit as std::clone::Clone> *)
  use creusot.prelude.Any
  use creusot.prelude.Mode
  
  meta "compute_max_steps" 1000000
  
  meta "select_lsinst" "all"
  
  let clone_Lit (self: ()) (mode: Mode.t) (return (x: ())) = {not Mode.terminates mode}
    (! bb0
    [ bb0 = s0 [ s0 = [ &_ret <- () ] s1 | s1 = return {_ret} ] ] [ & _ret: () = Any.any_l () ])
    [ return (result: ()) -> (! return {result}) ]
end
