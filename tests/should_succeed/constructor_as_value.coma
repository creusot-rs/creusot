    [ bb0 = s0 [ s0 = [ &t <- () ] s1 | s1 = f_T0 (fun (_x: ()) -> [ &_ret <- _x ] s2) | s2 = return {_ret} ] ]
    [ & _ret: () = Any.any_l () | & t: () = Any.any_l () ])
    [ return (result: ()) -> {[@stop_split] [@expl:h ensures] result = ()} (! return {result}) ]
