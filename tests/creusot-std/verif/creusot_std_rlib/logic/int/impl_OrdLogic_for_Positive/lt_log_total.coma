(* <logic::int::Positive as logic::ord::OrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use int.Int

type t_Subset_PositiveInner

type t_Positive = { f0: t_Subset_PositiveInner }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

type t_PositiveInner = { f0'0: int }

predicate invariant_PositiveInner (self: t_PositiveInner) = gt_log_Int self.f0'0 0

function inner_PositiveInner (self: t_Subset_PositiveInner) : t_PositiveInner

axiom inner_PositiveInner_spec:
  forall self: t_Subset_PositiveInner [inner_PositiveInner self]. invariant_PositiveInner (inner_PositiveInner self)

function to_int (self: t_Positive) : int = (inner_PositiveInner self.f0).f0'0

axiom to_int_spec: forall self: t_Positive [to_int self]. gt_log_Int (to_int self) 0

predicate le_log_Positive (self: t_Positive) (other: t_Positive) = to_int self <= to_int other

predicate lt_log_Positive (self: t_Positive) (other: t_Positive) = to_int self < to_int other

function le_lt_log_Positive (self: t_Positive) (other: t_Positive) : () = ()

axiom le_lt_log_Positive_spec: forall self: t_Positive, other: t_Positive. le_log_Positive self other
    = (lt_log_Positive self other \/ self = other)

predicate ext_eq (self: t_Positive) (other: t_Positive) = to_int self = to_int other

axiom ext_eq_spec: forall self: t_Positive, other: t_Positive [self = other]. ext_eq self other = (self = other)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Positive

constant other : t_Positive

function lt_log_total_Positive (self: t_Positive) (other: t_Positive) : ()

goal vc_lt_log_total_Positive: [@stop_split] [@expl:lt_log_total ensures] lt_log_Positive self other
  \/ self = other \/ lt_log_Positive other self
