(* <logic::int::Positive as logic::ops::arithmetic::AddLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use int.Int

type t_Subset_PositiveInner

type t_Positive = { f0: t_Subset_PositiveInner }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

type t_PositiveInner = { f0'0: int }

predicate invariant_PositiveInner (self: t_PositiveInner) = gt_log_Int self.f0'0 0

function inner_PositiveInner (self: t_Subset_PositiveInner) : t_PositiveInner

axiom inner_PositiveInner_spec:
  forall self: t_Subset_PositiveInner [inner_PositiveInner self]. invariant_PositiveInner (inner_PositiveInner self)

function to_int (self: t_Positive) : int = (inner_PositiveInner self.f0).f0'0

axiom to_int_spec: forall self: t_Positive [to_int self]. gt_log_Int (to_int self) 0

function view_Positive (self: t_Positive) : int = to_int self

function new_PositiveInner (x: t_PositiveInner) : t_Subset_PositiveInner

axiom new_PositiveInner_spec: forall x: t_PositiveInner [new_PositiveInner x]. invariant_PositiveInner x
    -> inner_PositiveInner (new_PositiveInner x) = x

function new (n: int) : t_Positive = { f0 = new_PositiveInner { f0'0 = n } }

axiom new_spec: forall n: int [new n]. gt_log_Int n 0 -> to_int (new n) = n

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Positive

constant other : t_Positive

function add_Positive (self: t_Positive) (other: t_Positive) : t_Positive

goal vc_add_Positive: ([@stop_split] [@expl:to_int ensures] gt_log_Int (to_int self) 0)
  -> ([@stop_split] [@expl:to_int ensures] gt_log_Int (to_int other) 0)
  -> ([@stop_split] [@expl:new requires] gt_log_Int (to_int self + to_int other) 0)
  /\ (([@stop_split] [@expl:new ensures] to_int (new (to_int self + to_int other)) = to_int self + to_int other)
  -> ([@stop_split] [@expl:add_logic ensures] view_Positive (new (to_int self + to_int other))
  = view_Positive self + view_Positive other))
