(* <logic::int::Nat as std::clone::Clone> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Any

type t_Subset_NatInner

type t_Nat = { f0: t_Subset_NatInner }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clone_Nat (self: t_Nat) (return (x: t_Nat)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Nat = Any.any_l () | & self: t_Nat = self ])
  [ return (result: t_Nat) -> {[@stop_split] [@expl:clone ensures] result = self} (! return {result}) ]
