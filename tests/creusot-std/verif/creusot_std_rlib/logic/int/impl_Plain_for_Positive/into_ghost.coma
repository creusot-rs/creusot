(* <logic::int::Positive as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Any
use int.Int

type t_Subset_PositiveInner

type t_Positive = { f0: t_Subset_PositiveInner }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

type t_PositiveInner = { f0'0: int }

predicate invariant_PositiveInner (self: t_PositiveInner) = gt_log_Int self.f0'0 0

function inner_PositiveInner (self: t_Subset_PositiveInner) : t_PositiveInner

axiom inner_PositiveInner_spec:
  forall self: t_Subset_PositiveInner [inner_PositiveInner self]. invariant_PositiveInner (inner_PositiveInner self)

function to_int (self: t_Positive) : int = (inner_PositiveInner self.f0).f0'0

axiom to_int_spec: forall self: t_Positive [to_int self]. gt_log_Int (to_int self) 0

predicate ext_eq (self: t_Positive) (other: t_Positive) = to_int self = to_int other

axiom ext_eq_spec: forall self: t_Positive, other: t_Positive [self = other]. ext_eq self other = (self = other)

predicate inv_Int [@inline:trivial] (_1: int) = true

meta "rewrite_def" predicate inv_Int

let into_ghost_Int (self: int) (return (x: int)) = {[@stop_split] [@expl:into_ghost requires] inv_Int self}
  any [ return (result: int) -> {[@stop_split] [@expl:into_ghost ensures] result = self} (! return {result}) ]

let into_inner_Int (self: int) (return (x: int)) = any
  [ return (result: int) -> {[@stop_split] [@expl:into_inner ensures] result = self} (! return {result}) ]

predicate inv_PositiveInner (_1: t_PositiveInner)

axiom inv_axiom [@rewrite]: forall x: t_PositiveInner [inv_PositiveInner x]. inv_PositiveInner x
    = invariant_PositiveInner x

function new_PositiveInner (x: t_PositiveInner) : t_Subset_PositiveInner

axiom new_PositiveInner_spec: forall x: t_PositiveInner [new_PositiveInner x]. invariant_PositiveInner x
    -> inner_PositiveInner (new_PositiveInner x) = x

let new_PositiveInner'0 (x: t_PositiveInner) (return (x'0: t_Subset_PositiveInner)) =
{[@stop_split] [@expl:new 'x' type invariant] inv_PositiveInner x}
  any
  [ return (result: t_Subset_PositiveInner) -> {[@stop_split] [@expl:new ensures] result = new_PositiveInner x}
    (! return {result}) ]

let new_Positive (x: t_Positive) (return (x'0: t_Positive)) = any
  [ return (result: t_Positive) -> {[@stop_split] [@expl:new ensures] result = x} (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let into_ghost_Positive (s: t_Positive) (return (x: t_Positive)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &n <- to_int s ] s1
    | s1 = [ &_8 <- () ] s2
    | s2 = into_ghost_Int {n} (fun (_x: int) -> [ &_13 <- _x ] s3)
    | s3 = into_inner_Int {_13} (fun (_x: int) -> [ &_12 <- _x ] s4)
    | s4 = [ &_11 <- { f0'0 = _12 } ] s5
    | s5 = new_PositiveInner'0 {_11} (fun (_x: t_Subset_PositiveInner) -> [ &_10 <- _x ] s6)
    | s6 = [ &_4 <- { f0 = _10 } ] s7
    | s7 = new_Positive {_4} (fun (_x: t_Positive) -> [ &_ret <- _x ] s8)
    | s8 = return {_ret} ] ]
  [ & _ret: t_Positive = Any.any_l ()
  | & s: t_Positive = s
  | & _4: t_Positive = Any.any_l ()
  | & n: int = Any.any_l ()
  | & _8: () = Any.any_l ()
  | & _10: t_Subset_PositiveInner = Any.any_l ()
  | & _11: t_PositiveInner = Any.any_l ()
  | & _12: int = Any.any_l ()
  | & _13: int = Any.any_l () ])
  [ return (result: t_Positive) -> {[@stop_split] [@expl:into_ghost ensures] result = s} (! return {result}) ]
