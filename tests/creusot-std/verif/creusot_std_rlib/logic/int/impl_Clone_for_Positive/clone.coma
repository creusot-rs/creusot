(* <logic::int::Positive as std::clone::Clone> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Any

type t_Subset_PositiveInner

type t_Positive = { f0: t_Subset_PositiveInner }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clone_Positive (self: t_Positive) (return (x: t_Positive)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Positive = Any.any_l () | & self: t_Positive = self ])
  [ return (result: t_Positive) -> {[@stop_split] [@expl:clone ensures] result = self} (! return {result}) ]
