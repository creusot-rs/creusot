(* logic::int::Positive *)

type namespace_other

type t_Namespace = Other namespace_other

use int.Int

type t_Subset_PositiveInner

type t_Positive = { f0: t_Subset_PositiveInner }

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

type t_PositiveInner = { f0'0: int }

predicate invariant_PositiveInner (self: t_PositiveInner) = gt_log_Int self.f0'0 0

function inner_PositiveInner (self: t_Subset_PositiveInner) : t_PositiveInner

axiom inner_PositiveInner_spec:
  forall self: t_Subset_PositiveInner [inner_PositiveInner self]. invariant_PositiveInner (inner_PositiveInner self)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Positive

function to_int (self: t_Positive) : int

goal vc_to_int: ([@stop_split] [@expl:inner ensures] invariant_PositiveInner (inner_PositiveInner self.f0))
  -> ([@stop_split] [@expl:to_int ensures] gt_log_Int (inner_PositiveInner self.f0).f0'0 0)
