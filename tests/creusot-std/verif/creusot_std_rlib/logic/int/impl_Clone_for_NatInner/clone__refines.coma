(* <logic::int::NatInner as std::clone::Clone> *)

type namespace_other

type t_Namespace = Other namespace_other

use int.Int

type t_NatInner = { f0: int }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

predicate invariant_NatInner (self: t_NatInner) = ge_log_Int self.f0 0

predicate inv_NatInner (_1: t_NatInner)

axiom inv_axiom [@rewrite]: forall _1: t_NatInner [inv_NatInner _1]. inv_NatInner _1 = invariant_NatInner _1

predicate invariant_ref_NatInner [@inline:trivial] (self: t_NatInner) = inv_NatInner self

meta "rewrite_def" predicate invariant_ref_NatInner

predicate inv_ref_NatInner [@inline:trivial] (_1: t_NatInner) = invariant_ref_NatInner _1

meta "rewrite_def" predicate inv_ref_NatInner

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_NatInner. inv_ref_NatInner self
    -> inv_ref_NatInner self /\ (forall result: t_NatInner. inv_NatInner result /\ result = self -> inv_NatInner result)
