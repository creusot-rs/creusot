(* <logic::int::Nat as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Any
use int.Int

type t_Subset_NatInner

type t_Nat = { f0: t_Subset_NatInner }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

type t_NatInner = { f0'0: int }

predicate invariant_NatInner (self: t_NatInner) = ge_log_Int self.f0'0 0

function inner_NatInner (self: t_Subset_NatInner) : t_NatInner

axiom inner_NatInner_spec:
  forall self: t_Subset_NatInner [inner_NatInner self]. invariant_NatInner (inner_NatInner self)

function to_int (self: t_Nat) : int = (inner_NatInner self.f0).f0'0

axiom to_int_spec: forall self: t_Nat [to_int self]. ge_log_Int (to_int self) 0

predicate ext_eq (self: t_Nat) (other: t_Nat) = to_int self = to_int other

axiom ext_eq_spec: forall self: t_Nat, other: t_Nat [self = other]. ext_eq self other = (self = other)

predicate inv_Int [@inline:trivial] (_1: int) = true

meta "rewrite_def" predicate inv_Int

let into_ghost_Int (self: int) (return (x: int)) = {[@stop_split] [@expl:into_ghost requires] inv_Int self}
  any [ return (result: int) -> {[@stop_split] [@expl:into_ghost ensures] result = self} (! return {result}) ]

let into_inner_Int (self: int) (return (x: int)) = any
  [ return (result: int) -> {[@stop_split] [@expl:into_inner ensures] result = self} (! return {result}) ]

predicate inv_NatInner (_1: t_NatInner)

axiom inv_axiom [@rewrite]: forall x: t_NatInner [inv_NatInner x]. inv_NatInner x = invariant_NatInner x

function new_NatInner (x: t_NatInner) : t_Subset_NatInner

axiom new_NatInner_spec: forall x: t_NatInner [new_NatInner x]. invariant_NatInner x
    -> inner_NatInner (new_NatInner x) = x

let new_NatInner'0 (x: t_NatInner) (return (x'0: t_Subset_NatInner)) =
{[@stop_split] [@expl:new 'x' type invariant] inv_NatInner x}
  any
  [ return (result: t_Subset_NatInner) -> {[@stop_split] [@expl:new ensures] result = new_NatInner x}
    (! return {result}) ]

let new_Nat (x: t_Nat) (return (x'0: t_Nat)) = any
  [ return (result: t_Nat) -> {[@stop_split] [@expl:new ensures] result = x} (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let into_ghost_Nat (s: t_Nat) (return (x: t_Nat)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &n <- to_int s ] s1
    | s1 = [ &_8 <- () ] s2
    | s2 = into_ghost_Int {n} (fun (_x: int) -> [ &_13 <- _x ] s3)
    | s3 = into_inner_Int {_13} (fun (_x: int) -> [ &_12 <- _x ] s4)
    | s4 = [ &_11 <- { f0'0 = _12 } ] s5
    | s5 = new_NatInner'0 {_11} (fun (_x: t_Subset_NatInner) -> [ &_10 <- _x ] s6)
    | s6 = [ &_4 <- { f0 = _10 } ] s7
    | s7 = new_Nat {_4} (fun (_x: t_Nat) -> [ &_ret <- _x ] s8)
    | s8 = return {_ret} ] ]
  [ & _ret: t_Nat = Any.any_l ()
  | & s: t_Nat = s
  | & _4: t_Nat = Any.any_l ()
  | & n: int = Any.any_l ()
  | & _8: () = Any.any_l ()
  | & _10: t_Subset_NatInner = Any.any_l ()
  | & _11: t_NatInner = Any.any_l ()
  | & _12: int = Any.any_l ()
  | & _13: int = Any.any_l () ])
  [ return (result: t_Nat) -> {[@stop_split] [@expl:into_ghost ensures] result = s} (! return {result}) ]
