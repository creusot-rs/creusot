  [ return (result: t_FMap_ref_K_ref_V) ->
  {[@stop_split] [@expl:as_ref_ghost_K ensures] ([@stop_split] [@expl:as_ref_ghost result type invariant] inv_FMap_ref_K_ref_V result)
