      [ _ck -> (! {[@expl:type invariant] inv_FMap_K_V self.current} any) ]
    | s1 = as_mut_ghost_K {_11} (fun (_x: t_FMap_ref_K_refmut_V) -> [ &_10 <- _x ] s2)
    | s2 = [ &_ret <- { f0 = _10 } ] s3
    | s3 = s4 [ _ck -> (! {[@expl:type invariant] inv_refmut_FMap_K_V self} any) ]
    | s4 = -{resolve_refmut_FMap_K_V self}- s5
    | s5 = return {_ret} ] ]
  [ & _ret: t_Iter_ref_K_refmut_V = Any.any_l ()
  | & self: MutBorrow.t t_FMap_K_V = self
  | & _10: t_FMap_ref_K_refmut_V = Any.any_l ()
  | & _11: MutBorrow.t t_FMap_K_V = Any.any_l () ])
  [ return (result: t_Iter_ref_K_refmut_V) ->
  {[@stop_split] [@expl:into_iter_refmut_FMap_K_V ensures] ([@stop_split] [@expl:into_iter result type invariant] inv_Iter_ref_K_refmut_V result)
