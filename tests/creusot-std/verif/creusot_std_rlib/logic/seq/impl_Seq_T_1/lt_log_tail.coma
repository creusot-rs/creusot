(* logic::seq::Seq<T> *)

type namespace_other

type t_Namespace = Other namespace_other

use seq.Seq
use int.Int

type t_T

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

predicate le_log_T (self: t_T) (other: t_T)

predicate lt_log_T (self: t_T) (other: t_T)

function le_lt_log_T (self: t_T) (other: t_T) : ()

axiom le_lt_log_T_spec: forall self: t_T, other: t_T. le_log_T self other = (lt_log_T self other \/ self = other)

function transitive_T (x: t_T) (y: t_T) (z: t_T) : ()

axiom transitive_T_spec: forall x: t_T, y: t_T, z: t_T. lt_log_T x y -> lt_log_T y z -> lt_log_T x z

function irreflexive_T (self: t_T) : ()

axiom irreflexive_T_spec: forall self: t_T. not lt_log_T self self

predicate lt_log_Seq_T (self: Seq.seq t_T) (other: Seq.seq t_T) =
  (exists i: int. 0 <= i
      /\ i < Seq.length self
      /\ i < Seq.length other
      /\ (forall j: int. 0 <= j /\ j < i -> Seq.get self j = Seq.get other j)
      /\ lt_log_T (Seq.get self i) (Seq.get other i))
  \/ Seq.length self < Seq.length other
  /\ (forall i: int. 0 <= i /\ i < Seq.length self -> Seq.get self i = Seq.get other i)

predicate le_log_Seq_T [@inline:trivial] (self: Seq.seq t_T) (other: Seq.seq t_T) =
  lt_log_Seq_T self other \/ self = other

meta "rewrite_def" predicate le_log_Seq_T

function le_lt_log_Seq_T (self: Seq.seq t_T) (other: Seq.seq t_T) : () = ()

axiom le_lt_log_Seq_T_spec: forall self: Seq.seq t_T, other: Seq.seq t_T. le_log_Seq_T self other
    = (lt_log_Seq_T self other \/ self = other)

function transitive_Seq_T (x: Seq.seq t_T) (y: Seq.seq t_T) (z: Seq.seq t_T) : () = ()

axiom transitive_Seq_T_spec: forall x: Seq.seq t_T, y: Seq.seq t_T, z: Seq.seq t_T. lt_log_Seq_T x y
    -> lt_log_Seq_T y z -> lt_log_Seq_T x z

function irreflexive_Seq_T (self: Seq.seq t_T) : () = ()

axiom irreflexive_Seq_T_spec: forall self: Seq.seq t_T. not lt_log_Seq_T self self

type t_RangeFrom_Int = { start: int }

function index_Seq_T [@inline:trivial] (self: Seq.seq t_T) (range: t_RangeFrom_Int) : Seq.seq t_T =
  Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Seq.seq t_T

constant other : Seq.seq t_T

function lt_log_tail_T (self: Seq.seq t_T) (other: Seq.seq t_T) : ()

goal vc_lt_log_tail_T: gt_log_Int (Seq.length self) 0 /\ gt_log_Int (Seq.length other) 0
  -> Seq.get self 0 = Seq.get other 0
  -> ([@stop_split] [@expl:lt_log_tail ensures] lt_log_Seq_T self other
  = lt_log_Seq_T (index_Seq_T self { start = 1 }) (index_Seq_T other { start = 1 }))
