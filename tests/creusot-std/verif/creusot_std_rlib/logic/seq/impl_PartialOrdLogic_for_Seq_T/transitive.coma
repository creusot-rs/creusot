(* <logic::seq::Seq<T> as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use seq.Seq
use int.Int

type t_T

predicate le_log_T (self: t_T) (other: t_T)

predicate lt_log_T (self: t_T) (other: t_T)

function le_lt_log_T (self: t_T) (other: t_T) : ()

axiom le_lt_log_T_spec: forall self: t_T, other: t_T. le_log_T self other = (lt_log_T self other \/ self = other)

function transitive_T (x: t_T) (y: t_T) (z: t_T) : ()

axiom transitive_T_spec: forall x: t_T, y: t_T, z: t_T. lt_log_T x y -> lt_log_T y z -> lt_log_T x z

function irreflexive_T (self: t_T) : ()

axiom irreflexive_T_spec: forall self: t_T. not lt_log_T self self

predicate lt_log_Seq_T (self: Seq.seq t_T) (other: Seq.seq t_T) =
  (exists i: int. 0 <= i
      /\ i < Seq.length self
      /\ i < Seq.length other
      /\ (forall j: int. 0 <= j /\ j < i -> Seq.get self j = Seq.get other j)
      /\ lt_log_T (Seq.get self i) (Seq.get other i))
  \/ Seq.length self < Seq.length other
  /\ (forall i: int. 0 <= i /\ i < Seq.length self -> Seq.get self i = Seq.get other i)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : Seq.seq t_T

constant y : Seq.seq t_T

constant z : Seq.seq t_T

function transitive_Seq_T (x: Seq.seq t_T) (y: Seq.seq t_T) (z: Seq.seq t_T) : ()

goal vc_transitive_Seq_T: lt_log_Seq_T x y
  -> lt_log_Seq_T y z -> ([@stop_split] [@expl:transitive ensures] lt_log_Seq_T x z)
