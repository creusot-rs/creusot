(* logic::seq::Seq<T> *)

use seq.Seq
use map.Map

type t_T

type t_U

type t_RangeFrom_Int = { start: int }

function index_Seq_T [@inline:trivial] (self: Seq.seq t_T) (range: t_RangeFrom_Int) : Seq.seq t_T =
  Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_T

function tail_T [@inline:trivial] (self: Seq.seq t_T) : Seq.seq t_T = index_Seq_T self { start = 1 }

meta "rewrite_def" function tail_T

function flat_map_T (self: Seq.seq t_T) (other: Map.map t_T (Seq.seq t_U)) : Seq.seq t_U

axiom flat_map_T_def:
  forall self: Seq.seq t_T, other: Map.map t_T (Seq.seq t_U) [flat_map_T self other]. flat_map_T self other
    = (if Seq.length self = 0 then
      Seq.empty: Seq.seq t_U
    else
      Seq.(++) (Map.get other (Seq.get self 0)) (flat_map_T (tail_T self) other)
    )

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : t_T

constant f : Map.map t_T (Seq.seq t_U)

function flat_map_singleton_T (x: t_T) (f: Map.map t_T (Seq.seq t_U)) : ()

goal vc_flat_map_singleton_T: [@stop_split] [@expl:flat_map_singleton ensures] flat_map_T (Seq.singleton x) f
  = Map.get f x
