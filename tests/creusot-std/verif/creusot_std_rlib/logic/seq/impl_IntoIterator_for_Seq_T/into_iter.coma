(* <logic::seq::Seq<T> as std::iter::IntoIterator> *)

type namespace_other

type t_Namespace = Other namespace_other

use seq.Seq
use creusot.prelude.Any
use int.Int

type t_T

type t_Iter_T = { f0: Seq.seq t_T }

predicate inv_T (_1: t_T)

predicate invariant_ref_T [@inline:trivial] (self: t_T) = inv_T self

meta "rewrite_def" predicate invariant_ref_T

predicate inv_ref_T [@inline:trivial] (_1: t_T) = invariant_ref_T _1

meta "rewrite_def" predicate inv_ref_T

predicate invariant_Seq_T [@inline:trivial] (self: Seq.seq t_T) =
  forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_T (Seq.get self i)

meta "rewrite_def" predicate invariant_Seq_T

predicate inv_Seq_T [@inline:trivial] (_1: Seq.seq t_T) = invariant_Seq_T _1

meta "rewrite_def" predicate inv_Seq_T

predicate inv_Iter_T (_1: t_Iter_T)

axiom inv_axiom [@rewrite]: forall x: t_Iter_T [inv_Iter_T x]. inv_Iter_T x = inv_Seq_T x.f0

function view_Iter_T (self: t_Iter_T) : Seq.seq t_T = self.f0

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let into_iter_Seq_T (self: Seq.seq t_T) (return (x: t_Iter_T)) =
{[@stop_split] [@expl:into_iter 'self' type invariant] inv_Seq_T self}
  (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- { f0 = self } ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Iter_T = Any.any_l () | & self: Seq.seq t_T = self ])
  [ return (result: t_Iter_T) ->
  {[@stop_split] [@expl:into_iter_Seq_T ensures] ([@stop_split] [@expl:into_iter result type invariant] inv_Iter_T result)
    /\ ([@stop_split] [@expl:into_iter ensures] self = view_Iter_T result)}
    (! return {result}) ]
