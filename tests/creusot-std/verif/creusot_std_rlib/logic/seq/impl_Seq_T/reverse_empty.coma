(* logic::seq::Seq<T> *)

type namespace_other

type t_Namespace = Other namespace_other

use seq.Reverse
use seq.Seq

type t_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

function reverse_empty_T : ()

goal vc_reverse_empty_T: [@stop_split] [@expl:reverse_empty ensures] Reverse.reverse (Seq.empty: Seq.seq t_T)
  = (Seq.empty: Seq.seq t_T)
