(* logic::seq::Seq<T> *)

type namespace_other

type t_Namespace = Other namespace_other

use seq.Seq

type t_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Seq.seq t_T

function concat_empty_T (self: Seq.seq t_T) : ()

goal vc_concat_empty_T:
  [@stop_split] [@expl:concat_empty_T ensures] ([@stop_split] [@expl:concat_empty ensures #0] Seq.(++) self (Seq.empty: Seq.seq t_T)
    = self)
  /\ ([@stop_split] [@expl:concat_empty ensures #1] Seq.(++) (Seq.empty: Seq.seq t_T) self = self)
