(* logic::seq::Seq<T> *)

type namespace_other

type t_Namespace = Other namespace_other

use seq.Seq

type t_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Seq.seq t_T

constant other1 : Seq.seq t_T

constant other2 : Seq.seq t_T

function concat_assoc_T (self: Seq.seq t_T) (other1: Seq.seq t_T) (other2: Seq.seq t_T) : ()

goal vc_concat_assoc_T: [@stop_split] [@expl:concat_assoc ensures] Seq.(++) (Seq.(++) self other1) other2
  = Seq.(++) self (Seq.(++) other1 other2)
