(* <logic::seq::Iter<T> as std::iter::Iterator> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.MutBorrow
use seq.Seq
use int.Int

type t_T

type t_Iter_T = { f0: Seq.seq t_T }

predicate inv_T (_1: t_T)

predicate invariant_ref_T [@inline:trivial] (self: t_T) = inv_T self

meta "rewrite_def" predicate invariant_ref_T

predicate inv_ref_T [@inline:trivial] (_1: t_T) = invariant_ref_T _1

meta "rewrite_def" predicate inv_ref_T

predicate invariant_Seq_T [@inline:trivial] (self: Seq.seq t_T) =
  forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_T (Seq.get self i)

meta "rewrite_def" predicate invariant_Seq_T

predicate inv_Seq_T [@inline:trivial] (_1: Seq.seq t_T) = invariant_Seq_T _1

meta "rewrite_def" predicate inv_Seq_T

predicate inv_Iter_T (_1: t_Iter_T)

axiom inv_axiom [@rewrite]: forall x: t_Iter_T [inv_Iter_T x]. inv_Iter_T x = inv_Seq_T x.f0

predicate invariant_refmut_Iter_T [@inline:trivial] (self: MutBorrow.t t_Iter_T) =
  inv_Iter_T self.current /\ inv_Iter_T self.final

meta "rewrite_def" predicate invariant_refmut_Iter_T

predicate inv_refmut_Iter_T [@inline:trivial] (_1: MutBorrow.t t_Iter_T) = invariant_refmut_Iter_T _1

meta "rewrite_def" predicate inv_refmut_Iter_T

type t_Option_T = None | Some t_T

predicate inv_Option_T (_1: t_Option_T)

axiom inv_axiom'0 [@rewrite]: forall x: t_Option_T [inv_Option_T x]. inv_Option_T x
    = match x with
      | None -> true
      | Some f0'0 -> inv_T f0'0
      end

function view_Iter_T (self: t_Iter_T) : Seq.seq t_T = self.f0

predicate produces_Iter_T [@inline:trivial] (self: t_Iter_T) (visited: Seq.seq t_T) (o: t_Iter_T) =
  view_Iter_T self = Seq.(++) visited (view_Iter_T o)

meta "rewrite_def" predicate produces_Iter_T

function produces_trans_Iter_T (a: t_Iter_T) (ab: Seq.seq t_T) (b: t_Iter_T) (bc: Seq.seq t_T) (c: t_Iter_T) : () = ()

axiom produces_trans_Iter_T_spec:
  forall a: t_Iter_T, ab: Seq.seq t_T, b: t_Iter_T, bc: Seq.seq t_T, c: t_Iter_T. produces_Iter_T a ab b
    -> produces_Iter_T b bc c -> produces_Iter_T a (Seq.(++) ab bc) c

function produces_refl_Iter_T (self: t_Iter_T) : () = ()

axiom produces_refl_Iter_T_spec: forall self: t_Iter_T. produces_Iter_T self (Seq.empty: Seq.seq t_T) self

predicate completed_Iter_T [@inline:trivial] (self: MutBorrow.t t_Iter_T) =
  view_Iter_T self.current = (Seq.empty: Seq.seq t_T)

meta "rewrite_def" predicate completed_Iter_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self_: MutBorrow.t t_Iter_T. inv_refmut_Iter_T self_
    -> inv_refmut_Iter_T self_
    /\ (forall result: t_Option_T. inv_Option_T result
        /\ match result with
          | None -> completed_Iter_T self_
          | Some v -> produces_Iter_T self_.current (Seq.singleton v) self_.final
          end
      -> inv_Option_T result
      /\ match result with
        | None -> completed_Iter_T self_
        | Some v -> produces_Iter_T self_.current (Seq.singleton v) self_.final
        end)
