(* <i8 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall x: Int8.t, y: Int8.t, z: Int8.t. Int8.lt x y
    -> Int8.lt y z -> Int8.lt x y /\ Int8.lt y z /\ (forall result: (). Int8.lt x z -> Int8.lt x z)
