(* <i8 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : Int8.t

constant y : Int8.t

constant z : Int8.t

function transitive_i8 (x: Int8.t) (y: Int8.t) (z: Int8.t) : ()

goal vc_transitive_i8: Int8.lt x y -> Int8.lt y z -> ([@stop_split] [@expl:transitive ensures] Int8.lt x z)
