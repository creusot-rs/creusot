(* <i16 as logic::ord::OrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int16

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Int16.t

constant other : Int16.t

function lt_log_total_i16 (self: Int16.t) (other: Int16.t) : ()

goal vc_lt_log_total_i16: [@stop_split] [@expl:lt_log_total ensures] Int16.lt self other
  \/ self = other \/ Int16.lt other self
