(* <u32 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt32

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : UInt32.t

constant y : UInt32.t

constant z : UInt32.t

function transitive_u32 (x: UInt32.t) (y: UInt32.t) (z: UInt32.t) : ()

goal vc_transitive_u32: UInt32.lt x y -> UInt32.lt y z -> ([@stop_split] [@expl:transitive ensures] UInt32.lt x z)
