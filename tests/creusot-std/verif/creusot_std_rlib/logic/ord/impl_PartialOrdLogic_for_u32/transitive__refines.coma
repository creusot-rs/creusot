(* <u32 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt32

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall x: UInt32.t, y: UInt32.t, z: UInt32.t. UInt32.lt x y
    -> UInt32.lt y z -> UInt32.lt x y /\ UInt32.lt y z /\ (forall result: (). UInt32.lt x z -> UInt32.lt x z)
