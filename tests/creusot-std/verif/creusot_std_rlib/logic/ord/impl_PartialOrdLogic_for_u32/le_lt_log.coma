(* <u32 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt32

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : UInt32.t

constant other : UInt32.t

function le_lt_log_u32 (self: UInt32.t) (other: UInt32.t) : ()

goal vc_le_lt_log_u32: [@stop_split] [@expl:le_lt_log ensures] UInt32.le self other
  = (UInt32.lt self other \/ self = other)
