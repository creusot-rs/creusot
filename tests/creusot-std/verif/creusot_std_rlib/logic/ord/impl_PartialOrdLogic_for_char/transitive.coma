(* <char as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Char

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : Char.t

constant y : Char.t

constant z : Char.t

function transitive_char (x: Char.t) (y: Char.t) (z: Char.t) : ()

goal vc_transitive_char: Char.lt x y -> Char.lt y z -> ([@stop_split] [@expl:transitive ensures] Char.lt x z)
