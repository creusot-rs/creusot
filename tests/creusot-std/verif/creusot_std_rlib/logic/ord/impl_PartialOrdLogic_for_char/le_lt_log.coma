(* <char as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Char

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Char.t

constant other : Char.t

function le_lt_log_char (self: Char.t) (other: Char.t) : ()

goal vc_le_lt_log_char: [@stop_split] [@expl:le_lt_log ensures] Char.le self other
  = (Char.lt self other \/ self = other)
