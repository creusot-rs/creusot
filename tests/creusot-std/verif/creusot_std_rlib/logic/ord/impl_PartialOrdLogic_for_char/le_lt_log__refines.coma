(* <char as logic::ord::PartialOrdLogic> *)

use creusot.prelude.Char

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: Char.t, other: Char.t. forall result: (). Char.le self other
        = (Char.lt self other \/ self = other) -> Char.le self other = (Char.lt self other \/ self = other)
