(* <i32 as logic::ord::OrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int32

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Int32.t

constant other : Int32.t

function lt_log_total_i32 (self: Int32.t) (other: Int32.t) : ()

goal vc_lt_log_total_i32: [@stop_split] [@expl:lt_log_total ensures] Int32.lt self other
  \/ self = other \/ Int32.lt other self
