(* <u16 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt16

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : UInt16.t

constant other : UInt16.t

function le_lt_log_u16 (self: UInt16.t) (other: UInt16.t) : ()

goal vc_le_lt_log_u16: [@stop_split] [@expl:le_lt_log ensures] UInt16.le self other
  = (UInt16.lt self other \/ self = other)
