(* <u16 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt16

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall x: UInt16.t, y: UInt16.t, z: UInt16.t. UInt16.lt x y
    -> UInt16.lt y z -> UInt16.lt x y /\ UInt16.lt y z /\ (forall result: (). UInt16.lt x z -> UInt16.lt x z)
