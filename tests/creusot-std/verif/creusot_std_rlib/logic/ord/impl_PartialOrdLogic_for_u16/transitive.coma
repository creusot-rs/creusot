(* <u16 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt16

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : UInt16.t

constant y : UInt16.t

constant z : UInt16.t

function transitive_u16 (x: UInt16.t) (y: UInt16.t) (z: UInt16.t) : ()

goal vc_transitive_u16: UInt16.lt x y -> UInt16.lt y z -> ([@stop_split] [@expl:transitive ensures] UInt16.lt x z)
