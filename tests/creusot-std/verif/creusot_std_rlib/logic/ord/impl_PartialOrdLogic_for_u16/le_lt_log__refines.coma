(* <u16 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt16

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: UInt16.t, other: UInt16.t. forall result: (). UInt16.le self other
        = (UInt16.lt self other \/ self = other) -> UInt16.le self other = (UInt16.lt self other \/ self = other)
