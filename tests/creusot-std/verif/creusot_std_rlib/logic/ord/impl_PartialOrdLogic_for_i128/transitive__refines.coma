(* <i128 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int128

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall x: Int128.t, y: Int128.t, z: Int128.t. Int128.lt x y
    -> Int128.lt y z -> Int128.lt x y /\ Int128.lt y z /\ (forall result: (). Int128.lt x z -> Int128.lt x z)
