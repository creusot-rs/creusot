(* <i128 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int128

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Int128.t

constant other : Int128.t

function le_lt_log_i128 (self: Int128.t) (other: Int128.t) : ()

goal vc_le_lt_log_i128: [@stop_split] [@expl:le_lt_log ensures] Int128.le self other
  = (Int128.lt self other \/ self = other)
