(* <i128 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int128

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : Int128.t

constant y : Int128.t

constant z : Int128.t

function transitive_i128 (x: Int128.t) (y: Int128.t) (z: Int128.t) : ()

goal vc_transitive_i128: Int128.lt x y -> Int128.lt y z -> ([@stop_split] [@expl:transitive ensures] Int128.lt x z)
