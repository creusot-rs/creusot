(* <i8 as logic::ord::OrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Int8.t

constant other : Int8.t

function lt_log_total_i8 (self: Int8.t) (other: Int8.t) : ()

goal vc_lt_log_total_i8: [@stop_split] [@expl:lt_log_total ensures] Int8.lt self other
  \/ self = other \/ Int8.lt other self
