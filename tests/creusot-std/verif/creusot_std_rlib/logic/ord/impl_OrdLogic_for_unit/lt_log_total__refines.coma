(* <() as logic::ord::OrdLogic> *)

predicate lt_log_unit [@inline:trivial] (self: ()) (_2: ()) = false

meta "rewrite_def" predicate lt_log_unit

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: (), other: (). forall result: (). lt_log_unit self other
        \/ self = other \/ lt_log_unit other self -> lt_log_unit self other \/ self = other \/ lt_log_unit other self
