(* <() as logic::ord::OrdLogic> *)

predicate lt_log_unit [@inline:trivial] (self: ()) (_2: ()) = false

meta "rewrite_def" predicate lt_log_unit

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : ()

constant other : ()

function lt_log_total_unit (self: ()) (other: ()) : ()

goal vc_lt_log_total_unit: [@stop_split] [@expl:lt_log_total ensures] lt_log_unit self other
  \/ self = other \/ lt_log_unit other self
