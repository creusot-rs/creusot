(* <bool as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Bool

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall x: bool, y: bool, z: bool. Bool.lt x y
    -> Bool.lt y z -> Bool.lt x y /\ Bool.lt y z /\ (forall result: (). Bool.lt x z -> Bool.lt x z)
