(* <bool as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Bool

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : bool

constant other : bool

function le_lt_log_bool (self: bool) (other: bool) : ()

goal vc_le_lt_log_bool: [@stop_split] [@expl:le_lt_log ensures] Bool.le self other
  = (Bool.lt self other \/ self = other)
