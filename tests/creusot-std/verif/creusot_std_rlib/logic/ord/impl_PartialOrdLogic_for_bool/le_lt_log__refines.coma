(* <bool as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Bool

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: bool, other: bool. forall result: (). Bool.le self other
        = (Bool.lt self other \/ self = other) -> Bool.le self other = (Bool.lt self other \/ self = other)
