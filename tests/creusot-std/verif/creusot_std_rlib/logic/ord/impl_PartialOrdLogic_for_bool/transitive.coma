(* <bool as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Bool

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : bool

constant y : bool

constant z : bool

function transitive_bool (x: bool) (y: bool) (z: bool) : ()

goal vc_transitive_bool: Bool.lt x y -> Bool.lt y z -> ([@stop_split] [@expl:transitive ensures] Bool.lt x z)
