(* <i64 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Int64.t

constant other : Int64.t

function le_lt_log_i64 (self: Int64.t) (other: Int64.t) : ()

goal vc_le_lt_log_i64: [@stop_split] [@expl:le_lt_log ensures] Int64.le self other
  = (Int64.lt self other \/ self = other)
