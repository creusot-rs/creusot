(* <i64 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: Int64.t, other: Int64.t. forall result: (). Int64.le self other
        = (Int64.lt self other \/ self = other) -> Int64.le self other = (Int64.lt self other \/ self = other)
