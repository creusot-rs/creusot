(* <i64 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall x: Int64.t, y: Int64.t, z: Int64.t. Int64.lt x y
    -> Int64.lt y z -> Int64.lt x y /\ Int64.lt y z /\ (forall result: (). Int64.lt x z -> Int64.lt x z)
