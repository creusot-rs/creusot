(* <u8 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : UInt8.t

constant y : UInt8.t

constant z : UInt8.t

function transitive_u8 (x: UInt8.t) (y: UInt8.t) (z: UInt8.t) : ()

goal vc_transitive_u8: UInt8.lt x y -> UInt8.lt y z -> ([@stop_split] [@expl:transitive ensures] UInt8.lt x z)
