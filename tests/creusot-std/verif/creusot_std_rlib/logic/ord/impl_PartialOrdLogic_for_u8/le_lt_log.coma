(* <u8 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : UInt8.t

constant other : UInt8.t

function le_lt_log_u8 (self: UInt8.t) (other: UInt8.t) : ()

goal vc_le_lt_log_u8: [@stop_split] [@expl:le_lt_log ensures] UInt8.le self other
  = (UInt8.lt self other \/ self = other)
