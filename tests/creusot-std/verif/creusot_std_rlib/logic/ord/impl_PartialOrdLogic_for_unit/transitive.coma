(* <() as logic::ord::PartialOrdLogic> *)

predicate lt_log_unit [@inline:trivial] (self: ()) (_2: ()) = false

meta "rewrite_def" predicate lt_log_unit

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : ()

constant y : ()

constant z : ()

function transitive_unit (x: ()) (y: ()) (z: ()) : ()

goal vc_transitive_unit: lt_log_unit x y
  -> lt_log_unit y z -> ([@stop_split] [@expl:transitive ensures] lt_log_unit x z)
