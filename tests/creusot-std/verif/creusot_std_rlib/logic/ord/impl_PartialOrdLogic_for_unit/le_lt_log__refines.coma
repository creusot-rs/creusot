(* <() as logic::ord::PartialOrdLogic> *)

predicate le_log_unit [@inline:trivial] (self: ()) (_2: ()) = true

meta "rewrite_def" predicate le_log_unit

predicate lt_log_unit [@inline:trivial] (self: ()) (_2: ()) = false

meta "rewrite_def" predicate lt_log_unit

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: (), other: (). forall result: (). le_log_unit self other
        = (lt_log_unit self other \/ self = other) -> le_log_unit self other = (lt_log_unit self other \/ self = other)
