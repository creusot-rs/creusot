(* <() as logic::ord::PartialOrdLogic> *)

predicate lt_log_unit [@inline:trivial] (self: ()) (_2: ()) = false

meta "rewrite_def" predicate lt_log_unit

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : ()

function irreflexive_unit (self: ()) : ()

goal vc_irreflexive_unit: [@stop_split] [@expl:irreflexive ensures] not lt_log_unit self self
