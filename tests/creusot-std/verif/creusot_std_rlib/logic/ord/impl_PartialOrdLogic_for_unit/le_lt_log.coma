(* <() as logic::ord::PartialOrdLogic> *)

predicate le_log_unit [@inline:trivial] (self: ()) (_2: ()) = true

meta "rewrite_def" predicate le_log_unit

predicate lt_log_unit [@inline:trivial] (self: ()) (_2: ()) = false

meta "rewrite_def" predicate lt_log_unit

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : ()

constant other : ()

function le_lt_log_unit (self: ()) (other: ()) : ()

goal vc_le_lt_log_unit: [@stop_split] [@expl:le_lt_log ensures] le_log_unit self other
  = (lt_log_unit self other \/ self = other)
