(* <() as logic::ord::PartialOrdLogic> *)

predicate lt_log_unit [@inline:trivial] (self: ()) (_2: ()) = false

meta "rewrite_def" predicate lt_log_unit

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall x: (), y: (), z: (). lt_log_unit x y
    -> lt_log_unit y z -> lt_log_unit x y /\ lt_log_unit y z /\ (forall result: (). lt_log_unit x z -> lt_log_unit x z)
