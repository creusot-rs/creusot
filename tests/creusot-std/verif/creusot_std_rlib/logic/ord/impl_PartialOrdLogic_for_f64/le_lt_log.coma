(* <f64 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.float.Float64

predicate le_log_f64 [@inline:trivial] (self: Float64.t) (other: Float64.t) = Float64.lt self other \/ self = other

meta "rewrite_def" predicate le_log_f64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Float64.t

constant other : Float64.t

function le_lt_log_f64 (self: Float64.t) (other: Float64.t) : ()

goal vc_le_lt_log_f64: [@stop_split] [@expl:le_lt_log ensures] le_log_f64 self other
  = (Float64.lt self other \/ self = other)
