(* <f64 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.float.Float64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall x: Float64.t, y: Float64.t, z: Float64.t. Float64.lt x y
    -> Float64.lt y z -> Float64.lt x y /\ Float64.lt y z /\ (forall result: (). Float64.lt x z -> Float64.lt x z)
