(* <f64 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.float.Float64

predicate le_log_f64 [@inline:trivial] (self: Float64.t) (other: Float64.t) = Float64.lt self other \/ self = other

meta "rewrite_def" predicate le_log_f64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: Float64.t, other: Float64.t. forall result: (). le_log_f64 self other
        = (Float64.lt self other \/ self = other) -> le_log_f64 self other = (Float64.lt self other \/ self = other)
