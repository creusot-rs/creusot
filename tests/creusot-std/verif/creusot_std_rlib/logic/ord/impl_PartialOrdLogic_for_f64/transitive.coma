(* <f64 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.float.Float64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : Float64.t

constant y : Float64.t

constant z : Float64.t

function transitive_f64 (x: Float64.t) (y: Float64.t) (z: Float64.t) : ()

goal vc_transitive_f64: Float64.lt x y -> Float64.lt y z -> ([@stop_split] [@expl:transitive ensures] Float64.lt x z)
