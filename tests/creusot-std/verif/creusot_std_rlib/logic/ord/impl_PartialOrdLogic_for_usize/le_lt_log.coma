(* <usize as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : UInt64.t

constant other : UInt64.t

function le_lt_log_usize (self: UInt64.t) (other: UInt64.t) : ()

goal vc_le_lt_log_usize: [@stop_split] [@expl:le_lt_log ensures] UInt64.le self other
  = (UInt64.lt self other \/ self = other)
