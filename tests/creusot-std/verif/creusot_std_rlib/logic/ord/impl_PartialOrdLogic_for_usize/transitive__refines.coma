(* <usize as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall x: UInt64.t, y: UInt64.t, z: UInt64.t. UInt64.lt x y
    -> UInt64.lt y z -> UInt64.lt x y /\ UInt64.lt y z /\ (forall result: (). UInt64.lt x z -> UInt64.lt x z)
