(* <usize as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: UInt64.t, other: UInt64.t. forall result: (). UInt64.le self other
        = (UInt64.lt self other \/ self = other) -> UInt64.le self other = (UInt64.lt self other \/ self = other)
