(* <logic::int::Int as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use int.Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : int

constant y : int

constant z : int

function transitive_Int (x: int) (y: int) (z: int) : ()

goal vc_transitive_Int: x < y -> y < z -> ([@stop_split] [@expl:transitive ensures] x < z)
