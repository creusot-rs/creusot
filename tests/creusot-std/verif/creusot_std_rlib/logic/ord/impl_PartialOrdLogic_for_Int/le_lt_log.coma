(* <logic::int::Int as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use int.Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : int

constant other : int

function le_lt_log_Int (self: int) (other: int) : ()

goal vc_le_lt_log_Int: [@stop_split] [@expl:le_lt_log ensures] (self <= other) = (self < other \/ self = other)
