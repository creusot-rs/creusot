(* <T as logic::ord::SemiLattice> *)

type namespace_other

type t_Namespace = Other namespace_other

type t_T

predicate lt_log_T (self: t_T) (other: t_T)

predicate le_log_T (self: t_T) (other: t_T)

function le_lt_log_T (self: t_T) (other: t_T) : ()

axiom le_lt_log_T_spec: forall self: t_T, other: t_T. le_log_T self other = (lt_log_T self other \/ self = other)

function transitive_T (x: t_T) (y: t_T) (z: t_T) : ()

axiom transitive_T_spec: forall x: t_T, y: t_T, z: t_T. lt_log_T x y -> lt_log_T y z -> lt_log_T x z

function irreflexive_T (self: t_T) : ()

axiom irreflexive_T_spec: forall self: t_T. not lt_log_T self self

function lt_log_total_T (self: t_T) (other: t_T) : ()

axiom lt_log_total_T_spec: forall self: t_T, other: t_T. lt_log_T self other \/ self = other \/ lt_log_T other self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_T

constant other : t_T

function join_T (self: t_T) (other: t_T) : t_T

goal vc_join_T: if lt_log_T self other then
    let result = other in [@stop_split] [@expl:join_T ensures] ([@stop_split] [@expl:join ensures #0] le_log_T self result)
    /\ ([@stop_split] [@expl:join ensures #1] le_log_T other result)
    /\ ([@stop_split] [@expl:join ensures #2] forall r: t_T. le_log_T self r -> le_log_T other r -> le_log_T result r)
  else
    let result = self in [@stop_split] [@expl:join_T ensures] ([@stop_split] [@expl:join ensures #0] le_log_T self result)
    /\ ([@stop_split] [@expl:join ensures #1] le_log_T other result)
    /\ ([@stop_split] [@expl:join ensures #2] forall r: t_T. le_log_T self r -> le_log_T other r -> le_log_T result r)
  
