(* <f32 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.float.Float32

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : Float32.t

constant y : Float32.t

constant z : Float32.t

function transitive_f32 (x: Float32.t) (y: Float32.t) (z: Float32.t) : ()

goal vc_transitive_f32: Float32.lt x y -> Float32.lt y z -> ([@stop_split] [@expl:transitive ensures] Float32.lt x z)
