(* <f32 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.float.Float32

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall x: Float32.t, y: Float32.t, z: Float32.t. Float32.lt x y
    -> Float32.lt y z -> Float32.lt x y /\ Float32.lt y z /\ (forall result: (). Float32.lt x z -> Float32.lt x z)
