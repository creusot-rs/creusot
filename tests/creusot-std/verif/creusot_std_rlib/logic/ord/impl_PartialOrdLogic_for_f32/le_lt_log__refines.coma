(* <f32 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.float.Float32

predicate le_log_f32 [@inline:trivial] (self: Float32.t) (other: Float32.t) = Float32.lt self other \/ self = other

meta "rewrite_def" predicate le_log_f32

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: Float32.t, other: Float32.t. forall result: (). le_log_f32 self other
        = (Float32.lt self other \/ self = other) -> le_log_f32 self other = (Float32.lt self other \/ self = other)
