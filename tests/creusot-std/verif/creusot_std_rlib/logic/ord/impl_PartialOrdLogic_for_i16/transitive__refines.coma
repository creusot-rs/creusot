(* <i16 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int16

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall x: Int16.t, y: Int16.t, z: Int16.t. Int16.lt x y
    -> Int16.lt y z -> Int16.lt x y /\ Int16.lt y z /\ (forall result: (). Int16.lt x z -> Int16.lt x z)
