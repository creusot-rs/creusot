(* <i16 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int16

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Int16.t

constant other : Int16.t

function le_lt_log_i16 (self: Int16.t) (other: Int16.t) : ()

goal vc_le_lt_log_i16: [@stop_split] [@expl:le_lt_log ensures] Int16.le self other
  = (Int16.lt self other \/ self = other)
