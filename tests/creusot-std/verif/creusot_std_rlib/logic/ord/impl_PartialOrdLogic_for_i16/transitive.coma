(* <i16 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int16

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : Int16.t

constant y : Int16.t

constant z : Int16.t

function transitive_i16 (x: Int16.t) (y: Int16.t) (z: Int16.t) : ()

goal vc_transitive_i16: Int16.lt x y -> Int16.lt y z -> ([@stop_split] [@expl:transitive ensures] Int16.lt x z)
