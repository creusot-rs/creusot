(* <i128 as logic::ord::OrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int128

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: Int128.t, other: Int128.t. forall result: (). Int128.lt self other
        \/ self = other \/ Int128.lt other self -> Int128.lt self other \/ self = other \/ Int128.lt other self
