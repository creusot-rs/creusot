(* <i128 as logic::ord::OrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int128

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Int128.t

constant other : Int128.t

function lt_log_total_i128 (self: Int128.t) (other: Int128.t) : ()

goal vc_lt_log_total_i128: [@stop_split] [@expl:lt_log_total ensures] Int128.lt self other
  \/ self = other \/ Int128.lt other self
