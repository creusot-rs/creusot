(* <u64 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : UInt64.t

constant y : UInt64.t

constant z : UInt64.t

function transitive_u64 (x: UInt64.t) (y: UInt64.t) (z: UInt64.t) : ()

goal vc_transitive_u64: UInt64.lt x y -> UInt64.lt y z -> ([@stop_split] [@expl:transitive ensures] UInt64.lt x z)
