(* <u128 as logic::ord::OrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt128

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: UInt128.t, other: UInt128.t. forall result: (). UInt128.lt self other
        \/ self = other \/ UInt128.lt other self -> UInt128.lt self other \/ self = other \/ UInt128.lt other self
