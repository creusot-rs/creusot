(* <u128 as logic::ord::OrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt128

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : UInt128.t

constant other : UInt128.t

function lt_log_total_u128 (self: UInt128.t) (other: UInt128.t) : ()

goal vc_lt_log_total_u128: [@stop_split] [@expl:lt_log_total ensures] UInt128.lt self other
  \/ self = other \/ UInt128.lt other self
