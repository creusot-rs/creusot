(* <usize as logic::ord::OrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : UInt64.t

constant other : UInt64.t

function lt_log_total_usize (self: UInt64.t) (other: UInt64.t) : ()

goal vc_lt_log_total_usize: [@stop_split] [@expl:lt_log_total ensures] UInt64.lt self other
  \/ self = other \/ UInt64.lt other self
