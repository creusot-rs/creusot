(* <u128 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt128

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall x: UInt128.t, y: UInt128.t, z: UInt128.t. UInt128.lt x y
    -> UInt128.lt y z -> UInt128.lt x y /\ UInt128.lt y z /\ (forall result: (). UInt128.lt x z -> UInt128.lt x z)
