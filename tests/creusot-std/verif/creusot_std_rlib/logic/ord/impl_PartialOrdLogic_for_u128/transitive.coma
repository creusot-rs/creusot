(* <u128 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt128

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : UInt128.t

constant y : UInt128.t

constant z : UInt128.t

function transitive_u128 (x: UInt128.t) (y: UInt128.t) (z: UInt128.t) : ()

goal vc_transitive_u128: UInt128.lt x y -> UInt128.lt y z -> ([@stop_split] [@expl:transitive ensures] UInt128.lt x z)
