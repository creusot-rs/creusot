(* <u128 as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt128

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : UInt128.t

constant other : UInt128.t

function le_lt_log_u128 (self: UInt128.t) (other: UInt128.t) : ()

goal vc_le_lt_log_u128: [@stop_split] [@expl:le_lt_log ensures] UInt128.le self other
  = (UInt128.lt self other \/ self = other)
