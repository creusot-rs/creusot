(* logic::seq::Seq<T> *)

use seq.Seq
use map.Map
use int.Int

type t_T

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

predicate index_Mapping_Int_bool [@inline:trivial] (self: Map.map int bool) (a: int) = Map.get self a

meta "rewrite_def" predicate index_Mapping_Int_bool

function card (a: int) (b: int) (p: Map.map int bool) : int

axiom card_def: forall a: int, b: int, p: Map.map int bool [card a b p]. a <= b
    -> card a b p
    = (if ge_log_Int a b then 0 else card a (b - 1) p + (if index_Mapping_Int_bool p (b - 1) then 1 else 0))

axiom card_spec: forall a: int, b: int, p: Map.map int bool [card a b p]. a <= b
    -> 0 <= card a b p /\ card a b p <= b - a

function count_T (self: Seq.seq t_T) (a: int) (b: int) (t: t_T) : int = card a b (fun (i: int) -> Seq.get self i = t)

axiom count_T_spec: forall self: Seq.seq t_T, a: int, b: int, t: t_T [count_T self a b t]. a <= b
    -> 0 <= count_T self a b t /\ count_T self a b t <= b - a

function card_join (a: int) (b: int) (c: int) (p: Map.map int bool) : ()

axiom card_join_spec: forall a: int, b: int, c: int, p: Map.map int bool. a <= b /\ b <= c
    -> card a c p = card a b p + card b c p

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Seq.seq t_T

constant a : int

constant b : int

constant c : int

constant t : t_T

function count_join_T (self: Seq.seq t_T) (a: int) (b: int) (c: int) (t: t_T) : ()

goal vc_count_join_T: a <= b /\ b <= c
  -> (forall f: Map.map int bool. (forall i: int. (Seq.get self i = t) = f i)
    -> ([@stop_split] [@expl:card_join requires] a <= b /\ b <= c)
    /\ (([@stop_split] [@expl:card_join ensures] card a c f = card a b f + card b c f)
    -> ([@stop_split] [@expl:count_join ensures] count_T self a c t = count_T self a b t + count_T self b c t)))
