use seq.Seq
use map.Map
use int.Int

predicate contains_Int (self: Seq.seq int) (x: int) = exists i: int. 0 <= i /\ i < Seq.length self /\ Seq.get self i = x

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

predicate index_Mapping_Int_bool [@inline:trivial] (self: Map.map int bool) (a: int) = Map.get self a

meta "rewrite_def" predicate index_Mapping_Int_bool

function card (a: int) (b: int) (p: Map.map int bool) : int

axiom card_def: forall a: int, b: int, p: Map.map int bool [card a b p]. a <= b
    -> card a b p
    = (if ge_log_Int a b then 0 else card a (b - 1) p + (if index_Mapping_Int_bool p (b - 1) then 1 else 0))

axiom card_spec: forall a: int, b: int, p: Map.map int bool [card a b p]. a <= b
    -> 0 <= card a b p /\ card a b p <= b - a

function surj_aux (s: Seq.seq int) (a: int) (j: int) : ()

axiom surj_aux_spec: forall s: Seq.seq int, a: int, j: int. a <= j
    -> (forall k: int. a <= k /\ k < j -> contains_Int s k)
    -> ge_log_Int (card 0 (Seq.length s) (fun (i: int) -> a <= Seq.get s i /\ Seq.get s i < j)) (j - a)

function card_disjoint (a: int) (b: int) (p1: Map.map int bool) (p2: Map.map int bool) (p: Map.map int bool) : ()

axiom card_disjoint_spec: forall a: int, b: int, p1: Map.map int bool, p2: Map.map int bool, p: Map.map int bool. a <= b
    -> (forall i: int. a <= i /\ i < b -> not (index_Mapping_Int_bool p1 i /\ index_Mapping_Int_bool p2 i))
    -> (forall i: int. a <= i /\ i < b
        -> index_Mapping_Int_bool p i = (index_Mapping_Int_bool p1 i \/ index_Mapping_Int_bool p2 i))
    -> card a b p = card a b p1 + card a b p2

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq int

constant n : int

constant k : int

function surj_aux_ne (s: Seq.seq int) (n: int) (k: int) : ()

goal vc_surj_aux_ne: (forall i: int. 0 <= i /\ i < Seq.length s -> 0 <= Seq.get s i /\ Seq.get s i < n)
  -> (forall j: int. 0 <= j /\ j < n -> contains_Int s j)
  -> 0 <= k /\ k < n
  -> ([@stop_split] [@expl:surj_aux requires] ([@stop_split] [@expl:surj_aux requires #0] 0 <= k)
    /\ ([@stop_split] [@expl:surj_aux requires #1] forall k'0: int. 0 <= k'0 /\ k'0 < k -> contains_Int s k'0))
  /\ (([@stop_split] [@expl:surj_aux ensures] ge_log_Int (card 0 (Seq.length s) (fun (i: int) -> 0 <= Seq.get s i
    /\ Seq.get s i < k)) (k - 0))
  -> ([@stop_split] [@expl:surj_aux requires] ([@stop_split] [@expl:surj_aux requires #0] k + 1 <= n)
    /\ ([@stop_split] [@expl:surj_aux requires #1] forall k'0: int. k + 1 <= k'0 /\ k'0 < n -> contains_Int s k'0))
  /\ (([@stop_split] [@expl:surj_aux ensures] ge_log_Int (card 0 (Seq.length s) (fun (i: int) -> k + 1 <= Seq.get s i
    /\ Seq.get s i < n)) (n - (k + 1)))
  -> (forall f: Map.map int bool. (forall i: int. if 0 <= Seq.get s i then (Seq.get s i < k) = f i else false = f i)
    -> (forall f'0: Map.map int bool. (forall i: int. if k + 1 <= Seq.get s i then
            (Seq.get s i < n) = f'0 i
          else
            false = f'0 i
        )
      -> (forall f'1: Map.map int bool. (forall i: int. (Seq.get s i <> k) = f'1 i)
        -> ([@stop_split] [@expl:card_disjoint requires] ([@stop_split] [@expl:card_disjoint requires #0] 0
            <= Seq.length s)
          /\ ([@stop_split] [@expl:card_disjoint requires #1] forall i: int. 0 <= i /\ i < Seq.length s
              -> not (index_Mapping_Int_bool f i /\ index_Mapping_Int_bool f'0 i))
          /\ ([@stop_split] [@expl:card_disjoint requires #2] forall i: int. 0 <= i /\ i < Seq.length s
            -> index_Mapping_Int_bool f'1 i = (index_Mapping_Int_bool f i \/ index_Mapping_Int_bool f'0 i)))
        /\ (([@stop_split] [@expl:card_disjoint ensures] card 0 (Seq.length s) f'1
          = card 0 (Seq.length s) f + card 0 (Seq.length s) f'0)
        -> ([@stop_split] [@expl:surj_aux_ne ensures] ge_log_Int (card 0 (Seq.length s) (fun (i: int) -> Seq.get s i
        <> k)) (n - 1))))))))
