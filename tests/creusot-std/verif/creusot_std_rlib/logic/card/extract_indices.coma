use seq.Seq
use map.Map
use int.Int

type t_T

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

predicate index_Mapping_Int_bool [@inline:trivial] (self: Map.map int bool) (a: int) = Map.get self a

meta "rewrite_def" predicate index_Mapping_Int_bool

function card (a: int) (b: int) (p: Map.map int bool) : int

axiom card_def: forall a: int, b: int, p: Map.map int bool [card a b p]. a <= b
    -> card a b p
    = (if ge_log_Int a b then 0 else card a (b - 1) p + (if index_Mapping_Int_bool p (b - 1) then 1 else 0))

axiom card_spec: forall a: int, b: int, p: Map.map int bool [card a b p]. a <= b
    -> 0 <= card a b p /\ card a b p <= b - a

function count_T (self: Seq.seq t_T) (a: int) (b: int) (t: t_T) : int = card a b (fun (i: int) -> Seq.get self i = t)

axiom count_T_spec: forall self: Seq.seq t_T, a: int, b: int, t: t_T [count_T self a b t]. a <= b
    -> 0 <= count_T self a b t /\ count_T self a b t <= b - a

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq t_T

constant t : t_T

constant i : int

function extract_indices_T (s: Seq.seq t_T) (t: t_T) (i: int) : Seq.seq int

goal vc_extract_indices_T: 0 <= i /\ i <= Seq.length s
  -> (if i = 0 then
    let result = Seq.empty: Seq.seq int in [@stop_split] [@expl:extract_indices_T ensures] ([@stop_split] [@expl:extract_indices ensures #0] forall j: int. 0
            <= j
          /\ j < Seq.length result -> 0 <= Seq.get result j /\ Seq.get result j < i /\ Seq.get s (Seq.get result j) = t)
    /\ ([@stop_split] [@expl:extract_indices ensures #1] Seq.length result = count_T s 0 i t)
    /\ ([@stop_split] [@expl:extract_indices ensures #2] forall j: int, k: int. 0 <= j /\ j < k /\ k < Seq.length result
      -> Seq.get result j < Seq.get result k)
  else
    (([@stop_split] [@expl:extract_indices requires] 0 <= i - 1 /\ i - 1 <= Seq.length s)
      /\ ([@expl:variant decreases] well_founded_relation_Int i (i - 1)))
    /\ (([@stop_split] [@expl:extract_indices ensures] ([@stop_split] [@expl:extract_indices ensures #0] forall j: int. 0
              <= j
            /\ j < Seq.length (extract_indices_T s t (i - 1))
          -> 0 <= Seq.get (extract_indices_T s t (i - 1)) j
          /\ Seq.get (extract_indices_T s t (i - 1)) j < i - 1
          /\ Seq.get s (Seq.get (extract_indices_T s t (i - 1)) j) = t)
      /\ ([@stop_split] [@expl:extract_indices ensures #1] Seq.length (extract_indices_T s t (i - 1))
        = count_T s 0 (i - 1) t)
      /\ ([@stop_split] [@expl:extract_indices ensures #2] forall j: int, k: int. 0 <= j
          /\ j < k /\ k < Seq.length (extract_indices_T s t (i - 1))
        -> Seq.get (extract_indices_T s t (i - 1)) j < Seq.get (extract_indices_T s t (i - 1)) k))
    -> (let prev = extract_indices_T s t (i - 1) in if Seq.get s (i - 1) = t then
      let result = Seq.snoc prev (i
      - 1) in [@stop_split] [@expl:extract_indices_T ensures] ([@stop_split] [@expl:extract_indices ensures #0] forall j: int. 0
              <= j
            /\ j < Seq.length result
          -> 0 <= Seq.get result j /\ Seq.get result j < i /\ Seq.get s (Seq.get result j) = t)
      /\ ([@stop_split] [@expl:extract_indices ensures #1] Seq.length result = count_T s 0 i t)
      /\ ([@stop_split] [@expl:extract_indices ensures #2] forall j: int, k: int. 0 <= j
          /\ j < k /\ k < Seq.length result -> Seq.get result j < Seq.get result k)
    else
      let result = prev in [@stop_split] [@expl:extract_indices_T ensures] ([@stop_split] [@expl:extract_indices ensures #0] forall j: int. 0
              <= j
            /\ j < Seq.length result
          -> 0 <= Seq.get result j /\ Seq.get result j < i /\ Seq.get s (Seq.get result j) = t)
      /\ ([@stop_split] [@expl:extract_indices ensures #1] Seq.length result = count_T s 0 i t)
      /\ ([@stop_split] [@expl:extract_indices ensures #2] forall j: int, k: int. 0 <= j
          /\ j < k /\ k < Seq.length result -> Seq.get result j < Seq.get result k)
    ))
  )
