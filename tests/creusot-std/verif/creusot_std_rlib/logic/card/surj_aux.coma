use seq.Seq
use map.Map
use int.Int

predicate contains_Int (self: Seq.seq int) (x: int) = exists i: int. 0 <= i /\ i < Seq.length self /\ Seq.get self i = x

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

predicate index_Mapping_Int_bool [@inline:trivial] (self: Map.map int bool) (a: int) = Map.get self a

meta "rewrite_def" predicate index_Mapping_Int_bool

function card (a: int) (b: int) (p: Map.map int bool) : int

axiom card_def: forall a: int, b: int, p: Map.map int bool [card a b p]. a <= b
    -> card a b p
    = (if ge_log_Int a b then 0 else card a (b - 1) p + (if index_Mapping_Int_bool p (b - 1) then 1 else 0))

axiom card_spec: forall a: int, b: int, p: Map.map int bool [card a b p]. a <= b
    -> 0 <= card a b p /\ card a b p <= b - a

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

predicate well_founded_relation_Int [@inline:trivial] (self: int) (other: int) =
  ge_log_Int self 0 /\ gt_log_Int self other

meta "rewrite_def" predicate well_founded_relation_Int

function card_false (a: int) (b: int) (p: Map.map int bool) : ()

axiom card_false_spec: forall a: int, b: int, p: Map.map int bool. a <= b
    -> (card a b p = 0) = (forall i: int. a <= i /\ i < b -> not index_Mapping_Int_bool p i)

function card_disjoint (a: int) (b: int) (p1: Map.map int bool) (p2: Map.map int bool) (p: Map.map int bool) : ()

axiom card_disjoint_spec: forall a: int, b: int, p1: Map.map int bool, p2: Map.map int bool, p: Map.map int bool. a <= b
    -> (forall i: int. a <= i /\ i < b -> not (index_Mapping_Int_bool p1 i /\ index_Mapping_Int_bool p2 i))
    -> (forall i: int. a <= i /\ i < b
        -> index_Mapping_Int_bool p i = (index_Mapping_Int_bool p1 i \/ index_Mapping_Int_bool p2 i))
    -> card a b p = card a b p1 + card a b p2

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Seq.seq int

constant a : int

constant j : int

function surj_aux (s: Seq.seq int) (a: int) (j: int) : ()

goal vc_surj_aux: a <= j
  -> (forall k: int. a <= k /\ k < j -> contains_Int s k)
  -> (if a < j then
    (([@stop_split] [@expl:surj_aux requires] ([@stop_split] [@expl:surj_aux requires #0] a <= j - 1)
        /\ ([@stop_split] [@expl:surj_aux requires #1] forall k: int. a <= k /\ k < j - 1 -> contains_Int s k))
      /\ ([@expl:variant decreases] well_founded_relation_Int (j - a) (j - 1 - a)))
    /\ (([@stop_split] [@expl:surj_aux ensures] ge_log_Int (card 0 (Seq.length s) (fun (i: int) -> a <= Seq.get s i
      /\ Seq.get s i < j - 1)) (j - 1 - a))
    -> (exists i: int. 0 <= i /\ i < Seq.length s /\ Seq.get s i = j - 1)
    && (forall f: Map.map int bool. (forall i: int. (Seq.get s i = j - 1) = f i)
      -> ([@stop_split] [@expl:card_false requires] 0 <= Seq.length s)
      /\ (([@stop_split] [@expl:card_false ensures] (card 0 (Seq.length s) f = 0)
        = (forall i: int. 0 <= i /\ i < Seq.length s -> not index_Mapping_Int_bool f i))
      -> (forall f'0: Map.map int bool. (forall i: int. (Seq.get s i = j - 1) = f'0 i)
        -> ([@stop_split] [@expl:card requires] 0 <= Seq.length s)
        /\ (([@stop_split] [@expl:card ensures] 0 <= card 0 (Seq.length s) f'0
          /\ card 0 (Seq.length s) f'0 <= Seq.length s - 0)
        -> ge_log_Int (card 0 (Seq.length s) f'0) 1
        && (forall f'1: Map.map int bool. (forall i: int. (Seq.get s i = j - 1) = f'1 i)
          -> (forall f'2: Map.map int bool. (forall i: int. if a <= Seq.get s i then
                  (Seq.get s i < j - 1) = f'2 i
                else
                  false = f'2 i
              )
            -> (forall f'3: Map.map int bool. (forall i: int. if a <= Seq.get s i then
                    (Seq.get s i < j) = f'3 i
                  else
                    false = f'3 i
                )
              -> ([@stop_split] [@expl:card_disjoint requires] ([@stop_split] [@expl:card_disjoint requires #0] 0
                  <= Seq.length s)
                /\ ([@stop_split] [@expl:card_disjoint requires #1] forall i: int. 0 <= i /\ i < Seq.length s
                    -> not (index_Mapping_Int_bool f'1 i /\ index_Mapping_Int_bool f'2 i))
                /\ ([@stop_split] [@expl:card_disjoint requires #2] forall i: int. 0 <= i /\ i < Seq.length s
                  -> index_Mapping_Int_bool f'3 i = (index_Mapping_Int_bool f'1 i \/ index_Mapping_Int_bool f'2 i)))
              /\ (([@stop_split] [@expl:card_disjoint ensures] card 0 (Seq.length s) f'3
                = card 0 (Seq.length s) f'1 + card 0 (Seq.length s) f'2)
              -> (forall f'4: Map.map int bool. (forall i: int. if a <= Seq.get s i then
                      (Seq.get s i < j) = f'4 i
                    else
                      false = f'4 i
                  )
                -> ([@stop_split] [@expl:card requires] 0 <= Seq.length s)
                /\ (([@stop_split] [@expl:card ensures] 0 <= card 0 (Seq.length s) f'4
                  /\ card 0 (Seq.length s) f'4 <= Seq.length s - 0)
                -> (forall f'5: Map.map int bool. (forall i: int. if a <= Seq.get s i then
                        (Seq.get s i < j - 1) = f'5 i
                      else
                        false = f'5 i
                    )
                  -> ([@stop_split] [@expl:card requires] 0 <= Seq.length s)
                  /\ (([@stop_split] [@expl:card ensures] 0 <= card 0 (Seq.length s) f'5
                    /\ card 0 (Seq.length s) f'5 <= Seq.length s - 0)
                  -> (forall f'6: Map.map int bool. (forall i: int. (Seq.get s i = j - 1) = f'6 i)
                    -> ([@stop_split] [@expl:card requires] 0 <= Seq.length s)
                    /\ (([@stop_split] [@expl:card ensures] 0 <= card 0 (Seq.length s) f'6
                      /\ card 0 (Seq.length s) f'6 <= Seq.length s - 0)
                    -> card 0 (Seq.length s) f'4 = card 0 (Seq.length s) f'5 + card 0 (Seq.length s) f'6
                    && ([@stop_split] [@expl:surj_aux ensures] ge_log_Int (card 0 (Seq.length s) (fun (i: int) -> a
                      <= Seq.get s i
                    /\ Seq.get s i < j)) (j - a)))))))))))))))))
  else
    [@stop_split] [@expl:surj_aux ensures] ge_log_Int (card 0 (Seq.length s) (fun (i: int) -> a <= Seq.get s i
    /\ Seq.get s i < j)) (j - a)
  )
