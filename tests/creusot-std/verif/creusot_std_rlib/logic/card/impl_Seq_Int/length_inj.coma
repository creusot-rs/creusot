(* logic::seq::Seq<logic::int::Int> *)

use seq.Seq
use map.Map
use int.Int

predicate injective_into (self: Seq.seq int) (n: int) =
  (forall i: int. 0 <= i /\ i < Seq.length self -> 0 <= Seq.get self i /\ Seq.get self i < n)
  /\ (forall i1: int, i2: int. 0 <= i1 /\ i1 <= i2 /\ i2 < Seq.length self
    -> Seq.get self i1 = Seq.get self i2 -> i1 = i2)

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

predicate index_Mapping_Int_bool [@inline:trivial] (self: Map.map int bool) (a: int) = Map.get self a

meta "rewrite_def" predicate index_Mapping_Int_bool

function card (a: int) (b: int) (p: Map.map int bool) : int

axiom card_def: forall a: int, b: int, p: Map.map int bool [card a b p]. a <= b
    -> card a b p
    = (if ge_log_Int a b then 0 else card a (b - 1) p + (if index_Mapping_Int_bool p (b - 1) then 1 else 0))

axiom card_spec: forall a: int, b: int, p: Map.map int bool [card a b p]. a <= b
    -> 0 <= card a b p /\ card a b p <= b - a

function inj_aux (s: Seq.seq int) (n: int) (k: int) : ()

axiom inj_aux_spec: forall s: Seq.seq int, n: int, k: int. 0 <= n
    -> (forall i1: int, i2: int. 0 <= i1 /\ i1 <= i2 /\ i2 < Seq.length s -> Seq.get s i1 = Seq.get s i2 -> i1 = i2)
    -> (forall i: int. 0 <= i /\ i < Seq.length s -> 0 <= Seq.get s i /\ Seq.get s i < n)
    -> 0 <= k /\ k <= Seq.length s -> k = card 0 n (fun (j: int) -> exists i: int. 0 <= i /\ i < k /\ Seq.get s i = j)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Seq.seq int

constant n : int

function length_inj (self: Seq.seq int) (n: int) : ()

goal vc_length_inj: injective_into self n
  -> 0 <= n
  -> ([@stop_split] [@expl:inj_aux requires] ([@stop_split] [@expl:inj_aux requires #0] 0 <= n)
    /\ ([@stop_split] [@expl:inj_aux requires #1] forall i1: int, i2: int. 0 <= i1 /\ i1 <= i2 /\ i2 < Seq.length self
        -> Seq.get self i1 = Seq.get self i2 -> i1 = i2)
    /\ ([@stop_split] [@expl:inj_aux requires #2] forall i: int. 0 <= i /\ i < Seq.length self
        -> 0 <= Seq.get self i /\ Seq.get self i < n)
    /\ ([@stop_split] [@expl:inj_aux requires #3] 0 <= Seq.length self /\ Seq.length self <= Seq.length self))
  /\ (([@stop_split] [@expl:inj_aux ensures] Seq.length self
    = card 0 n (fun (j: int) -> exists i: int. 0 <= i /\ i < Seq.length self /\ Seq.get self i = j))
  -> ([@stop_split] [@expl:length_inj ensures] Seq.length self <= n))
