(* <logic::id::Id as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Mode

type t_Id

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall mode: Mode.t, snap: t_Id. forall result: t_Id. result = snap -> result = snap
