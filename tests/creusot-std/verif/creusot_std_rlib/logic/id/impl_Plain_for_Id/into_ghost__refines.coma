(* <logic::id::Id as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

type t_Id

predicate inv_Id [@inline:trivial] (_1: t_Id) = true

meta "rewrite_def" predicate inv_Id

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: t_Id. inv_Id snap -> (forall result: t_Id. result = snap -> result = snap)
