(* logic::fset::FSet<T> *)

use set.Fset
use seq.Seq
use map.Map
use int.Int

type t_T

predicate contains_Seq_T [@inline:trivial] (self: Fset.fset (Seq.seq t_T)) (e: Seq.seq t_T) = Fset.mem e self

meta "rewrite_def" predicate contains_Seq_T

predicate contains_T [@inline:trivial] (self: Fset.fset t_T) (e: t_T) = Fset.mem e self

meta "rewrite_def" predicate contains_T

type t_RangeFrom_Int = { start: int }

function index_Seq_T [@inline:trivial] (self: Seq.seq t_T) (range: t_RangeFrom_Int) : Seq.seq t_T =
  Seq.([..]) self range.start (Seq.length self)

meta "rewrite_def" function index_Seq_T

function tail_T [@inline:trivial] (self: Seq.seq t_T) : Seq.seq t_T = index_Seq_T self { start = 1 }

meta "rewrite_def" function tail_T

function cons_T [@inline:trivial] (self: Seq.seq t_T) (x: t_T) : Seq.seq t_T = Seq.cons x self

meta "rewrite_def" function cons_T

function map_Seq_T (self: Fset.fset (Seq.seq t_T)) (f: Map.map (Seq.seq t_T) (Seq.seq t_T)) : Fset.fset (Seq.seq t_T) =
  Fset.map f self

function unions_T (self: Fset.fset t_T) (f: Map.map t_T (Fset.fset (Seq.seq t_T))) : Fset.fset (Seq.seq t_T)

axiom unions_T_spec:
  forall self: Fset.fset t_T, f: Map.map t_T (Fset.fset (Seq.seq t_T)) [unions_T self f]. forall y: Seq.seq t_T [contains_Seq_T (unions_T self f) y]. contains_Seq_T (unions_T self f) y
      = (exists x: t_T. contains_T self x /\ contains_Seq_T (Map.get f x) y)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant s : Fset.fset t_T

constant ss : Fset.fset (Seq.seq t_T)

function cons_T'0 (s: Fset.fset t_T) (ss: Fset.fset (Seq.seq t_T)) : Fset.fset (Seq.seq t_T)

goal vc_cons_T: (forall x: t_T, xs: Seq.seq t_T. tail_T (cons_T xs x) = xs)
  && (forall xs: Seq.seq t_T. 0 < Seq.length xs -> cons_T (tail_T xs) (Seq.get xs 0) = xs)
  && (forall f: Map.map t_T (Fset.fset (Seq.seq t_T)). (forall x: t_T. exists f'0: Map.map (Seq.seq t_T) (Seq.seq t_T). (forall xs: Seq.seq t_T. cons_T xs x
              = f'0 xs)
          /\ map_Seq_T ss f'0 = f x)
    -> ([@stop_split] [@expl:unions ensures] forall y: Seq.seq t_T [contains_Seq_T (unions_T s f) y]. contains_Seq_T (unions_T s f) y
        = (exists x: t_T. contains_T s x /\ contains_Seq_T (Map.get f x) y))
    -> ([@stop_split] [@expl:cons ensures] forall xs: Seq.seq t_T. contains_Seq_T (unions_T s f) xs
      = (0 < Seq.length xs /\ contains_T s (Seq.get xs 0) /\ contains_Seq_T ss (tail_T xs))))
