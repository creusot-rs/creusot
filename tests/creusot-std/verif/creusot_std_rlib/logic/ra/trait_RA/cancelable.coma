type namespace_other

type t_Namespace = Other namespace_other

type t_Self

type t_Option_Self = None | Some t_Self

function op_Self (self: t_Self) (other: t_Self) : t_Option_Self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Self

predicate cancelable_Self (self: t_Self)

goal vc_cancelable_Self: [@stop_split] [@expl:cancelable ensures] (forall x: t_Self, y: t_Self. op_Self self x <> None
      -> op_Self self x = op_Self self y -> x = y)
  = (forall x: t_Self, y: t_Self. op_Self self x <> None -> op_Self self x = op_Self self y -> x = y)
