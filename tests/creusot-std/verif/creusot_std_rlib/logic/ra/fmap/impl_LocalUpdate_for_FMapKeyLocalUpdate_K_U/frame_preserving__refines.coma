predicate premise_U (self: t_U) (from_auth: t_V) (from_frag: t_V)

predicate premise_FMapKeyLocalUpdate_K_U [@inline:trivial] (self: t_FMapKeyLocalUpdate_K_U) (from_auth: t_FMap_K_V) (from_frag: t_FMap_K_V) =
  match { f0'0 = map_Option_V (get_K from_auth self.f0) (fun (v: t_V) -> v);
          f1'0 = map_Option_V (get_K from_frag self.f0) (fun (v: t_V) -> v) } with
    | {f0'0 = Some'0 auth_v; f1'0 = Some'0 frag_v} -> premise_U self.f1 auth_v frag_v
    | {f1'0 = None'0} -> false
    | _ -> true
    end

meta "rewrite_def" predicate premise_FMapKeyLocalUpdate_K_U

type t_Option_Option_FMap_K_V = None'2 | Some'2 t_Option_FMap_K_V

