meta "rewrite_def" predicate contains_K

function add_K (self: t_FMap_K_V) (k: t_K) (v: t_V) : t_FMap_K_V

axiom add_K_spec: forall self: t_FMap_K_V, k: t_K, v: t_V [add_K self k v]. to_mapping_K (add_K self k v)
    = Map.set (to_mapping_K self) k (Some'1 v)

axiom add_K_spec'0: forall self: t_FMap_K_V, k: t_K, v: t_V [add_K self k v]. len_K (add_K self k v)
    = (if contains_K self k then len_K self else len_K self + 1)

function update_FMapKeyLocalUpdate_K_U [@inline:trivial] (self: t_FMapKeyLocalUpdate_K_U) (from_auth: t_FMap_K_V) (from_frag: t_FMap_K_V) : tup2_FMap_K_V_FMap_K_V
 =
  let {f0'3 = auth; f1'3 = frag} = update_U self.f1 (index_FMap_K_V from_auth self.f0) (index_FMap_K_V from_frag self.f0) in { f0'4 = add_K from_auth self.f0 auth;
                                                                                                                               f1'4 = add_K from_frag self.f0 frag }

meta "rewrite_def" function update_FMapKeyLocalUpdate_K_U

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall self: t_FMapKeyLocalUpdate_K_U, from_auth: t_FMap_K_V, from_frag: t_FMap_K_V, frame: t_Option_FMap_K_V. premise_FMapKeyLocalUpdate_K_U self from_auth from_frag
    -> op_Option_FMap_K_V (Some from_frag) frame = Some'2 (Some from_auth)
    -> premise_FMapKeyLocalUpdate_K_U self from_auth from_frag
    /\ op_Option_FMap_K_V (Some from_frag) frame = Some'2 (Some from_auth)
    /\ (forall result: (). (let {f0'4 = to_auth; f1'4 = to_frag} = update_FMapKeyLocalUpdate_K_U self from_auth from_frag in op_Option_FMap_K_V (Some to_frag) frame
        = Some'2 (Some to_auth))
      -> (let {f0'4 = to_auth; f1'4 = to_frag} = update_FMapKeyLocalUpdate_K_U self from_auth from_frag in op_Option_FMap_K_V (Some to_frag) frame
      = Some'2 (Some to_auth)))
