function op_V (self: t_V) (other: t_V) : t_Option_V

predicate incl_V (self: t_V) (other: t_V)

axiom incl_V_spec: forall self: t_V, other: t_V [incl_V self other]. incl_V self other
    = (exists factor: t_V. op_V self factor = Some'1 other)

function incl_transitive_V (a: t_V) (b: t_V) (c: t_V) : ()

axiom incl_transitive_V_spec: forall a: t_V, b: t_V, c: t_V. incl_V a b -> incl_V b c -> incl_V a c

function associative_some_V (a: t_V) (b: t_V) (c: t_V) (ab: t_V) (bc: t_V) : ()

axiom associative_some_V_spec: forall a: t_V, b: t_V, c: t_V, ab: t_V, bc: t_V. op_V a b = Some'1 ab
    -> op_V b c = Some'1 bc -> op_V a bc = op_V ab c

function associative_none_V (a: t_V) (b: t_V) (c: t_V) (bc: t_V) : ()

axiom associative_none_V_spec: forall a: t_V, b: t_V, c: t_V, bc: t_V. op_V a b = None'1
    -> op_V b c = Some'1 bc -> op_V a bc = None'1

function commutative_V (a: t_V) (b: t_V) : ()

axiom commutative_V_spec: forall a: t_V, b: t_V. op_V a b = op_V b a

function incl_op_V (self: t_V) (other: t_V) (comb: t_V) : ()

axiom incl_op_V_spec: forall self: t_V, other: t_V, comb: t_V. op_V self other = Some'1 comb -> incl_V self comb

function op_Option_V (self: t_Option_V) (other: t_Option_V) : t_Option_Option_V = match { f0'2 = self;
                                                                                          f1'2 = other } with
    | {f0'2 = None'1} -> Some'3 other
    | {f1'2 = None'1} -> Some'3 self
    | {f0'2 = Some'1 x; f1'2 = Some'1 y} -> map_Option_V'0 (op_V x y) (fun (z: t_V) -> Some'1 z)
    end

function commutative_Option_V (a: t_Option_V) (b: t_Option_V) : ()

axiom commutative_Option_V_spec: forall a: t_Option_V, b: t_Option_V. op_Option_V a b = op_Option_V b a

type tup2_V_V = { f0'3: t_V; f1'3: t_V }

function index_Mapping_tup2_V_V_V [@inline:trivial] (self: Map.map tup2_V_V t_V) (a: tup2_V_V) : t_V = Map.get self a

meta "rewrite_def" function index_Mapping_tup2_V_V_V

function merge_K (self: t_FMap_K_V) (m: t_FMap_K_V) (f: Map.map tup2_V_V t_V) : t_FMap_K_V

axiom merge_K_spec:
  forall self: t_FMap_K_V, m: t_FMap_K_V, f: Map.map tup2_V_V t_V [merge_K self m f]. forall k: t_K [get_K (merge_K self m f) k]. match { f0'2 = get_K self k;
                                                                                                                                          f1'2 = get_K m k } with
        | {f0'2 = None'1; f1'2 = y} -> get_K (merge_K self m f) k = y
        | {f0'2 = x; f1'2 = None'1} -> get_K (merge_K self m f) k = x
        | {f0'2 = Some'1 x; f1'2 = Some'1 y} -> get_K (merge_K self m f) k
        = Some'1 (index_Mapping_tup2_V_V_V f { f0'3 = x; f1'3 = y })
        end

predicate index_Mapping_V_bool [@inline:trivial] (self: Map.map t_V bool) (a: t_V) = Map.get self a

meta "rewrite_def" predicate index_Mapping_V_bool

function such_that_V (p: Map.map t_V bool) : t_V

axiom such_that_V_spec: forall p: Map.map t_V bool [such_that_V p]. (exists x: t_V. index_Mapping_V_bool p x)
    -> index_Mapping_V_bool p (such_that_V p)

constant any_V: t_V = such_that_V (fun (__0: t_V) -> true)

function total_op_K (self: t_FMap_K_V) (other: t_FMap_K_V) : t_FMap_K_V =
  merge_K self other (fun (__0: tup2_V_V) -> let {f0'3 = x; f1'3 = y} = __0 in match op_V x y with
    | Some'1 r -> r
    | _ -> any_V
    end)

axiom total_op_K_spec:
  forall self: t_FMap_K_V, other: t_FMap_K_V [total_op_K self other]. (forall k: t_K. op_Option_V (get_K self k) (get_K other k)
        <> None'3)
    -> (forall k: t_K. Some'3 (get_K (total_op_K self other) k) = op_Option_V (get_K self k) (get_K other k))

function op_FMap_K_V (self: t_FMap_K_V) (other: t_FMap_K_V) : t_Option_FMap_K_V =
  if forall k: t_K. op_Option_V (get_K self k) (get_K other k) <> None'3 then Some (total_op_K self other) else None

function commutative_FMap_K_V (a: t_FMap_K_V) (b: t_FMap_K_V) : () = ()

axiom commutative_FMap_K_V_spec: forall a: t_FMap_K_V, b: t_FMap_K_V. op_FMap_K_V a b = op_FMap_K_V b a

function op_Option_FMap_K_V (self: t_Option_FMap_K_V) (other: t_Option_FMap_K_V) : t_Option_Option_FMap_K_V =
  match { f0'1 = self; f1'1 = other } with
    | {f0'1 = None} -> Some'2 other
    | {f1'1 = None} -> Some'2 self
    | {f0'1 = Some x; f1'1 = Some y} -> map_Option_FMap_K_V (op_FMap_K_V x y) (fun (z: t_FMap_K_V) -> Some z)
    end

function commutative_Option_FMap_K_V (a: t_Option_FMap_K_V) (b: t_Option_FMap_K_V) : ()

