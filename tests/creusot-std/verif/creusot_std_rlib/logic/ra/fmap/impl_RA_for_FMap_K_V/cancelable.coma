(* <logic::fmap::FMap<K, V> as logic::ra::RA> *)

type namespace_other

type t_Namespace = Other namespace_other

use map.Map
use map.Const
use int.Int

type t_FMap_K_V

type t_Option_FMap_K_V = None | Some t_FMap_K_V

type t_V

type t_Option_V = None'0 | Some'0 t_V

type t_Option_Option_V = None'1 | Some'1 t_Option_V

type tup2_Option_V_Option_V = { f0: t_Option_V; f1: t_Option_V }

function map_Option_V (self: t_Option_V) (f: Map.map t_V t_Option_V) : t_Option_Option_V = match self with
    | None'0 -> None'1
    | Some'0 x -> Some'1 (Map.get f x)
    end

function op_V (self: t_V) (other: t_V) : t_Option_V

predicate incl_V (self: t_V) (other: t_V)

axiom incl_V_spec: forall self: t_V, other: t_V [incl_V self other]. incl_V self other
    = (exists factor: t_V. op_V self factor = Some'0 other)

function incl_transitive_V (a: t_V) (b: t_V) (c: t_V) : ()

axiom incl_transitive_V_spec: forall a: t_V, b: t_V, c: t_V. incl_V a b -> incl_V b c -> incl_V a c

function associative_some_V (a: t_V) (b: t_V) (c: t_V) (ab: t_V) (bc: t_V) : ()

axiom associative_some_V_spec: forall a: t_V, b: t_V, c: t_V, ab: t_V, bc: t_V. op_V a b = Some'0 ab
    -> op_V b c = Some'0 bc -> op_V a bc = op_V ab c

function associative_none_V (a: t_V) (b: t_V) (c: t_V) (bc: t_V) : ()

axiom associative_none_V_spec: forall a: t_V, b: t_V, c: t_V, bc: t_V. op_V a b = None'0
    -> op_V b c = Some'0 bc -> op_V a bc = None'0

function commutative_V (a: t_V) (b: t_V) : ()

axiom commutative_V_spec: forall a: t_V, b: t_V. op_V a b = op_V b a

function incl_op_V (self: t_V) (other: t_V) (comb: t_V) : ()

axiom incl_op_V_spec: forall self: t_V, other: t_V, comb: t_V. op_V self other = Some'0 comb -> incl_V self comb

function op_Option_V (self: t_Option_V) (other: t_Option_V) : t_Option_Option_V = match { f0 = self; f1 = other } with
    | {f0 = None'0} -> Some'1 other
    | {f1 = None'0} -> Some'1 self
    | {f0 = Some'0 x; f1 = Some'0 y} -> map_Option_V (op_V x y) (fun (z: t_V) -> Some'0 z)
    end

function commutative_Option_V (a: t_Option_V) (b: t_Option_V) : ()

axiom commutative_Option_V_spec: forall a: t_Option_V, b: t_Option_V. op_Option_V a b = op_Option_V b a

type t_K

function to_mapping_K (self: t_FMap_K_V) : Map.map t_K t_Option_V

function get_K [@inline:trivial] (self: t_FMap_K_V) (k: t_K) : t_Option_V = Map.get (to_mapping_K self) k

meta "rewrite_def" function get_K

type tup2_V_V = { f0'0: t_V; f1'0: t_V }

function index_Mapping_tup2_V_V_V [@inline:trivial] (self: Map.map tup2_V_V t_V) (a: tup2_V_V) : t_V = Map.get self a

meta "rewrite_def" function index_Mapping_tup2_V_V_V

function merge_K (self: t_FMap_K_V) (m: t_FMap_K_V) (f: Map.map tup2_V_V t_V) : t_FMap_K_V

axiom merge_K_spec:
  forall self: t_FMap_K_V, m: t_FMap_K_V, f: Map.map tup2_V_V t_V [merge_K self m f]. forall k: t_K [get_K (merge_K self m f) k]. match { f0 = get_K self k;
                                                                                                                                          f1 = get_K m k } with
        | {f0 = None'0; f1 = y} -> get_K (merge_K self m f) k = y
        | {f0 = x; f1 = None'0} -> get_K (merge_K self m f) k = x
        | {f0 = Some'0 x; f1 = Some'0 y} -> get_K (merge_K self m f) k
        = Some'0 (index_Mapping_tup2_V_V_V f { f0'0 = x; f1'0 = y })
        end

predicate index_Mapping_V_bool [@inline:trivial] (self: Map.map t_V bool) (a: t_V) = Map.get self a

meta "rewrite_def" predicate index_Mapping_V_bool

function such_that_V (p: Map.map t_V bool) : t_V

axiom such_that_V_spec: forall p: Map.map t_V bool [such_that_V p]. (exists x: t_V. index_Mapping_V_bool p x)
    -> index_Mapping_V_bool p (such_that_V p)

constant any_V: t_V = such_that_V (fun (__0: t_V) -> true)

function total_op_K (self: t_FMap_K_V) (other: t_FMap_K_V) : t_FMap_K_V =
  merge_K self other (fun (__0: tup2_V_V) -> let {f0'0 = x; f1'0 = y} = __0 in match op_V x y with
    | Some'0 r -> r
    | _ -> any_V
    end)

axiom total_op_K_spec:
  forall self: t_FMap_K_V, other: t_FMap_K_V [total_op_K self other]. (forall k: t_K. op_Option_V (get_K self k) (get_K other k)
        <> None'1)
    -> (forall k: t_K. Some'1 (get_K (total_op_K self other) k) = op_Option_V (get_K self k) (get_K other k))

function op_FMap_K_V (self: t_FMap_K_V) (other: t_FMap_K_V) : t_Option_FMap_K_V =
  if forall k: t_K. op_Option_V (get_K self k) (get_K other k) <> None'1 then Some (total_op_K self other) else None

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

function len_K (self: t_FMap_K_V) : int

axiom len_K_spec: forall self: t_FMap_K_V [len_K self]. ge_log_Int (len_K self) 0

constant empty_K : t_FMap_K_V

axiom empty_K_spec: len_K empty_K = 0

axiom empty_K_spec'0: to_mapping_K empty_K = Const.const (None'0)

predicate index_Mapping_FMap_K_V_bool [@inline:trivial] (self: Map.map t_FMap_K_V bool) (a: t_FMap_K_V) = Map.get self a

meta "rewrite_def" predicate index_Mapping_FMap_K_V_bool

function such_that_FMap_K_V (p: Map.map t_FMap_K_V bool) : t_FMap_K_V

axiom such_that_FMap_K_V_spec:
  forall p: Map.map t_FMap_K_V bool [such_that_FMap_K_V p]. (exists x: t_FMap_K_V. index_Mapping_FMap_K_V_bool p x)
    -> index_Mapping_FMap_K_V_bool p (such_that_FMap_K_V p)

constant any_FMap_K_V: t_FMap_K_V = such_that_FMap_K_V (fun (__0: t_FMap_K_V) -> true)

function unwrap_Option_FMap_K_V (self: t_Option_FMap_K_V) : t_FMap_K_V = match self with
    | Some x -> x
    | None -> any_FMap_K_V
    end

predicate ext_eq_K (self: t_FMap_K_V) (other: t_FMap_K_V) = forall k: t_K. get_K self k = get_K other k

axiom ext_eq_K_spec: forall self: t_FMap_K_V, other: t_FMap_K_V [self = other]. ext_eq_K self other = (self = other)

predicate contains_K [@inline:trivial] (self: t_FMap_K_V) (k: t_K) = get_K self k <> None'0

meta "rewrite_def" predicate contains_K

function insert_K (self: t_FMap_K_V) (k: t_K) (v: t_V) : t_FMap_K_V

axiom insert_K_spec: forall self: t_FMap_K_V, k: t_K, v: t_V [insert_K self k v]. to_mapping_K (insert_K self k v)
    = Map.set (to_mapping_K self) k (Some'0 v)

axiom insert_K_spec'0: forall self: t_FMap_K_V, k: t_K, v: t_V [insert_K self k v]. len_K (insert_K self k v)
    = (if contains_K self k then len_K self else len_K self + 1)

function singleton_K (k: t_K) (v: t_V) : t_FMap_K_V = insert_K empty_K k v

predicate cancelable_V (self: t_V)

axiom cancelable_V_spec: forall self: t_V [cancelable_V self]. cancelable_V self
    = (forall x: t_V, y: t_V. op_V self x <> None'0 -> op_V self x = op_V self y -> x = y)

function core_V (self: t_V) : t_Option_V

predicate cancelable_Option_V (self: t_Option_V) =
  match self with
    | None'0 -> true
    | Some'0 this -> cancelable_V this /\ core_V this = None'0
    end

axiom cancelable_Option_V_spec: forall self: t_Option_V [cancelable_Option_V self]. cancelable_Option_V self
    = (forall x: t_Option_V, y: t_Option_V. op_Option_V self x <> None'1
      -> op_Option_V self x = op_Option_V self y -> x = y)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_FMap_K_V

predicate cancelable_FMap_K_V (self: t_FMap_K_V)

goal vc_cancelable_FMap_K_V: if forall x: t_FMap_K_V, y: t_FMap_K_V. op_FMap_K_V self x <> None
    -> op_FMap_K_V self x = op_FMap_K_V self y -> x = y then
    (forall k: t_K. match get_K self k with
          | None'0 -> true
          | Some'0 v -> forall x: t_Option_V, y: t_Option_V. if op_Option_V (Some'0 v) x <> None'1 then
              if op_Option_V (Some'0 v) x = op_Option_V (Some'0 v) y then
                match x with
                  | None'0 -> ([@stop_split] [@expl:empty ensures] ([@stop_split] [@expl:empty ensures #0] len_K empty_K
                      = 0)
                    /\ ([@stop_split] [@expl:empty ensures #1] to_mapping_K empty_K = Const.const (None'0)))
                  -> (let fx = empty_K in match y with
                    | None'0 -> ([@stop_split] [@expl:empty ensures] ([@stop_split] [@expl:empty ensures #0] len_K empty_K
                        = 0)
                      /\ ([@stop_split] [@expl:empty ensures #1] to_mapping_K empty_K = Const.const (None'0)))
                    -> (let fy = empty_K in ([@stop_split] [@expl:unwrap_logic requires] op_FMap_K_V self fx <> None)
                    /\ (let opx = unwrap_Option_FMap_K_V (op_FMap_K_V self fx) in ([@stop_split] [@expl:unwrap_logic requires] op_FMap_K_V self fy
                      <> None)
                    /\ (let opy = unwrap_Option_FMap_K_V (op_FMap_K_V self fy) in true)))
                    | Some'0 y'0 -> let fy = singleton_K k y'0 in ([@stop_split] [@expl:unwrap_logic requires] op_FMap_K_V self fx
                      <> None)
                    /\ (let opx = unwrap_Option_FMap_K_V (op_FMap_K_V self fx) in ([@stop_split] [@expl:unwrap_logic requires] op_FMap_K_V self fy
                      <> None)
                    /\ (let opy = unwrap_Option_FMap_K_V (op_FMap_K_V self fy) in true))
                    end)
                  | Some'0 x'0 -> let fx = singleton_K k x'0 in match y with
                    | None'0 -> ([@stop_split] [@expl:empty ensures] ([@stop_split] [@expl:empty ensures #0] len_K empty_K
                        = 0)
                      /\ ([@stop_split] [@expl:empty ensures #1] to_mapping_K empty_K = Const.const (None'0)))
                    -> (let fy = empty_K in ([@stop_split] [@expl:unwrap_logic requires] op_FMap_K_V self fx <> None)
                    /\ (let opx = unwrap_Option_FMap_K_V (op_FMap_K_V self fx) in ([@stop_split] [@expl:unwrap_logic requires] op_FMap_K_V self fy
                      <> None)
                    /\ (let opy = unwrap_Option_FMap_K_V (op_FMap_K_V self fy) in true)))
                    | Some'0 y'0 -> let fy = singleton_K k y'0 in ([@stop_split] [@expl:unwrap_logic requires] op_FMap_K_V self fx
                      <> None)
                    /\ (let opx = unwrap_Option_FMap_K_V (op_FMap_K_V self fx) in ([@stop_split] [@expl:unwrap_logic requires] op_FMap_K_V self fy
                      <> None)
                    /\ (let opy = unwrap_Option_FMap_K_V (op_FMap_K_V self fy) in true))
                    end
                  end
              else
                true
            
            else
              true
          
          end)
    /\ (forall k: t_K. match get_K self k with
          | None'0 -> true
          | Some'0 v -> forall x: t_Option_V, y: t_Option_V. op_Option_V (Some'0 v) x <> None'1
            -> op_Option_V (Some'0 v) x = op_Option_V (Some'0 v) y
            -> (let fx = match x with
              | None'0 -> empty_K
              | Some'0 x'0 -> singleton_K k x'0
              end in let fy = match y with
              | None'0 -> empty_K
              | Some'0 y'0 -> singleton_K k y'0
              end in let opx = unwrap_Option_FMap_K_V (op_FMap_K_V self fx) in let opy = unwrap_Option_FMap_K_V (op_FMap_K_V self fy) in ext_eq_K opx opy
            /\ (opx = opy -> fx = fy))
          end)
    && (if forall k: t_K. cancelable_Option_V (get_K self k) then
      (forall x: t_FMap_K_V, y: t_FMap_K_V. op_FMap_K_V self x <> None
          -> op_FMap_K_V self x = op_FMap_K_V self y -> ext_eq_K x y)
      && ([@stop_split] [@expl:cancelable ensures] (forall k: t_K. cancelable_Option_V (get_K self k))
      = (forall x: t_FMap_K_V, y: t_FMap_K_V. op_FMap_K_V self x <> None
        -> op_FMap_K_V self x = op_FMap_K_V self y -> x = y))
    else
      [@stop_split] [@expl:cancelable ensures] (forall k: t_K. cancelable_Option_V (get_K self k))
      = (forall x: t_FMap_K_V, y: t_FMap_K_V. op_FMap_K_V self x <> None
        -> op_FMap_K_V self x = op_FMap_K_V self y -> x = y)
    )
  else
    if forall k: t_K. cancelable_Option_V (get_K self k) then
      (forall x: t_FMap_K_V, y: t_FMap_K_V. op_FMap_K_V self x <> None
          -> op_FMap_K_V self x = op_FMap_K_V self y -> ext_eq_K x y)
      && ([@stop_split] [@expl:cancelable ensures] (forall k: t_K. cancelable_Option_V (get_K self k))
      = (forall x: t_FMap_K_V, y: t_FMap_K_V. op_FMap_K_V self x <> None
        -> op_FMap_K_V self x = op_FMap_K_V self y -> x = y))
    else
      [@stop_split] [@expl:cancelable ensures] (forall k: t_K. cancelable_Option_V (get_K self k))
      = (forall x: t_FMap_K_V, y: t_FMap_K_V. op_FMap_K_V self x <> None
        -> op_FMap_K_V self x = op_FMap_K_V self y -> x = y)
  
  
