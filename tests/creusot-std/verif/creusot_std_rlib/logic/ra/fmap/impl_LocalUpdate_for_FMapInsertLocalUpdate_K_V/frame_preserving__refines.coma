function total_op_K (self: t_FMap_K_V) (other: t_FMap_K_V) : t_FMap_K_V =
  merge_K self other (fun (__0: tup2_V_V) -> let {f0'2 = x; f1'2 = y} = __0 in match op_V x y with
    | Some'0 r -> r
    | _ -> any_V
