(* <logic::ra::excl::Excl<T> as logic::ra::RA> *)

type namespace_other

type t_Namespace = Other namespace_other

type t_T

type t_Excl_T = { f0: t_T }

type t_Option_Excl_T = None | Some t_Excl_T

function op_Excl_T (self: t_Excl_T) (_other: t_Excl_T) : t_Option_Excl_T = None

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Excl_T, other: t_Excl_T. forall result: bool. result
        = (exists factor: t_Excl_T. op_Excl_T self factor = Some other)
      -> result = (exists factor: t_Excl_T. op_Excl_T self factor = Some other)
