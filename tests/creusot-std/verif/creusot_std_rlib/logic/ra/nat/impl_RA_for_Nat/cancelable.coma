(* <logic::int::Nat as logic::ra::RA> *)

type namespace_other

type t_Namespace = Other namespace_other

use int.Int

type t_Nat

type t_Option_Nat = None | Some t_Nat

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

function to_int (self: t_Nat) : int

axiom to_int_spec: forall self: t_Nat [to_int self]. ge_log_Int (to_int self) 0

function view_Nat (self: t_Nat) : int = to_int self

function add_Nat (self: t_Nat) (other: t_Nat) : t_Nat

axiom add_Nat_spec: forall self: t_Nat, other: t_Nat [add_Nat self other]. view_Nat (add_Nat self other)
    = view_Nat self + view_Nat other

function op_Nat [@inline:trivial] (self: t_Nat) (other: t_Nat) : t_Option_Nat = Some (add_Nat self other)

meta "rewrite_def" function op_Nat

predicate ext_eq (self: t_Nat) (other: t_Nat) = to_int self = to_int other

axiom ext_eq_spec: forall self: t_Nat, other: t_Nat [self = other]. ext_eq self other = (self = other)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Nat

predicate cancelable_Nat (self: t_Nat)

goal vc_cancelable_Nat: [@stop_split] [@expl:cancelable ensures] true
  = (forall x: t_Nat, y: t_Nat. op_Nat self x <> None -> op_Nat self x = op_Nat self y -> x = y)
