  premise_T1 self.f0 from.f0'0
  /\ premise_T2 self.f1 from.f1'0 /\ premise_T3 self.f2 from.f2'0 /\ premise_T4 self.f3 from.f3'0

meta "rewrite_def" predicate premise_tup4_T1_T2_T3_T4

type t_Option_tup4_R1_R2_R3_R4 = None | Some tup4_R1_R2_R3_R4

type t_Option_R1 = None'0 | Some'0 t_R1

