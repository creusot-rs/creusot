function op_tup4_R1_R2_R3_R4 (self: tup4_R1_R2_R3_R4) (other: tup4_R1_R2_R3_R4) : t_Option_tup4_R1_R2_R3_R4 =
  match { f0'2 = op_R1 self.f0'0 other.f0'0;
          f1'2 = op_R2 self.f1'0 other.f1'0;
          f2'2 = op_R3 self.f2'0 other.f2'0;
          f3'2 = op_R4 self.f3'0 other.f3'0 } with
    | {f0'2 = Some'0 v1; f1'2 = Some'1 v2; f2'2 = Some'2 v3; f3'2 = Some'3 v4} -> Some { f0'0 = v1;
                                                                                         f1'0 = v2;
                                                                                         f2'0 = v3;
                                                                                         f3'0 = v4 }
    | _ -> None
    end

function commutative_tup4_R1_R2_R3_R4 (a: tup4_R1_R2_R3_R4) (b: tup4_R1_R2_R3_R4) : () = ()

axiom commutative_tup4_R1_R2_R3_R4_spec: forall a: tup4_R1_R2_R3_R4, b: tup4_R1_R2_R3_R4. op_tup4_R1_R2_R3_R4 a b
    = op_tup4_R1_R2_R3_R4 b a

function update_T1 (self: t_T1) (from: t_R1) (ch: t_Choice) : t_R1

function update_T2 (self: t_T2) (from: t_R2) (ch: t_Choice'0) : t_R2

function update_T3 (self: t_T3) (from: t_R3) (ch: t_Choice'1) : t_R3

function update_T4 (self: t_T4) (from: t_R4) (ch: t_Choice'2) : t_R4

function update_tup4_T1_T2_T3_T4 [@inline:trivial] (self: tup4_T1_T2_T3_T4) (from: tup4_R1_R2_R3_R4) (ch: tup4_Choice_Choice_Choice_Choice) : tup4_R1_R2_R3_R4
 = { f0'0 = update_T1 self.f0 from.f0'0 ch.f0'1;
     f1'0 = update_T2 self.f1 from.f1'0 ch.f1'1;
     f2'0 = update_T3 self.f2 from.f2'0 ch.f2'1;
     f3'0 = update_T4 self.f3 from.f3'0 ch.f3'1 }

meta "rewrite_def" function update_tup4_T1_T2_T3_T4

function frame_preserving_T1 (self: t_T1) (from: t_R1) (frame: t_R1) : t_Choice

axiom frame_preserving_T1_spec:
  forall self: t_T1, from: t_R1, frame: t_R1 [frame_preserving_T1 self from frame]. premise_T1 self from
    -> op_R1 from frame <> None'0 -> op_R1 (update_T1 self from (frame_preserving_T1 self from frame)) frame <> None'0

function frame_preserving_T2 (self: t_T2) (from: t_R2) (frame: t_R2) : t_Choice'0

axiom frame_preserving_T2_spec:
  forall self: t_T2, from: t_R2, frame: t_R2 [frame_preserving_T2 self from frame]. premise_T2 self from
    -> op_R2 from frame <> None'1 -> op_R2 (update_T2 self from (frame_preserving_T2 self from frame)) frame <> None'1

function frame_preserving_T3 (self: t_T3) (from: t_R3) (frame: t_R3) : t_Choice'1

axiom frame_preserving_T3_spec:
  forall self: t_T3, from: t_R3, frame: t_R3 [frame_preserving_T3 self from frame]. premise_T3 self from
    -> op_R3 from frame <> None'2 -> op_R3 (update_T3 self from (frame_preserving_T3 self from frame)) frame <> None'2

function frame_preserving_T4 (self: t_T4) (from: t_R4) (frame: t_R4) : t_Choice'2

axiom frame_preserving_T4_spec:
  forall self: t_T4, from: t_R4, frame: t_R4 [frame_preserving_T4 self from frame]. premise_T4 self from
    -> op_R4 from frame <> None'3 -> op_R4 (update_T4 self from (frame_preserving_T4 self from frame)) frame <> None'3

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : tup4_T1_T2_T3_T4

constant from : tup4_R1_R2_R3_R4

constant frame : tup4_R1_R2_R3_R4

function frame_preserving_tup4_T1_T2_T3_T4 (self: tup4_T1_T2_T3_T4) (from: tup4_R1_R2_R3_R4) (frame: tup4_R1_R2_R3_R4) : tup4_Choice_Choice_Choice_Choice

goal vc_frame_preserving_tup4_T1_T2_T3_T4: premise_tup4_T1_T2_T3_T4 self from
  -> op_tup4_R1_R2_R3_R4 from frame <> None
  -> ([@stop_split] [@expl:frame_preserving requires] ([@stop_split] [@expl:frame_preserving requires #0] premise_T1 self.f0 from.f0'0)
    /\ ([@stop_split] [@expl:frame_preserving requires #1] op_R1 from.f0'0 frame.f0'0 <> None'0))
  /\ (([@stop_split] [@expl:frame_preserving ensures] op_R1 (update_T1 self.f0 from.f0'0 (frame_preserving_T1 self.f0 from.f0'0 frame.f0'0)) frame.f0'0
    <> None'0)
  -> ([@stop_split] [@expl:frame_preserving requires] ([@stop_split] [@expl:frame_preserving requires #0] premise_T2 self.f1 from.f1'0)
    /\ ([@stop_split] [@expl:frame_preserving requires #1] op_R2 from.f1'0 frame.f1'0 <> None'1))
  /\ (([@stop_split] [@expl:frame_preserving ensures] op_R2 (update_T2 self.f1 from.f1'0 (frame_preserving_T2 self.f1 from.f1'0 frame.f1'0)) frame.f1'0
    <> None'1)
  -> ([@stop_split] [@expl:frame_preserving requires] ([@stop_split] [@expl:frame_preserving requires #0] premise_T3 self.f2 from.f2'0)
    /\ ([@stop_split] [@expl:frame_preserving requires #1] op_R3 from.f2'0 frame.f2'0 <> None'2))
  /\ (([@stop_split] [@expl:frame_preserving ensures] op_R3 (update_T3 self.f2 from.f2'0 (frame_preserving_T3 self.f2 from.f2'0 frame.f2'0)) frame.f2'0
    <> None'2)
  -> ([@stop_split] [@expl:frame_preserving requires] ([@stop_split] [@expl:frame_preserving requires #0] premise_T4 self.f3 from.f3'0)
    /\ ([@stop_split] [@expl:frame_preserving requires #1] op_R4 from.f3'0 frame.f3'0 <> None'3))
  /\ (([@stop_split] [@expl:frame_preserving ensures] op_R4 (update_T4 self.f3 from.f3'0 (frame_preserving_T4 self.f3 from.f3'0 frame.f3'0)) frame.f3'0
    <> None'3)
  -> ([@stop_split] [@expl:frame_preserving ensures] op_tup4_R1_R2_R3_R4 (update_tup4_T1_T2_T3_T4 self from { f0'1 = frame_preserving_T1 self.f0 from.f0'0 frame.f0'0;
                                                                                                              f1'1 = frame_preserving_T2 self.f1 from.f1'0 frame.f1'0;
                                                                                                              f2'1 = frame_preserving_T3 self.f2 from.f2'0 frame.f2'0;
                                                                                                              f3'1 = frame_preserving_T4 self.f3 from.f3'0 frame.f3'0 }) frame
  <> None)))))
