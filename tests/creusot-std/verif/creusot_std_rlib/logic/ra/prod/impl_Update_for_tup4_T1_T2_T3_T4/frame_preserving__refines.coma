function update_T4 (self: t_T4) (from: t_R4) (ch: t_Choice'2) : t_R4

function update_tup4_T1_T2_T3_T4 [@inline:trivial] (self: tup4_T1_T2_T3_T4) (from: tup4_R1_R2_R3_R4) (ch: tup4_Choice_Choice_Choice_Choice) : tup4_R1_R2_R3_R4
 = { f0'0 = update_T1 self.f0 from.f0'0 ch.f0'2;
     f1'0 = update_T2 self.f1 from.f1'0 ch.f1'2;
     f2'0 = update_T3 self.f2 from.f2'0 ch.f2'2;
     f3'0 = update_T4 self.f3 from.f3'0 ch.f3'2 }

meta "rewrite_def" function update_tup4_T1_T2_T3_T4

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall self: tup4_T1_T2_T3_T4, from: tup4_R1_R2_R3_R4, frame: tup4_R1_R2_R3_R4. premise_tup4_T1_T2_T3_T4 self from
    -> op_tup4_R1_R2_R3_R4 from frame <> None
    -> premise_tup4_T1_T2_T3_T4 self from
    /\ op_tup4_R1_R2_R3_R4 from frame <> None
    /\ (forall result: tup4_Choice_Choice_Choice_Choice. op_tup4_R1_R2_R3_R4 (update_tup4_T1_T2_T3_T4 self from result) frame
        <> None -> op_tup4_R1_R2_R3_R4 (update_tup4_T1_T2_T3_T4 self from result) frame <> None)
