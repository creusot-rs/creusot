function op_tup4_R1_R2_R3_R4 (self: tup4_R1_R2_R3_R4) (other: tup4_R1_R2_R3_R4) : t_Option_tup4_R1_R2_R3_R4 =
  match { f0'1 = op_R1 self.f0'0 other.f0'0;
          f1'1 = op_R2 self.f1'0 other.f1'0;
          f2'1 = op_R3 self.f2'0 other.f2'0;
          f3'1 = op_R4 self.f3'0 other.f3'0 } with
    | {f0'1 = Some'0 v1; f1'1 = Some'1 v2; f2'1 = Some'2 v3; f3'1 = Some'3 v4} -> Some { f0'0 = v1;
                                                                                         f1'0 = v2;
                                                                                         f2'0 = v3;
                                                                                         f3'0 = v4 }
    | _ -> None
    end

function commutative_tup4_R1_R2_R3_R4 (a: tup4_R1_R2_R3_R4) (b: tup4_R1_R2_R3_R4) : () = ()

