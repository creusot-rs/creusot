(* <(T1, T2, T3) as logic::ra::RA> *)

type namespace_other

type t_Namespace = Other namespace_other

type t_T1

type t_T2

type t_T3

type tup3_T1_T2_T3 = { f0: t_T1; f1: t_T2; f2: t_T3 }

type t_Option_T1 = None | Some t_T1

function op_T1 (self: t_T1) (other: t_T1) : t_Option_T1

predicate incl_T1 (self: t_T1) (other: t_T1)

axiom incl_T1_spec: forall self: t_T1, other: t_T1 [incl_T1 self other]. incl_T1 self other
    = (exists factor: t_T1. op_T1 self factor = Some other)

function incl_transitive_T1 (a: t_T1) (b: t_T1) (c: t_T1) : ()

axiom incl_transitive_T1_spec: forall a: t_T1, b: t_T1, c: t_T1. incl_T1 a b -> incl_T1 b c -> incl_T1 a c

function associative_some_T1 (a: t_T1) (b: t_T1) (c: t_T1) (ab: t_T1) (bc: t_T1) : ()

axiom associative_some_T1_spec: forall a: t_T1, b: t_T1, c: t_T1, ab: t_T1, bc: t_T1. op_T1 a b = Some ab
    -> op_T1 b c = Some bc -> op_T1 a bc = op_T1 ab c

function associative_none_T1 (a: t_T1) (b: t_T1) (c: t_T1) (bc: t_T1) : ()

axiom associative_none_T1_spec: forall a: t_T1, b: t_T1, c: t_T1, bc: t_T1. op_T1 a b = None
    -> op_T1 b c = Some bc -> op_T1 a bc = None

function commutative_T1 (a: t_T1) (b: t_T1) : ()

axiom commutative_T1_spec: forall a: t_T1, b: t_T1. op_T1 a b = op_T1 b a

function incl_op_T1 (self: t_T1) (other: t_T1) (comb: t_T1) : ()

axiom incl_op_T1_spec: forall self: t_T1, other: t_T1, comb: t_T1. op_T1 self other = Some comb -> incl_T1 self comb

predicate eq_T1 (self: t_T1) (other: t_T1)

axiom eq_T1_spec: forall self: t_T1, other: t_T1 [eq_T1 self other]. eq_T1 self other = (self = other)

type t_Option_T2 = None'0 | Some'0 t_T2

function op_T2 (self: t_T2) (other: t_T2) : t_Option_T2

predicate incl_T2 (self: t_T2) (other: t_T2)

axiom incl_T2_spec: forall self: t_T2, other: t_T2 [incl_T2 self other]. incl_T2 self other
    = (exists factor: t_T2. op_T2 self factor = Some'0 other)

function incl_transitive_T2 (a: t_T2) (b: t_T2) (c: t_T2) : ()

axiom incl_transitive_T2_spec: forall a: t_T2, b: t_T2, c: t_T2. incl_T2 a b -> incl_T2 b c -> incl_T2 a c

function associative_some_T2 (a: t_T2) (b: t_T2) (c: t_T2) (ab: t_T2) (bc: t_T2) : ()

axiom associative_some_T2_spec: forall a: t_T2, b: t_T2, c: t_T2, ab: t_T2, bc: t_T2. op_T2 a b = Some'0 ab
    -> op_T2 b c = Some'0 bc -> op_T2 a bc = op_T2 ab c

function associative_none_T2 (a: t_T2) (b: t_T2) (c: t_T2) (bc: t_T2) : ()

axiom associative_none_T2_spec: forall a: t_T2, b: t_T2, c: t_T2, bc: t_T2. op_T2 a b = None'0
    -> op_T2 b c = Some'0 bc -> op_T2 a bc = None'0

function commutative_T2 (a: t_T2) (b: t_T2) : ()

axiom commutative_T2_spec: forall a: t_T2, b: t_T2. op_T2 a b = op_T2 b a

function incl_op_T2 (self: t_T2) (other: t_T2) (comb: t_T2) : ()

axiom incl_op_T2_spec: forall self: t_T2, other: t_T2, comb: t_T2. op_T2 self other = Some'0 comb -> incl_T2 self comb

predicate eq_T2 (self: t_T2) (other: t_T2)

axiom eq_T2_spec: forall self: t_T2, other: t_T2 [eq_T2 self other]. eq_T2 self other = (self = other)

type t_Option_T3 = None'1 | Some'1 t_T3

function op_T3 (self: t_T3) (other: t_T3) : t_Option_T3

predicate incl_T3 (self: t_T3) (other: t_T3)

axiom incl_T3_spec: forall self: t_T3, other: t_T3 [incl_T3 self other]. incl_T3 self other
    = (exists factor: t_T3. op_T3 self factor = Some'1 other)

function incl_transitive_T3 (a: t_T3) (b: t_T3) (c: t_T3) : ()

axiom incl_transitive_T3_spec: forall a: t_T3, b: t_T3, c: t_T3. incl_T3 a b -> incl_T3 b c -> incl_T3 a c

function associative_some_T3 (a: t_T3) (b: t_T3) (c: t_T3) (ab: t_T3) (bc: t_T3) : ()

axiom associative_some_T3_spec: forall a: t_T3, b: t_T3, c: t_T3, ab: t_T3, bc: t_T3. op_T3 a b = Some'1 ab
    -> op_T3 b c = Some'1 bc -> op_T3 a bc = op_T3 ab c

function associative_none_T3 (a: t_T3) (b: t_T3) (c: t_T3) (bc: t_T3) : ()

axiom associative_none_T3_spec: forall a: t_T3, b: t_T3, c: t_T3, bc: t_T3. op_T3 a b = None'1
    -> op_T3 b c = Some'1 bc -> op_T3 a bc = None'1

function commutative_T3 (a: t_T3) (b: t_T3) : ()

axiom commutative_T3_spec: forall a: t_T3, b: t_T3. op_T3 a b = op_T3 b a

function incl_op_T3 (self: t_T3) (other: t_T3) (comb: t_T3) : ()

axiom incl_op_T3_spec: forall self: t_T3, other: t_T3, comb: t_T3. op_T3 self other = Some'1 comb -> incl_T3 self comb

predicate eq_T3 (self: t_T3) (other: t_T3)

axiom eq_T3_spec: forall self: t_T3, other: t_T3 [eq_T3 self other]. eq_T3 self other = (self = other)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : tup3_T1_T2_T3

constant other : tup3_T1_T2_T3

predicate eq_tup3_T1_T2_T3 (self: tup3_T1_T2_T3) (other: tup3_T1_T2_T3)

goal vc_eq_tup3_T1_T2_T3: ([@stop_split] [@expl:eq ensures] eq_T1 self.f0 other.f0 = (self.f0 = other.f0))
  -> (if eq_T1 self.f0 other.f0 then
    ([@stop_split] [@expl:eq ensures] eq_T2 self.f1 other.f1 = (self.f1 = other.f1))
    -> (if eq_T2 self.f1 other.f1 then
      ([@stop_split] [@expl:eq ensures] eq_T3 self.f2 other.f2 = (self.f2 = other.f2))
      -> ([@stop_split] [@expl:eq ensures] eq_T3 self.f2 other.f2 = (self = other))
    else
      [@stop_split] [@expl:eq ensures] false = (self = other)
    )
  else
    [@stop_split] [@expl:eq ensures] false = (self = other)
  )
