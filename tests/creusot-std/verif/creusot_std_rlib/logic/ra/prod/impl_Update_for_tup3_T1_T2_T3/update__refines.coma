(* <(T1, T2, T3) as logic::ra::update::Update<(R1, R2, R3)>> *)

type t_T1

type t_T2

type t_T3

type tup3_T1_T2_T3 = { f0: t_T1; f1: t_T2; f2: t_T3 }

type t_R1

type t_R2

type t_R3

type tup3_R1_R2_R3 = { f0'0: t_R1; f1'0: t_R2; f2'0: t_R3 }

type t_Choice

type t_Choice'0

type t_Choice'1

type tup3_Choice_Choice_Choice = { f0'1: t_Choice; f1'1: t_Choice'0; f2'1: t_Choice'1 }

predicate premise_T1 (self: t_T1) (from: t_R1)

predicate premise_T2 (self: t_T2) (from: t_R2)

predicate premise_T3 (self: t_T3) (from: t_R3)

predicate premise_tup3_T1_T2_T3 [@inline:trivial] (self: tup3_T1_T2_T3) (from: tup3_R1_R2_R3) =
  premise_T1 self.f0 from.f0'0 /\ premise_T2 self.f1 from.f1'0 /\ premise_T3 self.f2 from.f2'0

meta "rewrite_def" predicate premise_tup3_T1_T2_T3

type t_Option_R3 = None | Some t_R3

function op_R3 (self: t_R3) (other: t_R3) : t_Option_R3

predicate incl_R3 (self: t_R3) (other: t_R3)

axiom incl_R3_spec: forall self: t_R3, other: t_R3 [incl_R3 self other]. incl_R3 self other
    = (exists factor: t_R3. op_R3 self factor = Some other)

function incl_transitive_R3 (a: t_R3) (b: t_R3) (c: t_R3) : ()

axiom incl_transitive_R3_spec: forall a: t_R3, b: t_R3, c: t_R3. incl_R3 a b -> incl_R3 b c -> incl_R3 a c

function associative_some_R3 (a: t_R3) (b: t_R3) (c: t_R3) (ab: t_R3) (bc: t_R3) : ()

axiom associative_some_R3_spec: forall a: t_R3, b: t_R3, c: t_R3, ab: t_R3, bc: t_R3. op_R3 a b = Some ab
    -> op_R3 b c = Some bc -> op_R3 a bc = op_R3 ab c

function associative_none_R3 (a: t_R3) (b: t_R3) (c: t_R3) (bc: t_R3) : ()

axiom associative_none_R3_spec: forall a: t_R3, b: t_R3, c: t_R3, bc: t_R3. op_R3 a b = None
    -> op_R3 b c = Some bc -> op_R3 a bc = None

function commutative_R3 (a: t_R3) (b: t_R3) : ()

axiom commutative_R3_spec: forall a: t_R3, b: t_R3. op_R3 a b = op_R3 b a

function incl_op_R3 (self: t_R3) (other: t_R3) (comb: t_R3) : ()

axiom incl_op_R3_spec: forall self: t_R3, other: t_R3, comb: t_R3. op_R3 self other = Some comb -> incl_R3 self comb

type t_Option_R2 = None'0 | Some'0 t_R2

function op_R2 (self: t_R2) (other: t_R2) : t_Option_R2

predicate incl_R2 (self: t_R2) (other: t_R2)

axiom incl_R2_spec: forall self: t_R2, other: t_R2 [incl_R2 self other]. incl_R2 self other
    = (exists factor: t_R2. op_R2 self factor = Some'0 other)

function incl_transitive_R2 (a: t_R2) (b: t_R2) (c: t_R2) : ()

axiom incl_transitive_R2_spec: forall a: t_R2, b: t_R2, c: t_R2. incl_R2 a b -> incl_R2 b c -> incl_R2 a c

function associative_some_R2 (a: t_R2) (b: t_R2) (c: t_R2) (ab: t_R2) (bc: t_R2) : ()

axiom associative_some_R2_spec: forall a: t_R2, b: t_R2, c: t_R2, ab: t_R2, bc: t_R2. op_R2 a b = Some'0 ab
    -> op_R2 b c = Some'0 bc -> op_R2 a bc = op_R2 ab c

function associative_none_R2 (a: t_R2) (b: t_R2) (c: t_R2) (bc: t_R2) : ()

axiom associative_none_R2_spec: forall a: t_R2, b: t_R2, c: t_R2, bc: t_R2. op_R2 a b = None'0
    -> op_R2 b c = Some'0 bc -> op_R2 a bc = None'0

function commutative_R2 (a: t_R2) (b: t_R2) : ()

axiom commutative_R2_spec: forall a: t_R2, b: t_R2. op_R2 a b = op_R2 b a

function incl_op_R2 (self: t_R2) (other: t_R2) (comb: t_R2) : ()

axiom incl_op_R2_spec: forall self: t_R2, other: t_R2, comb: t_R2. op_R2 self other = Some'0 comb -> incl_R2 self comb

type t_Option_R1 = None'1 | Some'1 t_R1

function op_R1 (self: t_R1) (other: t_R1) : t_Option_R1

predicate incl_R1 (self: t_R1) (other: t_R1)

axiom incl_R1_spec: forall self: t_R1, other: t_R1 [incl_R1 self other]. incl_R1 self other
    = (exists factor: t_R1. op_R1 self factor = Some'1 other)

function incl_transitive_R1 (a: t_R1) (b: t_R1) (c: t_R1) : ()

axiom incl_transitive_R1_spec: forall a: t_R1, b: t_R1, c: t_R1. incl_R1 a b -> incl_R1 b c -> incl_R1 a c

function associative_some_R1 (a: t_R1) (b: t_R1) (c: t_R1) (ab: t_R1) (bc: t_R1) : ()

axiom associative_some_R1_spec: forall a: t_R1, b: t_R1, c: t_R1, ab: t_R1, bc: t_R1. op_R1 a b = Some'1 ab
    -> op_R1 b c = Some'1 bc -> op_R1 a bc = op_R1 ab c

function associative_none_R1 (a: t_R1) (b: t_R1) (c: t_R1) (bc: t_R1) : ()

axiom associative_none_R1_spec: forall a: t_R1, b: t_R1, c: t_R1, bc: t_R1. op_R1 a b = None'1
    -> op_R1 b c = Some'1 bc -> op_R1 a bc = None'1

function commutative_R1 (a: t_R1) (b: t_R1) : ()

axiom commutative_R1_spec: forall a: t_R1, b: t_R1. op_R1 a b = op_R1 b a

function incl_op_R1 (self: t_R1) (other: t_R1) (comb: t_R1) : ()

axiom incl_op_R1_spec: forall self: t_R1, other: t_R1, comb: t_R1. op_R1 self other = Some'1 comb -> incl_R1 self comb

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall self: tup3_T1_T2_T3, from: tup3_R1_R2_R3, ch: tup3_Choice_Choice_Choice. premise_tup3_T1_T2_T3 self from
    -> premise_tup3_T1_T2_T3 self from
