    -> op_Option_R4 (Some'4 from_frag) frame = Some'8 (Some'4 from_auth)
    -> (let {f0'7 = to_auth; f1'7 = to_frag} = update_T4 self from_auth from_frag in op_Option_R4 (Some'4 to_frag) frame
    = Some'8 (Some'4 to_auth))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : tup4_T1_T2_T3_T4

constant from_auth : tup4_R1_R2_R3_R4

constant from_frag : tup4_R1_R2_R3_R4

constant frame : t_Option_tup4_R1_R2_R3_R4

function frame_preserving_tup4_T1_T2_T3_T4 (self: tup4_T1_T2_T3_T4) (from_auth: tup4_R1_R2_R3_R4) (from_frag: tup4_R1_R2_R3_R4) (frame: t_Option_tup4_R1_R2_R3_R4) : ()

goal vc_frame_preserving_tup4_T1_T2_T3_T4: premise_tup4_T1_T2_T3_T4 self from_auth from_frag
  -> op_Option_tup4_R1_R2_R3_R4 (Some from_frag) frame = Some'0 (Some from_auth)
  -> ([@stop_split] [@expl:frame_preserving requires] ([@stop_split] [@expl:frame_preserving requires #0] premise_T1 self.f0 from_auth.f0'0 from_frag.f0'0)
    /\ ([@stop_split] [@expl:frame_preserving requires #1] op_Option_R1 (Some'1 (from_frag.f0'0)) (map_Option_tup4_R1_R2_R3_R4'0 frame (fun (f: tup4_R1_R2_R3_R4) -> f.f0'0))
    = Some'5 (Some'1 (from_auth.f0'0))))
  /\ (([@stop_split] [@expl:frame_preserving ensures] let {f0'4 = to_auth; f1'4 = to_frag} = update_T1 self.f0 from_auth.f0'0 from_frag.f0'0 in op_Option_R1 (Some'1 to_frag) (map_Option_tup4_R1_R2_R3_R4'0 frame (fun (f: tup4_R1_R2_R3_R4) -> f.f0'0))
    = Some'5 (Some'1 to_auth))
  -> (let _ = frame_preserving_T1 self.f0 from_auth.f0'0 from_frag.f0'0 (map_Option_tup4_R1_R2_R3_R4'0 frame (fun (f: tup4_R1_R2_R3_R4) -> f.f0'0)) in ([@stop_split] [@expl:frame_preserving requires] ([@stop_split] [@expl:frame_preserving requires #0] premise_T2 self.f1 from_auth.f1'0 from_frag.f1'0)
    /\ ([@stop_split] [@expl:frame_preserving requires #1] op_Option_R2 (Some'2 (from_frag.f1'0)) (map_Option_tup4_R1_R2_R3_R4'1 frame (fun (f: tup4_R1_R2_R3_R4) -> f.f1'0))
    = Some'6 (Some'2 (from_auth.f1'0))))
  /\ (([@stop_split] [@expl:frame_preserving ensures] let {f0'5 = to_auth; f1'5 = to_frag} = update_T2 self.f1 from_auth.f1'0 from_frag.f1'0 in op_Option_R2 (Some'2 to_frag) (map_Option_tup4_R1_R2_R3_R4'1 frame (fun (f: tup4_R1_R2_R3_R4) -> f.f1'0))
    = Some'6 (Some'2 to_auth))
  -> (let _ = frame_preserving_T2 self.f1 from_auth.f1'0 from_frag.f1'0 (map_Option_tup4_R1_R2_R3_R4'1 frame (fun (f: tup4_R1_R2_R3_R4) -> f.f1'0)) in ([@stop_split] [@expl:frame_preserving requires] ([@stop_split] [@expl:frame_preserving requires #0] premise_T3 self.f2 from_auth.f2'0 from_frag.f2'0)
    /\ ([@stop_split] [@expl:frame_preserving requires #1] op_Option_R3 (Some'3 (from_frag.f2'0)) (map_Option_tup4_R1_R2_R3_R4'2 frame (fun (f: tup4_R1_R2_R3_R4) -> f.f2'0))
    = Some'7 (Some'3 (from_auth.f2'0))))
  /\ (([@stop_split] [@expl:frame_preserving ensures] let {f0'6 = to_auth; f1'6 = to_frag} = update_T3 self.f2 from_auth.f2'0 from_frag.f2'0 in op_Option_R3 (Some'3 to_frag) (map_Option_tup4_R1_R2_R3_R4'2 frame (fun (f: tup4_R1_R2_R3_R4) -> f.f2'0))
    = Some'7 (Some'3 to_auth))
  -> (let _ = frame_preserving_T3 self.f2 from_auth.f2'0 from_frag.f2'0 (map_Option_tup4_R1_R2_R3_R4'2 frame (fun (f: tup4_R1_R2_R3_R4) -> f.f2'0)) in ([@stop_split] [@expl:frame_preserving requires] ([@stop_split] [@expl:frame_preserving requires #0] premise_T4 self.f3 from_auth.f3'0 from_frag.f3'0)
    /\ ([@stop_split] [@expl:frame_preserving requires #1] op_Option_R4 (Some'4 (from_frag.f3'0)) (map_Option_tup4_R1_R2_R3_R4'3 frame (fun (f: tup4_R1_R2_R3_R4) -> f.f3'0))
    = Some'8 (Some'4 (from_auth.f3'0))))
  /\ (([@stop_split] [@expl:frame_preserving ensures] let {f0'7 = to_auth; f1'7 = to_frag} = update_T4 self.f3 from_auth.f3'0 from_frag.f3'0 in op_Option_R4 (Some'4 to_frag) (map_Option_tup4_R1_R2_R3_R4'3 frame (fun (f: tup4_R1_R2_R3_R4) -> f.f3'0))
    = Some'8 (Some'4 to_auth))
  -> (let _ = frame_preserving_T4 self.f3 from_auth.f3'0 from_frag.f3'0 (map_Option_tup4_R1_R2_R3_R4'3 frame (fun (f: tup4_R1_R2_R3_R4) -> f.f3'0)) in [@stop_split] [@expl:frame_preserving ensures] let {f0'3 = to_auth; f1'3 = to_frag} = update_tup4_T1_T2_T3_T4 self from_auth from_frag in op_Option_tup4_R1_R2_R3_R4 (Some to_frag) frame
  = Some'0 (Some to_auth)))))))))
