function associative_some_R3 (a: t_R3) (b: t_R3) (c: t_R3) (ab: t_R3) (bc: t_R3) : ()

axiom associative_some_R3_spec: forall a: t_R3, b: t_R3, c: t_R3, ab: t_R3, bc: t_R3. op_R3 a b = Some'3 ab
