(* <(T1, T2, T3, T4) as logic::ra::update::LocalUpdate<(R1, R2, R3, R4)>> *)

type namespace_other

type t_Namespace = Other namespace_other

use map.Map

type t_T1

type t_T2

type t_T3

type t_T4

