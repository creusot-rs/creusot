axiom incl_op_R4_spec: forall self: t_R4, other: t_R4, comb: t_R4. op_R4 self other = Some'4 comb -> incl_R4 self comb

function op_tup4_R1_R2_R3_R4 (self: tup4_R1_R2_R3_R4) (other: tup4_R1_R2_R3_R4) : t_Option_tup4_R1_R2_R3_R4 =
  match { f0'2 = op_R1 self.f0'0 other.f0'0;
          f1'2 = op_R2 self.f1'0 other.f1'0;
          f2'2 = op_R3 self.f2'0 other.f2'0;
          f3'2 = op_R4 self.f3'0 other.f3'0 } with
    | {f0'2 = Some'1 v1; f1'2 = Some'2 v2; f2'2 = Some'3 v3; f3'2 = Some'4 v4} -> Some { f0'0 = v1;
                                                                                         f1'0 = v2;
                                                                                         f2'0 = v3;
                                                                                         f3'0 = v4 }
    | _ -> None
    end

function commutative_tup4_R1_R2_R3_R4 (a: tup4_R1_R2_R3_R4) (b: tup4_R1_R2_R3_R4) : () = ()

axiom commutative_tup4_R1_R2_R3_R4_spec: forall a: tup4_R1_R2_R3_R4, b: tup4_R1_R2_R3_R4. op_tup4_R1_R2_R3_R4 a b
    = op_tup4_R1_R2_R3_R4 b a

function op_Option_tup4_R1_R2_R3_R4 (self: t_Option_tup4_R1_R2_R3_R4) (other: t_Option_tup4_R1_R2_R3_R4) : t_Option_Option_tup4_R1_R2_R3_R4
 = match { f0'1 = self; f1'1 = other } with
    | {f0'1 = None} -> Some'0 other
    | {f1'1 = None} -> Some'0 self
    | {f0'1 = Some x; f1'1 = Some y} -> map_Option_tup4_R1_R2_R3_R4 (op_tup4_R1_R2_R3_R4 x y) (fun (z: tup4_R1_R2_R3_R4) -> Some z)
    end

function commutative_Option_tup4_R1_R2_R3_R4 (a: t_Option_tup4_R1_R2_R3_R4) (b: t_Option_tup4_R1_R2_R3_R4) : ()

axiom commutative_Option_tup4_R1_R2_R3_R4_spec:
  forall a: t_Option_tup4_R1_R2_R3_R4, b: t_Option_tup4_R1_R2_R3_R4. op_Option_tup4_R1_R2_R3_R4 a b
    = op_Option_tup4_R1_R2_R3_R4 b a

type tup2_tup4_R1_R2_R3_R4_tup4_R1_R2_R3_R4 = { f0'3: tup4_R1_R2_R3_R4; f1'3: tup4_R1_R2_R3_R4 }

type tup2_R1_R1 = { f0'4: t_R1; f1'4: t_R1 }

function update_T1 (self: t_T1) (from_auth: t_R1) (from_frag: t_R1) : tup2_R1_R1

type tup2_R2_R2 = { f0'5: t_R2; f1'5: t_R2 }

function update_T2 (self: t_T2) (from_auth: t_R2) (from_frag: t_R2) : tup2_R2_R2

type tup2_R3_R3 = { f0'6: t_R3; f1'6: t_R3 }

function update_T3 (self: t_T3) (from_auth: t_R3) (from_frag: t_R3) : tup2_R3_R3

type tup2_R4_R4 = { f0'7: t_R4; f1'7: t_R4 }

function update_T4 (self: t_T4) (from_auth: t_R4) (from_frag: t_R4) : tup2_R4_R4

function update_tup4_T1_T2_T3_T4 [@inline:trivial] (self: tup4_T1_T2_T3_T4) (from_auth: tup4_R1_R2_R3_R4) (from_frag: tup4_R1_R2_R3_R4) : tup2_tup4_R1_R2_R3_R4_tup4_R1_R2_R3_R4
 =
  let v1 = update_T1 self.f0 from_auth.f0'0 from_frag.f0'0 in let v2 = update_T2 self.f1 from_auth.f1'0 from_frag.f1'0 in let v3 = update_T3 self.f2 from_auth.f2'0 from_frag.f2'0 in let v4 = update_T4 self.f3 from_auth.f3'0 from_frag.f3'0 in { f0'3 = { f0'0 = v1.f0'4;
                                                                                                                                                                                                                                                             f1'0 = v2.f0'5;
                                                                                                                                                                                                                                                             f2'0 = v3.f0'6;
                                                                                                                                                                                                                                                             f3'0 = v4.f0'7 };
                                                                                                                                                                                                                                                    f1'3 = { f0'0 = v1.f1'4;
                                                                                                                                                                                                                                                             f1'0 = v2.f1'5;
                                                                                                                                                                                                                                                             f2'0 = v3.f1'6;
                                                                                                                                                                                                                                                             f3'0 = v4.f1'7 } }

meta "rewrite_def" function update_tup4_T1_T2_T3_T4

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall self: tup4_T1_T2_T3_T4, from_auth: tup4_R1_R2_R3_R4, from_frag: tup4_R1_R2_R3_R4, frame: t_Option_tup4_R1_R2_R3_R4. premise_tup4_T1_T2_T3_T4 self from_auth from_frag
    -> op_Option_tup4_R1_R2_R3_R4 (Some from_frag) frame = Some'0 (Some from_auth)
    -> premise_tup4_T1_T2_T3_T4 self from_auth from_frag
    /\ op_Option_tup4_R1_R2_R3_R4 (Some from_frag) frame = Some'0 (Some from_auth)
    /\ (forall result: (). (let {f0'3 = to_auth; f1'3 = to_frag} = update_tup4_T1_T2_T3_T4 self from_auth from_frag in op_Option_tup4_R1_R2_R3_R4 (Some to_frag) frame
        = Some'0 (Some to_auth))
      -> (let {f0'3 = to_auth; f1'3 = to_frag} = update_tup4_T1_T2_T3_T4 self from_auth from_frag in op_Option_tup4_R1_R2_R3_R4 (Some to_frag) frame
      = Some'0 (Some to_auth)))
