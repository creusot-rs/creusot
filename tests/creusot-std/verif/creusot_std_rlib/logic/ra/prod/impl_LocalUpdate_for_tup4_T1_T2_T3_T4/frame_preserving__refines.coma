type t_Option_tup4_R1_R2_R3_R4 = None | Some tup4_R1_R2_R3_R4

predicate premise_T1 (self: t_T1) (from_auth: t_R1) (from_frag: t_R1)

predicate premise_T2 (self: t_T2) (from_auth: t_R2) (from_frag: t_R2)

predicate premise_T3 (self: t_T3) (from_auth: t_R3) (from_frag: t_R3)

predicate premise_T4 (self: t_T4) (from_auth: t_R4) (from_frag: t_R4)

