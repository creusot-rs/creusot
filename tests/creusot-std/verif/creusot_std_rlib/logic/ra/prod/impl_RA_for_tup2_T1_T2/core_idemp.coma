(* <(T1, T2) as logic::ra::RA> *)

type namespace_other

type t_Namespace = Other namespace_other

use map.Map

type t_T1

type t_T2

type tup2_T1_T2 = { f0: t_T1; f1: t_T2 }

type t_Option_tup2_T1_T2 = None | Some tup2_T1_T2

type t_Option_T1 = None'0 | Some'0 t_T1

type t_Option_T2 = None'1 | Some'1 t_T2

type tup2_Option_T1_Option_T2 = { f0'0: t_Option_T1; f1'0: t_Option_T2 }

function op_T1 (self: t_T1) (other: t_T1) : t_Option_T1

predicate incl_T1 (self: t_T1) (other: t_T1)

axiom incl_T1_spec: forall self: t_T1, other: t_T1 [incl_T1 self other]. incl_T1 self other
    = (exists factor: t_T1. op_T1 self factor = Some'0 other)

function incl_transitive_T1 (a: t_T1) (b: t_T1) (c: t_T1) : ()

axiom incl_transitive_T1_spec: forall a: t_T1, b: t_T1, c: t_T1. incl_T1 a b -> incl_T1 b c -> incl_T1 a c

function associative_some_T1 (a: t_T1) (b: t_T1) (c: t_T1) (ab: t_T1) (bc: t_T1) : ()

axiom associative_some_T1_spec: forall a: t_T1, b: t_T1, c: t_T1, ab: t_T1, bc: t_T1. op_T1 a b = Some'0 ab
    -> op_T1 b c = Some'0 bc -> op_T1 a bc = op_T1 ab c

function associative_none_T1 (a: t_T1) (b: t_T1) (c: t_T1) (bc: t_T1) : ()

axiom associative_none_T1_spec: forall a: t_T1, b: t_T1, c: t_T1, bc: t_T1. op_T1 a b = None'0
    -> op_T1 b c = Some'0 bc -> op_T1 a bc = None'0

function commutative_T1 (a: t_T1) (b: t_T1) : ()

axiom commutative_T1_spec: forall a: t_T1, b: t_T1. op_T1 a b = op_T1 b a

function incl_op_T1 (self: t_T1) (other: t_T1) (comb: t_T1) : ()

axiom incl_op_T1_spec: forall self: t_T1, other: t_T1, comb: t_T1. op_T1 self other = Some'0 comb -> incl_T1 self comb

function core_T1 (self: t_T1) : t_Option_T1

function op_T2 (self: t_T2) (other: t_T2) : t_Option_T2

predicate incl_T2 (self: t_T2) (other: t_T2)

axiom incl_T2_spec: forall self: t_T2, other: t_T2 [incl_T2 self other]. incl_T2 self other
    = (exists factor: t_T2. op_T2 self factor = Some'1 other)

function incl_transitive_T2 (a: t_T2) (b: t_T2) (c: t_T2) : ()

axiom incl_transitive_T2_spec: forall a: t_T2, b: t_T2, c: t_T2. incl_T2 a b -> incl_T2 b c -> incl_T2 a c

function associative_some_T2 (a: t_T2) (b: t_T2) (c: t_T2) (ab: t_T2) (bc: t_T2) : ()

axiom associative_some_T2_spec: forall a: t_T2, b: t_T2, c: t_T2, ab: t_T2, bc: t_T2. op_T2 a b = Some'1 ab
    -> op_T2 b c = Some'1 bc -> op_T2 a bc = op_T2 ab c

function associative_none_T2 (a: t_T2) (b: t_T2) (c: t_T2) (bc: t_T2) : ()

axiom associative_none_T2_spec: forall a: t_T2, b: t_T2, c: t_T2, bc: t_T2. op_T2 a b = None'1
    -> op_T2 b c = Some'1 bc -> op_T2 a bc = None'1

function commutative_T2 (a: t_T2) (b: t_T2) : ()

axiom commutative_T2_spec: forall a: t_T2, b: t_T2. op_T2 a b = op_T2 b a

function incl_op_T2 (self: t_T2) (other: t_T2) (comb: t_T2) : ()

axiom incl_op_T2_spec: forall self: t_T2, other: t_T2, comb: t_T2. op_T2 self other = Some'1 comb -> incl_T2 self comb

function core_T2 (self: t_T2) : t_Option_T2

function core_tup2_T1_T2 (self: tup2_T1_T2) : t_Option_tup2_T1_T2 = match { f0'0 = core_T1 self.f0;
                                                                            f1'0 = core_T2 self.f1 } with
    | {f0'0 = Some'0 v1; f1'0 = Some'1 v2} -> Some { f0 = v1; f1 = v2 }
    | _ -> None
    end

predicate index_Mapping_tup2_T1_T2_bool [@inline:trivial] (self: Map.map tup2_T1_T2 bool) (a: tup2_T1_T2) =
  Map.get self a

meta "rewrite_def" predicate index_Mapping_tup2_T1_T2_bool

function such_that_tup2_T1_T2 (p: Map.map tup2_T1_T2 bool) : tup2_T1_T2

axiom such_that_tup2_T1_T2_spec:
  forall p: Map.map tup2_T1_T2 bool [such_that_tup2_T1_T2 p]. (exists x: tup2_T1_T2. index_Mapping_tup2_T1_T2_bool p x)
    -> index_Mapping_tup2_T1_T2_bool p (such_that_tup2_T1_T2 p)

constant any_tup2_T1_T2: tup2_T1_T2 = such_that_tup2_T1_T2 (fun (__0: tup2_T1_T2) -> true)

function unwrap_Option_tup2_T1_T2 (self: t_Option_tup2_T1_T2) : tup2_T1_T2 = match self with
    | Some x -> x
    | None -> any_tup2_T1_T2
    end

function op_tup2_T1_T2 (self: tup2_T1_T2) (other: tup2_T1_T2) : t_Option_tup2_T1_T2 =
  match { f0'0 = op_T1 self.f0 other.f0; f1'0 = op_T2 self.f1 other.f1 } with
    | {f0'0 = Some'0 v1; f1'0 = Some'1 v2} -> Some { f0 = v1; f1 = v2 }
    | _ -> None
    end

predicate index_Mapping_T1_bool [@inline:trivial] (self: Map.map t_T1 bool) (a: t_T1) = Map.get self a

meta "rewrite_def" predicate index_Mapping_T1_bool

function such_that_T1 (p: Map.map t_T1 bool) : t_T1

axiom such_that_T1_spec: forall p: Map.map t_T1 bool [such_that_T1 p]. (exists x: t_T1. index_Mapping_T1_bool p x)
    -> index_Mapping_T1_bool p (such_that_T1 p)

constant any_T1: t_T1 = such_that_T1 (fun (__0: t_T1) -> true)

function unwrap_Option_T1 (self: t_Option_T1) : t_T1 = match self with
    | Some'0 x -> x
    | None'0 -> any_T1
    end

function core_idemp_T1 (self: t_T1) : ()

axiom core_idemp_T1_spec: forall self: t_T1. core_T1 self <> None'0
    -> (let c = unwrap_Option_T1 (core_T1 self) in op_T1 c c = Some'0 c)

axiom core_idemp_T1_spec'0: forall self: t_T1. core_T1 self <> None'0
    -> op_T1 (unwrap_Option_T1 (core_T1 self)) self = Some'0 self

predicate index_Mapping_T2_bool [@inline:trivial] (self: Map.map t_T2 bool) (a: t_T2) = Map.get self a

meta "rewrite_def" predicate index_Mapping_T2_bool

function such_that_T2 (p: Map.map t_T2 bool) : t_T2

axiom such_that_T2_spec: forall p: Map.map t_T2 bool [such_that_T2 p]. (exists x: t_T2. index_Mapping_T2_bool p x)
    -> index_Mapping_T2_bool p (such_that_T2 p)

constant any_T2: t_T2 = such_that_T2 (fun (__0: t_T2) -> true)

function unwrap_Option_T2 (self: t_Option_T2) : t_T2 = match self with
    | Some'1 x -> x
    | None'1 -> any_T2
    end

function core_idemp_T2 (self: t_T2) : ()

axiom core_idemp_T2_spec: forall self: t_T2. core_T2 self <> None'1
    -> (let c = unwrap_Option_T2 (core_T2 self) in op_T2 c c = Some'1 c)

axiom core_idemp_T2_spec'0: forall self: t_T2. core_T2 self <> None'1
    -> op_T2 (unwrap_Option_T2 (core_T2 self)) self = Some'1 self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : tup2_T1_T2

function core_idemp_tup2_T1_T2 (self: tup2_T1_T2) : ()

goal vc_core_idemp_tup2_T1_T2: core_tup2_T1_T2 self <> None
  -> ([@stop_split] [@expl:core_idemp requires] core_T1 self.f0 <> None'0)
  /\ (([@stop_split] [@expl:core_idemp ensures] ([@stop_split] [@expl:core_idemp ensures #0] let c = unwrap_Option_T1 (core_T1 self.f0) in op_T1 c c
      = Some'0 c)
    /\ ([@stop_split] [@expl:core_idemp ensures #1] op_T1 (unwrap_Option_T1 (core_T1 self.f0)) self.f0
    = Some'0 (self.f0)))
  -> (let _ = core_idemp_T1 self.f0 in ([@stop_split] [@expl:core_idemp requires] core_T2 self.f1 <> None'1)
  /\ (([@stop_split] [@expl:core_idemp ensures] ([@stop_split] [@expl:core_idemp ensures #0] let c = unwrap_Option_T2 (core_T2 self.f1) in op_T2 c c
      = Some'1 c)
    /\ ([@stop_split] [@expl:core_idemp ensures #1] op_T2 (unwrap_Option_T2 (core_T2 self.f1)) self.f1
    = Some'1 (self.f1)))
  -> (let _ = core_idemp_T2 self.f1 in [@stop_split] [@expl:core_idemp_tup2_T1_T2 ensures] ([@stop_split] [@expl:core_idemp ensures #0] let c = unwrap_Option_tup2_T1_T2 (core_tup2_T1_T2 self) in op_tup2_T1_T2 c c
    = Some c)
  /\ ([@stop_split] [@expl:core_idemp ensures #1] op_tup2_T1_T2 (unwrap_Option_tup2_T1_T2 (core_tup2_T1_T2 self)) self
  = Some self)))))
