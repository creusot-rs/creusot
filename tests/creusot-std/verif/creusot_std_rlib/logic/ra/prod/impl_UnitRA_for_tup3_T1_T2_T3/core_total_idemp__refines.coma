(* <(T1, T2, T3) as logic::ra::UnitRA> *)

type namespace_other

type t_Namespace = Other namespace_other

type t_T1

type t_T2

type t_T3

type tup3_T1_T2_T3 = { f0: t_T1; f1: t_T2; f2: t_T3 }

type t_Option_tup3_T1_T2_T3 = None | Some tup3_T1_T2_T3

type t_Option_T1 = None'0 | Some'0 t_T1

type t_Option_T2 = None'1 | Some'1 t_T2

type t_Option_T3 = None'2 | Some'2 t_T3

type tup3_Option_T1_Option_T2_Option_T3 = { f0'0: t_Option_T1; f1'0: t_Option_T2; f2'0: t_Option_T3 }

function op_T1 (self: t_T1) (other: t_T1) : t_Option_T1

predicate incl_T1 (self: t_T1) (other: t_T1)

axiom incl_T1_spec: forall self: t_T1, other: t_T1 [incl_T1 self other]. incl_T1 self other
    = (exists factor: t_T1. op_T1 self factor = Some'0 other)

function incl_transitive_T1 (a: t_T1) (b: t_T1) (c: t_T1) : ()

axiom incl_transitive_T1_spec: forall a: t_T1, b: t_T1, c: t_T1. incl_T1 a b -> incl_T1 b c -> incl_T1 a c

function associative_some_T1 (a: t_T1) (b: t_T1) (c: t_T1) (ab: t_T1) (bc: t_T1) : ()

axiom associative_some_T1_spec: forall a: t_T1, b: t_T1, c: t_T1, ab: t_T1, bc: t_T1. op_T1 a b = Some'0 ab
    -> op_T1 b c = Some'0 bc -> op_T1 a bc = op_T1 ab c

function associative_none_T1 (a: t_T1) (b: t_T1) (c: t_T1) (bc: t_T1) : ()

axiom associative_none_T1_spec: forall a: t_T1, b: t_T1, c: t_T1, bc: t_T1. op_T1 a b = None'0
    -> op_T1 b c = Some'0 bc -> op_T1 a bc = None'0

function commutative_T1 (a: t_T1) (b: t_T1) : ()

axiom commutative_T1_spec: forall a: t_T1, b: t_T1. op_T1 a b = op_T1 b a

function incl_op_T1 (self: t_T1) (other: t_T1) (comb: t_T1) : ()

axiom incl_op_T1_spec: forall self: t_T1, other: t_T1, comb: t_T1. op_T1 self other = Some'0 comb -> incl_T1 self comb

function op_T2 (self: t_T2) (other: t_T2) : t_Option_T2

predicate incl_T2 (self: t_T2) (other: t_T2)

axiom incl_T2_spec: forall self: t_T2, other: t_T2 [incl_T2 self other]. incl_T2 self other
    = (exists factor: t_T2. op_T2 self factor = Some'1 other)

function incl_transitive_T2 (a: t_T2) (b: t_T2) (c: t_T2) : ()

axiom incl_transitive_T2_spec: forall a: t_T2, b: t_T2, c: t_T2. incl_T2 a b -> incl_T2 b c -> incl_T2 a c

function associative_some_T2 (a: t_T2) (b: t_T2) (c: t_T2) (ab: t_T2) (bc: t_T2) : ()

axiom associative_some_T2_spec: forall a: t_T2, b: t_T2, c: t_T2, ab: t_T2, bc: t_T2. op_T2 a b = Some'1 ab
    -> op_T2 b c = Some'1 bc -> op_T2 a bc = op_T2 ab c

function associative_none_T2 (a: t_T2) (b: t_T2) (c: t_T2) (bc: t_T2) : ()

axiom associative_none_T2_spec: forall a: t_T2, b: t_T2, c: t_T2, bc: t_T2. op_T2 a b = None'1
    -> op_T2 b c = Some'1 bc -> op_T2 a bc = None'1

function commutative_T2 (a: t_T2) (b: t_T2) : ()

axiom commutative_T2_spec: forall a: t_T2, b: t_T2. op_T2 a b = op_T2 b a

function incl_op_T2 (self: t_T2) (other: t_T2) (comb: t_T2) : ()

axiom incl_op_T2_spec: forall self: t_T2, other: t_T2, comb: t_T2. op_T2 self other = Some'1 comb -> incl_T2 self comb

function op_T3 (self: t_T3) (other: t_T3) : t_Option_T3

predicate incl_T3 (self: t_T3) (other: t_T3)

axiom incl_T3_spec: forall self: t_T3, other: t_T3 [incl_T3 self other]. incl_T3 self other
    = (exists factor: t_T3. op_T3 self factor = Some'2 other)

function incl_transitive_T3 (a: t_T3) (b: t_T3) (c: t_T3) : ()

axiom incl_transitive_T3_spec: forall a: t_T3, b: t_T3, c: t_T3. incl_T3 a b -> incl_T3 b c -> incl_T3 a c

function associative_some_T3 (a: t_T3) (b: t_T3) (c: t_T3) (ab: t_T3) (bc: t_T3) : ()

axiom associative_some_T3_spec: forall a: t_T3, b: t_T3, c: t_T3, ab: t_T3, bc: t_T3. op_T3 a b = Some'2 ab
    -> op_T3 b c = Some'2 bc -> op_T3 a bc = op_T3 ab c

function associative_none_T3 (a: t_T3) (b: t_T3) (c: t_T3) (bc: t_T3) : ()

axiom associative_none_T3_spec: forall a: t_T3, b: t_T3, c: t_T3, bc: t_T3. op_T3 a b = None'2
    -> op_T3 b c = Some'2 bc -> op_T3 a bc = None'2

function commutative_T3 (a: t_T3) (b: t_T3) : ()

axiom commutative_T3_spec: forall a: t_T3, b: t_T3. op_T3 a b = op_T3 b a

function incl_op_T3 (self: t_T3) (other: t_T3) (comb: t_T3) : ()

axiom incl_op_T3_spec: forall self: t_T3, other: t_T3, comb: t_T3. op_T3 self other = Some'2 comb -> incl_T3 self comb

function op_tup3_T1_T2_T3 (self: tup3_T1_T2_T3) (other: tup3_T1_T2_T3) : t_Option_tup3_T1_T2_T3 =
  match { f0'0 = op_T1 self.f0 other.f0; f1'0 = op_T2 self.f1 other.f1; f2'0 = op_T3 self.f2 other.f2 } with
    | {f0'0 = Some'0 v1; f1'0 = Some'1 v2; f2'0 = Some'2 v3} -> Some { f0 = v1; f1 = v2; f2 = v3 }
    | _ -> None
    end

function commutative_tup3_T1_T2_T3 (a: tup3_T1_T2_T3) (b: tup3_T1_T2_T3) : () = ()

axiom commutative_tup3_T1_T2_T3_spec: forall a: tup3_T1_T2_T3, b: tup3_T1_T2_T3. op_tup3_T1_T2_T3 a b
    = op_tup3_T1_T2_T3 b a

function core_T1 (self: t_T1) : t_Option_T1

function core_T2 (self: t_T2) : t_Option_T2

function core_T3 (self: t_T3) : t_Option_T3

function core_tup3_T1_T2_T3 (self: tup3_T1_T2_T3) : t_Option_tup3_T1_T2_T3 = match { f0'0 = core_T1 self.f0;
                                                                                     f1'0 = core_T2 self.f1;
                                                                                     f2'0 = core_T3 self.f2 } with
    | {f0'0 = Some'0 v1; f1'0 = Some'1 v2; f2'0 = Some'2 v3} -> Some { f0 = v1; f1 = v2; f2 = v3 }
    | _ -> None
    end

constant unit_T1 : t_T1

axiom unit_T1_spec: forall x: t_T1 [op_T1 x unit_T1]. op_T1 x unit_T1 = Some'0 x

function core_total_T1 (self: t_T1) : t_T1

axiom core_total_T1_spec: forall self: t_T1 [core_total_T1 self]. core_T1 self = Some'0 (core_total_T1 self)

constant unit_core_T1 : ()

axiom unit_core_T1_spec: core_total_T1 unit_T1 = unit_T1

constant incl_refl_T1 : ()

axiom incl_refl_T1_spec: forall x: t_T1. incl_T1 x x

constant unit_T2 : t_T2

axiom unit_T2_spec: forall x: t_T2 [op_T2 x unit_T2]. op_T2 x unit_T2 = Some'1 x

function core_total_T2 (self: t_T2) : t_T2

axiom core_total_T2_spec: forall self: t_T2 [core_total_T2 self]. core_T2 self = Some'1 (core_total_T2 self)

constant unit_core_T2 : ()

axiom unit_core_T2_spec: core_total_T2 unit_T2 = unit_T2

constant incl_refl_T2 : ()

axiom incl_refl_T2_spec: forall x: t_T2. incl_T2 x x

constant unit_T3 : t_T3

axiom unit_T3_spec: forall x: t_T3 [op_T3 x unit_T3]. op_T3 x unit_T3 = Some'2 x

function core_total_T3 (self: t_T3) : t_T3

axiom core_total_T3_spec: forall self: t_T3 [core_total_T3 self]. core_T3 self = Some'2 (core_total_T3 self)

constant unit_core_T3 : ()

axiom unit_core_T3_spec: core_total_T3 unit_T3 = unit_T3

constant incl_refl_T3 : ()

axiom incl_refl_T3_spec: forall x: t_T3. incl_T3 x x

function core_total_tup3_T1_T2_T3 (self: tup3_T1_T2_T3) : tup3_T1_T2_T3 = { f0 = core_total_T1 self.f0;
                                                                            f1 = core_total_T2 self.f1;
                                                                            f2 = core_total_T3 self.f2 }

axiom core_total_tup3_T1_T2_T3_spec: forall self: tup3_T1_T2_T3 [core_total_tup3_T1_T2_T3 self]. core_tup3_T1_T2_T3 self
    = Some (core_total_tup3_T1_T2_T3 self)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall self: tup3_T1_T2_T3. forall result: (). op_tup3_T1_T2_T3 (core_total_tup3_T1_T2_T3 self) (core_total_tup3_T1_T2_T3 self)
          = Some (core_total_tup3_T1_T2_T3 self)
        /\ op_tup3_T1_T2_T3 (core_total_tup3_T1_T2_T3 self) self = Some self
      -> op_tup3_T1_T2_T3 (core_total_tup3_T1_T2_T3 self) (core_total_tup3_T1_T2_T3 self)
        = Some (core_total_tup3_T1_T2_T3 self)
      /\ op_tup3_T1_T2_T3 (core_total_tup3_T1_T2_T3 self) self = Some self
