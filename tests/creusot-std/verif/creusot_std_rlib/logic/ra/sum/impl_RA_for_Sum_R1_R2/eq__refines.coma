(* <logic::ra::sum::Sum<R1, R2> as logic::ra::RA> *)

type namespace_other

type t_Namespace = Other namespace_other

type t_R1

type t_R2

type t_Sum_R1_R2 = Left t_R1 | Right t_R2

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Sum_R1_R2, other: t_Sum_R1_R2. forall result: bool. result = (self = other)
      -> result = (self = other)
