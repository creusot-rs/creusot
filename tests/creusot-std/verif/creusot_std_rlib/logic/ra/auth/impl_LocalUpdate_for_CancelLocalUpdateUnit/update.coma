(* <logic::ra::auth::CancelLocalUpdateUnit as logic::ra::update::LocalUpdate<R>> *)

type namespace_other

type t_Namespace = Other namespace_other

use map.Map

type t_R

type tup2_R_R = { f0: t_R; f1: t_R }

type t_Option_R = None | Some t_R

function op_R (self: t_R) (other: t_R) : t_Option_R

predicate incl_R (self: t_R) (other: t_R)

axiom incl_R_spec: forall self: t_R, other: t_R [incl_R self other]. incl_R self other
    = (exists factor: t_R. op_R self factor = Some other)

function incl_transitive_R (a: t_R) (b: t_R) (c: t_R) : ()

axiom incl_transitive_R_spec: forall a: t_R, b: t_R, c: t_R. incl_R a b -> incl_R b c -> incl_R a c

function associative_some_R (a: t_R) (b: t_R) (c: t_R) (ab: t_R) (bc: t_R) : ()

axiom associative_some_R_spec: forall a: t_R, b: t_R, c: t_R, ab: t_R, bc: t_R. op_R a b = Some ab
    -> op_R b c = Some bc -> op_R a bc = op_R ab c

function associative_none_R (a: t_R) (b: t_R) (c: t_R) (bc: t_R) : ()

axiom associative_none_R_spec: forall a: t_R, b: t_R, c: t_R, bc: t_R. op_R a b = None
    -> op_R b c = Some bc -> op_R a bc = None

function commutative_R (a: t_R) (b: t_R) : ()

axiom commutative_R_spec: forall a: t_R, b: t_R. op_R a b = op_R b a

function incl_op_R (self: t_R) (other: t_R) (comb: t_R) : ()

axiom incl_op_R_spec: forall self: t_R, other: t_R, comb: t_R. op_R self other = Some comb -> incl_R self comb

function core_R (self: t_R) : t_Option_R

function core_total_R (self: t_R) : t_R

axiom core_total_R_spec: forall self: t_R [core_total_R self]. core_R self = Some (core_total_R self)

constant unit_R : t_R

axiom unit_R_spec: forall x: t_R [op_R x unit_R]. op_R x unit_R = Some x

constant unit_core_R : ()

axiom unit_core_R_spec: core_total_R unit_R = unit_R

constant incl_refl_R : ()

axiom incl_refl_R_spec: forall x: t_R. incl_R x x

function factor_R (self: t_R) (factor: t_R) : t_R

axiom factor_R_spec: forall self: t_R, factor: t_R [factor_R self factor]. incl_R factor self
    -> op_R factor (factor_R self factor) = Some self

predicate index_Mapping_R_bool [@inline:trivial] (self: Map.map t_R bool) (a: t_R) = Map.get self a

meta "rewrite_def" predicate index_Mapping_R_bool

function such_that_R (p: Map.map t_R bool) : t_R

axiom such_that_R_spec: forall p: Map.map t_R bool [such_that_R p]. (exists x: t_R. index_Mapping_R_bool p x)
    -> index_Mapping_R_bool p (such_that_R p)

constant any_R: t_R = such_that_R (fun (_0: t_R) -> true)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : ()

constant from_auth : t_R

constant from_frag : t_R

function update_CancelLocalUpdateUnit (self: ()) (from_auth: t_R) (from_frag: t_R) : tup2_R_R

goal vc_update_CancelLocalUpdateUnit: ([@stop_split] [@expl:incl ensures] incl_R from_frag from_auth
    = (exists factor: t_R. op_R from_frag factor = Some from_auth))
  -> (if incl_R from_frag from_auth then
    ([@stop_split] [@expl:factor requires] incl_R from_frag from_auth)
    /\ (([@stop_split] [@expl:factor ensures] op_R from_frag (factor_R from_auth from_frag) = Some from_auth)
    -> (let f = factor_R from_auth from_frag in ([@stop_split] [@expl:unit ensures] forall x: t_R [op_R x unit_R]. op_R x unit_R
        = Some x)
    -> (let result = { f0 = f;
                       f1 = unit_R } in [@stop_split] [@expl:update_CancelLocalUpdateUnit ensures] ([@stop_split] [@expl:update ensures #0] result.f1
      = unit_R)
    /\ ([@stop_split] [@expl:update ensures #1] incl_R from_frag from_auth
    -> op_R result.f0 from_frag = Some from_auth))))
  else
    let f = any_R in ([@stop_split] [@expl:unit ensures] forall x: t_R [op_R x unit_R]. op_R x unit_R = Some x)
    -> (let result = { f0 = f;
                       f1 = unit_R } in [@stop_split] [@expl:update_CancelLocalUpdateUnit ensures] ([@stop_split] [@expl:update ensures #0] result.f1
      = unit_R)
    /\ ([@stop_split] [@expl:update ensures #1] incl_R from_frag from_auth
    -> op_R result.f0 from_frag = Some from_auth))
  )
