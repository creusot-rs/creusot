(* <logic::real::Real as logic::ord::OrdLogic> *)

use real.Real

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: Real.real, other: Real.real. forall result: (). Real.(<) self other
        \/ self = other \/ Real.(<) other self -> Real.(<) self other \/ self = other \/ Real.(<) other self
