(* <logic::real::Real as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use real.Real

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : Real.real

constant other : Real.real

function le_lt_log_Real (self: Real.real) (other: Real.real) : ()

goal vc_le_lt_log_Real: [@stop_split] [@expl:le_lt_log ensures] Real.(<=) self other
  = (Real.(<) self other \/ self = other)
