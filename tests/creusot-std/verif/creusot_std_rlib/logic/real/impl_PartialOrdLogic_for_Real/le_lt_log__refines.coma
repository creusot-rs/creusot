(* <logic::real::Real as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use real.Real

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: Real.real, other: Real.real. forall result: (). Real.(<=) self other
        = (Real.(<) self other \/ self = other) -> Real.(<=) self other = (Real.(<) self other \/ self = other)
