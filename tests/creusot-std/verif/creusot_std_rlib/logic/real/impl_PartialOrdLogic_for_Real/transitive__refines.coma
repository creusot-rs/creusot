(* <logic::real::Real as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use real.Real

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall x: Real.real, y: Real.real, z: Real.real. Real.(<) x y
    -> Real.(<) y z -> Real.(<) x y /\ Real.(<) y z /\ (forall result: (). Real.(<) x z -> Real.(<) x z)
