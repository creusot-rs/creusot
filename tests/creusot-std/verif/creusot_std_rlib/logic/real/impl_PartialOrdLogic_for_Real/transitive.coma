(* <logic::real::Real as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

use real.Real

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant x : Real.real

constant y : Real.real

constant z : Real.real

function transitive_Real (x: Real.real) (y: Real.real) (z: Real.real) : ()

goal vc_transitive_Real: Real.(<) x y -> Real.(<) y z -> ([@stop_split] [@expl:transitive ensures] Real.(<) x z)
