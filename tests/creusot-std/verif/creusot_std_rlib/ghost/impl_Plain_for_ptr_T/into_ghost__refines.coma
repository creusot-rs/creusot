(* <*const T as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Opaque

predicate inv_ptr_T [@inline:trivial] (_1: Opaque.ptr) = true

meta "rewrite_def" predicate inv_ptr_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: Opaque.ptr. inv_ptr_T snap -> (forall result: Opaque.ptr. result = snap -> result = snap)
