    | s3 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & self: MutBorrow.t t_Fragment_R = self
  | & target: t_R = target
  | & _11: () = Any.any_l ()
  | & _12: MutBorrow.t t_Resource_View_AuthViewRel_R = Any.any_l () ])
  [ return (result: ()) ->
