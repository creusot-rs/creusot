let add_fragment_R (self: MutBorrow.t t_Authority_R) (frag: t_R) (return (x: t_Fragment_R)) =
{[@stop_split] [@expl:add_fragment_R requires] ([@stop_split] [@expl:add_fragment 'self' type invariant] inv_refmut_Authority_R self)
  /\ ([@stop_split] [@expl:add_fragment requires] op_R (view_Authority_R self.current) frag <> None)}
  (! bb0
