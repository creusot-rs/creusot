    [ s0 = id_ghost_R {self.current} (fun (_x: t_Id) -> [ &_14 <- _x ] s1)
    | s1 = new_unit_R {_14} (fun (_x: t_Fragment_R) -> [ &unit' <- _x ] s2)
    | s2 = MutBorrow.borrow_mut <t_Fragment_R> {unit'}
        (fun (_bor: MutBorrow.t t_Fragment_R) -> [ &_19 <- _bor ] [ &unit' <- _bor.final ] s3)
    | s3 = [ &_20 <- { f0'1 = frag } ] s4
    | s4 = MutBorrow.borrow_final <t_Authority_R> {self.current} {MutBorrow.get_id self}
        (fun (_bor: MutBorrow.t t_Authority_R) ->
          [ &_17 <- _bor ] -{inv_Authority_R _bor.final}-
          [ &self <- { self with current = _bor.final } ] s5)
