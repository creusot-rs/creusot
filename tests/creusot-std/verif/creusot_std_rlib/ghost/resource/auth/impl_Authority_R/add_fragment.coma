    | s5 = MutBorrow.borrow_final <t_Fragment_R> {_19.current} {MutBorrow.get_id _19}
        (fun (_bor: MutBorrow.t t_Fragment_R) -> [ &_18 <- _bor ] [ &_19 <- { _19 with current = _bor.final } ] s6)
    | s6 = update_R {_17} {_18} {_20} (fun (_x: ()) -> [ &_16 <- _x ] s7)
    | s7 = -{resolve_refmut_Fragment_R _19}- s8
    | s8 = s9 [ _ck -> (! {[@expl:type invariant] inv_refmut_Authority_R self} any) ]
    | s9 = -{resolve_refmut_Authority_R self}- s10
    | s10 = [ &_ret <- unit' ] s11
    | s11 = return {_ret} ] ]
  [ & _ret: t_Fragment_R = Any.any_l ()
  | & self: MutBorrow.t t_Authority_R = self
  | & frag: t_R = frag
  | & unit': t_Fragment_R = Any.any_l ()
  | & _14: t_Id = Any.any_l ()
  | & _16: () = Any.any_l ()
  | & _17: MutBorrow.t t_Authority_R = Any.any_l ()
  | & _18: MutBorrow.t t_Fragment_R = Any.any_l ()
  | & _19: MutBorrow.t t_Fragment_R = Any.any_l ()
  | & _20: t_OpLocalUpdate_R = Any.any_l () ])
