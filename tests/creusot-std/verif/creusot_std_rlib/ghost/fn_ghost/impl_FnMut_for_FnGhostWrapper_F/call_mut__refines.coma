(* <ghost::fn_ghost::FnGhostWrapper<F> as std::ops::FnMut<I>> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Mode
use creusot.prelude.MutBorrow

type t_F

type t_FnGhostWrapper_F = { f0: t_F }

type t_I

predicate inv_F (_1: t_F)

predicate inv_FnGhostWrapper_F (_1: t_FnGhostWrapper_F)

axiom inv_axiom [@rewrite]: forall _1: t_FnGhostWrapper_F [inv_FnGhostWrapper_F _1]. inv_FnGhostWrapper_F _1
    = inv_F _1.f0

predicate invariant_refmut_FnGhostWrapper_F [@inline:trivial] (self: MutBorrow.t t_FnGhostWrapper_F) =
  inv_FnGhostWrapper_F self.current /\ inv_FnGhostWrapper_F self.final

meta "rewrite_def" predicate invariant_refmut_FnGhostWrapper_F

predicate inv_refmut_FnGhostWrapper_F [@inline:trivial] (_1: MutBorrow.t t_FnGhostWrapper_F) =
  invariant_refmut_FnGhostWrapper_F _1

meta "rewrite_def" predicate inv_refmut_FnGhostWrapper_F

predicate inv_I (_1: t_I)

predicate precondition_F (self: t_F) (args: t_I) (mode: Mode.t)

predicate precondition_FnGhostWrapper_F (self: t_FnGhostWrapper_F) (args: t_I) (mode: Mode.t) =
  precondition_F self.f0 args mode

meta "rewrite_def" predicate precondition_FnGhostWrapper_F

type t_Output

predicate inv_Output (_1: t_Output)

predicate postcondition_once_F (self: t_F) (args: t_I) (result: t_Output) (mode: Mode.t)

predicate resolve_F (_1: t_F)

predicate postcondition_mut_F (self: t_F) (args: t_I) (result_state: t_F) (result: t_Output) (mode: Mode.t)

function fn_mut_once_F (self: t_F) (args: t_I) (res: t_Output) (mode: Mode.t) : ()

axiom fn_mut_once_F_spec:
  forall self: t_F, args: t_I, res: t_Output, mode: Mode.t [postcondition_once_F self args res mode]. postcondition_once_F self args res mode
    = (exists res_state: t_F. postcondition_mut_F self args res_state res mode /\ resolve_F res_state)

predicate hist_inv_F (self: t_F) (result_state: t_F)

function hist_inv_trans_F (self: t_F) (b: t_F) (c: t_F) : ()

axiom hist_inv_trans_F_spec:
  forall self: t_F, b: t_F, c: t_F [hist_inv_F self b, hist_inv_F b c | hist_inv_F self b, hist_inv_F self c | hist_inv_F b c, hist_inv_F self c]. hist_inv_F self b
    -> hist_inv_F b c -> hist_inv_F self c

function hist_inv_refl_F (self: t_F) : ()

axiom hist_inv_refl_F_spec: forall self: t_F [hist_inv_F self self]. hist_inv_F self self

function postcondition_mut_hist_inv_F (self: t_F) (args: t_I) (res_state: t_F) (res: t_Output) (mode: Mode.t) : ()

axiom postcondition_mut_hist_inv_F_spec:
  forall self: t_F, args: t_I, res_state: t_F, res: t_Output, mode: Mode.t [postcondition_mut_F self args res_state res mode | hist_inv_F self res_state]. postcondition_mut_F self args res_state res mode
    -> hist_inv_F self res_state

predicate postcondition_mut_FnGhostWrapper_F (self: t_FnGhostWrapper_F) (args: t_I) (result_state: t_FnGhostWrapper_F) (result: t_Output) (mode: Mode.t) =
  postcondition_mut_F self.f0 args result_state.f0 result mode

meta "rewrite_def" predicate postcondition_mut_FnGhostWrapper_F

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall mode: Mode.t, self: MutBorrow.t t_FnGhostWrapper_F, args: t_I. inv_refmut_FnGhostWrapper_F self
    -> inv_I args
    -> precondition_FnGhostWrapper_F self.current args mode
    -> inv_refmut_FnGhostWrapper_F self
    /\ inv_I args
    /\ precondition_FnGhostWrapper_F self.current args mode
    /\ (forall result: t_Output. inv_Output result
        /\ postcondition_mut_FnGhostWrapper_F self.current args self.final result mode
      -> inv_Output result /\ postcondition_mut_FnGhostWrapper_F self.current args self.final result mode)
