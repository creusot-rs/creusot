(* <ghost::fn_ghost::ErasedGhostFn<T, A, R> as std::ops::FnOnce<(&mut <A as ghost::fn_ghost::ErasedGhostFnArg>::Ty<'a, T>,)>> *)

use creusot.prelude.MutBorrow

type t_ErasedGhostFn_T_A_R = { f0: () }

type t_Ty

predicate inv_Ty (_1: t_Ty)

predicate invariant_refmut_Ty [@inline:trivial] (self: MutBorrow.t t_Ty) = inv_Ty self.current /\ inv_Ty self.final

meta "rewrite_def" predicate invariant_refmut_Ty

predicate inv_refmut_Ty [@inline:trivial] (_1: MutBorrow.t t_Ty) = invariant_refmut_Ty _1

meta "rewrite_def" predicate inv_refmut_Ty

predicate inv_tup1_refmut_Ty [@inline:trivial] (_1: MutBorrow.t t_Ty) = inv_refmut_Ty _1

meta "rewrite_def" predicate inv_tup1_refmut_Ty

predicate precondition_ErasedGhostFn_T_A_R (self: t_ErasedGhostFn_T_A_R) (args: MutBorrow.t t_Ty)

type t_R

predicate inv_R (_1: t_R)

predicate postcondition_once_ErasedGhostFn_T_A_R (self: t_ErasedGhostFn_T_A_R) (args: MutBorrow.t t_Ty) (result: t_R)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_ErasedGhostFn_T_A_R, args: MutBorrow.t t_Ty. inv_tup1_refmut_Ty args
    -> precondition_ErasedGhostFn_T_A_R self args
    -> inv_tup1_refmut_Ty args
    /\ (forall result: t_R. inv_R result -> inv_R result /\ postcondition_once_ErasedGhostFn_T_A_R self args result)
