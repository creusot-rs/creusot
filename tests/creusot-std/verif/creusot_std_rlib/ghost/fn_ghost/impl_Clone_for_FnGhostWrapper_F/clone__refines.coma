(* <ghost::fn_ghost::FnGhostWrapper<F> as std::clone::Clone> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Mode

type t_F

type t_FnGhostWrapper_F = { f0: t_F }

predicate inv_F (_1: t_F)

predicate inv_FnGhostWrapper_F (_1: t_FnGhostWrapper_F)

axiom inv_axiom [@rewrite]: forall _1: t_FnGhostWrapper_F [inv_FnGhostWrapper_F _1]. inv_FnGhostWrapper_F _1
    = inv_F _1.f0

predicate invariant_ref_FnGhostWrapper_F [@inline:trivial] (self: t_FnGhostWrapper_F) = inv_FnGhostWrapper_F self

meta "rewrite_def" predicate invariant_ref_FnGhostWrapper_F

predicate inv_ref_FnGhostWrapper_F [@inline:trivial] (_1: t_FnGhostWrapper_F) = invariant_ref_FnGhostWrapper_F _1

meta "rewrite_def" predicate inv_ref_FnGhostWrapper_F

predicate postcondition_clone (self: ()) (args: t_F) (result: t_F) (mode: Mode.t)

axiom postcondition_fndef:
  forall args: t_F, result: t_F, mode: Mode.t [postcondition_clone () args result mode]. postcondition_clone () args result mode
    -> (let self = args in inv_F result)

predicate invariant_ref_F [@inline:trivial] (self: t_F) = inv_F self

meta "rewrite_def" predicate invariant_ref_F

predicate inv_ref_F [@inline:trivial] (_1: t_F) = invariant_ref_F _1

meta "rewrite_def" predicate inv_ref_F

predicate precondition_clone (self: ()) (args: t_F) (mode: Mode.t)

axiom precondition_fndef:
  forall mode: Mode.t. forall args: t_F [precondition_clone () args mode]. (let self = args in inv_ref_F self)
      -> precondition_clone () args mode

predicate postcondition_once_clone (self: ()) (args: t_F) (result: t_F) (mode: Mode.t) =
  postcondition_clone self args result mode

meta "rewrite_def" predicate postcondition_once_clone

let clone_F (self: t_F) (mode: Mode.t) (return (x: t_F)) =
{[@stop_split] [@expl:clone requires] precondition_clone () self mode}
  any
  [ return (result: t_F) -> {[@stop_split] [@expl:clone ensures] postcondition_once_clone () self result mode}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall mode: Mode.t, self: t_FnGhostWrapper_F. inv_ref_FnGhostWrapper_F self
    -> inv_ref_FnGhostWrapper_F self
    /\ (forall result: t_FnGhostWrapper_F. inv_FnGhostWrapper_F result /\ postcondition_clone () self.f0 result.f0 mode
      -> inv_FnGhostWrapper_F result)
