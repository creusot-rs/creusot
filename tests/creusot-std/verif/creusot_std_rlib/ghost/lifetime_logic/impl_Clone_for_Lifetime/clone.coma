(* <ghost::lifetime_logic::Lifetime as std::clone::Clone> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Any

type t_Id

type t_Lifetime = { f0: t_Id }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let clone_Lifetime (self: t_Lifetime) (return (x: t_Lifetime)) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ]
  [ & _ret: t_Lifetime = Any.any_l () | & self: t_Lifetime = self ])
  [ return (result: t_Lifetime) -> {[@stop_split] [@expl:clone ensures] result = self} (! return {result}) ]
