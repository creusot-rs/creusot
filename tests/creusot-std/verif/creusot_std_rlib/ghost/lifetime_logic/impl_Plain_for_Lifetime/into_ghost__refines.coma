(* <ghost::lifetime_logic::Lifetime as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

type t_Id

type t_Lifetime = { f0: t_Id }

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: t_Lifetime. forall result: t_Lifetime. result = snap -> result = snap
