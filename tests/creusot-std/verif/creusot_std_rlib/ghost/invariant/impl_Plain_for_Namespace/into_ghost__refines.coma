(* <ghost::invariant::Namespace as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

predicate inv_Namespace [@inline:trivial] (_1: t_Namespace) = true

meta "rewrite_def" predicate inv_Namespace

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: t_Namespace. inv_Namespace snap
    -> (forall result: t_Namespace. result = snap -> result = snap)
