let clone_NotObjective (self: ()) (return (x: ())) = (! bb0
  [ bb0 = s0 [ s0 = [ &_ret <- self ] s1 | s1 = return {_ret} ] ] [ & _ret: () = Any.any_l () | & self: () = self ])
  [ return (result: ()) -> {[@stop_split] [@expl:clone ensures] result = self} (! return {result}) ]
