(* cell::permcell::PermCell<T> *)

use creusot.prelude.Mode
use creusot.prelude.MutBorrow
use creusot.prelude.Any

type t_T

predicate precondition_default (self: ()) (mode: Mode.t) (args: ())

axiom precondition_fndef:
  forall mode: Mode.t. forall args: () [precondition_default () mode args]. (let () = args in true)
      -> precondition_default () mode args

predicate inv_T (_1: t_T)

predicate postcondition_default (self: ()) (mode: Mode.t) (args: ()) (result: t_T)

axiom postcondition_fndef:
  forall mode: Mode.t, args: (), res: t_T [postcondition_default () mode args res]. postcondition_default () mode args res
    -> (let () = args in inv_T res)

predicate postcondition_once_default (self: ()) (mode: Mode.t) (args: ()) (result: t_T) =
  postcondition_default self mode args result

meta "rewrite_def" predicate postcondition_once_default

let default_T (mode: Mode.t) (return (x: t_T)) =
{[@stop_split] [@expl:default requires] precondition_default () mode ()}
  any
  [ return (result: t_T) -> {[@stop_split] [@expl:default ensures] postcondition_once_default () mode () result}
    (! return {result}) ]

type t_PermCell_T

type t_Perm_PermCell_T

function ward_PermCell_T (self: t_Perm_PermCell_T) : t_PermCell_T

function val_PermCell_T (self: t_Perm_PermCell_T) : t_T

function fin_Ghost_refmut_Perm_PermCell_T [@inline:trivial] (self: MutBorrow.t t_Perm_PermCell_T) : t_Perm_PermCell_T =
  self.final

meta "rewrite_def" function fin_Ghost_refmut_Perm_PermCell_T

let replace_T (mode: Mode.t) (self: t_PermCell_T) (perm: MutBorrow.t t_Perm_PermCell_T) (val': t_T) (return (x: t_T)) =
{[@stop_split] [@expl:replace_T requires] ([@stop_split] [@expl:replace 'val' type invariant] inv_T val')
  /\ ([@stop_split] [@expl:replace requires] self = ward_PermCell_T perm.current)}
  any
  [ return (result: t_T) ->
  {[@stop_split] [@expl:replace_T ensures] ([@stop_split] [@expl:replace result type invariant] inv_T result)
    /\ ([@stop_split] [@expl:replace ensures #0] val' = val_PermCell_T (fin_Ghost_refmut_Perm_PermCell_T perm))
    /\ ([@stop_split] [@expl:replace ensures #1] result = val_PermCell_T perm.current)
    /\ ([@stop_split] [@expl:replace ensures #2] self = ward_PermCell_T (fin_Ghost_refmut_Perm_PermCell_T perm))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let take_T (mode: Mode.t) (self: t_PermCell_T) (perm: MutBorrow.t t_Perm_PermCell_T) (return (x: t_T)) =
{[@stop_split] [@expl:take requires] self = ward_PermCell_T perm.current}
  (! bb0
  [ bb0 = s0
    [ s0 = default_T {mode} (fun (_x: t_T) -> [ &_15 <- _x ] s1)
    | s1 = replace_T {mode} {self} {perm} {_15} (fun (_x: t_T) -> [ &_ret <- _x ] s2)
    | s2 = return {_ret} ] ]
  [ & _ret: t_T = Any.any_l ()
  | & self: t_PermCell_T = self
  | & perm: MutBorrow.t t_Perm_PermCell_T = perm
  | & _15: t_T = Any.any_l () ])
  [ return (result: t_T) ->
  {[@stop_split] [@expl:take_T ensures] ([@stop_split] [@expl:take result type invariant] inv_T result)
    /\ ([@stop_split] [@expl:take ensures #0] self = ward_PermCell_T (fin_Ghost_refmut_Perm_PermCell_T perm))
    /\ ([@stop_split] [@expl:take ensures #1] result = val_PermCell_T perm.current)
    /\ ([@stop_split] [@expl:take ensures #2] postcondition_default () mode () (val_PermCell_T (fin_Ghost_refmut_Perm_PermCell_T perm)))}
    (! return {result}) ]
