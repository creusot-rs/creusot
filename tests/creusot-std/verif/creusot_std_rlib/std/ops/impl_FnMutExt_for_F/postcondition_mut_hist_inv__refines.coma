(* <F as std::ops::FnMutExt<Args>> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Mode

type t_F

type t_Args

type t_Output

predicate postcondition_mut_F (self: t_F) (args: t_Args) (result_state: t_F) (result: t_Output) (mode: Mode.t)

predicate hist_inv_F (self: t_F) (result_state: t_F)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall self: t_F, args: t_Args, res_state: t_F, res: t_Output, mode: Mode.t. postcondition_mut_F self args res_state res mode
    -> postcondition_mut_F self args res_state res mode
    /\ (forall result: (). hist_inv_F self res_state -> hist_inv_F self res_state)
