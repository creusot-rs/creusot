(* <std::collections::hash_map::IterMut<'a, K, V> as std::iter::ExactSizeIteratorSpec> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt64
use int.Int

type t_IterMut_K_V

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_FMap_DeepModelTy_refmut_V

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

function len_DeepModelTy (self: t_FMap_DeepModelTy_refmut_V) : int

axiom len_DeepModelTy_spec:
  forall self: t_FMap_DeepModelTy_refmut_V [len_DeepModelTy self]. ge_log_Int (len_DeepModelTy self) 0

function view_IterMut_K_V (self: t_IterMut_K_V) : t_FMap_DeepModelTy_refmut_V

predicate postcondition_size_hint (self: ()) (args: t_IterMut_K_V) (result: tup2_usize_Option_usize) =
  let self_ = args in UInt64.t'int result.f0 = len_DeepModelTy (view_IterMut_K_V self_) /\ result.f1 = Some (result.f0)

meta "rewrite_def" predicate postcondition_size_hint

predicate inv_IterMut_K_V (_1: t_IterMut_K_V)

predicate invariant_ref_IterMut_K_V [@inline:trivial] (self: t_IterMut_K_V) = inv_IterMut_K_V self

meta "rewrite_def" predicate invariant_ref_IterMut_K_V

predicate inv_ref_IterMut_K_V [@inline:trivial] (_1: t_IterMut_K_V) = invariant_ref_IterMut_K_V _1

meta "rewrite_def" predicate inv_ref_IterMut_K_V

let size_hint_IterMut_K_V (self_: t_IterMut_K_V) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self_' type invariant] inv_ref_IterMut_K_V self_}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_IterMut_K_V ensures] ([@stop_split] [@expl:size_hint ensures #0] UInt64.t'int result.f0
      = len_DeepModelTy (view_IterMut_K_V self_))
    /\ ([@stop_split] [@expl:size_hint ensures #1] result.f1 = Some (result.f0))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_IterMut_K_V, r: tup2_usize_Option_usize. postcondition_size_hint () self r
    -> postcondition_size_hint () self r /\ (forall result: (). r.f1 = Some (r.f0) -> r.f1 = Some (r.f0))
