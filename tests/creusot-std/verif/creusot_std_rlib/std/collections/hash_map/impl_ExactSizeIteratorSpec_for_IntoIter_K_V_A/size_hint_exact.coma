(* <std::collections::hash_map::IntoIter<K, V, A> as std::iter::ExactSizeIteratorSpec> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt64
use int.Int

type t_IntoIter_K_V_A

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_FMap_DeepModelTy_V

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

function len_DeepModelTy (self: t_FMap_DeepModelTy_V) : int

axiom len_DeepModelTy_spec:
  forall self: t_FMap_DeepModelTy_V [len_DeepModelTy self]. ge_log_Int (len_DeepModelTy self) 0

function view_IntoIter_K_V_A (self: t_IntoIter_K_V_A) : t_FMap_DeepModelTy_V

predicate postcondition_size_hint (self: ()) (args: t_IntoIter_K_V_A) (result: tup2_usize_Option_usize) =
  let self_ = args in UInt64.t'int result.f0 = len_DeepModelTy (view_IntoIter_K_V_A self_)
  /\ result.f1 = Some (result.f0)

meta "rewrite_def" predicate postcondition_size_hint

predicate inv_IntoIter_K_V_A (_1: t_IntoIter_K_V_A)

predicate invariant_ref_IntoIter_K_V_A [@inline:trivial] (self: t_IntoIter_K_V_A) = inv_IntoIter_K_V_A self

meta "rewrite_def" predicate invariant_ref_IntoIter_K_V_A

predicate inv_ref_IntoIter_K_V_A [@inline:trivial] (_1: t_IntoIter_K_V_A) = invariant_ref_IntoIter_K_V_A _1

meta "rewrite_def" predicate inv_ref_IntoIter_K_V_A

let size_hint_IntoIter_K_V_A (self_: t_IntoIter_K_V_A) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self_' type invariant] inv_ref_IntoIter_K_V_A self_}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_IntoIter_K_V_A ensures] ([@stop_split] [@expl:size_hint ensures #0] UInt64.t'int result.f0
      = len_DeepModelTy (view_IntoIter_K_V_A self_))
    /\ ([@stop_split] [@expl:size_hint ensures #1] result.f1 = Some (result.f0))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_IntoIter_K_V_A

constant r : tup2_usize_Option_usize

function size_hint_exact_IntoIter_K_V_A (self: t_IntoIter_K_V_A) (r: tup2_usize_Option_usize) : ()

goal vc_size_hint_exact_IntoIter_K_V_A: postcondition_size_hint () self r
  -> ([@stop_split] [@expl:size_hint_exact ensures] r.f1 = Some (r.f0))
