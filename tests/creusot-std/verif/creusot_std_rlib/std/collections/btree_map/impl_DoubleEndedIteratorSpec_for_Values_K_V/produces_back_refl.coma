(* <std::collections::btree_map::Values<'a, K, V> as std::iter::DoubleEndedIteratorSpec> *)

use seq.Seq
use seq.Reverse

type t_Values_K_V

type t_V

function view_Values_K_V (self: t_Values_K_V) : Seq.seq t_V

predicate produces_back_Values_K_V (self: t_Values_K_V) (visited: Seq.seq t_V) (tl: t_Values_K_V) =
  view_Values_K_V self = Seq.(++) (view_Values_K_V tl) (Reverse.reverse visited)

constant reverse_empty_ref_V : ()

axiom reverse_empty_ref_V_spec: Reverse.reverse (Seq.empty: Seq.seq t_V) = (Seq.empty: Seq.seq t_V)

function concat_empty_ref_V (self: Seq.seq t_V) : ()

axiom concat_empty_ref_V_spec: forall self: Seq.seq t_V. Seq.(++) self (Seq.empty: Seq.seq t_V) = self

axiom concat_empty_ref_V_spec'0: forall self: Seq.seq t_V. Seq.(++) (Seq.empty: Seq.seq t_V) self = self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Values_K_V

function produces_back_refl_Values_K_V (self: t_Values_K_V) : ()

goal vc_produces_back_refl_Values_K_V:
  ([@stop_split] [@expl:reverse_empty ensures] Reverse.reverse (Seq.empty: Seq.seq t_V) = (Seq.empty: Seq.seq t_V))
  -> ([@stop_split] [@expl:produces_back_refl ensures] produces_back_Values_K_V self (Seq.empty: Seq.seq t_V) self)
