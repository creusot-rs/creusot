(* <std::collections::btree_map::Values<'a, K, V> as std::iter::DoubleEndedIteratorSpec> *)

use seq.Seq
use seq.Reverse

type t_Values_K_V

type t_V

function view_Values_K_V (self: t_Values_K_V) : Seq.seq t_V

predicate produces_back_Values_K_V (self: t_Values_K_V) (visited: Seq.seq t_V) (tl: t_Values_K_V) =
  view_Values_K_V self = Seq.(++) (view_Values_K_V tl) (Reverse.reverse visited)

function reverse_concat_ref_V (self: Seq.seq t_V) (other: Seq.seq t_V) : ()

axiom reverse_concat_ref_V_spec: forall self: Seq.seq t_V, other: Seq.seq t_V. Reverse.reverse (Seq.(++) self other)
    = Seq.(++) (Reverse.reverse other) (Reverse.reverse self)

function concat_assoc_ref_V (self: Seq.seq t_V) (other1: Seq.seq t_V) (other2: Seq.seq t_V) : ()

axiom concat_assoc_ref_V_spec:
  forall self: Seq.seq t_V, other1: Seq.seq t_V, other2: Seq.seq t_V. Seq.(++) (Seq.(++) self other1) other2
    = Seq.(++) self (Seq.(++) other1 other2)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : t_Values_K_V

constant ab : Seq.seq t_V

constant b : t_Values_K_V

constant bc : Seq.seq t_V

constant c : t_Values_K_V

function produces_back_trans_Values_K_V (a: t_Values_K_V) (ab: Seq.seq t_V) (b: t_Values_K_V) (bc: Seq.seq t_V) (c: t_Values_K_V) : ()

goal vc_produces_back_trans_Values_K_V: produces_back_Values_K_V a ab b
  -> produces_back_Values_K_V b bc c
  -> ([@stop_split] [@expl:reverse_concat ensures] Reverse.reverse (Seq.(++) ab bc)
    = Seq.(++) (Reverse.reverse bc) (Reverse.reverse ab))
  -> ([@stop_split] [@expl:produces_back_trans ensures] produces_back_Values_K_V a (Seq.(++) ab bc) c)
