(* <std::collections::btree_map::RangeMut<'a, K, V> as std::iter::IteratorSpec> *)

use creusot.prelude.MutBorrow
use seq.Seq

type t_RangeMut_K_V

type t_K

type t_V

type tup2_ref_K_refmut_V = { f0: t_K; f1: MutBorrow.t t_V }

function view_RangeMut_K_V (self: t_RangeMut_K_V) : Seq.seq tup2_ref_K_refmut_V

predicate produces_RangeMut_K_V (self: t_RangeMut_K_V) (visited: Seq.seq tup2_ref_K_refmut_V) (tl: t_RangeMut_K_V) =
  view_RangeMut_K_V self = Seq.(++) visited (view_RangeMut_K_V tl)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall self: t_RangeMut_K_V. forall result: (). produces_RangeMut_K_V self (Seq.empty: Seq.seq tup2_ref_K_refmut_V) self
      -> produces_RangeMut_K_V self (Seq.empty: Seq.seq tup2_ref_K_refmut_V) self
