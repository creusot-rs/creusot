(* <std::collections::btree_map::Keys<'a, K, V> as std::iter::IteratorSpec> *)

use seq.Seq

type t_Keys_K_V

type t_K

function view_Keys_K_V (self: t_Keys_K_V) : Seq.seq t_K

predicate produces_Keys_K_V (self: t_Keys_K_V) (visited: Seq.seq t_K) (tl: t_Keys_K_V) =
  view_Keys_K_V self = Seq.(++) visited (view_Keys_K_V tl)

function concat_assoc_ref_K (self: Seq.seq t_K) (other1: Seq.seq t_K) (other2: Seq.seq t_K) : ()

axiom concat_assoc_ref_K_spec:
  forall self: Seq.seq t_K, other1: Seq.seq t_K, other2: Seq.seq t_K. Seq.(++) (Seq.(++) self other1) other2
    = Seq.(++) self (Seq.(++) other1 other2)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : t_Keys_K_V

constant ab : Seq.seq t_K

constant b : t_Keys_K_V

constant bc : Seq.seq t_K

constant c : t_Keys_K_V

function produces_trans_Keys_K_V (a: t_Keys_K_V) (ab: Seq.seq t_K) (b: t_Keys_K_V) (bc: Seq.seq t_K) (c: t_Keys_K_V) : ()

goal vc_produces_trans_Keys_K_V: produces_Keys_K_V a ab b
  -> produces_Keys_K_V b bc c -> ([@stop_split] [@expl:produces_trans ensures] produces_Keys_K_V a (Seq.(++) ab bc) c)
