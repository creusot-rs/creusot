(* <std::collections::btree_map::Keys<'a, K, V> as std::iter::DoubleEndedIteratorSpec> *)

use seq.Seq
use seq.Reverse

type t_Keys_K_V

type t_K

function view_Keys_K_V (self: t_Keys_K_V) : Seq.seq t_K

predicate produces_back_Keys_K_V (self: t_Keys_K_V) (visited: Seq.seq t_K) (tl: t_Keys_K_V) =
  view_Keys_K_V self = Seq.(++) (view_Keys_K_V tl) (Reverse.reverse visited)

function reverse_concat_ref_K (self: Seq.seq t_K) (other: Seq.seq t_K) : ()

axiom reverse_concat_ref_K_spec: forall self: Seq.seq t_K, other: Seq.seq t_K. Reverse.reverse (Seq.(++) self other)
    = Seq.(++) (Reverse.reverse other) (Reverse.reverse self)

function concat_assoc_ref_K (self: Seq.seq t_K) (other1: Seq.seq t_K) (other2: Seq.seq t_K) : ()

axiom concat_assoc_ref_K_spec:
  forall self: Seq.seq t_K, other1: Seq.seq t_K, other2: Seq.seq t_K. Seq.(++) (Seq.(++) self other1) other2
    = Seq.(++) self (Seq.(++) other1 other2)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : t_Keys_K_V

constant ab : Seq.seq t_K

constant b : t_Keys_K_V

constant bc : Seq.seq t_K

constant c : t_Keys_K_V

function produces_back_trans_Keys_K_V (a: t_Keys_K_V) (ab: Seq.seq t_K) (b: t_Keys_K_V) (bc: Seq.seq t_K) (c: t_Keys_K_V) : ()

goal vc_produces_back_trans_Keys_K_V: produces_back_Keys_K_V a ab b
  -> produces_back_Keys_K_V b bc c
  -> ([@stop_split] [@expl:reverse_concat ensures] Reverse.reverse (Seq.(++) ab bc)
    = Seq.(++) (Reverse.reverse bc) (Reverse.reverse ab))
  -> ([@stop_split] [@expl:produces_back_trans ensures] produces_back_Keys_K_V a (Seq.(++) ab bc) c)
