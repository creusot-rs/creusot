(* <std::collections::btree_map::Keys<'a, K, V> as std::iter::DoubleEndedIteratorSpec> *)

use creusot.int.UInt64
use seq.Seq
use seq.Reverse
use creusot.prelude.MutBorrow
use int.Int

type t_Keys_K_V

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_K

function view_Keys_K_V (self: t_Keys_K_V) : Seq.seq t_K

predicate postcondition_size_hint (self: ()) (args: t_Keys_K_V) (result: tup2_usize_Option_usize) =
  let self'0 = args in UInt64.t'int result.f0 = Seq.length (view_Keys_K_V self'0) /\ result.f1 = Some (result.f0)

meta "rewrite_def" predicate postcondition_size_hint

predicate inv_Keys_K_V (_1: t_Keys_K_V)

predicate invariant_ref_Keys_K_V [@inline:trivial] (self: t_Keys_K_V) = inv_Keys_K_V self

meta "rewrite_def" predicate invariant_ref_Keys_K_V

predicate inv_ref_Keys_K_V [@inline:trivial] (_1: t_Keys_K_V) = invariant_ref_Keys_K_V _1

meta "rewrite_def" predicate inv_ref_Keys_K_V

let size_hint_Keys_K_V (self: t_Keys_K_V) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] inv_ref_Keys_K_V self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_Keys_K_V ensures] ([@stop_split] [@expl:size_hint ensures #0] UInt64.t'int result.f0
      = Seq.length (view_Keys_K_V self))
    /\ ([@stop_split] [@expl:size_hint ensures #1] result.f1 = Some (result.f0))}
    (! return {result}) ]

predicate produces_back_Keys_K_V (self: t_Keys_K_V) (visited: Seq.seq t_K) (tl: t_Keys_K_V) =
  view_Keys_K_V self = Seq.(++) (view_Keys_K_V tl) (Reverse.reverse visited)

predicate produces_Keys_K_V (self: t_Keys_K_V) (visited: Seq.seq t_K) (tl: t_Keys_K_V) =
  view_Keys_K_V self = Seq.(++) visited (view_Keys_K_V tl)

function produces_trans_Keys_K_V (a: t_Keys_K_V) (ab: Seq.seq t_K) (b: t_Keys_K_V) (bc: Seq.seq t_K) (c: t_Keys_K_V) : ()
 = ()

axiom produces_trans_Keys_K_V_spec:
  forall a: t_Keys_K_V, ab: Seq.seq t_K, b: t_Keys_K_V, bc: Seq.seq t_K, c: t_Keys_K_V. produces_Keys_K_V a ab b
    -> produces_Keys_K_V b bc c -> produces_Keys_K_V a (Seq.(++) ab bc) c

function produces_refl_Keys_K_V (self: t_Keys_K_V) : () = ()

axiom produces_refl_Keys_K_V_spec: forall self: t_Keys_K_V. produces_Keys_K_V self (Seq.empty: Seq.seq t_K) self

predicate resolve_refmut_Keys_K_V [@inline:trivial] (_1: MutBorrow.t t_Keys_K_V) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Keys_K_V

predicate completed_Keys_K_V (self: MutBorrow.t t_Keys_K_V) =
  resolve_refmut_Keys_K_V self /\ view_Keys_K_V self.current = (Seq.empty: Seq.seq t_K)

predicate completed_back_Keys_K_V (self: MutBorrow.t t_Keys_K_V) = completed_Keys_K_V self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Keys_K_V

constant r : tup2_usize_Option_usize

function size_hint_back_spec_Keys_K_V (self: t_Keys_K_V) (r: tup2_usize_Option_usize) : ()

goal vc_size_hint_back_spec_Keys_K_V: postcondition_size_hint () self r
  -> ([@stop_split] [@expl:size_hint_back_spec_Keys_K_V ensures] ([@stop_split] [@expl:size_hint_back_spec ensures #0] forall s: Seq.seq t_K, i: MutBorrow.t t_Keys_K_V. produces_back_Keys_K_V self s i.current
        /\ completed_back_Keys_K_V i -> UInt64.t'int r.f0 <= Seq.length s)
  /\ ([@stop_split] [@expl:size_hint_back_spec ensures #1] match r.f1 with
    | Some r'0 -> forall s: Seq.seq t_K, i: t_Keys_K_V. produces_back_Keys_K_V self s i
      -> Seq.length s <= UInt64.t'int r'0
    | None -> true
    end))
