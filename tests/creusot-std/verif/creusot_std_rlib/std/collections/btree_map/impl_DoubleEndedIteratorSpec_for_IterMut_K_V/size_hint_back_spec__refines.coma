(* <std::collections::btree_map::IterMut<'a, K, V> as std::iter::DoubleEndedIteratorSpec> *)

use creusot.int.UInt64
use seq.Seq
use creusot.prelude.MutBorrow
use seq.Reverse
use int.Int

type t_IterMut_K_V

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_K

type t_V

type tup2_ref_K_refmut_V = { f0'0: t_K; f1'0: MutBorrow.t t_V }

function view_IterMut_K_V (self: t_IterMut_K_V) : Seq.seq tup2_ref_K_refmut_V

predicate postcondition_size_hint (self: ()) (args: t_IterMut_K_V) (result: tup2_usize_Option_usize) =
  let self'0 = args in UInt64.t'int result.f0 = Seq.length (view_IterMut_K_V self'0) /\ result.f1 = Some (result.f0)

meta "rewrite_def" predicate postcondition_size_hint

predicate inv_IterMut_K_V (_1: t_IterMut_K_V)

predicate invariant_ref_IterMut_K_V [@inline:trivial] (self: t_IterMut_K_V) = inv_IterMut_K_V self

meta "rewrite_def" predicate invariant_ref_IterMut_K_V

predicate inv_ref_IterMut_K_V [@inline:trivial] (_1: t_IterMut_K_V) = invariant_ref_IterMut_K_V _1

meta "rewrite_def" predicate inv_ref_IterMut_K_V

let size_hint_IterMut_K_V (self: t_IterMut_K_V) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] inv_ref_IterMut_K_V self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_IterMut_K_V ensures] ([@stop_split] [@expl:size_hint ensures #0] UInt64.t'int result.f0
      = Seq.length (view_IterMut_K_V self))
    /\ ([@stop_split] [@expl:size_hint ensures #1] result.f1 = Some (result.f0))}
    (! return {result}) ]

predicate produces_back_IterMut_K_V (self: t_IterMut_K_V) (visited: Seq.seq tup2_ref_K_refmut_V) (tl: t_IterMut_K_V) =
  view_IterMut_K_V self = Seq.(++) (view_IterMut_K_V tl) (Reverse.reverse visited)

predicate produces_IterMut_K_V (self: t_IterMut_K_V) (visited: Seq.seq tup2_ref_K_refmut_V) (tl: t_IterMut_K_V) =
  view_IterMut_K_V self = Seq.(++) visited (view_IterMut_K_V tl)

function produces_trans_IterMut_K_V (a: t_IterMut_K_V) (ab: Seq.seq tup2_ref_K_refmut_V) (b: t_IterMut_K_V) (bc: Seq.seq tup2_ref_K_refmut_V) (c: t_IterMut_K_V) : ()
 = ()

axiom produces_trans_IterMut_K_V_spec:
  forall a: t_IterMut_K_V, ab: Seq.seq tup2_ref_K_refmut_V, b: t_IterMut_K_V, bc: Seq.seq tup2_ref_K_refmut_V, c: t_IterMut_K_V. produces_IterMut_K_V a ab b
    -> produces_IterMut_K_V b bc c -> produces_IterMut_K_V a (Seq.(++) ab bc) c

function produces_refl_IterMut_K_V (self: t_IterMut_K_V) : () = ()

axiom produces_refl_IterMut_K_V_spec:
  forall self: t_IterMut_K_V. produces_IterMut_K_V self (Seq.empty: Seq.seq tup2_ref_K_refmut_V) self

predicate resolve_refmut_IterMut_K_V [@inline:trivial] (_1: MutBorrow.t t_IterMut_K_V) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_IterMut_K_V

predicate completed_IterMut_K_V (self: MutBorrow.t t_IterMut_K_V) =
  resolve_refmut_IterMut_K_V self /\ view_IterMut_K_V self.current = (Seq.empty: Seq.seq tup2_ref_K_refmut_V)

predicate completed_back_IterMut_K_V (self: MutBorrow.t t_IterMut_K_V) = completed_IterMut_K_V self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_IterMut_K_V, r: tup2_usize_Option_usize. postcondition_size_hint () self r
    -> postcondition_size_hint () self r
    /\ (forall result: (). (forall s: Seq.seq tup2_ref_K_refmut_V, i: MutBorrow.t t_IterMut_K_V. produces_back_IterMut_K_V self s i.current
              /\ completed_back_IterMut_K_V i -> UInt64.t'int r.f0 <= Seq.length s)
        /\ match r.f1 with
          | Some r'0 -> forall s: Seq.seq tup2_ref_K_refmut_V, i: t_IterMut_K_V. produces_back_IterMut_K_V self s i
            -> Seq.length s <= UInt64.t'int r'0
          | None -> true
          end
      -> (forall s: Seq.seq tup2_ref_K_refmut_V, i: MutBorrow.t t_IterMut_K_V. produces_back_IterMut_K_V self s i.current
            /\ completed_back_IterMut_K_V i -> UInt64.t'int r.f0 <= Seq.length s)
      /\ match r.f1 with
        | Some r'0 -> forall s: Seq.seq tup2_ref_K_refmut_V, i: t_IterMut_K_V. produces_back_IterMut_K_V self s i
          -> Seq.length s <= UInt64.t'int r'0
        | None -> true
        end)
