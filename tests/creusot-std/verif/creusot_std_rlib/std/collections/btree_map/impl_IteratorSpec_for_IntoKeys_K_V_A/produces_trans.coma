(* <std::collections::btree_map::IntoKeys<K, V, A> as std::iter::IteratorSpec> *)

use seq.Seq

type t_IntoKeys_K_V_A

type t_K

function view_IntoKeys_K_V_A (self: t_IntoKeys_K_V_A) : Seq.seq t_K

predicate produces_IntoKeys_K_V_A (self: t_IntoKeys_K_V_A) (visited: Seq.seq t_K) (tl: t_IntoKeys_K_V_A) =
  view_IntoKeys_K_V_A self = Seq.(++) visited (view_IntoKeys_K_V_A tl)

function concat_assoc_K (self: Seq.seq t_K) (other1: Seq.seq t_K) (other2: Seq.seq t_K) : ()

axiom concat_assoc_K_spec:
  forall self: Seq.seq t_K, other1: Seq.seq t_K, other2: Seq.seq t_K. Seq.(++) (Seq.(++) self other1) other2
    = Seq.(++) self (Seq.(++) other1 other2)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : t_IntoKeys_K_V_A

constant ab : Seq.seq t_K

constant b : t_IntoKeys_K_V_A

constant bc : Seq.seq t_K

constant c : t_IntoKeys_K_V_A

function produces_trans_IntoKeys_K_V_A (a: t_IntoKeys_K_V_A) (ab: Seq.seq t_K) (b: t_IntoKeys_K_V_A) (bc: Seq.seq t_K) (c: t_IntoKeys_K_V_A) : ()

goal vc_produces_trans_IntoKeys_K_V_A: produces_IntoKeys_K_V_A a ab b
  -> produces_IntoKeys_K_V_A b bc c
  -> ([@stop_split] [@expl:produces_trans ensures] produces_IntoKeys_K_V_A a (Seq.(++) ab bc) c)
