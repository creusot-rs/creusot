(* <std::collections::btree_map::IntoKeys<K, V, A> as std::iter::DoubleEndedIteratorSpec> *)

use creusot.int.UInt64
use seq.Seq
use seq.Reverse
use creusot.prelude.MutBorrow
use int.Int

type t_IntoKeys_K_V_A

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_K

function view_IntoKeys_K_V_A (self: t_IntoKeys_K_V_A) : Seq.seq t_K

predicate postcondition_size_hint (self: ()) (args: t_IntoKeys_K_V_A) (result: tup2_usize_Option_usize) =
  let self'0 = args in UInt64.t'int result.f0 = Seq.length (view_IntoKeys_K_V_A self'0) /\ result.f1 = Some (result.f0)

meta "rewrite_def" predicate postcondition_size_hint

predicate inv_IntoKeys_K_V_A (_1: t_IntoKeys_K_V_A)

predicate invariant_ref_IntoKeys_K_V_A [@inline:trivial] (self: t_IntoKeys_K_V_A) = inv_IntoKeys_K_V_A self

meta "rewrite_def" predicate invariant_ref_IntoKeys_K_V_A

predicate inv_ref_IntoKeys_K_V_A [@inline:trivial] (_1: t_IntoKeys_K_V_A) = invariant_ref_IntoKeys_K_V_A _1

meta "rewrite_def" predicate inv_ref_IntoKeys_K_V_A

let size_hint_IntoKeys_K_V_A (self: t_IntoKeys_K_V_A) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] inv_ref_IntoKeys_K_V_A self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_IntoKeys_K_V_A ensures] ([@stop_split] [@expl:size_hint ensures #0] UInt64.t'int result.f0
      = Seq.length (view_IntoKeys_K_V_A self))
    /\ ([@stop_split] [@expl:size_hint ensures #1] result.f1 = Some (result.f0))}
    (! return {result}) ]

predicate produces_back_IntoKeys_K_V_A (self: t_IntoKeys_K_V_A) (visited: Seq.seq t_K) (tl: t_IntoKeys_K_V_A) =
  view_IntoKeys_K_V_A self = Seq.(++) (view_IntoKeys_K_V_A tl) (Reverse.reverse visited)

predicate produces_IntoKeys_K_V_A (self: t_IntoKeys_K_V_A) (visited: Seq.seq t_K) (tl: t_IntoKeys_K_V_A) =
  view_IntoKeys_K_V_A self = Seq.(++) visited (view_IntoKeys_K_V_A tl)

function produces_trans_IntoKeys_K_V_A (a: t_IntoKeys_K_V_A) (ab: Seq.seq t_K) (b: t_IntoKeys_K_V_A) (bc: Seq.seq t_K) (c: t_IntoKeys_K_V_A) : ()
 = ()

axiom produces_trans_IntoKeys_K_V_A_spec:
  forall a: t_IntoKeys_K_V_A, ab: Seq.seq t_K, b: t_IntoKeys_K_V_A, bc: Seq.seq t_K, c: t_IntoKeys_K_V_A. produces_IntoKeys_K_V_A a ab b
    -> produces_IntoKeys_K_V_A b bc c -> produces_IntoKeys_K_V_A a (Seq.(++) ab bc) c

function produces_refl_IntoKeys_K_V_A (self: t_IntoKeys_K_V_A) : () = ()

axiom produces_refl_IntoKeys_K_V_A_spec:
  forall self: t_IntoKeys_K_V_A. produces_IntoKeys_K_V_A self (Seq.empty: Seq.seq t_K) self

predicate resolve_refmut_IntoKeys_K_V_A [@inline:trivial] (_1: MutBorrow.t t_IntoKeys_K_V_A) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_IntoKeys_K_V_A

predicate completed_IntoKeys_K_V_A (self: MutBorrow.t t_IntoKeys_K_V_A) =
  resolve_refmut_IntoKeys_K_V_A self /\ view_IntoKeys_K_V_A self.current = (Seq.empty: Seq.seq t_K)

predicate completed_back_IntoKeys_K_V_A (self: MutBorrow.t t_IntoKeys_K_V_A) = completed_IntoKeys_K_V_A self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_IntoKeys_K_V_A, r: tup2_usize_Option_usize. postcondition_size_hint () self r
    -> postcondition_size_hint () self r
    /\ (forall result: (). (forall s: Seq.seq t_K, i: MutBorrow.t t_IntoKeys_K_V_A. produces_back_IntoKeys_K_V_A self s i.current
              /\ completed_back_IntoKeys_K_V_A i -> UInt64.t'int r.f0 <= Seq.length s)
        /\ match r.f1 with
          | Some r'0 -> forall s: Seq.seq t_K, i: t_IntoKeys_K_V_A. produces_back_IntoKeys_K_V_A self s i
            -> Seq.length s <= UInt64.t'int r'0
          | None -> true
          end
      -> (forall s: Seq.seq t_K, i: MutBorrow.t t_IntoKeys_K_V_A. produces_back_IntoKeys_K_V_A self s i.current
            /\ completed_back_IntoKeys_K_V_A i -> UInt64.t'int r.f0 <= Seq.length s)
      /\ match r.f1 with
        | Some r'0 -> forall s: Seq.seq t_K, i: t_IntoKeys_K_V_A. produces_back_IntoKeys_K_V_A self s i
          -> Seq.length s <= UInt64.t'int r'0
        | None -> true
        end)
