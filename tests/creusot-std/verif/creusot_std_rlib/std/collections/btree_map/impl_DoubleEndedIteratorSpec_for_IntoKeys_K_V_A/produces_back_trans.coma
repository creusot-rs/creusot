(* <std::collections::btree_map::IntoKeys<K, V, A> as std::iter::DoubleEndedIteratorSpec> *)

use seq.Seq
use seq.Reverse

type t_IntoKeys_K_V_A

type t_K

function view_IntoKeys_K_V_A (self: t_IntoKeys_K_V_A) : Seq.seq t_K

predicate produces_back_IntoKeys_K_V_A (self: t_IntoKeys_K_V_A) (visited: Seq.seq t_K) (tl: t_IntoKeys_K_V_A) =
  view_IntoKeys_K_V_A self = Seq.(++) (view_IntoKeys_K_V_A tl) (Reverse.reverse visited)

function reverse_concat_K (self: Seq.seq t_K) (other: Seq.seq t_K) : ()

axiom reverse_concat_K_spec: forall self: Seq.seq t_K, other: Seq.seq t_K. Reverse.reverse (Seq.(++) self other)
    = Seq.(++) (Reverse.reverse other) (Reverse.reverse self)

function concat_assoc_K (self: Seq.seq t_K) (other1: Seq.seq t_K) (other2: Seq.seq t_K) : ()

axiom concat_assoc_K_spec:
  forall self: Seq.seq t_K, other1: Seq.seq t_K, other2: Seq.seq t_K. Seq.(++) (Seq.(++) self other1) other2
    = Seq.(++) self (Seq.(++) other1 other2)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : t_IntoKeys_K_V_A

constant ab : Seq.seq t_K

constant b : t_IntoKeys_K_V_A

constant bc : Seq.seq t_K

constant c : t_IntoKeys_K_V_A

function produces_back_trans_IntoKeys_K_V_A (a: t_IntoKeys_K_V_A) (ab: Seq.seq t_K) (b: t_IntoKeys_K_V_A) (bc: Seq.seq t_K) (c: t_IntoKeys_K_V_A) : ()

goal vc_produces_back_trans_IntoKeys_K_V_A: produces_back_IntoKeys_K_V_A a ab b
  -> produces_back_IntoKeys_K_V_A b bc c
  -> ([@stop_split] [@expl:reverse_concat ensures] Reverse.reverse (Seq.(++) ab bc)
    = Seq.(++) (Reverse.reverse bc) (Reverse.reverse ab))
  -> ([@stop_split] [@expl:produces_back_trans ensures] produces_back_IntoKeys_K_V_A a (Seq.(++) ab bc) c)
