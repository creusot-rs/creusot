(* <std::collections::btree_map::IntoKeys<K, V, A> as std::iter::DoubleEndedIteratorSpec> *)

use seq.Seq
use seq.Reverse

type t_IntoKeys_K_V_A

type t_K

function view_IntoKeys_K_V_A (self: t_IntoKeys_K_V_A) : Seq.seq t_K

predicate produces_back_IntoKeys_K_V_A (self: t_IntoKeys_K_V_A) (visited: Seq.seq t_K) (tl: t_IntoKeys_K_V_A) =
  view_IntoKeys_K_V_A self = Seq.(++) (view_IntoKeys_K_V_A tl) (Reverse.reverse visited)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall a: t_IntoKeys_K_V_A, ab: Seq.seq t_K, b: t_IntoKeys_K_V_A, bc: Seq.seq t_K, c: t_IntoKeys_K_V_A. produces_back_IntoKeys_K_V_A a ab b
    -> produces_back_IntoKeys_K_V_A b bc c
    -> produces_back_IntoKeys_K_V_A a ab b
    /\ produces_back_IntoKeys_K_V_A b bc c
    /\ (forall result: (). produces_back_IntoKeys_K_V_A a (Seq.(++) ab bc) c
      -> produces_back_IntoKeys_K_V_A a (Seq.(++) ab bc) c)
