(* <std::collections::btree_map::IntoValues<K, V, A> as std::iter::IteratorSpec> *)

use seq.Seq

type t_IntoValues_K_V_A

type t_V

function view_IntoValues_K_V_A (self: t_IntoValues_K_V_A) : Seq.seq t_V

predicate produces_IntoValues_K_V_A (self: t_IntoValues_K_V_A) (visited: Seq.seq t_V) (tl: t_IntoValues_K_V_A) =
  view_IntoValues_K_V_A self = Seq.(++) visited (view_IntoValues_K_V_A tl)

function concat_assoc_V (self: Seq.seq t_V) (other1: Seq.seq t_V) (other2: Seq.seq t_V) : ()

axiom concat_assoc_V_spec:
  forall self: Seq.seq t_V, other1: Seq.seq t_V, other2: Seq.seq t_V. Seq.(++) (Seq.(++) self other1) other2
    = Seq.(++) self (Seq.(++) other1 other2)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : t_IntoValues_K_V_A

constant ab : Seq.seq t_V

constant b : t_IntoValues_K_V_A

constant bc : Seq.seq t_V

constant c : t_IntoValues_K_V_A

function produces_trans_IntoValues_K_V_A (a: t_IntoValues_K_V_A) (ab: Seq.seq t_V) (b: t_IntoValues_K_V_A) (bc: Seq.seq t_V) (c: t_IntoValues_K_V_A) : ()

goal vc_produces_trans_IntoValues_K_V_A: produces_IntoValues_K_V_A a ab b
  -> produces_IntoValues_K_V_A b bc c
  -> ([@stop_split] [@expl:produces_trans ensures] produces_IntoValues_K_V_A a (Seq.(++) ab bc) c)
