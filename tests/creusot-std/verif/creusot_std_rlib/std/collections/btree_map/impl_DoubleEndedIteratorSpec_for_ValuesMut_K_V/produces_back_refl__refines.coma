(* <std::collections::btree_map::ValuesMut<'a, K, V> as std::iter::DoubleEndedIteratorSpec> *)

use creusot.prelude.MutBorrow
use seq.Seq
use seq.Reverse

type t_ValuesMut_K_V

type t_V

function view_ValuesMut_K_V (self: t_ValuesMut_K_V) : Seq.seq (MutBorrow.t t_V)

predicate produces_back_ValuesMut_K_V (self: t_ValuesMut_K_V) (visited: Seq.seq (MutBorrow.t t_V)) (tl: t_ValuesMut_K_V) =
  view_ValuesMut_K_V self = Seq.(++) (view_ValuesMut_K_V tl) (Reverse.reverse visited)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall self: t_ValuesMut_K_V. forall result: (). produces_back_ValuesMut_K_V self (Seq.empty: Seq.seq (MutBorrow.t t_V)) self
      -> produces_back_ValuesMut_K_V self (Seq.empty: Seq.seq (MutBorrow.t t_V)) self
