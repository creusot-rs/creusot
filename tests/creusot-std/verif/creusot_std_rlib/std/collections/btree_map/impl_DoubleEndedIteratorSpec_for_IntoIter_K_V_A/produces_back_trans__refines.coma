(* <std::collections::btree_map::IntoIter<K, V, A> as std::iter::DoubleEndedIteratorSpec> *)

use seq.Seq
use seq.Reverse

type t_IntoIter_K_V_A

type t_K

type t_V

type tup2_K_V = { f0: t_K; f1: t_V }

function view_IntoIter_K_V_A (self: t_IntoIter_K_V_A) : Seq.seq tup2_K_V

predicate produces_back_IntoIter_K_V_A (self: t_IntoIter_K_V_A) (visited: Seq.seq tup2_K_V) (tl: t_IntoIter_K_V_A) =
  view_IntoIter_K_V_A self = Seq.(++) (view_IntoIter_K_V_A tl) (Reverse.reverse visited)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall a: t_IntoIter_K_V_A, ab: Seq.seq tup2_K_V, b: t_IntoIter_K_V_A, bc: Seq.seq tup2_K_V, c: t_IntoIter_K_V_A. produces_back_IntoIter_K_V_A a ab b
    -> produces_back_IntoIter_K_V_A b bc c
    -> produces_back_IntoIter_K_V_A a ab b
    /\ produces_back_IntoIter_K_V_A b bc c
    /\ (forall result: (). produces_back_IntoIter_K_V_A a (Seq.(++) ab bc) c
      -> produces_back_IntoIter_K_V_A a (Seq.(++) ab bc) c)
