(* <std::collections::btree_map::IntoIter<K, V, A> as std::iter::DoubleEndedIteratorSpec> *)

use seq.Seq
use seq.Reverse

type t_IntoIter_K_V_A

type t_K

type t_V

type tup2_K_V = { f0: t_K; f1: t_V }

function view_IntoIter_K_V_A (self: t_IntoIter_K_V_A) : Seq.seq tup2_K_V

predicate produces_back_IntoIter_K_V_A (self: t_IntoIter_K_V_A) (visited: Seq.seq tup2_K_V) (tl: t_IntoIter_K_V_A) =
  view_IntoIter_K_V_A self = Seq.(++) (view_IntoIter_K_V_A tl) (Reverse.reverse visited)

constant reverse_empty_tup2_K_V : ()

axiom reverse_empty_tup2_K_V_spec: Reverse.reverse (Seq.empty: Seq.seq tup2_K_V) = (Seq.empty: Seq.seq tup2_K_V)

function concat_empty_tup2_K_V (self: Seq.seq tup2_K_V) : ()

axiom concat_empty_tup2_K_V_spec: forall self: Seq.seq tup2_K_V. Seq.(++) self (Seq.empty: Seq.seq tup2_K_V) = self

axiom concat_empty_tup2_K_V_spec'0: forall self: Seq.seq tup2_K_V. Seq.(++) (Seq.empty: Seq.seq tup2_K_V) self = self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_IntoIter_K_V_A

function produces_back_refl_IntoIter_K_V_A (self: t_IntoIter_K_V_A) : ()

goal vc_produces_back_refl_IntoIter_K_V_A:
  ([@stop_split] [@expl:reverse_empty ensures] Reverse.reverse (Seq.empty: Seq.seq tup2_K_V)
    = (Seq.empty: Seq.seq tup2_K_V))
  -> ([@stop_split] [@expl:produces_back_refl ensures] produces_back_IntoIter_K_V_A self (Seq.empty: Seq.seq tup2_K_V) self)
