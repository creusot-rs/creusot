(* <std::collections::btree_map::IntoValues<K, V, A> as std::iter::DoubleEndedIteratorSpec> *)

use creusot.int.UInt64
use seq.Seq
use seq.Reverse
use creusot.prelude.MutBorrow
use int.Int

type t_IntoValues_K_V_A

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_V

function view_IntoValues_K_V_A (self: t_IntoValues_K_V_A) : Seq.seq t_V

predicate postcondition_size_hint (self: ()) (args: t_IntoValues_K_V_A) (result: tup2_usize_Option_usize) =
  let self'0 = args in UInt64.t'int result.f0 = Seq.length (view_IntoValues_K_V_A self'0)
  /\ result.f1 = Some (result.f0)

meta "rewrite_def" predicate postcondition_size_hint

predicate inv_IntoValues_K_V_A (_1: t_IntoValues_K_V_A)

predicate invariant_ref_IntoValues_K_V_A [@inline:trivial] (self: t_IntoValues_K_V_A) = inv_IntoValues_K_V_A self

meta "rewrite_def" predicate invariant_ref_IntoValues_K_V_A

predicate inv_ref_IntoValues_K_V_A [@inline:trivial] (_1: t_IntoValues_K_V_A) = invariant_ref_IntoValues_K_V_A _1

meta "rewrite_def" predicate inv_ref_IntoValues_K_V_A

let size_hint_IntoValues_K_V_A (self: t_IntoValues_K_V_A) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] inv_ref_IntoValues_K_V_A self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_IntoValues_K_V_A ensures] ([@stop_split] [@expl:size_hint ensures #0] UInt64.t'int result.f0
      = Seq.length (view_IntoValues_K_V_A self))
    /\ ([@stop_split] [@expl:size_hint ensures #1] result.f1 = Some (result.f0))}
    (! return {result}) ]

predicate produces_back_IntoValues_K_V_A (self: t_IntoValues_K_V_A) (visited: Seq.seq t_V) (tl: t_IntoValues_K_V_A) =
  view_IntoValues_K_V_A self = Seq.(++) (view_IntoValues_K_V_A tl) (Reverse.reverse visited)

predicate produces_IntoValues_K_V_A (self: t_IntoValues_K_V_A) (visited: Seq.seq t_V) (tl: t_IntoValues_K_V_A) =
  view_IntoValues_K_V_A self = Seq.(++) visited (view_IntoValues_K_V_A tl)

function produces_trans_IntoValues_K_V_A (a: t_IntoValues_K_V_A) (ab: Seq.seq t_V) (b: t_IntoValues_K_V_A) (bc: Seq.seq t_V) (c: t_IntoValues_K_V_A) : ()
 = ()

axiom produces_trans_IntoValues_K_V_A_spec:
  forall a: t_IntoValues_K_V_A, ab: Seq.seq t_V, b: t_IntoValues_K_V_A, bc: Seq.seq t_V, c: t_IntoValues_K_V_A. produces_IntoValues_K_V_A a ab b
    -> produces_IntoValues_K_V_A b bc c -> produces_IntoValues_K_V_A a (Seq.(++) ab bc) c

function produces_refl_IntoValues_K_V_A (self: t_IntoValues_K_V_A) : () = ()

axiom produces_refl_IntoValues_K_V_A_spec:
  forall self: t_IntoValues_K_V_A. produces_IntoValues_K_V_A self (Seq.empty: Seq.seq t_V) self

predicate resolve_refmut_IntoValues_K_V_A [@inline:trivial] (_1: MutBorrow.t t_IntoValues_K_V_A) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_IntoValues_K_V_A

predicate completed_IntoValues_K_V_A (self: MutBorrow.t t_IntoValues_K_V_A) =
  resolve_refmut_IntoValues_K_V_A self /\ view_IntoValues_K_V_A self.current = (Seq.empty: Seq.seq t_V)

predicate completed_back_IntoValues_K_V_A (self: MutBorrow.t t_IntoValues_K_V_A) = completed_IntoValues_K_V_A self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_IntoValues_K_V_A

constant r : tup2_usize_Option_usize

function size_hint_back_spec_IntoValues_K_V_A (self: t_IntoValues_K_V_A) (r: tup2_usize_Option_usize) : ()

goal vc_size_hint_back_spec_IntoValues_K_V_A: postcondition_size_hint () self r
  -> ([@stop_split] [@expl:size_hint_back_spec_IntoValues_K_V_A ensures] ([@stop_split] [@expl:size_hint_back_spec ensures #0] forall s: Seq.seq t_V, i: MutBorrow.t t_IntoValues_K_V_A. produces_back_IntoValues_K_V_A self s i.current
        /\ completed_back_IntoValues_K_V_A i -> UInt64.t'int r.f0 <= Seq.length s)
  /\ ([@stop_split] [@expl:size_hint_back_spec ensures #1] match r.f1 with
    | Some r'0 -> forall s: Seq.seq t_V, i: t_IntoValues_K_V_A. produces_back_IntoValues_K_V_A self s i
      -> Seq.length s <= UInt64.t'int r'0
    | None -> true
    end))
