(* <std::collections::btree_map::Values<'a, K, V> as std::iter::IteratorSpec> *)

use seq.Seq

type t_Values_K_V

type t_V

function view_Values_K_V (self: t_Values_K_V) : Seq.seq t_V

predicate produces_Values_K_V (self: t_Values_K_V) (visited: Seq.seq t_V) (tl: t_Values_K_V) =
  view_Values_K_V self = Seq.(++) visited (view_Values_K_V tl)

function concat_assoc_ref_V (self: Seq.seq t_V) (other1: Seq.seq t_V) (other2: Seq.seq t_V) : ()

axiom concat_assoc_ref_V_spec:
  forall self: Seq.seq t_V, other1: Seq.seq t_V, other2: Seq.seq t_V. Seq.(++) (Seq.(++) self other1) other2
    = Seq.(++) self (Seq.(++) other1 other2)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : t_Values_K_V

constant ab : Seq.seq t_V

constant b : t_Values_K_V

constant bc : Seq.seq t_V

constant c : t_Values_K_V

function produces_trans_Values_K_V (a: t_Values_K_V) (ab: Seq.seq t_V) (b: t_Values_K_V) (bc: Seq.seq t_V) (c: t_Values_K_V) : ()

goal vc_produces_trans_Values_K_V: produces_Values_K_V a ab b
  -> produces_Values_K_V b bc c
  -> ([@stop_split] [@expl:produces_trans ensures] produces_Values_K_V a (Seq.(++) ab bc) c)
