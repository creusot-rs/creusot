(* <std::collections::btree_map::IntoIter<K, V, A> as std::iter::ExactSizeIteratorSpec> *)

use creusot.int.UInt64
use seq.Seq

type t_IntoIter_K_V_A

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_K

type t_V

type tup2_K_V = { f0'0: t_K; f1'0: t_V }

function view_IntoIter_K_V_A (self: t_IntoIter_K_V_A) : Seq.seq tup2_K_V

predicate postcondition_size_hint (self: ()) (args: t_IntoIter_K_V_A) (result: tup2_usize_Option_usize) =
  let self'0 = args in UInt64.t'int result.f0 = Seq.length (view_IntoIter_K_V_A self'0) /\ result.f1 = Some (result.f0)

meta "rewrite_def" predicate postcondition_size_hint

predicate inv_IntoIter_K_V_A (_1: t_IntoIter_K_V_A)

predicate invariant_ref_IntoIter_K_V_A [@inline:trivial] (self: t_IntoIter_K_V_A) = inv_IntoIter_K_V_A self

meta "rewrite_def" predicate invariant_ref_IntoIter_K_V_A

predicate inv_ref_IntoIter_K_V_A [@inline:trivial] (_1: t_IntoIter_K_V_A) = invariant_ref_IntoIter_K_V_A _1

meta "rewrite_def" predicate inv_ref_IntoIter_K_V_A

let size_hint_IntoIter_K_V_A (self: t_IntoIter_K_V_A) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] inv_ref_IntoIter_K_V_A self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_IntoIter_K_V_A ensures] ([@stop_split] [@expl:size_hint ensures #0] UInt64.t'int result.f0
      = Seq.length (view_IntoIter_K_V_A self))
    /\ ([@stop_split] [@expl:size_hint ensures #1] result.f1 = Some (result.f0))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_IntoIter_K_V_A, r: tup2_usize_Option_usize. postcondition_size_hint () self r
    -> postcondition_size_hint () self r /\ (forall result: (). r.f1 = Some (r.f0) -> r.f1 = Some (r.f0))
