(* <std::collections::btree_map::Range<'a, K, V> as std::iter::IteratorSpec> *)

use seq.Seq

type t_Range_K_V

type t_K

type t_V

type tup2_ref_K_ref_V = { f0: t_K; f1: t_V }

function view_Range_K_V (self: t_Range_K_V) : Seq.seq tup2_ref_K_ref_V

predicate produces_Range_K_V (self: t_Range_K_V) (visited: Seq.seq tup2_ref_K_ref_V) (tl: t_Range_K_V) =
  view_Range_K_V self = Seq.(++) visited (view_Range_K_V tl)

function concat_empty_tup2_ref_K_ref_V (self: Seq.seq tup2_ref_K_ref_V) : ()

axiom concat_empty_tup2_ref_K_ref_V_spec:
  forall self: Seq.seq tup2_ref_K_ref_V. Seq.(++) self (Seq.empty: Seq.seq tup2_ref_K_ref_V) = self

axiom concat_empty_tup2_ref_K_ref_V_spec'0:
  forall self: Seq.seq tup2_ref_K_ref_V. Seq.(++) (Seq.empty: Seq.seq tup2_ref_K_ref_V) self = self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Range_K_V

function produces_refl_Range_K_V (self: t_Range_K_V) : ()

goal vc_produces_refl_Range_K_V:
  [@stop_split] [@expl:produces_refl ensures] produces_Range_K_V self (Seq.empty: Seq.seq tup2_ref_K_ref_V) self
