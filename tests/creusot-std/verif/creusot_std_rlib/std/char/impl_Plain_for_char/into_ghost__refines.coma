(* <char as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Char

predicate inv_char [@inline:trivial] (_1: Char.t) = true

meta "rewrite_def" predicate inv_char

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: Char.t. inv_char snap -> (forall result: Char.t. result = snap -> result = snap)
