(* <std::thread::ErasedScope<'_, F, T> as std::ops::FnOnce<()>> *)

type t_ErasedScope_F_T = { f0: () }

predicate precondition_ErasedScope_F_T (self: t_ErasedScope_F_T) (args: ())

type t_T

predicate inv_T (_1: t_T)

predicate postcondition_once_ErasedScope_F_T (self: t_ErasedScope_F_T) (args: ()) (result: t_T)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_ErasedScope_F_T, args: (). precondition_ErasedScope_F_T self args
    -> (forall result: t_T. inv_T result -> inv_T result /\ postcondition_once_ErasedScope_F_T self args result)
