(* <std::sync::view::SyncView as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

type t_SyncView

predicate lt_log_SyncView (self: t_SyncView) (_2: t_SyncView)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall x: t_SyncView, y: t_SyncView, z: t_SyncView. lt_log_SyncView x y
    -> lt_log_SyncView y z
    -> lt_log_SyncView x y /\ lt_log_SyncView y z /\ (forall result: (). lt_log_SyncView x z -> lt_log_SyncView x z)
