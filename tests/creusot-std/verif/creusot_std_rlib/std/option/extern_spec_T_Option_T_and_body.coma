meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let extern_spec_T_Option_T_and_body_T (self_: t_Option_T) (optb: t_Option_U) (return (x: t_Option_U)) =
{[@stop_split] [@expl:extern_spec_T_Option_T_and_body_T requires] ([@stop_split] [@expl:extern_spec_T_Option_T_and_body 'self_' type invariant] inv_Option_T self_)
  /\ ([@stop_split] [@expl:extern_spec_T_Option_T_and_body 'optb' type invariant] inv_Option_U optb)}
  (! bb0
  [ bb0 = any [ br0 -> {self_ = None} (! bb2) | br1 (x0: t_T) -> {self_ = Some x0} (! bb3) ]
  | bb3 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_Option_T self_} any) ]
    | s1 = -{resolve_Option_T self_}- s2
    | s2 = [ &_ret <- optb ] s3
