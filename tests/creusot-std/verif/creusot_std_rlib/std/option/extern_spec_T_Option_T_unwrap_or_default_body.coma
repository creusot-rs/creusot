type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Mode
use creusot.prelude.Any

type t_T

type t_Option_T = None | Some t_T

let elim_Some (_x: t_Option_T) (return (f0: t_T)) = any
  [ _k (f0: t_T) -> {Some f0 = _x} (! return {f0})
  | _chk -> (! {[@expl:elim Some] match _x with
      | Some _ -> true
      | _ -> false
      end}
    any) ]

predicate precondition_default (self: ()) (mode: Mode.t) (args: ())

axiom precondition_fndef:
  forall mode: Mode.t. forall args: () [precondition_default () mode args]. (let () = args in true)
      -> precondition_default () mode args

predicate inv_T (_1: t_T)

predicate postcondition_default (self: ()) (mode: Mode.t) (args: ()) (result: t_T)

axiom postcondition_fndef:
  forall mode: Mode.t, args: (), res: t_T [postcondition_default () mode args res]. postcondition_default () mode args res
    -> (let () = args in inv_T res)

predicate postcondition_once_default (self: ()) (mode: Mode.t) (args: ()) (result: t_T) =
  postcondition_default self mode args result

meta "rewrite_def" predicate postcondition_once_default

let default_T (mode: Mode.t) (return (x: t_T)) =
{[@stop_split] [@expl:default requires] precondition_default () mode ()}
  any
  [ return (result: t_T) -> {[@stop_split] [@expl:default ensures] postcondition_once_default () mode () result}
    (! return {result}) ]

predicate inv_Option_T (_1: t_Option_T)

axiom inv_axiom [@rewrite]: forall x: t_Option_T [inv_Option_T x]. inv_Option_T x
    = match x with
      | None -> true
      | Some f0 -> inv_T f0
      end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let extern_spec_T_Option_T_unwrap_or_default_body_T (mode: Mode.t) (self_: t_Option_T) (return (x: t_T)) =
{[@stop_split] [@expl:extern_spec_T_Option_T_unwrap_or_default_body 'self_' type invariant] inv_Option_T self_}
  (! bb0
  [ bb0 = any [ br0 -> {self_ = None} (! bb4) | br1 (x0: t_T) -> {self_ = Some x0} (! bb5) ]
  | bb5 = s0 [ s0 = elim_Some {self_} (fun (r0: t_T) -> [ &t <- r0 ] s1) | s1 = [ &_ret <- t ] s2 | s2 = return {_ret} ]
  | bb4 = s0 [ s0 = default_T {mode} (fun (_x: t_T) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: t_T = Any.any_l () | & self_: t_Option_T = self_ | & t: t_T = Any.any_l () ])
  [ return (result: t_T) ->
  {[@stop_split] [@expl:extern_spec_T_Option_T_unwrap_or_default_body_T ensures] ([@stop_split] [@expl:extern_spec_T_Option_T_unwrap_or_default_body result type invariant] inv_T result)
    /\ ([@stop_split] [@expl:extern_spec_T_Option_T_unwrap_or_default_body ensures #0] self_ = None
      -> postcondition_default () mode () result)
    /\ ([@stop_split] [@expl:extern_spec_T_Option_T_unwrap_or_default_body ensures #1] self_ = None
    \/ self_ = Some result)}
    (! return {result}) ]
