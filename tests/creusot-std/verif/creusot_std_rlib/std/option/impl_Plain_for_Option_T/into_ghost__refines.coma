(* <std::option::Option<T> as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

type t_T

type t_Option_T = None | Some t_T

predicate inv_T (_1: t_T)

predicate inv_Option_T (_1: t_Option_T)

axiom inv_axiom [@rewrite]: forall x: t_Option_T [inv_Option_T x]. inv_Option_T x
    = match x with
      | None -> true
      | Some f0 -> inv_T f0
      end

predicate invariant_Ghost_Option_T [@inline:trivial] (self: t_Option_T) = inv_Option_T self

meta "rewrite_def" predicate invariant_Ghost_Option_T

predicate inv_Ghost_Option_T [@inline:trivial] (_1: t_Option_T) = invariant_Ghost_Option_T _1

meta "rewrite_def" predicate inv_Ghost_Option_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: t_Option_T. inv_Option_T snap
    -> inv_Option_T snap
    /\ (forall result: t_Option_T. inv_Ghost_Option_T result /\ result = snap
      -> inv_Ghost_Option_T result /\ result = snap)
