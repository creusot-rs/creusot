{[@stop_split] [@expl:deref 'self' type invariant] inv_ref_Ghost_T self}
  any
  [ return (result: t_T) ->
  {[@stop_split] [@expl:deref_Ghost_T ensures] ([@stop_split] [@expl:deref result type invariant] inv_ref_T result)
    /\ ([@stop_split] [@expl:deref ensures] result = self)}
    (! return {result}) ]

predicate inv_tup3_V_U_T [@inline:trivial] (_1: tup3_V_U_T) = inv_V _1.f0 /\ inv_U _1.f1 /\ inv_T _1.f2

meta "rewrite_def" predicate inv_tup3_V_U_T

predicate invariant_Ghost_tup3_V_U_T [@inline:trivial] (self: tup3_V_U_T) = inv_tup3_V_U_T self

meta "rewrite_def" predicate invariant_Ghost_tup3_V_U_T

predicate inv_Ghost_tup3_V_U_T [@inline:trivial] (_1: tup3_V_U_T) = invariant_Ghost_tup3_V_U_T _1

meta "rewrite_def" predicate inv_Ghost_tup3_V_U_T

let new_tup3_V_U_T (x: tup3_V_U_T) (return (x'0: tup3_V_U_T)) =
{[@stop_split] [@expl:new 'x' type invariant] inv_tup3_V_U_T x}
  any
  [ return (result: tup3_V_U_T) ->
  {[@stop_split] [@expl:new_tup3_V_U_T ensures] ([@stop_split] [@expl:new result type invariant] inv_Ghost_tup3_V_U_T result)
    /\ ([@stop_split] [@expl:new ensures] result = x)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let into_ghost_tup3_V_U_T (snap: tup3_V_U_T) (return (x: tup3_V_U_T)) =
{[@stop_split] [@expl:into_ghost requires] inv_tup3_V_U_T snap}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &x <- snap.f0 ] s1
    | s1 = into_ghost_V {x} (fun (_x: t_V) -> [ &_13 <- _x ] s2)
    | s2 = deref_Ghost_V {_13} (fun (_x: t_V) -> [ &_11 <- _x ] s3)
    | s3 = [ &x'0 <- snap.f1 ] s4
    | s4 = into_ghost_U {x'0} (fun (_x: t_U) -> [ &_21 <- _x ] s5)
    | s5 = deref_Ghost_U {_21} (fun (_x: t_U) -> [ &_19 <- _x ] s6)
    | s6 = [ &x'1 <- snap.f2 ] s7
    | s7 = into_ghost_T {x'1} (fun (_x: t_T) -> [ &_29 <- _x ] s8)
    | s8 = deref_Ghost_T {_29} (fun (_x: t_T) -> [ &_27 <- _x ] s9)
    | s9 = [ &_6 <- { f0 = _11; f1 = _19; f2 = _27 } ] s10
    | s10 = new_tup3_V_U_T {_6} (fun (_x: tup3_V_U_T) -> [ &_ret <- _x ] s11)
    | s11 = return {_ret} ] ]
  [ & _ret: tup3_V_U_T = Any.any_l ()
  | & snap: tup3_V_U_T = snap
  | & _6: tup3_V_U_T = Any.any_l ()
  | & x: t_V = Any.any_l ()
  | & _11: t_V = Any.any_l ()
  | & _13: t_V = Any.any_l ()
  | & x'0: t_U = Any.any_l ()
  | & _19: t_U = Any.any_l ()
  | & _21: t_U = Any.any_l ()
  | & x'1: t_T = Any.any_l ()
  | & _27: t_T = Any.any_l ()
  | & _29: t_T = Any.any_l () ])
  [ return (result: tup3_V_U_T) ->
  {[@stop_split] [@expl:into_ghost_tup3_V_U_T ensures] ([@stop_split] [@expl:into_ghost result type invariant] inv_Ghost_tup3_V_U_T result)
    /\ ([@stop_split] [@expl:into_ghost ensures] result = snap)}
    (! return {result}) ]
