(* <(U, T) as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Mode
use creusot.prelude.Any

type t_U

type t_T

type tup2_U_T = { f0: t_U; f1: t_T }

predicate inv_U (_1: t_U)

predicate invariant_Ghost_U [@inline:trivial] (self: t_U) = inv_U self

meta "rewrite_def" predicate invariant_Ghost_U

predicate inv_Ghost_U [@inline:trivial] (_1: t_U) = invariant_Ghost_U _1

meta "rewrite_def" predicate inv_Ghost_U

let into_ghost_U (mode: Mode.t) (self: t_U) (return (x: t_U)) = any
  [ return (result: t_U) ->
  {[@stop_split] [@expl:into_ghost_U ensures] ([@stop_split] [@expl:into_ghost result type invariant] inv_Ghost_U result)
    /\ ([@stop_split] [@expl:into_ghost ensures] result = self)}
    (! return {result}) ]

predicate invariant_ref_Ghost_U [@inline:trivial] (self: t_U) = inv_Ghost_U self

meta "rewrite_def" predicate invariant_ref_Ghost_U

predicate inv_ref_Ghost_U [@inline:trivial] (_1: t_U) = invariant_ref_Ghost_U _1

meta "rewrite_def" predicate inv_ref_Ghost_U

predicate invariant_ref_U [@inline:trivial] (self: t_U) = inv_U self

meta "rewrite_def" predicate invariant_ref_U

predicate inv_ref_U [@inline:trivial] (_1: t_U) = invariant_ref_U _1

meta "rewrite_def" predicate inv_ref_U

let deref_Ghost_U (mode: Mode.t) (self: t_U) (return (x: t_U)) =
{[@stop_split] [@expl:deref 'self' type invariant] inv_ref_Ghost_U self}
  any
  [ return (result: t_U) ->
  {[@stop_split] [@expl:deref_Ghost_U ensures] ([@stop_split] [@expl:deref result type invariant] inv_ref_U result)
    /\ ([@stop_split] [@expl:deref ensures] result = self)}
    (! return {result}) ]

predicate inv_T (_1: t_T)

predicate invariant_Ghost_T [@inline:trivial] (self: t_T) = inv_T self

meta "rewrite_def" predicate invariant_Ghost_T

predicate inv_Ghost_T [@inline:trivial] (_1: t_T) = invariant_Ghost_T _1

meta "rewrite_def" predicate inv_Ghost_T

let into_ghost_T (mode: Mode.t) (self: t_T) (return (x: t_T)) = any
  [ return (result: t_T) ->
  {[@stop_split] [@expl:into_ghost_T ensures] ([@stop_split] [@expl:into_ghost result type invariant] inv_Ghost_T result)
    /\ ([@stop_split] [@expl:into_ghost ensures] result = self)}
    (! return {result}) ]

predicate invariant_ref_Ghost_T [@inline:trivial] (self: t_T) = inv_Ghost_T self

meta "rewrite_def" predicate invariant_ref_Ghost_T

predicate inv_ref_Ghost_T [@inline:trivial] (_1: t_T) = invariant_ref_Ghost_T _1

meta "rewrite_def" predicate inv_ref_Ghost_T

predicate invariant_ref_T [@inline:trivial] (self: t_T) = inv_T self

meta "rewrite_def" predicate invariant_ref_T

predicate inv_ref_T [@inline:trivial] (_1: t_T) = invariant_ref_T _1

meta "rewrite_def" predicate inv_ref_T

let deref_Ghost_T (mode: Mode.t) (self: t_T) (return (x: t_T)) =
{[@stop_split] [@expl:deref 'self' type invariant] inv_ref_Ghost_T self}
  any
  [ return (result: t_T) ->
  {[@stop_split] [@expl:deref_Ghost_T ensures] ([@stop_split] [@expl:deref result type invariant] inv_ref_T result)
    /\ ([@stop_split] [@expl:deref ensures] result = self)}
    (! return {result}) ]

predicate inv_tup2_U_T [@inline:trivial] (_1: tup2_U_T) = inv_U _1.f0 /\ inv_T _1.f1

meta "rewrite_def" predicate inv_tup2_U_T

predicate invariant_Ghost_tup2_U_T [@inline:trivial] (self: tup2_U_T) = inv_tup2_U_T self

meta "rewrite_def" predicate invariant_Ghost_tup2_U_T

predicate inv_Ghost_tup2_U_T [@inline:trivial] (_1: tup2_U_T) = invariant_Ghost_tup2_U_T _1

meta "rewrite_def" predicate inv_Ghost_tup2_U_T

let new_tup2_U_T (mode: Mode.t) (x: tup2_U_T) (return (x'0: tup2_U_T)) =
{[@stop_split] [@expl:new 'x' type invariant] inv_tup2_U_T x}
  any
  [ return (result: tup2_U_T) ->
  {[@stop_split] [@expl:new_tup2_U_T ensures] ([@stop_split] [@expl:new result type invariant] inv_Ghost_tup2_U_T result)
    /\ ([@stop_split] [@expl:new ensures] result = x)}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let into_ghost_tup2_U_T (mode: Mode.t) (snap: tup2_U_T) (return (x: tup2_U_T)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &x <- snap.f0 ] s1
    | s1 = into_ghost_U {Mode.into_ghost mode} {x} (fun (_x: t_U) -> [ &_11 <- _x ] s2)
    | s2 = deref_Ghost_U {Mode.into_ghost mode} {_11} (fun (_x: t_U) -> [ &_9 <- _x ] s3)
    | s3 = [ &x'0 <- snap.f1 ] s4
    | s4 = into_ghost_T {Mode.into_ghost mode} {x'0} (fun (_x: t_T) -> [ &_19 <- _x ] s5)
    | s5 = deref_Ghost_T {Mode.into_ghost mode} {_19} (fun (_x: t_T) -> [ &_17 <- _x ] s6)
    | s6 = [ &_4 <- { f0 = _9; f1 = _17 } ] s7
    | s7 = new_tup2_U_T {Mode.into_ghost mode} {_4} (fun (_x: tup2_U_T) -> [ &_ret <- _x ] s8)
    | s8 = return {_ret} ] ]
  [ & _ret: tup2_U_T = Any.any_l ()
  | & snap: tup2_U_T = snap
  | & _4: tup2_U_T = Any.any_l ()
  | & x: t_U = Any.any_l ()
  | & _9: t_U = Any.any_l ()
  | & _11: t_U = Any.any_l ()
  | & x'0: t_T = Any.any_l ()
  | & _17: t_T = Any.any_l ()
  | & _19: t_T = Any.any_l () ])
  [ return (result: tup2_U_T) ->
  {[@stop_split] [@expl:into_ghost_tup2_U_T ensures] ([@stop_split] [@expl:into_ghost result type invariant] inv_Ghost_tup2_U_T result)
    /\ ([@stop_split] [@expl:into_ghost ensures] result = snap)}
    (! return {result}) ]
