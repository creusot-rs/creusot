(* <(W, V, U, T) as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

type t_W

type t_V

type t_U

type t_T

type tup4_W_V_U_T = { f0: t_W; f1: t_V; f2: t_U; f3: t_T }

predicate inv_W (_1: t_W)

predicate inv_V (_1: t_V)

predicate inv_U (_1: t_U)

predicate inv_T (_1: t_T)

predicate inv_tup4_W_V_U_T [@inline:trivial] (_1: tup4_W_V_U_T) =
  inv_W _1.f0 /\ inv_V _1.f1 /\ inv_U _1.f2 /\ inv_T _1.f3

meta "rewrite_def" predicate inv_tup4_W_V_U_T

predicate invariant_Ghost_tup4_W_V_U_T [@inline:trivial] (self: tup4_W_V_U_T) = inv_tup4_W_V_U_T self

meta "rewrite_def" predicate invariant_Ghost_tup4_W_V_U_T

predicate inv_Ghost_tup4_W_V_U_T [@inline:trivial] (_1: tup4_W_V_U_T) = invariant_Ghost_tup4_W_V_U_T _1

meta "rewrite_def" predicate inv_Ghost_tup4_W_V_U_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: tup4_W_V_U_T. inv_tup4_W_V_U_T snap
    -> inv_tup4_W_V_U_T snap
    /\ (forall result: tup4_W_V_U_T. inv_Ghost_tup4_W_V_U_T result /\ result = snap
      -> inv_Ghost_tup4_W_V_U_T result /\ result = snap)
