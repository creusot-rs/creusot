let into_ghost_tup4_W_V_U_T (snap: tup4_W_V_U_T) (return (x: tup4_W_V_U_T)) =
{[@stop_split] [@expl:into_ghost requires] inv_tup4_W_V_U_T snap}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &x <- snap.f0 ] s1
    | s1 = into_ghost_W {x} (fun (_x: t_W) -> [ &_13 <- _x ] s2)
    | s2 = deref_Ghost_W {_13} (fun (_x: t_W) -> [ &_11 <- _x ] s3)
    | s3 = [ &x'0 <- snap.f1 ] s4
    | s4 = into_ghost_V {x'0} (fun (_x: t_V) -> [ &_21 <- _x ] s5)
    | s5 = deref_Ghost_V {_21} (fun (_x: t_V) -> [ &_19 <- _x ] s6)
    | s6 = [ &x'1 <- snap.f2 ] s7
    | s7 = into_ghost_U {x'1} (fun (_x: t_U) -> [ &_29 <- _x ] s8)
    | s8 = deref_Ghost_U {_29} (fun (_x: t_U) -> [ &_27 <- _x ] s9)
    | s9 = [ &x'2 <- snap.f3 ] s10
    | s10 = into_ghost_T {x'2} (fun (_x: t_T) -> [ &_37 <- _x ] s11)
    | s11 = deref_Ghost_T {_37} (fun (_x: t_T) -> [ &_35 <- _x ] s12)
    | s12 = [ &_6 <- { f0 = _11; f1 = _19; f2 = _27; f3 = _35 } ] s13
    | s13 = new_tup4_W_V_U_T {_6} (fun (_x: tup4_W_V_U_T) -> [ &_ret <- _x ] s14)
    | s14 = return {_ret} ] ]
  [ & _ret: tup4_W_V_U_T = Any.any_l ()
  | & snap: tup4_W_V_U_T = snap
  | & _6: tup4_W_V_U_T = Any.any_l ()
  | & x: t_W = Any.any_l ()
  | & _11: t_W = Any.any_l ()
  | & _13: t_W = Any.any_l ()
  | & x'0: t_V = Any.any_l ()
  | & _19: t_V = Any.any_l ()
  | & _21: t_V = Any.any_l ()
  | & x'1: t_U = Any.any_l ()
  | & _27: t_U = Any.any_l ()
  | & _29: t_U = Any.any_l ()
  | & x'2: t_T = Any.any_l ()
  | & _35: t_T = Any.any_l ()
  | & _37: t_T = Any.any_l () ])
  [ return (result: tup4_W_V_U_T) ->
