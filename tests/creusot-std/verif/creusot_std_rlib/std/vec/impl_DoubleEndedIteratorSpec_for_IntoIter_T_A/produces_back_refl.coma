(* <std::vec::IntoIter<T, A> as std::iter::DoubleEndedIteratorSpec> *)

type namespace_other

type t_Namespace = Other namespace_other

use seq.Seq
use seq.Reverse

type t_IntoIter_T_A

type t_T

function view_IntoIter_T_A (self: t_IntoIter_T_A) : Seq.seq t_T

predicate produces_back_IntoIter_T_A (self: t_IntoIter_T_A) (visited: Seq.seq t_T) (rhs: t_IntoIter_T_A) =
  view_IntoIter_T_A self = Seq.(++) (view_IntoIter_T_A rhs) (Reverse.reverse visited)

constant reverse_empty_T : ()

axiom reverse_empty_T_spec: Reverse.reverse (Seq.empty: Seq.seq t_T) = (Seq.empty: Seq.seq t_T)

function concat_empty_T (self: Seq.seq t_T) : ()

axiom concat_empty_T_spec: forall self: Seq.seq t_T. Seq.(++) self (Seq.empty: Seq.seq t_T) = self

axiom concat_empty_T_spec'0: forall self: Seq.seq t_T. Seq.(++) (Seq.empty: Seq.seq t_T) self = self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_IntoIter_T_A

function produces_back_refl_IntoIter_T_A (self: t_IntoIter_T_A) : ()

goal vc_produces_back_refl_IntoIter_T_A:
  ([@stop_split] [@expl:reverse_empty ensures] Reverse.reverse (Seq.empty: Seq.seq t_T) = (Seq.empty: Seq.seq t_T))
  -> (let _ = reverse_empty_T in [@stop_split] [@expl:produces_back_refl ensures] produces_back_IntoIter_T_A self (Seq.empty: Seq.seq t_T) self)
