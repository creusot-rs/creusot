(* <std::vec::IntoIter<T, A> as std::iter::DoubleEndedIteratorSpec> *)

type namespace_other

type t_Namespace = Other namespace_other

use seq.Seq
use seq.Reverse

type t_IntoIter_T_A

type t_T

function view_IntoIter_T_A (self: t_IntoIter_T_A) : Seq.seq t_T

predicate produces_back_IntoIter_T_A (self: t_IntoIter_T_A) (visited: Seq.seq t_T) (rhs: t_IntoIter_T_A) =
  view_IntoIter_T_A self = Seq.(++) (view_IntoIter_T_A rhs) (Reverse.reverse visited)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall a: t_IntoIter_T_A, ab: Seq.seq t_T, b: t_IntoIter_T_A, bc: Seq.seq t_T, c: t_IntoIter_T_A. produces_back_IntoIter_T_A a ab b
    -> produces_back_IntoIter_T_A b bc c
    -> produces_back_IntoIter_T_A a ab b
    /\ produces_back_IntoIter_T_A b bc c
    /\ (forall result: (). produces_back_IntoIter_T_A a (Seq.(++) ab bc) c
      -> produces_back_IntoIter_T_A a (Seq.(++) ab bc) c)
