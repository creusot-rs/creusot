(* <std::vec::IntoIter<T, A> as std::iter::DoubleEndedIteratorSpec> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt64
use seq.Seq
use seq.Reverse
use creusot.prelude.MutBorrow
use int.Int

type t_IntoIter_T_A

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_T

function view_IntoIter_T_A (self: t_IntoIter_T_A) : Seq.seq t_T

predicate postcondition_size_hint (self: ()) (args: t_IntoIter_T_A) (result: tup2_usize_Option_usize) =
  let self_ = args in UInt64.t'int result.f0 = Seq.length (view_IntoIter_T_A self_) /\ result.f1 = Some (result.f0)

meta "rewrite_def" predicate postcondition_size_hint

predicate inv_IntoIter_T_A (_1: t_IntoIter_T_A)

predicate invariant_ref_IntoIter_T_A [@inline:trivial] (self: t_IntoIter_T_A) = inv_IntoIter_T_A self

meta "rewrite_def" predicate invariant_ref_IntoIter_T_A

predicate inv_ref_IntoIter_T_A [@inline:trivial] (_1: t_IntoIter_T_A) = invariant_ref_IntoIter_T_A _1

meta "rewrite_def" predicate inv_ref_IntoIter_T_A

let size_hint_IntoIter_T_A (self_: t_IntoIter_T_A) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self_' type invariant] inv_ref_IntoIter_T_A self_}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_IntoIter_T_A ensures] ([@stop_split] [@expl:size_hint ensures #0] UInt64.t'int result.f0
      = Seq.length (view_IntoIter_T_A self_))
    /\ ([@stop_split] [@expl:size_hint ensures #1] result.f1 = Some (result.f0))}
    (! return {result}) ]

predicate produces_back_IntoIter_T_A (self: t_IntoIter_T_A) (visited: Seq.seq t_T) (rhs: t_IntoIter_T_A) =
  view_IntoIter_T_A self = Seq.(++) (view_IntoIter_T_A rhs) (Reverse.reverse visited)

predicate produces_IntoIter_T_A (self: t_IntoIter_T_A) (visited: Seq.seq t_T) (rhs: t_IntoIter_T_A) =
  view_IntoIter_T_A self = Seq.(++) visited (view_IntoIter_T_A rhs)

function produces_trans_IntoIter_T_A (a: t_IntoIter_T_A) (ab: Seq.seq t_T) (b: t_IntoIter_T_A) (bc: Seq.seq t_T) (c: t_IntoIter_T_A) : ()
 = ()

axiom produces_trans_IntoIter_T_A_spec:
  forall a: t_IntoIter_T_A, ab: Seq.seq t_T, b: t_IntoIter_T_A, bc: Seq.seq t_T, c: t_IntoIter_T_A. produces_IntoIter_T_A a ab b
    -> produces_IntoIter_T_A b bc c -> produces_IntoIter_T_A a (Seq.(++) ab bc) c

function produces_refl_IntoIter_T_A (self: t_IntoIter_T_A) : () = ()

axiom produces_refl_IntoIter_T_A_spec:
  forall self: t_IntoIter_T_A. produces_IntoIter_T_A self (Seq.empty: Seq.seq t_T) self

predicate resolve_refmut_IntoIter_T_A [@inline:trivial] (_1: MutBorrow.t t_IntoIter_T_A) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_IntoIter_T_A

predicate completed_IntoIter_T_A (self: MutBorrow.t t_IntoIter_T_A) =
  resolve_refmut_IntoIter_T_A self /\ view_IntoIter_T_A self.current = (Seq.empty: Seq.seq t_T)

predicate completed_back_IntoIter_T_A (self: MutBorrow.t t_IntoIter_T_A) = completed_IntoIter_T_A self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_IntoIter_T_A

constant r : tup2_usize_Option_usize

function size_hint_back_spec_IntoIter_T_A (self: t_IntoIter_T_A) (r: tup2_usize_Option_usize) : ()

goal vc_size_hint_back_spec_IntoIter_T_A: postcondition_size_hint () self r
  -> ([@stop_split] [@expl:size_hint_back_spec_IntoIter_T_A ensures] ([@stop_split] [@expl:size_hint_back_spec ensures #0] forall s: Seq.seq t_T, i: MutBorrow.t t_IntoIter_T_A. produces_back_IntoIter_T_A self s i.current
        /\ completed_back_IntoIter_T_A i -> UInt64.t'int r.f0 <= Seq.length s)
  /\ ([@stop_split] [@expl:size_hint_back_spec ensures #1] match r.f1 with
    | Some r'0 -> forall s: Seq.seq t_T, i: t_IntoIter_T_A. produces_back_IntoIter_T_A self s i
      -> Seq.length s <= UInt64.t'int r'0
    | None -> true
    end))
