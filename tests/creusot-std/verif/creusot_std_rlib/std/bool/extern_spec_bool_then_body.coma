type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Any

type t_F

type t_T

predicate inv_F (_1: t_F)

predicate precondition_F (self: t_F) (args: ())

predicate inv_T (_1: t_T)

predicate postcondition_once_F (self: t_F) (args: ()) (result: t_T)

let call_once_F (self_: t_F) (arg: ()) (return (x: t_T)) =
{[@stop_split] [@expl:call_once_F requires] ([@stop_split] [@expl:call_once 'self_' type invariant] inv_F self_)
  /\ ([@stop_split] [@expl:call_once requires] precondition_F self_ arg)}
  any
  [ return (result: t_T) ->
  {[@stop_split] [@expl:call_once_F ensures] ([@stop_split] [@expl:call_once result type invariant] inv_T result)
    /\ ([@stop_split] [@expl:call_once ensures] postcondition_once_F self_ arg result)}
    (! return {result}) ]

type t_Option_T = None | Some t_T

predicate resolve_F (_1: t_F)

predicate inv_Option_T (_1: t_Option_T)

axiom inv_axiom [@rewrite]: forall x: t_Option_T [inv_Option_T x]. inv_Option_T x
    = match x with
      | None -> true
      | Some f0 -> inv_T f0
      end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let extern_spec_bool_then_body_T (self_: bool) (f: t_F) (return (x: t_Option_T)) =
{[@stop_split] [@expl:extern_spec_bool_then_body_T requires] ([@stop_split] [@expl:extern_spec_bool_then_body 'f' type invariant] inv_F f)
  /\ ([@stop_split] [@expl:extern_spec_bool_then_body requires] self_ -> precondition_F f ())}
  (! bb0
  [ bb0 = any [ br0 -> {self_ = false} (! bb4) | br1 -> {self_} (! bb1) ]
  | bb1 = s0
    [ s0 = call_once_F {f} {_14} (fun (_x: t_T) -> [ &_12 <- _x ] s1)
    | s1 = [ &_ret <- Some _12 ] s2
    | s2 = return {_ret} ]
  | bb4 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_F f} any) ]
    | s1 = -{resolve_F f}- s2
    | s2 = [ &_ret <- None ] s3
    | s3 = return {_ret} ] ]
  [ & _ret: t_Option_T = Any.any_l ()
  | & self_: bool = self_
  | & f: t_F = f
  | & _12: t_T = Any.any_l ()
  | & _14: () = Any.any_l () ])
  [ return (result: t_Option_T) ->
  {[@stop_split] [@expl:extern_spec_bool_then_body_T ensures] ([@stop_split] [@expl:extern_spec_bool_then_body result type invariant] inv_Option_T result)
    /\ ([@stop_split] [@expl:extern_spec_bool_then_body ensures #0] not self_ -> result = None)
    /\ ([@stop_split] [@expl:extern_spec_bool_then_body ensures #1] self_
    -> match result with
      | None -> false
      | Some t -> postcondition_once_F f () t
      end)}
    (! return {result}) ]
