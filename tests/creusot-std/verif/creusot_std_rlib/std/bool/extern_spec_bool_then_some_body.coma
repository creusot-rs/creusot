type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Any

type t_T

type t_Option_T = None | Some t_T

predicate inv_T (_1: t_T)

predicate resolve_T (_1: t_T)

predicate inv_Option_T (_1: t_Option_T)

axiom inv_axiom [@rewrite]: forall x: t_Option_T [inv_Option_T x]. inv_Option_T x
    = match x with
      | None -> true
      | Some f0 -> inv_T f0
      end

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let extern_spec_bool_then_some_body_T (self_: bool) (t: t_T) (return (x: t_Option_T)) =
{[@stop_split] [@expl:extern_spec_bool_then_some_body 't' type invariant] inv_T t}
  (! bb0
  [ bb0 = any [ br0 -> {self_ = false} (! bb3) | br1 -> {self_} (! bb1) ]
  | bb1 = s0 [ s0 = [ &_ret <- Some t ] s1 | s1 = return {_ret} ]
  | bb3 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_T t} any) ]
    | s1 = -{resolve_T t}- s2
    | s2 = [ &_ret <- None ] s3
    | s3 = return {_ret} ] ] [ & _ret: t_Option_T = Any.any_l () | & self_: bool = self_ | & t: t_T = t ])
  [ return (result: t_Option_T) ->
  {[@stop_split] [@expl:extern_spec_bool_then_some_body_T ensures] ([@stop_split] [@expl:extern_spec_bool_then_some_body result type invariant] inv_Option_T result)
    /\ ([@stop_split] [@expl:extern_spec_bool_then_some_body ensures] result = (if self_ then Some t else None))}
    (! return {result}) ]
