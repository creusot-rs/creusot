(* <std::collections::vec_deque::Iter<'a, T> as std::iter::IteratorSpec> *)

type namespace_other

type t_Namespace = Other namespace_other

use seq.Seq

type t_Iter_T

type t_T

function view_Iter_T (self: t_Iter_T) : Seq.seq t_T

predicate produces_Iter_T (self: t_Iter_T) (visited: Seq.seq t_T) (tl: t_Iter_T) =
  view_Iter_T self = Seq.(++) visited (view_Iter_T tl)

function concat_empty_ref_T (self: Seq.seq t_T) : ()

axiom concat_empty_ref_T_spec: forall self: Seq.seq t_T. Seq.(++) self (Seq.empty: Seq.seq t_T) = self

axiom concat_empty_ref_T_spec'0: forall self: Seq.seq t_T. Seq.(++) (Seq.empty: Seq.seq t_T) self = self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Iter_T

function produces_refl_Iter_T (self: t_Iter_T) : ()

goal vc_produces_refl_Iter_T:
  [@stop_split] [@expl:produces_refl ensures] produces_Iter_T self (Seq.empty: Seq.seq t_T) self
