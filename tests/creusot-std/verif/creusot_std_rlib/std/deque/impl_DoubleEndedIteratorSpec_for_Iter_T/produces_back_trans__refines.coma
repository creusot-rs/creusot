(* <std::collections::vec_deque::Iter<'a, T> as std::iter::DoubleEndedIteratorSpec> *)

type namespace_other

type t_Namespace = Other namespace_other

use seq.Seq
use seq.Reverse

type t_Iter_T

type t_T

function view_Iter_T (self: t_Iter_T) : Seq.seq t_T

predicate produces_back_Iter_T (self: t_Iter_T) (visited: Seq.seq t_T) (tl: t_Iter_T) =
  view_Iter_T self = Seq.(++) (view_Iter_T tl) (Reverse.reverse visited)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall a: t_Iter_T, ab: Seq.seq t_T, b: t_Iter_T, bc: Seq.seq t_T, c: t_Iter_T. produces_back_Iter_T a ab b
    -> produces_back_Iter_T b bc c
    -> produces_back_Iter_T a ab b
    /\ produces_back_Iter_T b bc c
    /\ (forall result: (). produces_back_Iter_T a (Seq.(++) ab bc) c -> produces_back_Iter_T a (Seq.(++) ab bc) c)
