predicate is_aligned_to_ptr_T (self: Opaque.ptr) (align: UInt64BW.t) =
  UInt64BW.bw_and (PtrBW.addr_logic_u64 self) (UInt64BW.sub align (1: UInt64BW.t)) = (0: UInt64BW.t)

