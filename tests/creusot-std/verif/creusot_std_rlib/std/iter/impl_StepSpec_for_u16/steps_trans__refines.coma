(* <u16 as std::iter::StepSpec> *)

use creusot.int.UInt16
use int.Int

function steps_to_u16 [@inline:trivial] (self: UInt16.t) (other: UInt16.t) : int = UInt16.t'int other
  - UInt16.t'int self

meta "rewrite_def" function steps_to_u16

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall a: UInt16.t, b: UInt16.t, c: UInt16.t. forall result: (). steps_to_u16 a b + steps_to_u16 b c
      = steps_to_u16 a c
