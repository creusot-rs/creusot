(* <u32 as std::iter::StepSpec> *)

use creusot.int.UInt32
use int.Int

function steps_to_u32 [@inline:trivial] (self: UInt32.t) (other: UInt32.t) : int = UInt32.t'int other
  - UInt32.t'int self

meta "rewrite_def" function steps_to_u32

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: UInt32.t. forall result: (). steps_to_u32 self self = 0
