(* <i128 as std::iter::StepSpec> *)

use creusot.int.Int128
use int.Int

function deep_model_i128 [@inline:trivial] (self: Int128.t) : int = Int128.to_int self

meta "rewrite_def" function deep_model_i128

function steps_to_i128 [@inline:trivial] (self: Int128.t) (other: Int128.t) : int = Int128.to_int other
  - Int128.to_int self

meta "rewrite_def" function steps_to_i128

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: Int128.t, other: Int128.t. forall result: (). (deep_model_i128 self < deep_model_i128 other)
      = (0 < steps_to_i128 self other)
