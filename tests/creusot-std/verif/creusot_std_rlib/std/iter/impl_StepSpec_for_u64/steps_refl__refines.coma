(* <u64 as std::iter::StepSpec> *)

use creusot.int.UInt64
use int.Int

function steps_to_u64 [@inline:trivial] (self: UInt64.t) (other: UInt64.t) : int = UInt64.t'int other
  - UInt64.t'int self

meta "rewrite_def" function steps_to_u64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: UInt64.t. forall result: (). steps_to_u64 self self = 0
