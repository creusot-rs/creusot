(* <std::num::NonZero<u128> as std::iter::StepSpec> *)

use creusot.int.UInt128
use int.Int

function deep_model_u128 [@inline:trivial] (self: UInt128.t) : int = UInt128.t'int self

meta "rewrite_def" function deep_model_u128

function deep_model_NonZero_u128 [@inline:trivial] (self: UInt128.t) : int = deep_model_u128 self

meta "rewrite_def" function deep_model_NonZero_u128

function view_NonZero_u128 [@inline:trivial] (self: UInt128.t) : int = UInt128.t'int self

meta "rewrite_def" function view_NonZero_u128

function steps_to_NonZero_u128 [@inline:trivial] (self: UInt128.t) (other: UInt128.t) : int = view_NonZero_u128 other
  - view_NonZero_u128 self

meta "rewrite_def" function steps_to_NonZero_u128

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: UInt128.t, other: UInt128.t. forall result: (). (deep_model_NonZero_u128 self
        < deep_model_NonZero_u128 other)
      = (0 < steps_to_NonZero_u128 self other)
