(* <std::iter::Map<I, F> as std::iter::ExactSizeIteratorSpec> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt64
use creusot.prelude.Mode
use seq.Seq
use creusot.prelude.MutBorrow
use int.Int

type t_Map_I_F

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_I

type t_Item

predicate produces_I (self: t_I) (visited: Seq.seq t_Item) (o: t_I)

function produces_trans_I (a: t_I) (ab: Seq.seq t_Item) (b: t_I) (bc: Seq.seq t_Item) (c: t_I) : ()

axiom produces_trans_I_spec: forall a: t_I, ab: Seq.seq t_Item, b: t_I, bc: Seq.seq t_Item, c: t_I. produces_I a ab b
    -> produces_I b bc c -> produces_I a (Seq.(++) ab bc) c

function produces_refl_I (self: t_I) : ()

axiom produces_refl_I_spec: forall self: t_I. produces_I self (Seq.empty: Seq.seq t_Item) self

predicate completed_I (self: MutBorrow.t t_I)

predicate postcondition_size_hint (self: ()) (args: t_I) (result: tup2_usize_Option_usize) (mode: Mode.t)

axiom postcondition_fndef:
  forall args: t_I, result: tup2_usize_Option_usize, mode: Mode.t [postcondition_size_hint () args result mode]. postcondition_size_hint () args result mode
    -> (let self = args in (forall s: Seq.seq t_Item, i: MutBorrow.t t_I. produces_I self s i.current /\ completed_I i
        -> UInt64.t'int result.f0 <= Seq.length s)
    /\ match result.f1 with
      | Some r -> forall s: Seq.seq t_Item, i: t_I. produces_I self s i -> Seq.length s <= UInt64.t'int r
      | None -> true
      end)

function iter_Map_I_F (self: t_Map_I_F) : t_I

predicate postcondition_size_hint'0 (self: ()) (args: t_Map_I_F) (result: tup2_usize_Option_usize) (mode: Mode.t) =
  let self'0 = args in postcondition_size_hint () (iter_Map_I_F self'0) result mode

meta "rewrite_def" predicate postcondition_size_hint'0

predicate inv_I (_1: t_I)

type t_F

predicate inv_F (_1: t_F)

function func_Map_I_F (self: t_Map_I_F) : t_F

predicate inv_Item (_1: t_Item)

predicate precondition_F (self: t_F) (args: t_Item) (mode: Mode.t)

predicate next_precondition_I [@inline:trivial] (iter: t_I) (func: t_F) =
  forall e: t_Item, i: t_I [produces_I iter (Seq.singleton e) i]. inv_Item e /\ produces_I iter (Seq.singleton e) i
    -> (forall mode: Mode.t. precondition_F func e mode)

meta "rewrite_def" predicate next_precondition_I

type t_B

predicate postcondition_once_F (self: t_F) (args: t_Item) (result: t_B) (mode: Mode.t)

predicate resolve_F (_1: t_F)

predicate postcondition_mut_F (self: t_F) (args: t_Item) (result_state: t_F) (result: t_B) (mode: Mode.t)

function fn_mut_once_F (self: t_F) (args: t_Item) (res: t_B) (mode: Mode.t) : ()

axiom fn_mut_once_F_spec:
  forall self: t_F, args: t_Item, res: t_B, mode: Mode.t [postcondition_once_F self args res mode]. postcondition_once_F self args res mode
    = (exists res_state: t_F. postcondition_mut_F self args res_state res mode /\ resolve_F res_state)

predicate hist_inv_F (self: t_F) (result_state: t_F)

function hist_inv_trans_F (self: t_F) (b: t_F) (c: t_F) : ()

axiom hist_inv_trans_F_spec:
  forall self: t_F, b: t_F, c: t_F [hist_inv_F self b, hist_inv_F b c | hist_inv_F self b, hist_inv_F self c | hist_inv_F b c, hist_inv_F self c]. hist_inv_F self b
    -> hist_inv_F b c -> hist_inv_F self c

function hist_inv_refl_F (self: t_F) : ()

axiom hist_inv_refl_F_spec: forall self: t_F [hist_inv_F self self]. hist_inv_F self self

function postcondition_mut_hist_inv_F (self: t_F) (args: t_Item) (res_state: t_F) (res: t_B) (mode: Mode.t) : ()

axiom postcondition_mut_hist_inv_F_spec:
  forall self: t_F, args: t_Item, res_state: t_F, res: t_B, mode: Mode.t [postcondition_mut_F self args res_state res mode | hist_inv_F self res_state]. postcondition_mut_F self args res_state res mode
    -> hist_inv_F self res_state

predicate invariant_ref_Item [@inline:trivial] (self: t_Item) = inv_Item self

meta "rewrite_def" predicate invariant_ref_Item

predicate inv_ref_Item [@inline:trivial] (_1: t_Item) = invariant_ref_Item _1

meta "rewrite_def" predicate inv_ref_Item

predicate invariant_Seq_Item [@inline:trivial] (self: Seq.seq t_Item) =
  forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_Item (Seq.get self i)

meta "rewrite_def" predicate invariant_Seq_Item

predicate inv_Seq_Item [@inline:trivial] (_1: Seq.seq t_Item) = invariant_Seq_Item _1

meta "rewrite_def" predicate inv_Seq_Item

predicate invariant_refmut_F [@inline:trivial] (self: MutBorrow.t t_F) = inv_F self.current /\ inv_F self.final

meta "rewrite_def" predicate invariant_refmut_F

predicate inv_refmut_F [@inline:trivial] (_1: MutBorrow.t t_F) = invariant_refmut_F _1

meta "rewrite_def" predicate inv_refmut_F

predicate preservation_I [@inline:trivial] (iter: t_I) (func: t_F) =
  forall s: Seq.seq t_Item, e1: t_Item, e2: t_Item, f: MutBorrow.t t_F, b: t_B, i: t_I, mode: Mode.t [produces_I iter (Seq.snoc (Seq.snoc s e1) e2) i, postcondition_mut_F f.current e1 f.final b mode]. hist_inv_F func f.current
      /\ inv_Seq_Item s
      /\ inv_Item e1
      /\ inv_Item e2
      /\ inv_refmut_F f
      /\ produces_I iter (Seq.snoc (Seq.snoc s e1) e2) i /\ postcondition_mut_F f.current e1 f.final b Mode.program_mode
    -> precondition_F f.final e2 mode

meta "rewrite_def" predicate preservation_I

predicate reinitialize_I [@inline:trivial] =
  forall iter: MutBorrow.t t_I, func: t_F. completed_I iter
    -> next_precondition_I iter.final func /\ preservation_I iter.final func

meta "rewrite_def" predicate reinitialize_I

predicate invariant_Map_I_F (self: t_Map_I_F) =
  inv_I (iter_Map_I_F self)
  /\ inv_F (func_Map_I_F self)
  /\ reinitialize_I
  /\ preservation_I (iter_Map_I_F self) (func_Map_I_F self)
  /\ next_precondition_I (iter_Map_I_F self) (func_Map_I_F self)

axiom invariant_Map_I_F_spec: forall self: t_Map_I_F [invariant_Map_I_F self]. invariant_Map_I_F self
    -> inv_I (iter_Map_I_F self) /\ inv_F (func_Map_I_F self)

predicate inv_Map_I_F (_1: t_Map_I_F)

axiom inv_axiom: forall _1: t_Map_I_F [inv_Map_I_F _1]. inv_Map_I_F _1 -> invariant_Map_I_F _1

predicate invariant_ref_Map_I_F [@inline:trivial] (self: t_Map_I_F) = inv_Map_I_F self

meta "rewrite_def" predicate invariant_ref_Map_I_F

predicate inv_ref_Map_I_F [@inline:trivial] (_1: t_Map_I_F) = invariant_ref_Map_I_F _1

meta "rewrite_def" predicate inv_ref_Map_I_F

predicate invariant_ref_I [@inline:trivial] (self: t_I) = inv_I self

meta "rewrite_def" predicate invariant_ref_I

predicate inv_ref_I [@inline:trivial] (_1: t_I) = invariant_ref_I _1

meta "rewrite_def" predicate inv_ref_I

predicate precondition_size_hint (self: ()) (args: t_I) (mode: Mode.t)

axiom precondition_fndef:
  forall mode: Mode.t. forall args: t_I [precondition_size_hint () args mode]. (let self = args in inv_ref_I self)
      -> precondition_size_hint () args mode

predicate postcondition_once_size_hint (self: ()) (args: t_I) (result: tup2_usize_Option_usize) (mode: Mode.t) =
  postcondition_size_hint self args result mode

meta "rewrite_def" predicate postcondition_once_size_hint

let size_hint_I (self: t_I) (mode: Mode.t) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint requires] precondition_size_hint () self mode}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint ensures] postcondition_once_size_hint () self result mode}
    (! return {result}) ]

let size_hint_Map_I_F (self: t_Map_I_F) (mode: Mode.t) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] inv_ref_Map_I_F self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint ensures] postcondition_size_hint () (iter_Map_I_F self) result mode}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines:
  forall self: t_Map_I_F, r: tup2_usize_Option_usize. (exists mode: Mode.t. postcondition_size_hint'0 () self r mode)
    -> (exists mode: Mode.t. postcondition_size_hint'0 () self r mode)
    /\ (forall result: (). r.f1 = Some (r.f0) -> r.f1 = Some (r.f0))
