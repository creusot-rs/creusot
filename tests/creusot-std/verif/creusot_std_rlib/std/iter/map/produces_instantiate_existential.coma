function such_that_tup2_Seq_refmut_F_Seq_Item (p: Map.map tup2_Seq_refmut_F_Seq_Item bool) : tup2_Seq_refmut_F_Seq_Item

axiom such_that_tup2_Seq_refmut_F_Seq_Item_spec:
