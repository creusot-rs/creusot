(* std::iter::map_inv::MapInv<I, F> *)

type namespace_other

type t_Namespace = Other namespace_other

use seq.Seq
use creusot.prelude.Mode
use int.Int

type t_I

type t_F

type t_Item

type t_MapInv_I_F = { iter: t_I; func: t_F; produced: Seq.seq t_Item }

type t_B

type tup2_Item_Snapshot_Seq_Item = { f0: t_Item; f1: Seq.seq t_Item }

predicate postcondition_once_F (self: t_F) (mode: Mode.t) (args: tup2_Item_Snapshot_Seq_Item) (result: t_B)

predicate resolve_F (_1: t_F)

predicate postcondition_mut_F (self: t_F) (mode: Mode.t) (args: tup2_Item_Snapshot_Seq_Item) (result_state: t_F) (result: t_B)

function fn_mut_once_F (self: t_F) (mode: Mode.t) (args: tup2_Item_Snapshot_Seq_Item) (res: t_B) : ()

axiom fn_mut_once_F_spec:
  forall self: t_F, mode: Mode.t, args: tup2_Item_Snapshot_Seq_Item, res: t_B [postcondition_once_F self mode args res]. postcondition_once_F self mode args res
    = (exists res_state: t_F. postcondition_mut_F self mode args res_state res /\ resolve_F res_state)

predicate hist_inv_F (self: t_F) (result_state: t_F)

function hist_inv_trans_F (self: t_F) (b: t_F) (c: t_F) : ()

axiom hist_inv_trans_F_spec:
  forall self: t_F, b: t_F, c: t_F [hist_inv_F self b, hist_inv_F b c | hist_inv_F self b, hist_inv_F self c | hist_inv_F b c, hist_inv_F self c]. hist_inv_F self b
    -> hist_inv_F b c -> hist_inv_F self c

function hist_inv_refl_F (self: t_F) : ()

axiom hist_inv_refl_F_spec: forall self: t_F [hist_inv_F self self]. hist_inv_F self self

function postcondition_mut_hist_inv_F (self: t_F) (mode: Mode.t) (args: tup2_Item_Snapshot_Seq_Item) (res_state: t_F) (res: t_B) : ()

axiom postcondition_mut_hist_inv_F_spec:
  forall self: t_F, mode: Mode.t, args: tup2_Item_Snapshot_Seq_Item, res_state: t_F, res: t_B [postcondition_mut_F self mode args res_state res | hist_inv_F self res_state]. postcondition_mut_F self mode args res_state res
    -> hist_inv_F self res_state

predicate produces_I (self: t_I) (visited: Seq.seq t_Item) (o: t_I)

function produces_trans_I (a: t_I) (ab: Seq.seq t_Item) (b: t_I) (bc: Seq.seq t_Item) (c: t_I) : ()

axiom produces_trans_I_spec: forall a: t_I, ab: Seq.seq t_Item, b: t_I, bc: Seq.seq t_Item, c: t_I. produces_I a ab b
    -> produces_I b bc c -> produces_I a (Seq.(++) ab bc) c

function produces_refl_I (self: t_I) : ()

axiom produces_refl_I_spec: forall self: t_I. produces_I self (Seq.empty: Seq.seq t_Item) self

function push_front_F [@inline:trivial] (self: Seq.seq t_F) (x: t_F) : Seq.seq t_F = Seq.cons x self

meta "rewrite_def" function push_front_F

predicate produces_MapInv_I_F [@inline:trivial] (self: t_MapInv_I_F) (visited: Seq.seq t_B) (succ: t_MapInv_I_F) =
  hist_inv_F self.func succ.func
  /\ (exists fs: Seq.seq t_F. Seq.length fs = Seq.length visited
    /\ (exists s: Seq.seq t_Item. Seq.length s = Seq.length visited
      /\ produces_I self.iter s succ.iter
      /\ succ.produced = Seq.(++) self.produced s
      /\ (Seq.length visited = 0 -> self.func = succ.func)
      /\ (Seq.length visited <> 0 -> Seq.get fs (Seq.length fs - 1) = succ.func)
      /\ (forall i: int. 0 <= i /\ i < Seq.length visited
        -> hist_inv_F self.func (Seq.get (push_front_F fs self.func) i)
        /\ (exists mode: Mode.t. postcondition_mut_F (Seq.get (push_front_F fs self.func) i) mode { f0 = Seq.get s i;
                                                                                                    f1 = Seq.(++) self.produced (Seq.([..]) s 0 i) } (Seq.get (push_front_F fs self.func) (i
          + 1)) (Seq.get visited i)))))

meta "rewrite_def" predicate produces_MapInv_I_F

function produces_trans_MapInv_I_F (a: t_MapInv_I_F) (ab: Seq.seq t_B) (b: t_MapInv_I_F) (bc: Seq.seq t_B) (c: t_MapInv_I_F) : ()
 = ()

axiom produces_trans_MapInv_I_F_spec:
  forall a: t_MapInv_I_F, ab: Seq.seq t_B, b: t_MapInv_I_F, bc: Seq.seq t_B, c: t_MapInv_I_F. produces_MapInv_I_F a ab b
    -> produces_MapInv_I_F b bc c -> produces_MapInv_I_F a (Seq.(++) ab bc) c

function produces_refl_MapInv_I_F (self: t_MapInv_I_F) : () = ()

axiom produces_refl_MapInv_I_F_spec: forall self: t_MapInv_I_F. produces_MapInv_I_F self (Seq.empty: Seq.seq t_B) self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_MapInv_I_F

constant visited : t_B

constant succ : t_MapInv_I_F

predicate produces_one_I (self: t_MapInv_I_F) (visited: t_B) (succ: t_MapInv_I_F)

goal vc_produces_one_I:
  [@stop_split] [@expl:produces_one ensures] (exists e: t_Item. produces_I self.iter (Seq.singleton e) succ.iter
      /\ succ.produced = Seq.snoc self.produced e
      /\ (exists mode: Mode.t. postcondition_mut_F self.func mode { f0 = e; f1 = self.produced } succ.func visited))
  = produces_MapInv_I_F self (Seq.singleton visited) succ
