(* <std::num::NonZero<usize> as std::iter::StepSpec> *)

use creusot.int.UInt64
use int.Int

function deep_model_usize [@inline:trivial] (self: UInt64.t) : int = UInt64.t'int self

meta "rewrite_def" function deep_model_usize

function deep_model_NonZero_usize [@inline:trivial] (self: UInt64.t) : int = deep_model_usize self

meta "rewrite_def" function deep_model_NonZero_usize

function view_NonZero_usize [@inline:trivial] (self: UInt64.t) : int = UInt64.t'int self

meta "rewrite_def" function view_NonZero_usize

function steps_to_NonZero_usize [@inline:trivial] (self: UInt64.t) (other: UInt64.t) : int = view_NonZero_usize other
  - view_NonZero_usize self

meta "rewrite_def" function steps_to_NonZero_usize

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: UInt64.t, other: UInt64.t. forall result: (). (deep_model_NonZero_usize self
        < deep_model_NonZero_usize other)
      = (0 < steps_to_NonZero_usize self other)
