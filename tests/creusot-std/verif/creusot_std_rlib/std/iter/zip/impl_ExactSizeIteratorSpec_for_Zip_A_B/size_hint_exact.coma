(* <std::iter::Zip<A, B> as std::iter::ExactSizeIteratorSpec> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt64
use seq.Seq
use creusot.prelude.MutBorrow
use int.Int

type t_Zip_A_B

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_A

type t_Item

predicate produces_A (self: t_A) (visited: Seq.seq t_Item) (o: t_A)

function produces_trans_A (a: t_A) (ab: Seq.seq t_Item) (b: t_A) (bc: Seq.seq t_Item) (c: t_A) : ()

axiom produces_trans_A_spec: forall a: t_A, ab: Seq.seq t_Item, b: t_A, bc: Seq.seq t_Item, c: t_A. produces_A a ab b
    -> produces_A b bc c -> produces_A a (Seq.(++) ab bc) c

function produces_refl_A (self: t_A) : ()

axiom produces_refl_A_spec: forall self: t_A. produces_A self (Seq.empty: Seq.seq t_Item) self

predicate completed_A (self: MutBorrow.t t_A)

predicate postcondition_size_hint (self: ()) (args: t_A) (result: tup2_usize_Option_usize)

axiom postcondition_fndef:
  forall args: t_A, res: tup2_usize_Option_usize [postcondition_size_hint () args res]. postcondition_size_hint () args res
    -> (let self_ = args in (forall s: Seq.seq t_Item, i: MutBorrow.t t_A. produces_A self_ s i.current /\ completed_A i
        -> UInt64.t'int res.f0 <= Seq.length s)
    /\ match res.f1 with
      | Some r -> forall s: Seq.seq t_Item, i: t_A. produces_A self_ s i -> Seq.length s <= UInt64.t'int r
      | None -> true
      end)

function iter_a_Zip_A_B (self: t_Zip_A_B) : t_A

type t_B

type t_Item'0

predicate produces_B (self: t_B) (visited: Seq.seq t_Item'0) (o: t_B)

function produces_trans_B (a: t_B) (ab: Seq.seq t_Item'0) (b: t_B) (bc: Seq.seq t_Item'0) (c: t_B) : ()

axiom produces_trans_B_spec:
  forall a: t_B, ab: Seq.seq t_Item'0, b: t_B, bc: Seq.seq t_Item'0, c: t_B. produces_B a ab b
    -> produces_B b bc c -> produces_B a (Seq.(++) ab bc) c

function produces_refl_B (self: t_B) : ()

axiom produces_refl_B_spec: forall self: t_B. produces_B self (Seq.empty: Seq.seq t_Item'0) self

predicate completed_B (self: MutBorrow.t t_B)

predicate postcondition_size_hint'0 (self: ()) (args: t_B) (result: tup2_usize_Option_usize)

axiom postcondition_fndef'0:
  forall args: t_B, res: tup2_usize_Option_usize [postcondition_size_hint'0 () args res]. postcondition_size_hint'0 () args res
    -> (let self_ = args in (forall s: Seq.seq t_Item'0, i: MutBorrow.t t_B. produces_B self_ s i.current
          /\ completed_B i -> UInt64.t'int res.f0 <= Seq.length s)
    /\ match res.f1 with
      | Some r -> forall s: Seq.seq t_Item'0, i: t_B. produces_B self_ s i -> Seq.length s <= UInt64.t'int r
      | None -> true
      end)

function iter_b_Zip_A_B (self: t_Zip_A_B) : t_B

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

type tup2_Option_usize_Option_usize = { f0'0: t_Option_usize; f1'0: t_Option_usize }

predicate postcondition_size_hint'1 (self: ()) (args: t_Zip_A_B) (result: tup2_usize_Option_usize) =
  let self_ = args in exists ra: tup2_usize_Option_usize, rb: tup2_usize_Option_usize. postcondition_size_hint () (iter_a_Zip_A_B self_) ra
    /\ postcondition_size_hint'0 () (iter_b_Zip_A_B self_) rb
    /\ (UInt64.t'int ra.f0 <= UInt64.t'int rb.f0 -> result.f0 = ra.f0)
    /\ (ge_log_Int (UInt64.t'int ra.f0) (UInt64.t'int rb.f0) -> result.f0 = rb.f0)
    /\ match { f0'0 = ra.f1; f1'0 = rb.f1 } with
      | {f0'0 = Some ua; f1'0 = Some ub} -> (UInt64.t'int ua <= UInt64.t'int ub -> result.f1 = Some ua)
      /\ (ge_log_Int (UInt64.t'int ua) (UInt64.t'int ub) -> result.f1 = Some ub)
      | {f0'0 = Some ua; f1'0 = None} -> result.f1 = Some ua
      | {f0'0 = None; f1'0 = Some ub} -> result.f1 = Some ub
      | {f0'0 = None; f1'0 = None} -> result.f1 = None
      end

meta "rewrite_def" predicate postcondition_size_hint'1

predicate inv_A (_1: t_A)

predicate inv_B (_1: t_B)

predicate invariant_Zip_A_B [@inline:trivial] (self: t_Zip_A_B) =
  inv_A (iter_a_Zip_A_B self) /\ inv_B (iter_b_Zip_A_B self)

meta "rewrite_def" predicate invariant_Zip_A_B

predicate inv_Zip_A_B (_1: t_Zip_A_B)

axiom inv_axiom: forall x: t_Zip_A_B [inv_Zip_A_B x]. inv_Zip_A_B x -> invariant_Zip_A_B x

predicate invariant_ref_Zip_A_B [@inline:trivial] (self: t_Zip_A_B) = inv_Zip_A_B self

meta "rewrite_def" predicate invariant_ref_Zip_A_B

predicate inv_ref_Zip_A_B [@inline:trivial] (_1: t_Zip_A_B) = invariant_ref_Zip_A_B _1

meta "rewrite_def" predicate inv_ref_Zip_A_B

predicate invariant_ref_A [@inline:trivial] (self: t_A) = inv_A self

meta "rewrite_def" predicate invariant_ref_A

predicate inv_ref_A [@inline:trivial] (_1: t_A) = invariant_ref_A _1

meta "rewrite_def" predicate inv_ref_A

predicate precondition_size_hint (self: ()) (args: t_A)

axiom precondition_fndef: forall args: t_A [precondition_size_hint () args]. (let self_ = args in inv_ref_A self_)
    -> precondition_size_hint () args

predicate postcondition_once_size_hint (self: ()) (args: t_A) (result: tup2_usize_Option_usize) =
  postcondition_size_hint self args result

meta "rewrite_def" predicate postcondition_once_size_hint

let size_hint_A (self_: t_A) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint requires] precondition_size_hint () self_}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint ensures] postcondition_once_size_hint () self_ result}
    (! return {result}) ]

predicate invariant_ref_B [@inline:trivial] (self: t_B) = inv_B self

meta "rewrite_def" predicate invariant_ref_B

predicate inv_ref_B [@inline:trivial] (_1: t_B) = invariant_ref_B _1

meta "rewrite_def" predicate inv_ref_B

predicate precondition_size_hint'0 (self: ()) (args: t_B)

axiom precondition_fndef'0: forall args: t_B [precondition_size_hint'0 () args]. (let self_ = args in inv_ref_B self_)
    -> precondition_size_hint'0 () args

predicate postcondition_once_size_hint'0 (self: ()) (args: t_B) (result: tup2_usize_Option_usize) =
  postcondition_size_hint'0 self args result

meta "rewrite_def" predicate postcondition_once_size_hint'0

let size_hint_B (self_: t_B) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint requires] precondition_size_hint'0 () self_}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint ensures] postcondition_once_size_hint'0 () self_ result}
    (! return {result}) ]

let size_hint_Zip_A_B (self_: t_Zip_A_B) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self_' type invariant] inv_ref_Zip_A_B self_}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint ensures] exists ra: tup2_usize_Option_usize, rb: tup2_usize_Option_usize. postcondition_size_hint () (iter_a_Zip_A_B self_) ra
      /\ postcondition_size_hint'0 () (iter_b_Zip_A_B self_) rb
      /\ (UInt64.t'int ra.f0 <= UInt64.t'int rb.f0 -> result.f0 = ra.f0)
      /\ (ge_log_Int (UInt64.t'int ra.f0) (UInt64.t'int rb.f0) -> result.f0 = rb.f0)
      /\ match { f0'0 = ra.f1; f1'0 = rb.f1 } with
        | {f0'0 = Some ua; f1'0 = Some ub} -> (UInt64.t'int ua <= UInt64.t'int ub -> result.f1 = Some ua)
        /\ (ge_log_Int (UInt64.t'int ua) (UInt64.t'int ub) -> result.f1 = Some ub)
        | {f0'0 = Some ua; f1'0 = None} -> result.f1 = Some ua
        | {f0'0 = None; f1'0 = Some ub} -> result.f1 = Some ub
        | {f0'0 = None; f1'0 = None} -> result.f1 = None
        end}
    (! return {result}) ]

function size_hint_exact_A (self: t_A) (r: tup2_usize_Option_usize) : ()

axiom size_hint_exact_A_spec: forall self: t_A, r: tup2_usize_Option_usize. postcondition_size_hint () self r
    -> r.f1 = Some (r.f0)

function size_hint_exact_B (self: t_B) (r: tup2_usize_Option_usize) : ()

axiom size_hint_exact_B_spec: forall self: t_B, r: tup2_usize_Option_usize. postcondition_size_hint'0 () self r
    -> r.f1 = Some (r.f0)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Zip_A_B

constant r : tup2_usize_Option_usize

function size_hint_exact_Zip_A_B (self: t_Zip_A_B) (r: tup2_usize_Option_usize) : ()

goal vc_size_hint_exact_Zip_A_B: postcondition_size_hint'1 () self r
  -> ([@stop_split] [@expl:size_hint_exact ensures] r.f1 = Some (r.f0))
