(* <std::num::NonZero<u8> as std::iter::StepSpec> *)

use creusot.int.UInt8
use int.Int

function view_NonZero_u8 [@inline:trivial] (self: UInt8.t) : int = UInt8.t'int self

meta "rewrite_def" function view_NonZero_u8

function steps_to_NonZero_u8 [@inline:trivial] (self: UInt8.t) (other: UInt8.t) : int = view_NonZero_u8 other
  - view_NonZero_u8 self

meta "rewrite_def" function steps_to_NonZero_u8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall a: UInt8.t, b: UInt8.t. forall result: (). steps_to_NonZero_u8 a b = - steps_to_NonZero_u8 b a
