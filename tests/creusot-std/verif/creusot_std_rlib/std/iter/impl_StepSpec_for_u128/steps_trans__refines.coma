(* <u128 as std::iter::StepSpec> *)

use creusot.int.UInt128
use int.Int

function steps_to_u128 [@inline:trivial] (self: UInt128.t) (other: UInt128.t) : int = UInt128.t'int other
  - UInt128.t'int self

meta "rewrite_def" function steps_to_u128

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall a: UInt128.t, b: UInt128.t, c: UInt128.t. forall result: (). steps_to_u128 a b + steps_to_u128 b c
      = steps_to_u128 a c
