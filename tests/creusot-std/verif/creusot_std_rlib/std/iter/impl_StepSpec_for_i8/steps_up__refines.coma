(* <i8 as std::iter::StepSpec> *)

use creusot.int.Int8
use int.Int

function deep_model_i8 [@inline:trivial] (self: Int8.t) : int = Int8.to_int self

meta "rewrite_def" function deep_model_i8

function steps_to_i8 [@inline:trivial] (self: Int8.t) (other: Int8.t) : int = Int8.to_int other - Int8.to_int self

meta "rewrite_def" function steps_to_i8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: Int8.t, other: Int8.t. forall result: (). (deep_model_i8 self < deep_model_i8 other)
      = (0 < steps_to_i8 self other)
