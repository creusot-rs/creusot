(* <isize as std::iter::StepSpec> *)

use creusot.int.Int64
use int.Int

function deep_model_isize [@inline:trivial] (self: Int64.t) : int = Int64.to_int self

meta "rewrite_def" function deep_model_isize

function steps_to_isize [@inline:trivial] (self: Int64.t) (other: Int64.t) : int = Int64.to_int other
  - Int64.to_int self

meta "rewrite_def" function steps_to_isize

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: Int64.t, other: Int64.t. forall result: (). (deep_model_isize self < deep_model_isize other)
      = (0 < steps_to_isize self other)
