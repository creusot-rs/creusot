(* <std::ops::RangeInclusive<i16> as std::iter::ExactSizeIteratorSpec> *)

use creusot.int.UInt64
use creusot.int.Int16
use int.Int

type t_RangeInclusive_i16

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

function deep_model_i16 [@inline:trivial] (self: Int16.t) : int = Int16.to_int self

meta "rewrite_def" function deep_model_i16

function start_log_RangeInclusive_i16 (self: t_RangeInclusive_i16) : Int16.t

function end_log_RangeInclusive_i16 (self: t_RangeInclusive_i16) : Int16.t

predicate is_empty_log_RangeInclusive_i16 (self: t_RangeInclusive_i16)

axiom is_empty_log_RangeInclusive_i16_spec:
  forall self: t_RangeInclusive_i16 [is_empty_log_RangeInclusive_i16 self]. not is_empty_log_RangeInclusive_i16 self
    -> deep_model_i16 (start_log_RangeInclusive_i16 self) <= deep_model_i16 (end_log_RangeInclusive_i16 self)

predicate steps_i16 [@inline:trivial] (self: Int16.t) (count: int) (other: Int16.t) =
  Int16.to_int self + count = Int16.to_int other

meta "rewrite_def" predicate steps_i16

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

predicate postcondition_size_hint (self: ()) (args: t_RangeInclusive_i16) (result: tup2_usize_Option_usize) =
  let self'0 = args in (is_empty_log_RangeInclusive_i16 self'0
    -> result = { f0 = (0: UInt64.t); f1 = Some (0: UInt64.t) })
  /\ (forall count: int. not is_empty_log_RangeInclusive_i16 self'0
      /\ steps_i16 (start_log_RangeInclusive_i16 self'0) count (end_log_RangeInclusive_i16 self'0)
    -> result
    = (if count < UInt64.t'int const_MAX then
      { f0 = UInt64.of_int (count + 1); f1 = Some (UInt64.of_int (count + 1)) }
    else
      { f0 = const_MAX; f1 = None }
    ))

meta "rewrite_def" predicate postcondition_size_hint

predicate inv_RangeInclusive_i16 (_1: t_RangeInclusive_i16)

predicate invariant_ref_RangeInclusive_i16 [@inline:trivial] (self: t_RangeInclusive_i16) = inv_RangeInclusive_i16 self

meta "rewrite_def" predicate invariant_ref_RangeInclusive_i16

predicate inv_ref_RangeInclusive_i16 [@inline:trivial] (_1: t_RangeInclusive_i16) = invariant_ref_RangeInclusive_i16 _1

meta "rewrite_def" predicate inv_ref_RangeInclusive_i16

let size_hint_RangeInclusive_i16 (self: t_RangeInclusive_i16) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] inv_ref_RangeInclusive_i16 self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_RangeInclusive_i16 ensures] ([@stop_split] [@expl:size_hint ensures #0] is_empty_log_RangeInclusive_i16 self
      -> result = { f0 = (0: UInt64.t); f1 = Some (0: UInt64.t) })
    /\ ([@stop_split] [@expl:size_hint ensures #1] forall count: int. not is_empty_log_RangeInclusive_i16 self
        /\ steps_i16 (start_log_RangeInclusive_i16 self) count (end_log_RangeInclusive_i16 self)
      -> result
      = (if count < UInt64.t'int const_MAX then
        { f0 = UInt64.of_int (count + 1); f1 = Some (UInt64.of_int (count + 1)) }
      else
        { f0 = const_MAX; f1 = None }
      ))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_RangeInclusive_i16

constant r : tup2_usize_Option_usize

function size_hint_exact_RangeInclusive_i16 (self: t_RangeInclusive_i16) (r: tup2_usize_Option_usize) : ()

goal vc_size_hint_exact_RangeInclusive_i16: postcondition_size_hint () self r
  -> ([@stop_split] [@expl:size_hint_exact ensures] r.f1 = Some (r.f0))
