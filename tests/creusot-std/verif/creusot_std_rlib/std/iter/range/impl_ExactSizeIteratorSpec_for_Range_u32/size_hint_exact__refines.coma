(* <std::ops::Range<u32> as std::iter::ExactSizeIteratorSpec> *)

use creusot.int.UInt32
use creusot.int.UInt64
use int.Int

type t_Range_u32 = { start: UInt32.t; end': UInt32.t }

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

function deep_model_u32 [@inline:trivial] (self: UInt32.t) : int = UInt32.t'int self

meta "rewrite_def" function deep_model_u32

function steps_to_u32 [@inline:trivial] (self: UInt32.t) (other: UInt32.t) : int = UInt32.t'int other
  - UInt32.t'int self

meta "rewrite_def" function steps_to_u32

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

predicate postcondition_size_hint (self: ()) (args: t_Range_u32) (result: tup2_usize_Option_usize) =
  let self'0 = args in (ge_log_Int (deep_model_u32 self'0.start) (deep_model_u32 self'0.end')
    -> result = { f0 = (0: UInt64.t); f1 = Some (0: UInt64.t) })
  /\ (let count = steps_to_u32 self'0.start self'0.end' in result
  = (if count <= UInt64.t'int const_MAX then
    { f0 = UInt64.of_int count; f1 = Some (UInt64.of_int count) }
  else
    { f0 = const_MAX; f1 = None }
  ))

meta "rewrite_def" predicate postcondition_size_hint

let size_hint_Range_u32 (self: t_Range_u32) (return (x: tup2_usize_Option_usize)) = any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_Range_u32 ensures] ([@stop_split] [@expl:size_hint ensures #0] ge_log_Int (deep_model_u32 self.start) (deep_model_u32 self.end')
      -> result = { f0 = (0: UInt64.t); f1 = Some (0: UInt64.t) })
    /\ ([@stop_split] [@expl:size_hint ensures #1] let count = steps_to_u32 self.start self.end' in result
    = (if count <= UInt64.t'int const_MAX then
      { f0 = UInt64.of_int count; f1 = Some (UInt64.of_int count) }
    else
      { f0 = const_MAX; f1 = None }
    ))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Range_u32, r: tup2_usize_Option_usize. postcondition_size_hint () self r
    -> postcondition_size_hint () self r /\ (forall result: (). r.f1 = Some (r.f0) -> r.f1 = Some (r.f0))
