(* <std::ops::Range<usize> as std::iter::ExactSizeIteratorSpec> *)

use creusot.int.UInt64
use int.Int

type t_Range_usize = { start: UInt64.t; end': UInt64.t }

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

function deep_model_usize [@inline:trivial] (self: UInt64.t) : int = UInt64.t'int self

meta "rewrite_def" function deep_model_usize

predicate steps_usize [@inline:trivial] (self: UInt64.t) (count: int) (other: UInt64.t) =
  UInt64.t'int self + count = UInt64.t'int other

meta "rewrite_def" predicate steps_usize

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

predicate postcondition_size_hint (self: ()) (args: t_Range_usize) (result: tup2_usize_Option_usize) =
  let self'0 = args in (ge_log_Int (deep_model_usize self'0.start) (deep_model_usize self'0.end')
    -> result = { f0 = (0: UInt64.t); f1 = Some (0: UInt64.t) })
  /\ (forall count: int. steps_usize self'0.start count self'0.end'
    -> result
    = (if count <= UInt64.t'int const_MAX then
      { f0 = UInt64.of_int count; f1 = Some (UInt64.of_int count) }
    else
      { f0 = const_MAX; f1 = None }
    ))

meta "rewrite_def" predicate postcondition_size_hint

let size_hint_Range_usize (self: t_Range_usize) (return (x: tup2_usize_Option_usize)) = any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_Range_usize ensures] ([@stop_split] [@expl:size_hint ensures #0] ge_log_Int (deep_model_usize self.start) (deep_model_usize self.end')
      -> result = { f0 = (0: UInt64.t); f1 = Some (0: UInt64.t) })
    /\ ([@stop_split] [@expl:size_hint ensures #1] forall count: int. steps_usize self.start count self.end'
      -> result
      = (if count <= UInt64.t'int const_MAX then
        { f0 = UInt64.of_int count; f1 = Some (UInt64.of_int count) }
      else
        { f0 = const_MAX; f1 = None }
      ))}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Range_usize

constant r : tup2_usize_Option_usize

function size_hint_exact_Range_usize (self: t_Range_usize) (r: tup2_usize_Option_usize) : ()

goal vc_size_hint_exact_Range_usize: postcondition_size_hint () self r
  -> ([@stop_split] [@expl:size_hint_exact ensures] r.f1 = Some (r.f0))
