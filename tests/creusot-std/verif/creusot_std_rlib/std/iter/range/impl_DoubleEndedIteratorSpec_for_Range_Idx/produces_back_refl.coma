(* <std::ops::Range<Idx> as std::iter::DoubleEndedIteratorSpec> *)

use seq.Seq
use int.Int

type t_Idx

type t_Range_Idx = { start: t_Idx; end': t_Idx }

type t_DeepModelTy

predicate le_log_DeepModelTy (self: t_DeepModelTy) (other: t_DeepModelTy)

predicate lt_log_DeepModelTy (self: t_DeepModelTy) (other: t_DeepModelTy)

function le_lt_log_DeepModelTy (self: t_DeepModelTy) (other: t_DeepModelTy) : ()

axiom le_lt_log_DeepModelTy_spec: forall self: t_DeepModelTy, other: t_DeepModelTy. le_log_DeepModelTy self other
    = (lt_log_DeepModelTy self other \/ self = other)

function transitive_DeepModelTy (x: t_DeepModelTy) (y: t_DeepModelTy) (z: t_DeepModelTy) : ()

axiom transitive_DeepModelTy_spec: forall x: t_DeepModelTy, y: t_DeepModelTy, z: t_DeepModelTy. lt_log_DeepModelTy x y
    -> lt_log_DeepModelTy y z -> lt_log_DeepModelTy x z

function irreflexive_DeepModelTy (self: t_DeepModelTy) : ()

axiom irreflexive_DeepModelTy_spec: forall self: t_DeepModelTy. not lt_log_DeepModelTy self self

predicate ge_log_DeepModelTy [@inline:trivial] (self: t_DeepModelTy) (other: t_DeepModelTy) =
  le_log_DeepModelTy other self

meta "rewrite_def" predicate ge_log_DeepModelTy

function deep_model_Idx (self: t_Idx) : t_DeepModelTy

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

predicate steps_Idx (self: t_Idx) (count: int) (other: t_Idx)

function steps_up_Idx (self: t_Idx) (count: int) (other: t_Idx) : ()

axiom steps_up_Idx_spec: forall self: t_Idx, count: int, other: t_Idx. steps_Idx self count other
    -> lt_log_DeepModelTy (deep_model_Idx self) (deep_model_Idx other) = (0 < count)

function steps_trans_Idx (a: t_Idx) (ab: int) (b: t_Idx) (bc: int) (c: t_Idx) : ()

axiom steps_trans_Idx_spec: forall a: t_Idx, ab: int, b: t_Idx, bc: int, c: t_Idx. steps_Idx a ab b
    -> steps_Idx b bc c -> steps_Idx a (ab + bc) c

function steps_sym_Idx (a: t_Idx) (ab: int) (b: t_Idx) : ()

axiom steps_sym_Idx_spec: forall a: t_Idx, ab: int, b: t_Idx. steps_Idx a ab b -> steps_Idx b (- ab) a

function steps_refl_Idx (self: t_Idx) : ()

axiom steps_refl_Idx_spec: forall self: t_Idx. steps_Idx self 0 self

function steps_unique_Idx (self: t_Idx) (count1: int) (count2: int) (other: t_Idx) : ()

axiom steps_unique_Idx_spec: forall self: t_Idx, count1: int, count2: int, other: t_Idx. steps_Idx self count1 other
    -> steps_Idx self count2 other -> count1 = count2

predicate produces_back_Range_Idx (self: t_Range_Idx) (visited: Seq.seq t_Idx) (o: t_Range_Idx) =
  self.start = o.start
  /\ ge_log_DeepModelTy (deep_model_Idx self.end') (deep_model_Idx o.end')
  /\ (gt_log_Int (Seq.length visited) 0 -> ge_log_DeepModelTy (deep_model_Idx o.end') (deep_model_Idx o.start))
  /\ steps_Idx self.end' (- Seq.length visited) o.end'
  /\ (forall i: int. 0 <= i /\ i < Seq.length visited -> steps_Idx self.end' (- i - 1) (Seq.get visited i))

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Range_Idx

function produces_back_refl_Range_Idx (self: t_Range_Idx) : ()

goal vc_produces_back_refl_Range_Idx:
  [@stop_split] [@expl:produces_back_refl ensures] produces_back_Range_Idx self (Seq.empty: Seq.seq t_Idx) self
