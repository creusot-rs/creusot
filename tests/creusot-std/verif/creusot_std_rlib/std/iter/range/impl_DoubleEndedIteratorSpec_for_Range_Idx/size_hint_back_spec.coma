(* <std::ops::Range<Idx> as std::iter::DoubleEndedIteratorSpec> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt64
use seq.Seq
use creusot.prelude.MutBorrow
use int.Int

type t_Idx

type t_Range_Idx = { start: t_Idx; end': t_Idx }

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

predicate ge_log_Int [@inline:trivial] (self: int) (other: int) = other <= self

meta "rewrite_def" predicate ge_log_Int

function deep_model_Idx (self: t_Idx) : int

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

predicate postcondition_size_hint (self: ()) (args: t_Range_Idx) (result: tup2_usize_Option_usize) =
  let self_ = args in (ge_log_Int (deep_model_Idx self_.start) (deep_model_Idx self_.end')
    -> result = { f0 = (0: UInt64.t); f1 = Some (0: UInt64.t) })
  /\ (let s = deep_model_Idx self_.end' - deep_model_Idx self_.start in ge_log_Int s 0 /\ s <= UInt64.t'int const_MAX
    -> UInt64.t'int result.f0 = s /\ result.f1 = Some (result.f0))
  /\ (gt_log_Int (deep_model_Idx self_.end' - deep_model_Idx self_.start) (UInt64.t'int const_MAX)
  -> result = { f0 = const_MAX; f1 = None })

meta "rewrite_def" predicate postcondition_size_hint

predicate inv_Idx (_1: t_Idx)

predicate inv_Range_Idx (_1: t_Range_Idx)

axiom inv_axiom [@rewrite]: forall x: t_Range_Idx [inv_Range_Idx x]. inv_Range_Idx x
    = (inv_Idx x.start /\ inv_Idx x.end')

predicate invariant_ref_Range_Idx [@inline:trivial] (self: t_Range_Idx) = inv_Range_Idx self

meta "rewrite_def" predicate invariant_ref_Range_Idx

predicate inv_ref_Range_Idx [@inline:trivial] (_1: t_Range_Idx) = invariant_ref_Range_Idx _1

meta "rewrite_def" predicate inv_ref_Range_Idx

let size_hint_Range_Idx (self_: t_Range_Idx) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self_' type invariant] inv_ref_Range_Idx self_}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_Range_Idx ensures] ([@stop_split] [@expl:size_hint ensures #0] ge_log_Int (deep_model_Idx self_.start) (deep_model_Idx self_.end')
      -> result = { f0 = (0: UInt64.t); f1 = Some (0: UInt64.t) })
    /\ ([@stop_split] [@expl:size_hint ensures #1] let s = deep_model_Idx self_.end'
      - deep_model_Idx self_.start in ge_log_Int s 0 /\ s <= UInt64.t'int const_MAX
      -> UInt64.t'int result.f0 = s /\ result.f1 = Some (result.f0))
    /\ ([@stop_split] [@expl:size_hint ensures #2] gt_log_Int (deep_model_Idx self_.end'
      - deep_model_Idx self_.start) (UInt64.t'int const_MAX) -> result = { f0 = const_MAX; f1 = None })}
    (! return {result}) ]

predicate produces_back_Range_Idx (self: t_Range_Idx) (visited: Seq.seq t_Idx) (o: t_Range_Idx) =
  self.start = o.start
  /\ ge_log_Int (deep_model_Idx self.end') (deep_model_Idx o.end')
  /\ (gt_log_Int (Seq.length visited) 0 -> ge_log_Int (deep_model_Idx o.end') (deep_model_Idx o.start))
  /\ Seq.length visited = deep_model_Idx self.end' - deep_model_Idx o.end'
  /\ (forall i: int. 0 <= i /\ i < Seq.length visited
    -> deep_model_Idx (Seq.get visited i) = deep_model_Idx self.end' - i - 1)

predicate produces_Range_Idx (self: t_Range_Idx) (visited: Seq.seq t_Idx) (o: t_Range_Idx) =
  self.end' = o.end'
  /\ deep_model_Idx self.start <= deep_model_Idx o.start
  /\ (gt_log_Int (Seq.length visited) 0 -> deep_model_Idx o.start <= deep_model_Idx o.end')
  /\ Seq.length visited = deep_model_Idx o.start - deep_model_Idx self.start
  /\ (forall i: int. 0 <= i /\ i < Seq.length visited
    -> deep_model_Idx (Seq.get visited i) = deep_model_Idx self.start + i)

function produces_trans_Range_Idx (a: t_Range_Idx) (ab: Seq.seq t_Idx) (b: t_Range_Idx) (bc: Seq.seq t_Idx) (c: t_Range_Idx) : ()
 = ()

axiom produces_trans_Range_Idx_spec:
  forall a: t_Range_Idx, ab: Seq.seq t_Idx, b: t_Range_Idx, bc: Seq.seq t_Idx, c: t_Range_Idx. produces_Range_Idx a ab b
    -> produces_Range_Idx b bc c -> produces_Range_Idx a (Seq.(++) ab bc) c

function produces_refl_Range_Idx (self: t_Range_Idx) : () = ()

axiom produces_refl_Range_Idx_spec: forall self: t_Range_Idx. produces_Range_Idx self (Seq.empty: Seq.seq t_Idx) self

predicate resolve_refmut_Range_Idx [@inline:trivial] (_1: MutBorrow.t t_Range_Idx) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Range_Idx

predicate completed_Range_Idx (self: MutBorrow.t t_Range_Idx) =
  resolve_refmut_Range_Idx self /\ ge_log_Int (deep_model_Idx self.current.start) (deep_model_Idx self.current.end')

predicate completed_back_Range_Idx (self: MutBorrow.t t_Range_Idx) = completed_Range_Idx self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_Range_Idx

constant r : tup2_usize_Option_usize

function size_hint_back_spec_Range_Idx (self: t_Range_Idx) (r: tup2_usize_Option_usize) : ()

goal vc_size_hint_back_spec_Range_Idx: postcondition_size_hint () self r
  -> ([@stop_split] [@expl:size_hint_back_spec_Range_Idx ensures] ([@stop_split] [@expl:size_hint_back_spec ensures #0] forall s: Seq.seq t_Idx, i: MutBorrow.t t_Range_Idx. produces_back_Range_Idx self s i.current
        /\ completed_back_Range_Idx i -> UInt64.t'int r.f0 <= Seq.length s)
  /\ ([@stop_split] [@expl:size_hint_back_spec ensures #1] match r.f1 with
    | Some r'0 -> forall s: Seq.seq t_Idx, i: t_Range_Idx. produces_back_Range_Idx self s i
      -> Seq.length s <= UInt64.t'int r'0
    | None -> true
    end))
