(* <std::ops::Range<Idx> as std::iter::DoubleEndedIteratorSpec> *)

use creusot.int.UInt64
use seq.Seq
use creusot.prelude.MutBorrow
use int.Int

type t_Idx

type t_Range_Idx = { start: t_Idx; end': t_Idx }

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_DeepModelTy

predicate le_log_DeepModelTy (self: t_DeepModelTy) (other: t_DeepModelTy)

predicate lt_log_DeepModelTy (self: t_DeepModelTy) (other: t_DeepModelTy)

function le_lt_log_DeepModelTy (self: t_DeepModelTy) (other: t_DeepModelTy) : ()

axiom le_lt_log_DeepModelTy_spec: forall self: t_DeepModelTy, other: t_DeepModelTy. le_log_DeepModelTy self other
    = (lt_log_DeepModelTy self other \/ self = other)

function transitive_DeepModelTy (x: t_DeepModelTy) (y: t_DeepModelTy) (z: t_DeepModelTy) : ()

axiom transitive_DeepModelTy_spec: forall x: t_DeepModelTy, y: t_DeepModelTy, z: t_DeepModelTy. lt_log_DeepModelTy x y
    -> lt_log_DeepModelTy y z -> lt_log_DeepModelTy x z

function irreflexive_DeepModelTy (self: t_DeepModelTy) : ()

axiom irreflexive_DeepModelTy_spec: forall self: t_DeepModelTy. not lt_log_DeepModelTy self self

predicate ge_log_DeepModelTy [@inline:trivial] (self: t_DeepModelTy) (other: t_DeepModelTy) =
  le_log_DeepModelTy other self

meta "rewrite_def" predicate ge_log_DeepModelTy

function deep_model_Idx (self: t_Idx) : t_DeepModelTy

function steps_to_Idx (self: t_Idx) (other: t_Idx) : int

function steps_up_Idx (self: t_Idx) (other: t_Idx) : ()

axiom steps_up_Idx_spec:
  forall self: t_Idx, other: t_Idx. lt_log_DeepModelTy (deep_model_Idx self) (deep_model_Idx other)
    = (0 < steps_to_Idx self other)

function steps_trans_Idx (a: t_Idx) (b: t_Idx) (c: t_Idx) : ()

axiom steps_trans_Idx_spec: forall a: t_Idx, b: t_Idx, c: t_Idx. steps_to_Idx a b + steps_to_Idx b c = steps_to_Idx a c

function steps_sym_Idx (a: t_Idx) (b: t_Idx) : ()

axiom steps_sym_Idx_spec: forall a: t_Idx, b: t_Idx. steps_to_Idx a b = - steps_to_Idx b a

function steps_refl_Idx (self: t_Idx) : ()

axiom steps_refl_Idx_spec: forall self: t_Idx. steps_to_Idx self self = 0

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

predicate postcondition_size_hint (self: ()) (args: t_Range_Idx) (result: tup2_usize_Option_usize) =
  let self'0 = args in (ge_log_DeepModelTy (deep_model_Idx self'0.start) (deep_model_Idx self'0.end')
    -> result = { f0 = (0: UInt64.t); f1 = Some (0: UInt64.t) })
  /\ (let count = steps_to_Idx self'0.start self'0.end' in result
  = (if count <= UInt64.t'int const_MAX then
    { f0 = UInt64.of_int count; f1 = Some (UInt64.of_int count) }
  else
    { f0 = const_MAX; f1 = None }
  ))

meta "rewrite_def" predicate postcondition_size_hint

predicate inv_Idx (_1: t_Idx)

predicate inv_Range_Idx (_1: t_Range_Idx)

axiom inv_axiom [@rewrite]: forall _1: t_Range_Idx [inv_Range_Idx _1]. inv_Range_Idx _1
    = (inv_Idx _1.start /\ inv_Idx _1.end')

predicate invariant_ref_Range_Idx [@inline:trivial] (self: t_Range_Idx) = inv_Range_Idx self

meta "rewrite_def" predicate invariant_ref_Range_Idx

predicate inv_ref_Range_Idx [@inline:trivial] (_1: t_Range_Idx) = invariant_ref_Range_Idx _1

meta "rewrite_def" predicate inv_ref_Range_Idx

let size_hint_Range_Idx (self: t_Range_Idx) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self' type invariant] inv_ref_Range_Idx self}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_Range_Idx ensures] ([@stop_split] [@expl:size_hint ensures #0] ge_log_DeepModelTy (deep_model_Idx self.start) (deep_model_Idx self.end')
      -> result = { f0 = (0: UInt64.t); f1 = Some (0: UInt64.t) })
    /\ ([@stop_split] [@expl:size_hint ensures #1] let count = steps_to_Idx self.start self.end' in result
    = (if count <= UInt64.t'int const_MAX then
      { f0 = UInt64.of_int count; f1 = Some (UInt64.of_int count) }
    else
      { f0 = const_MAX; f1 = None }
    ))}
    (! return {result}) ]

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

predicate produces_back_Range_Idx (self: t_Range_Idx) (visited: Seq.seq t_Idx) (o: t_Range_Idx) =
  self.start = o.start
  /\ ge_log_DeepModelTy (deep_model_Idx self.end') (deep_model_Idx o.end')
  /\ (gt_log_Int (Seq.length visited) 0 -> ge_log_DeepModelTy (deep_model_Idx o.end') (deep_model_Idx o.start))
  /\ Seq.length visited = steps_to_Idx o.end' self.end'
  /\ (forall i: int. 0 <= i /\ i < Seq.length visited -> i + 1 = steps_to_Idx (Seq.get visited i) self.end')

predicate produces_Range_Idx (self: t_Range_Idx) (visited: Seq.seq t_Idx) (o: t_Range_Idx) =
  self.end' = o.end'
  /\ le_log_DeepModelTy (deep_model_Idx self.start) (deep_model_Idx o.start)
  /\ (gt_log_Int (Seq.length visited) 0 -> le_log_DeepModelTy (deep_model_Idx o.start) (deep_model_Idx o.end'))
  /\ Seq.length visited = steps_to_Idx self.start o.start
  /\ (forall i: int. 0 <= i /\ i < Seq.length visited -> i = steps_to_Idx self.start (Seq.get visited i))

function produces_trans_Range_Idx (a: t_Range_Idx) (ab: Seq.seq t_Idx) (b: t_Range_Idx) (bc: Seq.seq t_Idx) (c: t_Range_Idx) : ()
 = ()

axiom produces_trans_Range_Idx_spec:
  forall a: t_Range_Idx, ab: Seq.seq t_Idx, b: t_Range_Idx, bc: Seq.seq t_Idx, c: t_Range_Idx. produces_Range_Idx a ab b
    -> produces_Range_Idx b bc c -> produces_Range_Idx a (Seq.(++) ab bc) c

function produces_refl_Range_Idx (self: t_Range_Idx) : () = ()

axiom produces_refl_Range_Idx_spec: forall self: t_Range_Idx. produces_Range_Idx self (Seq.empty: Seq.seq t_Idx) self

predicate resolve_refmut_Range_Idx [@inline:trivial] (_1: MutBorrow.t t_Range_Idx) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_Range_Idx

predicate completed_Range_Idx (self: MutBorrow.t t_Range_Idx) =
  resolve_refmut_Range_Idx self
  /\ ge_log_DeepModelTy (deep_model_Idx self.current.start) (deep_model_Idx self.current.end')

predicate completed_back_Range_Idx (self: MutBorrow.t t_Range_Idx) = completed_Range_Idx self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Range_Idx, r: tup2_usize_Option_usize. postcondition_size_hint () self r
    -> postcondition_size_hint () self r
    /\ (forall result: (). (forall s: Seq.seq t_Idx, i: MutBorrow.t t_Range_Idx. produces_back_Range_Idx self s i.current
              /\ completed_back_Range_Idx i -> UInt64.t'int r.f0 <= Seq.length s)
        /\ match r.f1 with
          | Some r'0 -> forall s: Seq.seq t_Idx, i: t_Range_Idx. produces_back_Range_Idx self s i
            -> Seq.length s <= UInt64.t'int r'0
          | None -> true
          end
      -> (forall s: Seq.seq t_Idx, i: MutBorrow.t t_Range_Idx. produces_back_Range_Idx self s i.current
            /\ completed_back_Range_Idx i -> UInt64.t'int r.f0 <= Seq.length s)
      /\ match r.f1 with
        | Some r'0 -> forall s: Seq.seq t_Idx, i: t_Range_Idx. produces_back_Range_Idx self s i
          -> Seq.length s <= UInt64.t'int r'0
        | None -> true
        end)
