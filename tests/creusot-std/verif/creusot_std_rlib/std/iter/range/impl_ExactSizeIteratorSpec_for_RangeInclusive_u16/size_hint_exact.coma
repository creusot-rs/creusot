(* <std::ops::RangeInclusive<u16> as std::iter::ExactSizeIteratorSpec> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt64
use creusot.int.UInt16
use int.Int

type t_RangeInclusive_u16

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

function deep_model_u16 [@inline:trivial] (self: UInt16.t) : int = UInt16.t'int self

meta "rewrite_def" function deep_model_u16

function start_log_RangeInclusive_u16 (self: t_RangeInclusive_u16) : UInt16.t

function end_log_RangeInclusive_u16 (self: t_RangeInclusive_u16) : UInt16.t

predicate is_empty_log_RangeInclusive_u16 (self: t_RangeInclusive_u16)

axiom is_empty_log_RangeInclusive_u16_spec:
  forall self: t_RangeInclusive_u16 [is_empty_log_RangeInclusive_u16 self]. not is_empty_log_RangeInclusive_u16 self
    -> deep_model_u16 (start_log_RangeInclusive_u16 self) <= deep_model_u16 (end_log_RangeInclusive_u16 self)

function range_inclusive_len_u16 (r: t_RangeInclusive_u16) : int = if is_empty_log_RangeInclusive_u16 r then
    0
  else
    deep_model_u16 (end_log_RangeInclusive_u16 r) - deep_model_u16 (start_log_RangeInclusive_u16 r) + 1


axiom range_inclusive_len_u16_spec:
  forall r: t_RangeInclusive_u16 [range_inclusive_len_u16 r]. is_empty_log_RangeInclusive_u16 r
    = (range_inclusive_len_u16 r = 0)

constant const_MAX: UInt64.t = (18446744073709551615: UInt64.t)

predicate gt_log_Int [@inline:trivial] (self: int) (other: int) = other < self

meta "rewrite_def" predicate gt_log_Int

predicate postcondition_size_hint (self: ()) (args: t_RangeInclusive_u16) (result: tup2_usize_Option_usize) =
  let self_ = args in (let s = range_inclusive_len_u16 self_ in s <= UInt64.t'int const_MAX
    -> UInt64.t'int result.f0 = s /\ result.f1 = Some (result.f0))
  /\ (gt_log_Int (range_inclusive_len_u16 self_) (UInt64.t'int const_MAX) -> result = { f0 = const_MAX; f1 = None })

meta "rewrite_def" predicate postcondition_size_hint

predicate inv_RangeInclusive_u16 (_1: t_RangeInclusive_u16)

predicate invariant_ref_RangeInclusive_u16 [@inline:trivial] (self: t_RangeInclusive_u16) = inv_RangeInclusive_u16 self

meta "rewrite_def" predicate invariant_ref_RangeInclusive_u16

predicate inv_ref_RangeInclusive_u16 [@inline:trivial] (_1: t_RangeInclusive_u16) = invariant_ref_RangeInclusive_u16 _1

meta "rewrite_def" predicate inv_ref_RangeInclusive_u16

let size_hint_RangeInclusive_u16 (self_: t_RangeInclusive_u16) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self_' type invariant] inv_ref_RangeInclusive_u16 self_}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_RangeInclusive_u16 ensures] ([@stop_split] [@expl:size_hint ensures #0] let s = range_inclusive_len_u16 self_ in s
        <= UInt64.t'int const_MAX -> UInt64.t'int result.f0 = s /\ result.f1 = Some (result.f0))
    /\ ([@stop_split] [@expl:size_hint ensures #1] gt_log_Int (range_inclusive_len_u16 self_) (UInt64.t'int const_MAX)
    -> result = { f0 = const_MAX; f1 = None })}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_RangeInclusive_u16

constant r : tup2_usize_Option_usize

function size_hint_exact_RangeInclusive_u16 (self: t_RangeInclusive_u16) (r: tup2_usize_Option_usize) : ()

goal vc_size_hint_exact_RangeInclusive_u16: postcondition_size_hint () self r
  -> ([@stop_split] [@expl:size_hint_exact ensures] r.f1 = Some (r.f0))
