(* <i64 as std::iter::StepSpec> *)

use creusot.int.Int64
use int.Int

function deep_model_i64 [@inline:trivial] (self: Int64.t) : int = Int64.to_int self

meta "rewrite_def" function deep_model_i64

function steps_to_i64 [@inline:trivial] (self: Int64.t) (other: Int64.t) : int = Int64.to_int other - Int64.to_int self

meta "rewrite_def" function steps_to_i64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: Int64.t, other: Int64.t. forall result: (). (deep_model_i64 self < deep_model_i64 other)
      = (0 < steps_to_i64 self other)
