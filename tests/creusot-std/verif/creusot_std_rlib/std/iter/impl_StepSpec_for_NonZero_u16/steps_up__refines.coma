(* <std::num::NonZero<u16> as std::iter::StepSpec> *)

use creusot.int.UInt16
use int.Int

function deep_model_u16 [@inline:trivial] (self: UInt16.t) : int = UInt16.t'int self

meta "rewrite_def" function deep_model_u16

function deep_model_NonZero_u16 [@inline:trivial] (self: UInt16.t) : int = deep_model_u16 self

meta "rewrite_def" function deep_model_NonZero_u16

function view_NonZero_u16 [@inline:trivial] (self: UInt16.t) : int = UInt16.t'int self

meta "rewrite_def" function view_NonZero_u16

function steps_to_NonZero_u16 [@inline:trivial] (self: UInt16.t) (other: UInt16.t) : int = view_NonZero_u16 other
  - view_NonZero_u16 self

meta "rewrite_def" function steps_to_NonZero_u16

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: UInt16.t, other: UInt16.t. forall result: (). (deep_model_NonZero_u16 self
        < deep_model_NonZero_u16 other)
      = (0 < steps_to_NonZero_u16 self other)
