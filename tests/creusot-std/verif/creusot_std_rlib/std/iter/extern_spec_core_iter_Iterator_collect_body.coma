predicate inv_Self_ (_1: t_Self_)

predicate precondition_into_iter (self: ()) (args: t_Self_) (mode: Mode.t) = let self'0 = args in inv_Self_ self'0

meta "rewrite_def" predicate precondition_into_iter

let into_iter_Self_ (self: t_Self_) (mode: Mode.t) (return (x: t_Self_)) =
{[@stop_split] [@expl:into_iter 'self' type invariant] inv_Self_ self}
  any
  [ return (result: t_Self_) ->
  {[@stop_split] [@expl:into_iter_Self_ ensures] ([@stop_split] [@expl:into_iter result type invariant] inv_Self_ result)
    /\ ([@stop_split] [@expl:into_iter ensures] result = self)}
    (! return {result}) ]

predicate precondition_from_iter (self: ()) (args: t_Self_) (mode: Mode.t)

axiom precondition_fndef:
  forall mode: Mode.t. forall args: t_Self_ [precondition_from_iter () args mode]. (let iter = args in inv_Self_ iter
        /\ precondition_into_iter () iter mode) -> precondition_from_iter () args mode

predicate inv_B (_1: t_B)

predicate postcondition_from_iter (self: ()) (args: t_Self_) (result: t_B) (mode: Mode.t)

axiom postcondition_fndef:
  forall args: t_Self_, result: t_B, mode: Mode.t [postcondition_from_iter () args result mode]. postcondition_from_iter () args result mode
    -> (let iter = args in inv_B result)

predicate postcondition_once_from_iter (self: ()) (args: t_Self_) (result: t_B) (mode: Mode.t) =
  postcondition_from_iter self args result mode

meta "rewrite_def" predicate postcondition_once_from_iter

let from_iter_B (iter: t_Self_) (mode: Mode.t) (return (x: t_B)) =
{[@stop_split] [@expl:from_iter requires] precondition_from_iter () iter mode}
  any
  [ return (result: t_B) -> {[@stop_split] [@expl:from_iter ensures] postcondition_once_from_iter () iter result mode}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let extern_spec_core_iter_Iterator_collect_body_Self_ (self_: t_Self_) (mode: Mode.t) (return (x: t_B)) =
{not Mode.terminates mode}
  {[@stop_split] [@expl:extern_spec_core_iter_Iterator_collect_body_Self_ requires] ([@stop_split] [@expl:extern_spec_core_iter_Iterator_collect_body 'self_' type invariant] inv_Self_ self_)
  /\ ([@stop_split] [@expl:extern_spec_core_iter_Iterator_collect_body requires] precondition_from_iter () self_ mode)}
