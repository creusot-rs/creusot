  [ return (result: bool) -> {[@stop_split] [@expl:extern_spec_core_cmp_PartialOrd_Rhs_lt_body ensures] result
    = lt_log_DeepModelTy (deep_model_ref_Self_ self_) (deep_model_ref_Rhs other)}
    (! return {result}) ]
