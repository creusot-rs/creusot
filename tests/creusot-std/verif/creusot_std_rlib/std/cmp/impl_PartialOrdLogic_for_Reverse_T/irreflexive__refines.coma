(* <std::cmp::Reverse<T> as logic::ord::PartialOrdLogic> *)

type namespace_other

type t_Namespace = Other namespace_other

type t_T

type t_Reverse_T = { f0: t_T }

predicate le_log_T (self: t_T) (other: t_T)

predicate lt_log_T (self: t_T) (other: t_T)

function le_lt_log_T (self: t_T) (other: t_T) : ()

axiom le_lt_log_T_spec: forall self: t_T, other: t_T. le_log_T self other = (lt_log_T self other \/ self = other)

function transitive_T (x: t_T) (y: t_T) (z: t_T) : ()

axiom transitive_T_spec: forall x: t_T, y: t_T, z: t_T. lt_log_T x y -> lt_log_T y z -> lt_log_T x z

function irreflexive_T (self: t_T) : ()

axiom irreflexive_T_spec: forall self: t_T. not lt_log_T self self

predicate lt_log_Reverse_T [@inline:trivial] (self: t_Reverse_T) (o: t_Reverse_T) = lt_log_T o.f0 self.f0

meta "rewrite_def" predicate lt_log_Reverse_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall self: t_Reverse_T. forall result: (). not lt_log_Reverse_T self self
      -> not lt_log_Reverse_T self self
