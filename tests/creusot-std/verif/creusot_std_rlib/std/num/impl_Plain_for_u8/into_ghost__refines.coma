(* <u8 as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt8

predicate inv_u8 [@inline:trivial] (_1: UInt8.t) = true

meta "rewrite_def" predicate inv_u8

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: UInt8.t. inv_u8 snap -> (forall result: UInt8.t. result = snap -> result = snap)
