(* <u128 as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt128

predicate inv_u128 [@inline:trivial] (_1: UInt128.t) = true

meta "rewrite_def" predicate inv_u128

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: UInt128.t. inv_u128 snap -> (forall result: UInt128.t. result = snap -> result = snap)
