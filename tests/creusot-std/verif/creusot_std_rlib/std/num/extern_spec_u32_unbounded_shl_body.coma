use creusot.int.UInt32
use creusot.prelude.Any
use creusot.int.UInt8

constant const_BITS: UInt32.t = (32: UInt32.t)

let unchecked_shl (self: UInt32.t) (rhs: UInt32.t) (return (x: UInt32.t)) =
{[@stop_split] [@expl:unchecked_shl requires] UInt32.lt rhs const_BITS}
  any
  [ return (result: UInt32.t) -> {[@stop_split] [@expl:unchecked_shl ensures] result = UInt32.shl self rhs}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let extern_spec_u32_unbounded_shl_body (self_: UInt32.t) (rhs: UInt32.t) (return (x: UInt32.t)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_6 <- UInt32.lt rhs const_BITS ] s1 | s1 = any [ br0 -> {_6 = false} (! bb3) | br1 -> {_6} (! bb1) ] ]
  | bb1 = s0 [ s0 = unchecked_shl {self_} {rhs} (fun (_x: UInt32.t) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_ret <- (0: UInt32.t) ] s1 | s1 = return {_ret} ] ]
  [ & _ret: UInt32.t = Any.any_l () | & self_: UInt32.t = self_ | & rhs: UInt32.t = rhs | & _6: bool = Any.any_l () ])
  [ return (result: UInt32.t) -> {[@stop_split] [@expl:extern_spec_u32_unbounded_shl_body ensures] result
    = (if UInt32.lt rhs const_BITS then UInt32.shl self_ rhs else UInt32.of_int (UInt8.t'int (0: UInt8.t)))}
    (! return {result}) ]
