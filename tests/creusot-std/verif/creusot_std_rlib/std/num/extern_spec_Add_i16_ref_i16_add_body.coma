use creusot.int.Int16
use creusot.prelude.Any
use int.Int

constant const_MIN: Int16.t = (-32768: Int16.t)

constant const_MAX: Int16.t = (32767: Int16.t)

let add_ref_i16 (self_: Int16.t) (rhs: Int16.t) (return (x: Int16.t)) =
{[@stop_split] [@expl:add requires] Int16.to_int const_MIN <= Int16.to_int self_ + Int16.to_int rhs
  /\ Int16.to_int self_ + Int16.to_int rhs <= Int16.to_int const_MAX}
  any
  [ return (result: Int16.t) -> {[@stop_split] [@expl:add ensures] Int16.to_int result
    = Int16.to_int self_ + Int16.to_int rhs}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

