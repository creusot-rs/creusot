(* <u16 as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt16

predicate inv_u16 [@inline:trivial] (_1: UInt16.t) = true

meta "rewrite_def" predicate inv_u16

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: UInt16.t. inv_u16 snap -> (forall result: UInt16.t. result = snap -> result = snap)
