(* <i128 as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int128

predicate inv_i128 [@inline:trivial] (_1: Int128.t) = true

meta "rewrite_def" predicate inv_i128

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: Int128.t. inv_i128 snap -> (forall result: Int128.t. result = snap -> result = snap)
