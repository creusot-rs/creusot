(* <u64 as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt64

predicate inv_u64 [@inline:trivial] (_1: UInt64.t) = true

meta "rewrite_def" predicate inv_u64

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: UInt64.t. inv_u64 snap -> (forall result: UInt64.t. result = snap -> result = snap)
