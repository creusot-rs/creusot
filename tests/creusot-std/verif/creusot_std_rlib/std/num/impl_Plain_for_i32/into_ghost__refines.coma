(* <i32 as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Mode
use creusot.int.Int32

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall mode: Mode.t, snap: Int32.t. forall result: Int32.t. result = snap -> result = snap
