(* <i32 as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.Int32

predicate inv_i32 [@inline:trivial] (_1: Int32.t) = true

meta "rewrite_def" predicate inv_i32

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall snap: Int32.t. inv_i32 snap -> (forall result: Int32.t. result = snap -> result = snap)
