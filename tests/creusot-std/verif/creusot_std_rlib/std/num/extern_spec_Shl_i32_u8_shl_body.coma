{not Mode.terminates mode}
  {[@stop_split] [@expl:extern_spec_Shl_i32_u8_shl_body requires] Int32.le (Int32.of_int (UInt64.t'int (0: UInt64.t))) rhs
  /\ Int32.le rhs (Int32.of_int (UInt32.t'int (UInt32.sub const_BITS (1: UInt32.t))))}
  (! bb0
  [ bb0 = s0
    [ s0 = UInt8.shl {self_} {Int32.to_int rhs} (fun (_x: UInt8.t) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ] ]
  [ & _ret: UInt8.t = Any.any_l () | & self_: UInt8.t = self_ | & rhs: Int32.t = rhs ])
