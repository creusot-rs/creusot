use creusot.int.UInt32
use creusot.int.Int32
use creusot.prelude.Any
use creusot.int.UInt8

constant const_BITS: UInt32.t = (32: UInt32.t)

function shl_i32 [@inline:trivial] (self: Int32.t) (rhs: UInt32.t) : Int32.t =
  Int32.shl self (Int32.of_int (UInt32.t'int rhs))

meta "rewrite_def" function shl_i32

let unchecked_shl (self: Int32.t) (rhs: UInt32.t) (return (x: Int32.t)) =
{[@stop_split] [@expl:unchecked_shl requires] UInt32.lt rhs const_BITS}
  any
  [ return (result: Int32.t) -> {[@stop_split] [@expl:unchecked_shl ensures] result = shl_i32 self rhs}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let extern_spec_i32_unbounded_shl_body (self_: Int32.t) (rhs: UInt32.t) (return (x: Int32.t)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_6 <- UInt32.lt rhs const_BITS ] s1 | s1 = any [ br0 -> {_6 = false} (! bb3) | br1 -> {_6} (! bb1) ] ]
  | bb1 = s0 [ s0 = unchecked_shl {self_} {rhs} (fun (_x: Int32.t) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ]
  | bb3 = s0 [ s0 = [ &_ret <- (0: Int32.t) ] s1 | s1 = return {_ret} ] ]
  [ & _ret: Int32.t = Any.any_l () | & self_: Int32.t = self_ | & rhs: UInt32.t = rhs | & _6: bool = Any.any_l () ])
  [ return (result: Int32.t) -> {[@stop_split] [@expl:extern_spec_i32_unbounded_shl_body ensures] result
    = (if UInt32.lt rhs const_BITS then shl_i32 self_ rhs else Int32.of_int (UInt8.t'int (0: UInt8.t)))}
    (! return {result}) ]
