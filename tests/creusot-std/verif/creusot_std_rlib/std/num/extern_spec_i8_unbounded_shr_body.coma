use creusot.int.UInt32
use creusot.int.Int8
use creusot.prelude.Any

constant const_BITS: UInt32.t = (8: UInt32.t)

function shr_i8 [@inline:trivial] (self: Int8.t) (rhs: UInt32.t) : Int8.t =
  Int8.shr self (Int8.of_int (UInt32.t'int rhs))

meta "rewrite_def" function shr_i8

let unchecked_shr (self: Int8.t) (rhs: UInt32.t) (return (x: Int8.t)) =
{[@stop_split] [@expl:unchecked_shr requires] UInt32.lt rhs const_BITS}
  any
  [ return (result: Int8.t) -> {[@stop_split] [@expl:unchecked_shr ensures] result = shr_i8 self rhs}
    (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let extern_spec_i8_unbounded_shr_body (self_: Int8.t) (rhs: UInt32.t) (return (x: Int8.t)) = (! bb0
  [ bb0 = s0
    [ s0 = [ &_6 <- UInt32.lt rhs const_BITS ] s1 | s1 = any [ br0 -> {_6 = false} (! bb3) | br1 -> {_6} (! bb1) ] ]
  | bb1 = s0 [ s0 = unchecked_shr {self_} {rhs} (fun (_x: Int8.t) -> [ &_ret <- _x ] s1) | s1 = return {_ret} ]
  | bb3 = s0
    [ s0 = UInt32.sub {const_BITS} {(1: UInt32.t)} (fun (_x: UInt32.t) -> [ &_11 <- _x ] s1)
    | s1 = unchecked_shr {self_} {_11} (fun (_x: Int8.t) -> [ &_ret <- _x ] s2)
    | s2 = return {_ret} ] ]
  [ & _ret: Int8.t = Any.any_l ()
  | & self_: Int8.t = self_
  | & rhs: UInt32.t = rhs
  | & _6: bool = Any.any_l ()
  | & _11: UInt32.t = Any.any_l () ])
  [ return (result: Int8.t) -> {[@stop_split] [@expl:extern_spec_i8_unbounded_shr_body ensures] result
    = (if UInt32.lt rhs const_BITS then shr_i8 self_ rhs else shr_i8 self_ (UInt32.sub const_BITS (1: UInt32.t)))}
    (! return {result}) ]
