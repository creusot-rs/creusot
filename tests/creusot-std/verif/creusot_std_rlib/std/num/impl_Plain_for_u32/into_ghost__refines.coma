(* <u32 as ghost::Plain> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Mode
use creusot.int.UInt32

predicate inv_u32 [@inline:trivial] (_1: UInt32.t) = true

meta "rewrite_def" predicate inv_u32

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

goal refines: forall mode: Mode.t, snap: UInt32.t. inv_u32 snap
    -> (forall result: UInt32.t. result = snap -> result = snap)
