type namespace_other

type t_Namespace = Other namespace_other

use creusot.prelude.Mode
use creusot.prelude.Any

predicate inv_never [@inline:trivial] (_1: ()) = false

meta "rewrite_def" predicate inv_never

let panic (mode: Mode.t) (expr: string) (return (x: ())) = {[@stop_split] [@expl:panic requires] not Mode.nopanic mode}
  any
  [ return (result: ()) -> {[@stop_split] [@expl:panic result type invariant] inv_never result} (! return {result}) ]

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let extern_spec_core_hint_unreachable_unchecked_body (mode: Mode.t) (return (x: ())) =
{[@stop_split] [@expl:extern_spec_core_hint_unreachable_unchecked_body requires] false}
  (! bb0
  [ bb0 = s0
    [ s0 = panic {mode} {"internal error: entered unreachable code"} (fun (_x: ()) -> [ &_ret <- _x ] s1)
    | s1 = {false} any ] ] [ & _ret: () = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:extern_spec_core_hint_unreachable_unchecked_body result type invariant] inv_never result}
    (! return {result}) ]
