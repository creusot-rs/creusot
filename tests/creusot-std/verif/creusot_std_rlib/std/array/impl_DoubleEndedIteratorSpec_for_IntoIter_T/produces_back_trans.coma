(* <std::array::IntoIter<T, N> as std::iter::DoubleEndedIteratorSpec> *)

type namespace_other

type t_Namespace = Other namespace_other

use seq.Seq
use seq.Reverse

type t_IntoIter_T

type t_T

function view_IntoIter_T (self: t_IntoIter_T) : Seq.seq t_T

predicate produces_back_IntoIter_T (self: t_IntoIter_T) (visited: Seq.seq t_T) (o: t_IntoIter_T) =
  view_IntoIter_T self = Seq.(++) (view_IntoIter_T o) (Reverse.reverse visited)

function reverse_concat_T (self: Seq.seq t_T) (other: Seq.seq t_T) : ()

axiom reverse_concat_T_spec: forall self: Seq.seq t_T, other: Seq.seq t_T. Reverse.reverse (Seq.(++) self other)
    = Seq.(++) (Reverse.reverse other) (Reverse.reverse self)

function concat_assoc_T (self: Seq.seq t_T) (other1: Seq.seq t_T) (other2: Seq.seq t_T) : ()

axiom concat_assoc_T_spec:
  forall self: Seq.seq t_T, other1: Seq.seq t_T, other2: Seq.seq t_T. Seq.(++) (Seq.(++) self other1) other2
    = Seq.(++) self (Seq.(++) other1 other2)

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant a : t_IntoIter_T

constant ab : Seq.seq t_T

constant b : t_IntoIter_T

constant bc : Seq.seq t_T

constant c : t_IntoIter_T

function produces_back_trans_IntoIter_T (a: t_IntoIter_T) (ab: Seq.seq t_T) (b: t_IntoIter_T) (bc: Seq.seq t_T) (c: t_IntoIter_T) : ()

goal vc_produces_back_trans_IntoIter_T: produces_back_IntoIter_T a ab b
  -> produces_back_IntoIter_T b bc c
  -> ([@stop_split] [@expl:reverse_concat ensures] Reverse.reverse (Seq.(++) ab bc)
    = Seq.(++) (Reverse.reverse bc) (Reverse.reverse ab))
  -> (let _ = reverse_concat_T ab bc in [@stop_split] [@expl:produces_back_trans ensures] produces_back_IntoIter_T a (Seq.(++) ab bc) c)
