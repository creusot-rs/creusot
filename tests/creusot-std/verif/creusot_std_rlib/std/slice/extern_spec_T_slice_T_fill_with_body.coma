  [ return (result: ()) ->
  {[@stop_split] [@expl:extern_spec_T__slice_T_fill_with_body_T ensures] ([@stop_split] [@expl:extern_spec_T__slice_T_fill_with_body ensures #0] Seq.length (Slice64.view self_.final)
      = Seq.length (Slice64.view self_.current))
    /\ ([@stop_split] [@expl:extern_spec_T__slice_T_fill_with_body ensures #1] exists s: Seq.seq t_F. Seq.length s
