type t_T

predicate inv_T (_1: t_T)

predicate invariant_ref_T [@inline:trivial] (self: t_T) = inv_T self

meta "rewrite_def" predicate invariant_ref_T

predicate inv_ref_T [@inline:trivial] (_1: t_T) = invariant_ref_T _1

meta "rewrite_def" predicate inv_ref_T

predicate invariant_Seq_T [@inline:trivial] (self: Seq.seq t_T) =
  forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_T (Seq.get self i)

meta "rewrite_def" predicate invariant_Seq_T

predicate inv_Seq_T [@inline:trivial] (_1: Seq.seq t_T) = invariant_Seq_T _1

meta "rewrite_def" predicate inv_Seq_T

predicate invariant_slice_T (self: Slice64.slice t_T) = inv_Seq_T (Slice64.view self)

predicate inv_slice_T [@inline:trivial] (_1: Slice64.slice t_T) = invariant_slice_T _1

meta "rewrite_def" predicate inv_slice_T

predicate invariant_ref_slice_T [@inline:trivial] (self: Slice64.slice t_T) = inv_slice_T self

meta "rewrite_def" predicate invariant_ref_slice_T

predicate inv_ref_slice_T [@inline:trivial] (_1: Slice64.slice t_T) = invariant_ref_slice_T _1

meta "rewrite_def" predicate inv_ref_slice_T

let len_T (self: Slice64.slice t_T) (return (x: UInt64.t)) =
{[@stop_split] [@expl:len 'self' type invariant] inv_ref_slice_T self}
  any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] Seq.length (Slice64.view self)
    = UInt64.t'int result}
    (! return {result}) ]

type t_F

predicate postcondition_once_F (self: t_F) (args: ()) (result: t_T)

predicate resolve_F (_1: t_F)

predicate postcondition_mut_F (self: t_F) (args: ()) (result_state: t_F) (result: t_T)

function fn_mut_once_F (self: t_F) (args: ()) (res: t_T) : ()

axiom fn_mut_once_F_spec:
  forall self: t_F, args: (), res: t_T [postcondition_once_F self args res]. postcondition_once_F self args res
    = (exists res_state: t_F. postcondition_mut_F self args res_state res /\ resolve_F res_state)

predicate hist_inv_F (self: t_F) (result_state: t_F)

function hist_inv_trans_F (self: t_F) (b: t_F) (c: t_F) : ()

axiom hist_inv_trans_F_spec:
  forall self: t_F, b: t_F, c: t_F [hist_inv_F self b, hist_inv_F b c | hist_inv_F self b, hist_inv_F self c | hist_inv_F b c, hist_inv_F self c]. hist_inv_F self b
    -> hist_inv_F b c -> hist_inv_F self c

function hist_inv_refl_F (self: t_F) : ()

axiom hist_inv_refl_F_spec: forall self: t_F [hist_inv_F self self]. hist_inv_F self self

function postcondition_mut_hist_inv_F (self: t_F) (args: ()) (res_state: t_F) (res: t_T) : ()

axiom postcondition_mut_hist_inv_F_spec:
  forall self: t_F, args: (), res_state: t_F, res: t_T [postcondition_mut_F self args res_state res | hist_inv_F self res_state]. postcondition_mut_F self args res_state res
    -> hist_inv_F self res_state

predicate inv_F (_1: t_F)

predicate invariant_refmut_slice_T [@inline:trivial] (self: MutBorrow.t (Slice64.slice t_T)) =
  inv_slice_T self.current /\ inv_slice_T self.final

meta "rewrite_def" predicate invariant_refmut_slice_T

predicate inv_refmut_slice_T [@inline:trivial] (_1: MutBorrow.t (Slice64.slice t_T)) = invariant_refmut_slice_T _1

meta "rewrite_def" predicate inv_refmut_slice_T

type t_RangeTo_Int = { end': int }

function index_Seq_T [@inline:trivial] (self: Seq.seq t_T) (range: t_RangeTo_Int) : Seq.seq t_T =
  Seq.([..]) self 0 range.end'

meta "rewrite_def" function index_Seq_T

predicate invariant_refmut_F [@inline:trivial] (self: MutBorrow.t t_F) = inv_F self.current /\ inv_F self.final

meta "rewrite_def" predicate invariant_refmut_F

predicate inv_refmut_F [@inline:trivial] (_1: MutBorrow.t t_F) = invariant_refmut_F _1

meta "rewrite_def" predicate inv_refmut_F

predicate precondition_F (self: t_F) (args: ())

let call_mut_F (self: MutBorrow.t t_F) (args: ()) (return (x: t_T)) =
{[@stop_split] [@expl:call_mut_F requires] ([@stop_split] [@expl:call_mut 'self' type invariant] inv_refmut_F self)
  /\ ([@stop_split] [@expl:call_mut requires] precondition_F self.current args)}
  any
  [ return (result: t_T) ->
  {[@stop_split] [@expl:call_mut_F ensures] ([@stop_split] [@expl:call_mut result type invariant] inv_T result)
    /\ ([@stop_split] [@expl:call_mut ensures] postcondition_mut_F self.current args self.final result)}
    (! return {result}) ]

function index_slice_T [@inline:trivial] (self: Slice64.slice t_T) (ix: UInt64.t) : t_T =
  Seq.get (Slice64.view self) (UInt64.t'int ix)

meta "rewrite_def" function index_slice_T

predicate resolve_T (_1: t_T)

predicate resolve_refmut_slice_T [@inline:trivial] (_1: MutBorrow.t (Slice64.slice t_T)) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_slice_T

predicate invariant_ref_F [@inline:trivial] (self: t_F) = inv_F self

meta "rewrite_def" predicate invariant_ref_F

predicate inv_ref_F [@inline:trivial] (_1: t_F) = invariant_ref_F _1

meta "rewrite_def" predicate inv_ref_F

predicate invariant_Seq_F [@inline:trivial] (self: Seq.seq t_F) =
  forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_F (Seq.get self i)

meta "rewrite_def" predicate invariant_Seq_F

predicate inv_Seq_F [@inline:trivial] (_1: Seq.seq t_F) = invariant_Seq_F _1

meta "rewrite_def" predicate inv_Seq_F

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let extern_spec_T__slice_T_fill_with_body_T (self_: MutBorrow.t (Slice64.slice t_T)) (f: t_F) (return (x: ())) =
{[@stop_split] [@expl:extern_spec_T__slice_T_fill_with_body_T requires] ([@stop_split] [@expl:extern_spec_T__slice_T_fill_with_body 'self_' type invariant] inv_refmut_slice_T self_)
  /\ ([@stop_split] [@expl:extern_spec_T__slice_T_fill_with_body 'f' type invariant] inv_F f)
  /\ ([@stop_split] [@expl:extern_spec_T__slice_T_fill_with_body requires] forall s: Seq.seq t_F, e: Seq.seq t_T [precondition_F (Seq.get s (Seq.length e)) ()]. Seq.length s
      = Seq.length e + 1
