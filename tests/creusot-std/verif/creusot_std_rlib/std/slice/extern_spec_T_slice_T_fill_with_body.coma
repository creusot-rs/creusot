    -> (forall j: int. 0 <= j /\ j < Seq.length e
        -> postcondition_mut_F (Seq.get s j) () (Seq.get s (j + 1)) (Seq.get e j))
    -> inv_Seq_F s /\ inv_Seq_T e /\ hist_inv_F f (Seq.get s (Seq.length e))
    -> Seq.length e < Seq.length (Slice64.view self_.current) -> precondition_F (Seq.get s (Seq.length e)) ())}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_sl <- Seq.length (Slice64.view self_.current) ] s1
    | s1 = [ &_f <- f ] s2
    | s2 = [ &i <- (0: UInt64.t) ] s3
    | s3 = [ &f'0 <- f ] s4
    | s4 = [ &_hist <- Seq.create 1 [|f'0|] ] s5
    | s5 = [ &_old <- self_.final ] s6
    | s6 = bb4 ]
  | bb4 = bb4
    [ bb4 = {[@expl:inferred invariant: type invariant] inv_F f'0}
      {[@expl:inferred invariant: type invariant] inv_refmut_slice_T self_}
      {[@expl:inferred invariant: unchanged value] _old = self_.final}
      {[@expl:loop invariant #0] Seq.length (Slice64.view self_.current) = _sl}
      {[@expl:loop invariant #1] UInt64.t'int i <= Seq.length (Slice64.view self_.current)}
      {[@expl:loop invariant #2] Seq.length _hist = UInt64.t'int i + 1}
      {[@expl:loop invariant #3] Seq.get _hist 0 = _f}
      {[@expl:loop invariant #4] Seq.get _hist (UInt64.t'int i) = f'0}
      {[@expl:loop invariant #5] forall j: int. 0 <= j /\ j < Seq.length _hist
        -> inv_F (Seq.get _hist j) /\ hist_inv_F _f (Seq.get _hist j)}
      {[@expl:loop invariant #6] forall j: int. 0 <= j /\ j < UInt64.t'int i
        -> postcondition_mut_F (Seq.get _hist j) () (Seq.get _hist (j + 1)) (Seq.get (Slice64.view self_.current) j)}
      (! s0)
      [ s0 = len_T {self_.current} (fun (_x: UInt64.t) -> [ &_49 <- _x ] s1)
      | s1 = [ &_47 <- UInt64.lt i _49 ] s2
      | s2 = any [ br0 -> {_47 = false} (! bb15) | br1 -> {_47} (! bb7) ] ]
      [ bb7 = s0
        [ s0 = [ &_e <- index_Seq_T (Slice64.view self_.current) { end' = UInt64.t'int i } ] s1
        | s1 = {[@expl:assertion] forall j: int. 0 <= j /\ j < Seq.length _e
            -> postcondition_mut_F (Seq.get _hist j) () (Seq.get _hist (j + 1)) (Seq.get _e j)}
          s2
        | s2 = MutBorrow.borrow_mut <t_F> {f'0}
            (fun (_bor: MutBorrow.t t_F) -> [ &_60 <- _bor ] -{inv_F _bor.final}- [ &f'0 <- _bor.final ] s3)
          [ _ck -> (! {[@expl:type invariant] inv_F f'0} any) ]
        | s3 = call_mut_F {_60} {_61} (fun (_x: t_T) -> [ &_59 <- _x ] s4)
        | s4 = [ &_62 <- i ] s5
        | s5 = Opaque.fresh_ptr
            (fun (_ptr: Opaque.ptr) ->
              -{Slice64.slice_ptr_len _ptr = Slice64.length self_.current}-
              [ &_63 <- _ptr ] s6)
        | s6 = [ &_64 <- Slice64.slice_ptr_len _63 ] s7
        | s7 = [ &_65 <- UInt64.lt _62 _64 ] s8
        | s8 = {[@expl:index in bounds] _65} s9
        | s9 = s10 [ _ck -> (! {[@expl:type invariant] inv_T (index_slice_T self_.current _62)} any) ]
        | s10 = -{resolve_T (index_slice_T self_.current _62)}- s11
        | s11 = Slice64.set <t_T> {self_.current} {_62} {_59}
            (fun (r: Slice64.slice t_T) -> [ &self_ <- { self_ with current = r } ] s12)
        | s12 = [ &_66 <- Seq.snoc _hist f'0 ] s13
        | s13 = [ &_hist <- _66 ] s14
        | s14 = UInt64.add {i} {(1: UInt64.t)} (fun (_x: UInt64.t) -> [ &i <- _x ] s15)
        | s15 = bb4 ] ] ]
  | bb15 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_F f'0} any) ]
    | s1 = -{resolve_F f'0}- s2
    | s2 = s3 [ _ck -> (! {[@expl:type invariant] inv_refmut_slice_T self_} any) ]
    | s3 = -{resolve_refmut_slice_T self_}- s4
    | s4 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & self_: MutBorrow.t (Slice64.slice t_T) = self_
  | & f: t_F = f
  | & _sl: int = Any.any_l ()
  | & _f: t_F = Any.any_l ()
  | & i: UInt64.t = Any.any_l ()
  | & f'0: t_F = Any.any_l ()
  | & _hist: Seq.seq t_F = Any.any_l ()
