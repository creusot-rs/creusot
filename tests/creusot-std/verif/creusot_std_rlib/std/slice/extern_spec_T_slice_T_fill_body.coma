use creusot.prelude.MutBorrow
use creusot.slice.Slice64
use seq.Seq
use creusot.int.UInt64
use creusot.prelude.Opaque
use creusot.prelude.Any
use int.Int

type t_T

predicate inv_T (_1: t_T)

predicate invariant_ref_T [@inline:trivial] (self: t_T) = inv_T self

meta "rewrite_def" predicate invariant_ref_T

predicate inv_ref_T [@inline:trivial] (_1: t_T) = invariant_ref_T _1

meta "rewrite_def" predicate inv_ref_T

predicate invariant_Seq_T [@inline:trivial] (self: Seq.seq t_T) =
  forall i: int. 0 <= i /\ i < Seq.length self -> inv_ref_T (Seq.get self i)

meta "rewrite_def" predicate invariant_Seq_T

predicate inv_Seq_T [@inline:trivial] (_1: Seq.seq t_T) = invariant_Seq_T _1

meta "rewrite_def" predicate inv_Seq_T

predicate invariant_slice_T (self: Slice64.slice t_T) = inv_Seq_T (Slice64.view self)

predicate inv_slice_T [@inline:trivial] (_1: Slice64.slice t_T) = invariant_slice_T _1

meta "rewrite_def" predicate inv_slice_T

predicate invariant_ref_slice_T [@inline:trivial] (self: Slice64.slice t_T) = inv_slice_T self

meta "rewrite_def" predicate invariant_ref_slice_T

predicate inv_ref_slice_T [@inline:trivial] (_1: Slice64.slice t_T) = invariant_ref_slice_T _1

meta "rewrite_def" predicate inv_ref_slice_T

let len_T (self: Slice64.slice t_T) (return (x: UInt64.t)) =
{[@stop_split] [@expl:len 'self' type invariant] inv_ref_slice_T self}
  any
  [ return (result: UInt64.t) -> {[@stop_split] [@expl:len ensures] Seq.length (Slice64.view self)
    = UInt64.t'int result}
    (! return {result}) ]

predicate postcondition_clone (self: ()) (args: t_T) (result: t_T)

axiom postcondition_fndef:
  forall args: t_T, result: t_T [postcondition_clone () args result]. postcondition_clone () args result
    -> (let self = args in inv_T result)

predicate precondition_clone (self: ()) (args: t_T)

axiom precondition_fndef: forall args: t_T [precondition_clone () args]. (let self = args in inv_ref_T self)
    -> precondition_clone () args

predicate postcondition_once_clone (self: ()) (args: t_T) (result: t_T) = postcondition_clone self args result

meta "rewrite_def" predicate postcondition_once_clone

let clone_T (self: t_T) (return (x: t_T)) = {[@stop_split] [@expl:clone requires] precondition_clone () self}
  any
  [ return (result: t_T) -> {[@stop_split] [@expl:clone ensures] postcondition_once_clone () self result}
    (! return {result}) ]

predicate invariant_refmut_slice_T [@inline:trivial] (self: MutBorrow.t (Slice64.slice t_T)) =
  inv_slice_T self.current /\ inv_slice_T self.final

meta "rewrite_def" predicate invariant_refmut_slice_T

predicate inv_refmut_slice_T [@inline:trivial] (_1: MutBorrow.t (Slice64.slice t_T)) = invariant_refmut_slice_T _1

meta "rewrite_def" predicate inv_refmut_slice_T

function index_slice_T [@inline:trivial] (self: Slice64.slice t_T) (ix: UInt64.t) : t_T =
  Seq.get (Slice64.view self) (UInt64.t'int ix)

meta "rewrite_def" function index_slice_T

predicate resolve_T (_1: t_T)

predicate resolve_refmut_slice_T [@inline:trivial] (_1: MutBorrow.t (Slice64.slice t_T)) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_slice_T

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

let extern_spec_T__slice_T_fill_body_T (self_: MutBorrow.t (Slice64.slice t_T)) (value: t_T) (return (x: ())) =
{[@stop_split] [@expl:extern_spec_T__slice_T_fill_body_T requires] ([@stop_split] [@expl:extern_spec_T__slice_T_fill_body 'self_' type invariant] inv_refmut_slice_T self_)
  /\ ([@stop_split] [@expl:extern_spec_T__slice_T_fill_body 'value' type invariant] inv_T value)}
  (! bb0
  [ bb0 = s0
    [ s0 = [ &_sl <- Seq.length (Slice64.view self_.current) ] s1
    | s1 = [ &i <- (0: UInt64.t) ] s2
    | s2 = [ &_old <- self_.final ] s3
    | s3 = bb2 ]
  | bb2 = bb2
    [ bb2 = {[@expl:inferred invariant: type invariant] inv_refmut_slice_T self_}
      {[@expl:inferred invariant: unchanged value] _old = self_.final}
      {[@expl:loop invariant #0] Seq.length (Slice64.view self_.current) = _sl}
      {[@expl:loop invariant #1] UInt64.t'int i <= Seq.length (Slice64.view self_.current)}
      {[@expl:loop invariant #2] forall j: int. 0 <= j /\ j < UInt64.t'int i
        -> postcondition_clone () value (Seq.get (Slice64.view self_.current) j)}
      (! s0)
      [ s0 = len_T {self_.current} (fun (_x: UInt64.t) -> [ &_26 <- _x ] s1)
      | s1 = [ &_24 <- UInt64.lt i _26 ] s2
      | s2 = any [ br0 -> {_24 = false} (! bb11) | br1 -> {_24} (! bb5) ] ]
      [ bb5 = s0
        [ s0 = clone_T {value} (fun (_x: t_T) -> [ &_28 <- _x ] s1)
        | s1 = [ &_30 <- i ] s2
        | s2 = Opaque.fresh_ptr
            (fun (_ptr: Opaque.ptr) ->
              -{Slice64.slice_ptr_len _ptr = Slice64.length self_.current}-
              [ &_31 <- _ptr ] s3)
        | s3 = [ &_32 <- Slice64.slice_ptr_len _31 ] s4
        | s4 = [ &_33 <- UInt64.lt _30 _32 ] s5
        | s5 = {[@expl:index in bounds] _33} s6
        | s6 = s7 [ _ck -> (! {[@expl:type invariant] inv_T (index_slice_T self_.current _30)} any) ]
        | s7 = -{resolve_T (index_slice_T self_.current _30)}- s8
        | s8 = Slice64.set <t_T> {self_.current} {_30} {_28}
            (fun (r: Slice64.slice t_T) -> [ &self_ <- { self_ with current = r } ] s9)
        | s9 = UInt64.add {i} {(1: UInt64.t)} (fun (_x: UInt64.t) -> [ &i <- _x ] s10)
        | s10 = bb2 ] ] ]
  | bb11 = s0
    [ s0 = s1 [ _ck -> (! {[@expl:type invariant] inv_T value} any) ]
    | s1 = -{resolve_T value}- s2
    | s2 = s3 [ _ck -> (! {[@expl:type invariant] inv_refmut_slice_T self_} any) ]
    | s3 = -{resolve_refmut_slice_T self_}- s4
    | s4 = return {_ret} ] ]
  [ & _ret: () = Any.any_l ()
  | & self_: MutBorrow.t (Slice64.slice t_T) = self_
  | & value: t_T = value
  | & _sl: int = Any.any_l ()
  | & i: UInt64.t = Any.any_l ()
  | & _24: bool = Any.any_l ()
  | & _26: UInt64.t = Any.any_l ()
  | & _28: t_T = Any.any_l ()
  | & _30: UInt64.t = Any.any_l ()
  | & _31: Opaque.ptr = Any.any_l ()
  | & _32: UInt64.t = Any.any_l ()
  | & _33: bool = Any.any_l ()
  | & _old: Slice64.slice t_T = Any.any_l () ])
  [ return (result: ()) ->
  {[@stop_split] [@expl:extern_spec_T__slice_T_fill_body_T ensures] ([@stop_split] [@expl:extern_spec_T__slice_T_fill_body ensures #0] Seq.length (Slice64.view self_.final)
      = Seq.length (Slice64.view self_.current))
    /\ ([@stop_split] [@expl:extern_spec_T__slice_T_fill_body ensures #1] forall i: int. 0 <= i
        /\ i < Seq.length (Slice64.view self_.final)
      -> postcondition_clone () value (Seq.get (Slice64.view self_.final) i))}
    (! return {result}) ]
