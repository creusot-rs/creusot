(* <std::slice::IterMut<'a, T> as std::iter::DoubleEndedIteratorSpec> *)

type namespace_other

type t_Namespace = Other namespace_other

use creusot.int.UInt64
use seq.Seq
use creusot.slice.Slice64
use creusot.prelude.MutBorrow
use seq.Reverse
use int.Int

type t_IterMut_T

type t_Option_usize = None | Some UInt64.t

type tup2_usize_Option_usize = { f0: UInt64.t; f1: t_Option_usize }

type t_T

function view_IterMut_T (self: t_IterMut_T) : MutBorrow.t (Slice64.slice t_T)

axiom view_IterMut_T_spec:
  forall self: t_IterMut_T [view_IterMut_T self]. Seq.length (Slice64.view (view_IterMut_T self).final)
    = Seq.length (Slice64.view (view_IterMut_T self).current)

predicate postcondition_size_hint (self: ()) (args: t_IterMut_T) (result: tup2_usize_Option_usize) =
  let self_ = args in UInt64.t'int result.f0 = Seq.length (Slice64.view (view_IterMut_T self_).current)
  /\ result.f1 = Some (result.f0)

meta "rewrite_def" predicate postcondition_size_hint

predicate inv_IterMut_T (_1: t_IterMut_T)

predicate invariant_ref_IterMut_T [@inline:trivial] (self: t_IterMut_T) = inv_IterMut_T self

meta "rewrite_def" predicate invariant_ref_IterMut_T

predicate inv_ref_IterMut_T [@inline:trivial] (_1: t_IterMut_T) = invariant_ref_IterMut_T _1

meta "rewrite_def" predicate inv_ref_IterMut_T

let size_hint_IterMut_T (self_: t_IterMut_T) (return (x: tup2_usize_Option_usize)) =
{[@stop_split] [@expl:size_hint 'self_' type invariant] inv_ref_IterMut_T self_}
  any
  [ return (result: tup2_usize_Option_usize) ->
  {[@stop_split] [@expl:size_hint_IterMut_T ensures] ([@stop_split] [@expl:size_hint ensures #0] UInt64.t'int result.f0
      = Seq.length (Slice64.view (view_IterMut_T self_).current))
    /\ ([@stop_split] [@expl:size_hint ensures #1] result.f1 = Some (result.f0))}
    (! return {result}) ]

function index_slice_T [@inline:trivial] (self: Slice64.slice t_T) (ix: int) : t_T = Seq.get (Slice64.view self) ix

meta "rewrite_def" function index_slice_T

function to_mut_seq_slice_T (self: MutBorrow.t (Slice64.slice t_T)) : Seq.seq (MutBorrow.t t_T)

axiom to_mut_seq_slice_T_spec:
  forall self: MutBorrow.t (Slice64.slice t_T) [to_mut_seq_slice_T self]. Seq.length (to_mut_seq_slice_T self)
    = Seq.length (Slice64.view self.current)

axiom to_mut_seq_slice_T_spec'0:
  forall self: MutBorrow.t (Slice64.slice t_T) [to_mut_seq_slice_T self]. forall i: int. 0 <= i
        /\ i < Seq.length (to_mut_seq_slice_T self)
      -> Seq.get (to_mut_seq_slice_T self) i
      = MutBorrow.borrow_logic (index_slice_T self.current i) (index_slice_T self.final i) (MutBorrow.inherit_id (MutBorrow.get_id self) i)

predicate produces_back_IterMut_T (self: t_IterMut_T) (visited: Seq.seq (MutBorrow.t t_T)) (o: t_IterMut_T) =
  to_mut_seq_slice_T (view_IterMut_T self) = Seq.(++) (to_mut_seq_slice_T (view_IterMut_T o)) (Reverse.reverse visited)

predicate produces_IterMut_T (self: t_IterMut_T) (visited: Seq.seq (MutBorrow.t t_T)) (tl: t_IterMut_T) =
  to_mut_seq_slice_T (view_IterMut_T self) = Seq.(++) visited (to_mut_seq_slice_T (view_IterMut_T tl))

function produces_trans_IterMut_T (a: t_IterMut_T) (ab: Seq.seq (MutBorrow.t t_T)) (b: t_IterMut_T) (bc: Seq.seq (MutBorrow.t t_T)) (c: t_IterMut_T) : ()
 = ()

axiom produces_trans_IterMut_T_spec:
  forall a: t_IterMut_T, ab: Seq.seq (MutBorrow.t t_T), b: t_IterMut_T, bc: Seq.seq (MutBorrow.t t_T), c: t_IterMut_T. produces_IterMut_T a ab b
    -> produces_IterMut_T b bc c -> produces_IterMut_T a (Seq.(++) ab bc) c

function produces_refl_IterMut_T (self: t_IterMut_T) : () = ()

axiom produces_refl_IterMut_T_spec:
  forall self: t_IterMut_T. produces_IterMut_T self (Seq.empty: Seq.seq (MutBorrow.t t_T)) self

predicate resolve_refmut_IterMut_T [@inline:trivial] (_1: MutBorrow.t t_IterMut_T) = _1.final = _1.current

meta "rewrite_def" predicate resolve_refmut_IterMut_T

predicate completed_IterMut_T (self: MutBorrow.t t_IterMut_T) =
  resolve_refmut_IterMut_T self /\ Slice64.view (view_IterMut_T self.current).current = (Seq.empty: Seq.seq t_T)

predicate completed_back_IterMut_T (self: MutBorrow.t t_IterMut_T) = completed_IterMut_T self

meta "compute_max_steps" 1000000

meta "select_lsinst" "all"

constant self : t_IterMut_T

constant r : tup2_usize_Option_usize

function size_hint_back_spec_IterMut_T (self: t_IterMut_T) (r: tup2_usize_Option_usize) : ()

goal vc_size_hint_back_spec_IterMut_T: postcondition_size_hint () self r
  -> ([@stop_split] [@expl:size_hint_back_spec_IterMut_T ensures] ([@stop_split] [@expl:size_hint_back_spec ensures #0] forall s: Seq.seq (MutBorrow.t t_T), i: MutBorrow.t t_IterMut_T. produces_back_IterMut_T self s i.current
        /\ completed_back_IterMut_T i -> UInt64.t'int r.f0 <= Seq.length s)
  /\ ([@stop_split] [@expl:size_hint_back_spec ensures #1] match r.f1 with
    | Some r'0 -> forall s: Seq.seq (MutBorrow.t t_T), i: t_IterMut_T. produces_back_IterMut_T self s i
      -> Seq.length s <= UInt64.t'int r'0
    | None -> true
    end))
